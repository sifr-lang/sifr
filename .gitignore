# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
.obsidian/
*.swp
*.swo

# Environment
.env
.env.local

# Dependencies
node_modules/
__pycache__/
*.pyc

# Build
dist/
build/
!crates/sifr_driver/src/build/
!crates/sifr_driver/src/build/**
**/target/
**/Cargo.lock
!/Cargo.lock
!/vendor/*/Cargo.lock
!verification/areas/rust_interop/fixtures/*/examples/*/Cargo.lock
!verification/areas/rust_interop/fixtures/*/negative/Cargo.lock
!/vendor/*/build/
!/vendor/*/build/**
!/vendor/*/.vscode/
!/vendor/*/.vscode/**
/sifr_output/
/tmp/
tmp_*

# Demos - ignore generated/compiled artifacts, keep .sifr source files
demos/**/sifr_output/
demos/**/*.d
demos/**/*.o
demos/**/*.so
demos/**/*.dylib
demos/**/*.exe
!demos/**/*.sifr
!demos/**/*.rs

# Claude worktrees
.claude/worktrees/*
\!CLAUDE.md
*.claude.log

# Generated snapshot proposals from insta
*.snap.new

# Local Sifr compiler cache
.sifr_cache/

# Optional local reference checkout; uv production dependencies are pinned by Cargo.
/third_party/uv/

# Mintlify docs tooling (local analysis cache; also in docs/.mintignore)
docs/.atlas-analysis.json
