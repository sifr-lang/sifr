{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Sifr",
  "theme": "luma",
  "seo": {
    "metatags": {
      "canonical": "https://docs.sifr.sh"
    }
  },
  "colors": {
    "primary": "#0EA5E9",
    "light": "#38BDF8",
    "dark": "#0284C7"
  },
  "background": {
    "decoration": "gradient"
  },
  "favicon": "/logo/logo.webp",
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 700
    },
    "body": {
      "family": "Plus Jakarta Sans"
    }
  },
  "appearance": {
    "default": "light"
  },
  "logo": {
    "light": "/logo/logo.webp",
    "dark": "/logo/logo.webp",
    "href": "https://sifr.sh"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://sifr.sh",
        "icon": "globe"
      },
      {
        "label": "Blog",
        "href": "https://sifr.sh/blog",
        "icon": "newspaper"
      },
      {
        "label": "Install Sifr",
        "href": "/installation",
        "icon": "download",
        "primary": true
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "index",
              "introduction",
              "installation",
              "quickstart",
              "from-python",
              "python-interop"
            ]
          },
          {
            "group": "Learn Sifr",
            "icon": "braces",
            "pages": [
              "language/type-system",
              "language/error-handling",
              "language/ownership",
              "language/values-and-collections",
              "language/iteration",
              "language/classes",
              "language/pattern-matching"
            ]
          },
          {
            "group": "Concurrency",
            "icon": "workflow",
            "pages": [
              "language/concurrency",
              "concurrency/async-and-await",
              "concurrency/structured-tasks",
              "concurrency/cancellation-and-timeouts",
              "concurrency/ownership-across-tasks"
            ]
          },
          {
            "group": "Standard Library",
            "icon": "book-open",
            "pages": [
              "stdlib/overview",
              "stdlib/module-index",
              "stdlib/collections",
              "stdlib/io-filesystem",
              "stdlib/networking",
              "stdlib/concurrency",
              "stdlib/text-encoding"
            ]
          },
          {
            "group": "Package Management",
            "icon": "package",
            "pages": [
              "packages/overview",
              "packages/manifest",
              "packages/dependencies",
              "packages/publishing"
            ]
          },
          {
            "group": "Project",
            "icon": "circle-dot",
            "pages": [
              "status"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "map",
        "groups": [
          {
            "group": "Overview",
            "icon": "globe",
            "pages": [
              "guides/index"
            ]
          },
          {
            "group": "Python Developer Guide",
            "icon": "map",
            "pages": [
              "guides/python-developers/index",
              "guides/python-developers/mental-model"
            ]
          },
          {
            "group": "Rust Developer Guide",
            "icon": "refresh-cw",
            "pages": [
              "guides/rust-developers/index",
              "guides/rust-developers/rust-concepts"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "library",
        "groups": [
          {
            "group": "CLI",
            "icon": "square-terminal",
            "pages": [
              "cli/overview",
              "cli/build-run",
              "cli/check-emit",
              "cli/fmt-lint",
              "cli/test",
              "cli/lsp",
              "cli/packages-workspaces"
            ]
          },
          {
            "group": "Error Codes",
            "icon": "scan-search",
            "pages": [
              "diagnostics/overview",
              "diagnostics/error-codes"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/sifr-lang/sifr"
    }
  }
}
