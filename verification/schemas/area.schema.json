{
  "$schema": "https://sifr-lang.local/verification/area.schema.json",
  "title": "Sifr verification area manifest",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "owner",
    "description",
    "parallel_safe",
    "resource_classes",
    "timeout_seconds",
    "suites"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2]
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parallel_safe": {
      "type": "boolean"
    },
    "resource_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "default-local",
          "network",
          "large-memory",
          "platform-specific",
          "long-running",
          "external-corpus"
        ]
      }
    },
    "timeout_seconds": {
      "type": "integer"
    },
    "network_mode": {
      "type": "string",
      "enum": ["offline", "live"]
    },
    "pinned_corpus": {
      "type": "object",
      "required": ["required", "revision", "checksum"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "revision": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        }
      }
    },
    "skip_policy": {
      "type": "object",
      "required": ["allowed", "requires_reason"],
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "requires_reason": {
          "type": "boolean"
        }
      }
    },
    "baseline_metadata_rules": {
      "type": "object",
      "required": ["required", "source"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "artifact_declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "retention"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "format": "repo-relative-path"
          },
          "retention": {
            "type": "string"
          }
        }
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "cases"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["manifest", "golden", "adapter"]
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "entry",
                "command",
                "expect_exit_code",
                "diagnostic_formats"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "entry": {
                  "type": "string",
                  "format": "repo-relative-path"
                },
                "command": {
                  "type": "string"
                },
                "expect_exit_code": {
                  "type": "integer"
                },
                "diagnostic_formats": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "quiet": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
