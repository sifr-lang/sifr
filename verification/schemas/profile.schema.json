{
  "$schema": "https://sifr-lang.local/verification/profile.schema.json",
  "title": "Sifr verification profile",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "description",
    "budgets",
    "resource_policy",
    "selected_areas",
    "toolchain_steps",
    "guardrail_steps",
    "e2e",
    "retry_policy",
    "shard_policy",
    "resume_policy",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [2]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "budgets": {
      "type": "object",
      "required": ["warm_wall_time_minutes", "cold_wall_time_minutes"],
      "additionalProperties": false,
      "properties": {
        "warm_wall_time_minutes": {
          "type": "integer"
        },
        "cold_wall_time_minutes": {
          "type": "integer"
        }
      }
    },
    "step_budgets": {
      "type": "object",
      "additionalProperties": true
    },
    "resource_policy": {
      "type": "object",
      "required": ["classes", "max_parallel", "thermal_policy", "memory_policy"],
      "additionalProperties": false,
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "default-local",
              "network",
              "large-memory",
              "platform-specific",
              "long-running",
              "external-corpus",
              "container-runtime"
            ]
          }
        },
        "max_parallel": {
          "type": "integer"
        },
        "thermal_policy": {
          "type": "string"
        },
        "memory_policy": {
          "type": "string"
        }
      }
    },
    "network_policy": {
      "type": "object",
      "required": ["mode", "live_network_allowed"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["offline", "live"]
        },
        "live_network_allowed": {
          "type": "boolean"
        }
      }
    },
    "cargo_policy": {
      "type": "object",
      "required": ["locked", "offline", "setup_command"],
      "additionalProperties": false,
      "properties": {
        "locked": {
          "type": "boolean"
        },
        "offline": {
          "type": "boolean"
        },
        "setup_command": {
          "type": "string"
        }
      }
    },
    "reference_host": {
      "type": "object",
      "required": ["os", "arch", "notes"],
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "execution_sandbox": {
      "type": "object",
      "required": [
        "tempdir_only",
        "external_network",
        "loopback_network",
        "subprocess_cleanup",
        "stdout_stderr_byte_limit"
      ],
      "additionalProperties": false,
      "properties": {
        "tempdir_only": {
          "type": "boolean"
        },
        "external_network": {
          "type": "string",
          "enum": ["forbidden", "allowed"]
        },
        "loopback_network": {
          "type": "string",
          "enum": ["forbidden", "declared-only", "allowed"]
        },
        "subprocess_cleanup": {
          "type": "boolean"
        },
        "stdout_stderr_byte_limit": {
          "type": "integer"
        }
      }
    },
    "crate_test_membership": {
      "type": "object",
      "required": ["suites"],
      "additionalProperties": false,
      "properties": {
        "suites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "package",
              "command",
              "modes",
              "status",
              "executed_in_merge"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "package": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "modes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["smoke", "full"]
                }
              },
              "status": {
                "type": "string",
                "enum": ["blocking", "red-blocker"]
              },
              "executed_in_merge": {
                "type": "boolean"
              },
              "must_be_executed_by": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "selected_areas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["area", "suites", "resource_classes"],
        "additionalProperties": false,
        "properties": {
          "area": {
            "type": "string"
          },
          "suites": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "resource_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "default-local",
                "network",
                "large-memory",
                "platform-specific",
                "long-running",
                "external-corpus",
                "container-runtime"
              ]
            }
          }
        }
      }
    },
    "toolchain_steps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cargo-build-release",
          "cargo-fmt-check",
          "cargo-clippy-workspace",
          "cargo-test-sifr-smoke",
          "cargo-test-sifr-full",
          "cargo-test-workspace",
          "e2e-pass",
          "e2e-report-determinism",
          "e2e-sequential-parallel-equivalence"
        ]
      }
    },
    "guardrail_steps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "hir-maintainability",
          "file-size",
          "demo-emitted-freshness",
          "source-crate-dependency-direction",
          "submodule-ownership",
          "sysroot-resource-certification",
          "stdlib-native-intrinsic-allowlist",
          "stdlib-native-adapter-reachability",
          "stdlib-manifest-schema",
          "stdlib-bootstrap-ordering",
          "driver-maintainability",
          "verification-hardening-self-test",
          "verification-runner-foundation",
          "hardening-determinism-scale"
        ]
      }
    },
    "e2e": {
      "type": "object",
      "required": [
        "fixture_manifest",
        "sifr_jobs",
        "rust_jobs",
        "run_jobs",
        "cargo_build_jobs",
        "max_group_fixtures",
        "disable_cache"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_manifest": {
          "type": "string"
        },
        "sifr_jobs": {
          "type": "integer"
        },
        "rust_jobs": {
          "type": "integer"
        },
        "run_jobs": {
          "type": "integer"
        },
        "cargo_build_jobs": {
          "type": "integer"
        },
        "max_group_fixtures": {
          "type": "integer"
        },
        "disable_cache": {
          "type": "boolean"
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "required": ["max_attempts", "retry_flaky_only"],
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer"
        },
        "retry_flaky_only": {
          "type": "boolean"
        }
      }
    },
    "shard_policy": {
      "type": "object",
      "required": ["strategy", "shards"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["none", "deterministic"]
        },
        "shards": {
          "type": "integer"
        }
      }
    },
    "resume_policy": {
      "type": "object",
      "required": ["enabled", "failure_reproduction"],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failure_reproduction": {
          "type": "string",
          "enum": ["profile-and-case"]
        }
      }
    },
    "report": {
      "type": "object",
      "required": ["format", "output_dir"],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json-v1"]
        },
        "output_dir": {
          "type": "string",
          "format": "repo-relative-path"
        }
      }
    }
  }
}
