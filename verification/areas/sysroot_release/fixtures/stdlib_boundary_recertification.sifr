from sifr.test import assert_eq, assert_true


def main() -> None:
    try:
        payload: bytes = bytes.from_hex("73696672")
        encoded: str = payload.hex()
        assert_eq(encoded, "73696672")
        assert_true(len(payload) == 4)
    except ParseError as e:
        assert_true(False)
    print("stdlib boundary recertification: pass")
