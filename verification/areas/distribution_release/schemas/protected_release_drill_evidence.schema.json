{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected stable release drill evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "external_network",
    "production_credentials",
    "scenarios",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "environment": {
      "const": "stable-release-drill"
    },
    "external_network": {
      "const": "blocked"
    },
    "production_credentials": {
      "const": "absent"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tests"
        ],
        "properties": {
          "name": {
            "enum": [
              "publication",
              "rollback",
              "first-ga"
            ]
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "status": {
      "const": "pass"
    }
  }
}
