{
  "schema_version": 2,
  "name": "algorithmic_compatibility",
  "owner": "algorithmic/compatibility",
  "description": "Algorithmic corpus compatibility, LeetCode fixture checks, and full-corpus failure taxonomy tooling.",
  "parallel_safe": false,
  "resource_classes": [
    "default-local",
    "external-corpus",
    "long-running"
  ],
  "timeout_seconds": 1800,
  "suites": [
    {
      "name": "profile-manifest",
      "kind": "manifest",
      "cases": [
        {
          "id": "leetcode-profile-manifest",
          "entry": "verification/areas/algorithmic_compatibility/data/leetcode_profile_manifest.json",
          "command": "algorithmic-profile-manifest",
          "expect_exit_code": 0,
          "diagnostic_formats": []
        }
      ]
    },
    {
      "name": "representative-subset",
      "kind": "adapter",
      "cases": [
        {
          "id": "leetcode-representative-subset",
          "entry": "verification/areas/algorithmic_compatibility/data/leetcode_profile_manifest.json",
          "command": "algorithmic-representative-subset",
          "expect_exit_code": 0,
          "diagnostic_formats": []
        }
      ]
    },
    {
      "name": "leetcode-full",
      "kind": "adapter",
      "cases": [
        {
          "id": "leetcode-full-corpus",
          "entry": "verification/areas/algorithmic_compatibility/data/leetcode_profile_manifest.json",
          "command": "algorithmic-leetcode-full",
          "expect_exit_code": 0,
          "diagnostic_formats": []
        }
      ]
    },
    {
      "name": "taxonomy-smoke",
      "kind": "adapter",
      "cases": [
        {
          "id": "full-corpus-taxonomy-smoke",
          "entry": "verification/areas/algorithmic_compatibility/tools/build_full_corpus_failure_taxonomy.py",
          "command": "algorithmic-taxonomy-smoke",
          "expect_exit_code": 0,
          "diagnostic_formats": []
        }
      ]
    },
    {
      "name": "leetcode-check",
      "kind": "adapter",
      "cases": [
        {
          "id": "leetcode-corpus-check",
          "entry": "verification/areas/algorithmic_compatibility/corpora/leetcode/src",
          "command": "algorithmic-leetcode-check",
          "expect_exit_code": 0,
          "diagnostic_formats": []
        }
      ]
    }
  ],
  "network_mode": "offline",
  "pinned_corpus": {
    "required": true,
    "revision": "checked-in-local-corpus",
    "checksum": "sha256:4c16fa4f9a1fbc118c2d2e317535d7131242a27b7bc539b22f8c8e3385116f69"
  },
  "skip_policy": {
    "allowed": false,
    "requires_reason": true
  },
  "baseline_metadata_rules": {
    "required": false,
    "source": "not-applicable"
  }
}
