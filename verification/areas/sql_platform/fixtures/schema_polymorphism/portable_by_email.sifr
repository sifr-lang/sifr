from sifr.sql import SqlSchema
from sifr.sql.requirements import has_users
from sifr.sql.schemas import app


def by_email[S: has_users.Schema](schema: SqlSchema[S], email: str):
    return schema.sql(t"""
        SELECT id, email
        FROM public.users
        WHERE email = {email}
    """)


def main():
    query = by_email(app.schema, "dev@example.com")
