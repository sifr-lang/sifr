{
  "schema_version": 1,
  "rust_version": "1.98",
  "root_lock_package": "sifr_sql_dependency_lock",
  "sqlite_amalgamation": "3.53.2",
  "build_environment": {
    "SYNTAQLITE_SQLITE_VERSION": "3053002",
    "SYNTAQLITE_CFLAG_*": []
  },
  "required_audits": [
    "advisory",
    "license",
    "panic",
    "secret-redaction",
    "unsafe-code"
  ],
  "constraints": [
    {
      "id": "compiler-component-sandbox",
      "platform_part": "compiler_components",
      "audit_owner": "sifr_compiler_component",
      "rules": [
        "The host enables the WebAssembly Component Model without WASI.",
        "The host links no ambient file, network, clock, random, environment, process, thread, or native-library interface.",
        "Fuel, memory, stack, input, output, and protocol limits fail with SIFR-COMPONENT diagnostics."
      ]
    },
    {
      "id": "syntaqlite-source-and-fork-readiness",
      "platform_part": "sqlite_provider",
      "audit_owner": "sifr-sql-sqlite/component",
      "rules": [
        "Crates.io is the release authority.",
        "GitHub is the source authority.",
        "The exact pre-1.0 release is pinned.",
        "The provider-owned adapter is the documented fork boundary."
      ]
    },
    {
      "id": "single-sqlite-link-identity",
      "platform_part": "sqlite_provider",
      "audit_owner": "sifr-package/cargo-graph",
      "rules": [
        "Every first-party provider must resolve one compatible libsqlite3-sys link identity before linking.",
        "Every direct Rust interoperability path must use that identity."
      ]
    },
    {
      "id": "shared-tls-dependency-ring",
      "platform_part": "common_sql",
      "audit_owner": "sifr_runtime/tls",
      "rules": [
        "Tokio, Rustls, Tokio Rustls, and the platform verifier remain shared dependency Ring 4 substrate.",
        "AWS-LC-RS is the shared Rustls crypto provider.",
        "Each provider TLS adapter is an explicit dependency Ring 4 edge with AWS-LC-RS."
      ]
    }
  ],
