{
  "schema_version": 1,
  "graph_owner": "sifr_package",
  "dispatch_owner": "sifr",
  "workspace_metadata_key": "workspace.metadata.sifr.tools-package",
  "lock_authority": ["Cargo.lock", "sifr-tools.lock.json"],
  "metadata_authority": "cargo metadata --frozen",
  "execution": {
    "build_target": "host",
    "target_argument_allowed": true,
    "target_source": "sifr-build-target",
    "direct_namespace": true,
    "application_graph_separate": true,
    "build_then_direct_exec": true,
    "cargo_program_absolute": true,
    "native_sandbox_required": true,
    "output_limit_bytes": 10485760
  },
  "entrypoint_identity": [
    "cargo-package-id",
    "package-name",
    "package-version",
    "package-source",
    "package-checksum",
    "binary-entrypoint",
    "capabilities",
    "tools-manifest-fingerprint",
    "lockfile-fingerprint",
    "persisted-tool-graph",
    "executable-sha256"
  ],
  "capabilities": [
    "credentials",
    "environment",
    "network",
    "project-read",
    "project-write",
    "subprocess"
  ],
  "negative_contracts": [
    "unknown-namespace",
    "reserved-namespace",
    "duplicate-namespace",
    "unknown-capability",
    "missing-entrypoint",
    "non-direct-tool-package",
    "lockfile-hash-drift",
    "target-graph-contamination",
    "missing-persisted-lock",
    "tools-manifest-drift",
    "path-source-drift",
    "capability-denial"
  ],
  "sql_test_provision": {
    "command": "sifr sql test provision --profile <name>",
    "manifest_version": 1,
    "inline_credentials": false,
    "cleanup_identity_required": true,
    "cleanup_command": "sifr <tool-namespace> test cleanup --resource-id <id>",
    "credential_helper_uses_shell": false
  },
  "inherited_failure_isolation": {
    "sql_initialization_is_fatal": false,
    "diagnostic_is_required": true,
    "non_sql_analysis_is_preserved": true
  },
  "behavioral_evidence": [
    "crates/sifr_package/src/host_tools_tests.rs",
    "crates/sifr/tests/host_tool_cli.rs",
    "crates/sifr_analysis/src/host/tests/sql_editor_tests.rs",
    "crates/sifr_sql_contract/tests/provision_contract.rs",
    "crates/sifr_sql_mysql_tools/src/command.rs",
    "crates/sifr_sql_mysql_tools/src/provision.rs",
    "crates/sifr_sql_sqlite_tools/src/command.rs",
    "crates/sifr_sql_sqlite_tools/src/provision.rs"
  ],
  "executable_tests": [
    {"path": "crates/sifr/tests/host_tool_cli.rs", "name": "direct_sql_namespace_runs_locked_host_tool_and_validates_manifest"},
    {"path": "crates/sifr_analysis/src/host/tests/sql_editor_tests.rs", "name": "lockfile_less_project_defers_sql_profiles_and_preserves_overlay_analysis"},
    {"path": "crates/sifr_package/src/host_tools_tests.rs", "name": "host_tool_graph_resolves_locked_host_entrypoint"},
    {"path": "crates/sifr_package/src/host_tools_tests.rs", "name": "host_tool_graph_rejects_reserved_namespaces_and_unknown_capabilities"},
    {"path": "crates/sifr_package/src/host_tools_tests.rs", "name": "host_tool_graph_rejects_application_contamination"},
    {"path": "crates/sifr_package/src/host_tools_tests.rs", "name": "host_tool_graph_detects_lockfile_hash_drift"},
    {"path": "crates/sifr_sql_contract/tests/provision_contract.rs", "name": "connection_manifest_is_structured_and_never_contains_inline_credentials"}
  ]
}
