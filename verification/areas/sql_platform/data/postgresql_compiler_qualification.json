{
  "schema_version": 1,
  "component_crate": "sifr_sql_postgresql",
  "component_family": "sifr.sql.postgresql.sql",
  "source_manifest": "crates/sifr_sql_postgresql/component-sources.json",
  "artifact_manifest": "crates/sifr_sql_postgresql/component-artifacts.json",
  "supported_server_majors": [13, 14, 15, 16, 17, 18],
  "parser_boundary": {
    "strict_parser": "libpg_query",
    "raw_transport": "json",
    "owned_adapter": "crates/sifr_sql_postgresql/src/raw_adapter.rs",
    "ffi_owner": "crates/sifr_sql_postgresql/src/ffi.rs",
    "build_adapter": "cc@1.4.4"
  },
  "core_schema_objects": [
    "check-constraint",
    "column",
    "composite",
    "domain",
    "enum",
    "foreign-key",
    "function",
    "index",
    "materialized-view",
    "namespace",
    "primary-key",
    "range",
    "sequence",
    "table",
    "unique-constraint",
    "view"
  ],
  "semantic_mechanisms": [
    "array-and-range-resolution",
    "aggregate-resolution",
    "alias-resolution",
    "cast-resolution",
    "correlated-subquery-resolution",
    "cte-resolution",
    "exact-codec-inference",
    "exact-parameter-inference",
    "function-resolution",
    "json-operator-resolution",
    "outer-join-nullability",
    "operator-resolution",
    "postgresql-nullability",
    "set-operation-resolution",
    "window-and-locking-resolution",
    "write-effects"
  ],
  "stability_mechanisms": [
    "canonical-query-signature-artifact",
    "explicit-private-star-expansion",
    "exported-star-rejection",
    "machine-applicable-projection-fixes"
  ],
  "write_mechanisms": [
    "conflict-targets",
    "excluded-relation",
    "generated-column-rejection",
    "required-values",
    "returning",
    "write-effect-contract"
  ],
  "placeholder_contract": {
    "syntax": "$n",
    "emitted_index_base": 1,
    "metadata_index_base": 0,
    "lexically_safe_rewrite": true
  },
  "diagnostic_spans": ["schema", "sifr", "virtual-sql"],
  "evidence": {
    "architecture": "internal_docs/sql_postgresql_compiler.md",
    "component_tests": "crates/sifr_sql_postgresql/tests/postgresql_compiler.rs",
    "regression_tests": "crates/sifr_sql_postgresql/tests/postgresql_regressions.rs",
    "artifact_builder": "verification/areas/sql_platform/tools/build_postgresql_components.py",
    "artifact_manifest": "crates/sifr_sql_postgresql/component-artifacts.json",
    "live_server_matrix": "verification/areas/sql_platform/data/postgresql_server_matrix.json",
    "parser_matrix_runner": "verification/areas/sql_platform/tools/run_postgresql_parser_matrix.py",
    "server_matrix_runner": "verification/areas/sql_platform/tools/run_postgresql_server_matrix.py"
  }
