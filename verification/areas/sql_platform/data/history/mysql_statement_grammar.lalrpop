grammar;

use crate::lexer::{Keyword, Token};
use crate::parser::RawStatement;

extern {
    type Location = usize;
    type Error = crate::lexer::LexError;

    enum Token {
        "SELECT" => Token::Keyword(Keyword::Select),
        "WITH" => Token::Keyword(Keyword::With),
        "INSERT" => Token::Keyword(Keyword::Insert),
        "REPLACE" => Token::Keyword(Keyword::Replace),
        "UPDATE" => Token::Keyword(Keyword::Update),
        "DELETE" => Token::Keyword(Keyword::Delete),
        "CREATE" => Token::Keyword(Keyword::Create),
        "ALTER" => Token::Keyword(Keyword::Alter),
        "DROP" => Token::Keyword(Keyword::Drop),
        "TABLE" => Token::Keyword(Keyword::Table),
        "VIEW" => Token::Keyword(Keyword::View),
        "INDEX" => Token::Keyword(Keyword::Index),
        "UNIQUE" => Token::Keyword(Keyword::Unique),
        "PRIMARY" => Token::Keyword(Keyword::Primary),
        "KEY" => Token::Keyword(Keyword::Key),
        "FOREIGN" => Token::Keyword(Keyword::Foreign),
        "REFERENCES" => Token::Keyword(Keyword::References),
        "CHECK" => Token::Keyword(Keyword::Check),
        "INTO" => Token::Keyword(Keyword::Into),
        "VALUES" => Token::Keyword(Keyword::Values),
        "FROM" => Token::Keyword(Keyword::From),
        "WHERE" => Token::Keyword(Keyword::Where),
        "JOIN" => Token::Keyword(Keyword::Join),
        "LEFT" => Token::Keyword(Keyword::Left),
        "RIGHT" => Token::Keyword(Keyword::Right),
        "INNER" => Token::Keyword(Keyword::Inner),
        "CROSS" => Token::Keyword(Keyword::Cross),
        "ON" => Token::Keyword(Keyword::On),
        "AS" => Token::Keyword(Keyword::As),
        "SET" => Token::Keyword(Keyword::Set),
        "AND" => Token::Keyword(Keyword::And),
        "OR" => Token::Keyword(Keyword::Or),
        "NOT" => Token::Keyword(Keyword::Not),
        "NULL" => Token::Keyword(Keyword::Null),
        "DEFAULT" => Token::Keyword(Keyword::Default),
        "GENERATED" => Token::Keyword(Keyword::Generated),
        "ALWAYS" => Token::Keyword(Keyword::Always),
        "VIRTUAL" => Token::Keyword(Keyword::Virtual),
        "STORED" => Token::Keyword(Keyword::Stored),
        "AUTO_INCREMENT" => Token::Keyword(Keyword::AutoIncrement),
        "UNSIGNED" => Token::Keyword(Keyword::Unsigned),
        "ZEROFILL" => Token::Keyword(Keyword::Zerofill),
        "CHARACTER" => Token::Keyword(Keyword::Character),
        "CHARSET" => Token::Keyword(Keyword::Charset),
        "COLLATE" => Token::Keyword(Keyword::Collate),
        "CONSTRAINT" => Token::Keyword(Keyword::Constraint),
        "IGNORE" => Token::Keyword(Keyword::Ignore),
        "DUPLICATE" => Token::Keyword(Keyword::Duplicate),
        "GROUP" => Token::Keyword(Keyword::Group),
        "BY" => Token::Keyword(Keyword::By),
        "HAVING" => Token::Keyword(Keyword::Having),
        "ORDER" => Token::Keyword(Keyword::Order),
        "LIMIT" => Token::Keyword(Keyword::Limit),
        "OFFSET" => Token::Keyword(Keyword::Offset),
        "DISTINCT" => Token::Keyword(Keyword::Distinct),
        "WINDOW" => Token::Keyword(Keyword::Window),
        "OVER" => Token::Keyword(Keyword::Over),
        "FOR" => Token::Keyword(Keyword::For),
        "RETURNING" => Token::Keyword(Keyword::Returning),
        "UNION" => Token::Keyword(Keyword::Union),
        "ALL" => Token::Keyword(Keyword::All),
        "identifier" => Token::Identifier(<String>),
        "quoted_identifier" => Token::QuotedIdentifier(<String>),
        "string" => Token::String(<String>),
        "number" => Token::Number(<String>),
        "parameter" => Token::Parameter,
        "," => Token::Comma,
        "." => Token::Dot,
        "(" => Token::LeftParen,
        ")" => Token::RightParen,
        "operator" => Token::Operator(<String>),
        ";" => Token::Semicolon,
    }
}

pub Statements: Vec<RawStatement> = {
    <mut statements:(<Statement> ";")*> <last:Statement?> => {
        if let Some(last) = last {
            statements.push(last);
        }
        statements
    }
};

Statement: RawStatement = {
    <start:@L> "SELECT" <tail:Any*> <end:@R> => RawStatement::new(start, Token::Keyword(Keyword::Select), tail, end),
    <start:@L> "WITH" <tail:Any*> <end:@R> => RawStatement::new(start, Token::Keyword(Keyword::With), tail, end),
    <start:@L> "INSERT" <tail:Any*> <end:@R> => RawStatement::new(start, Token::Keyword(Keyword::Insert), tail, end),
    <start:@L> "REPLACE" <tail:Any*> <end:@R> => RawStatement::new(start, Token::Keyword(Keyword::Replace), tail, end),
    <start:@L> "UPDATE" <tail:Any*> <end:@R> => RawStatement::new(start, Token::Keyword(Keyword::Update), tail, end),
    <start:@L> "DELETE" <tail:Any*> <end:@R> => RawStatement::new(start, Token::Keyword(Keyword::Delete), tail, end),
    <start:@L> "CREATE" <tail:Any*> <end:@R> => RawStatement::new(start, Token::Keyword(Keyword::Create), tail, end),
    <start:@L> "ALTER" <tail:Any*> <end:@R> => RawStatement::new(start, Token::Keyword(Keyword::Alter), tail, end),
    <start:@L> "DROP" <tail:Any*> <end:@R> => RawStatement::new(start, Token::Keyword(Keyword::Drop), tail, end),
};

Any: Token = {
    "SELECT" => Token::Keyword(Keyword::Select), "WITH" => Token::Keyword(Keyword::With),
    "INSERT" => Token::Keyword(Keyword::Insert), "REPLACE" => Token::Keyword(Keyword::Replace),
    "UPDATE" => Token::Keyword(Keyword::Update), "DELETE" => Token::Keyword(Keyword::Delete),
    "CREATE" => Token::Keyword(Keyword::Create), "ALTER" => Token::Keyword(Keyword::Alter),
    "DROP" => Token::Keyword(Keyword::Drop), "TABLE" => Token::Keyword(Keyword::Table),
    "VIEW" => Token::Keyword(Keyword::View), "INDEX" => Token::Keyword(Keyword::Index),
    "UNIQUE" => Token::Keyword(Keyword::Unique), "PRIMARY" => Token::Keyword(Keyword::Primary),
    "KEY" => Token::Keyword(Keyword::Key), "FOREIGN" => Token::Keyword(Keyword::Foreign),
    "REFERENCES" => Token::Keyword(Keyword::References), "CHECK" => Token::Keyword(Keyword::Check),
    "INTO" => Token::Keyword(Keyword::Into), "VALUES" => Token::Keyword(Keyword::Values),
    "FROM" => Token::Keyword(Keyword::From), "WHERE" => Token::Keyword(Keyword::Where),
    "JOIN" => Token::Keyword(Keyword::Join), "LEFT" => Token::Keyword(Keyword::Left),
    "RIGHT" => Token::Keyword(Keyword::Right), "INNER" => Token::Keyword(Keyword::Inner),
    "CROSS" => Token::Keyword(Keyword::Cross), "ON" => Token::Keyword(Keyword::On),
    "AS" => Token::Keyword(Keyword::As), "SET" => Token::Keyword(Keyword::Set),
    "AND" => Token::Keyword(Keyword::And), "OR" => Token::Keyword(Keyword::Or),
    "NOT" => Token::Keyword(Keyword::Not), "NULL" => Token::Keyword(Keyword::Null),
    "DEFAULT" => Token::Keyword(Keyword::Default), "GENERATED" => Token::Keyword(Keyword::Generated),
    "ALWAYS" => Token::Keyword(Keyword::Always), "VIRTUAL" => Token::Keyword(Keyword::Virtual),
    "STORED" => Token::Keyword(Keyword::Stored), "AUTO_INCREMENT" => Token::Keyword(Keyword::AutoIncrement),
    "UNSIGNED" => Token::Keyword(Keyword::Unsigned), "ZEROFILL" => Token::Keyword(Keyword::Zerofill),
    "CHARACTER" => Token::Keyword(Keyword::Character), "CHARSET" => Token::Keyword(Keyword::Charset),
    "COLLATE" => Token::Keyword(Keyword::Collate), "CONSTRAINT" => Token::Keyword(Keyword::Constraint),
    "IGNORE" => Token::Keyword(Keyword::Ignore), "DUPLICATE" => Token::Keyword(Keyword::Duplicate),
    "GROUP" => Token::Keyword(Keyword::Group), "BY" => Token::Keyword(Keyword::By),
    "HAVING" => Token::Keyword(Keyword::Having), "ORDER" => Token::Keyword(Keyword::Order),
    "LIMIT" => Token::Keyword(Keyword::Limit), "OFFSET" => Token::Keyword(Keyword::Offset),
    "DISTINCT" => Token::Keyword(Keyword::Distinct), "WINDOW" => Token::Keyword(Keyword::Window),
    "OVER" => Token::Keyword(Keyword::Over), "FOR" => Token::Keyword(Keyword::For),
    "RETURNING" => Token::Keyword(Keyword::Returning), "UNION" => Token::Keyword(Keyword::Union),
    "ALL" => Token::Keyword(Keyword::All),
    <value:"identifier"> => Token::Identifier(value),
    <value:"quoted_identifier"> => Token::QuotedIdentifier(value),
    <value:"string"> => Token::String(value), <value:"number"> => Token::Number(value),
    "parameter" => Token::Parameter, "," => Token::Comma, "." => Token::Dot,
    "(" => Token::LeftParen, ")" => Token::RightParen,
    <value:"operator"> => Token::Operator(value),
};
