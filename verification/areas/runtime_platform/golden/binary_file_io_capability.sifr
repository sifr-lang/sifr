from sifr.io import exists
from sifr.os import remove_file


def main():
    path: str = "/tmp/sifr_platform_binary_file_io_capability.bin"
    payload_ok: bool = False
    closed_rejects: bool = False
    cleanup_ok: bool = False

    try:
        writer = open(path, "wb")
        _w: None = writer.write_bytes(b"platform-binary")
        writer.close()

        try:
            _after_close: None = writer.write_bytes(b"again")
        except IOError as e:
            _ = str(e.message)
            closed_rejects = True

        reader = open(path, "rb")
        loaded: bytes = reader.read_bytes()
        reader.close()
        payload_ok = loaded == b"platform-binary"
    except IOError as e:
        _ = str(e.message)

    try:
        if exists(path):
            _rm: None = remove_file(path)
        cleanup_ok = not exists(path)
    except IOError as e:
        _ = str(e.message)

    assert payload_ok
    assert closed_rejects
    assert cleanup_ok
    print("platform-golden: binary-file-io pass")
