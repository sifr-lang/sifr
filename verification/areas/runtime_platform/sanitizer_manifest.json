      ],
      "timeout_seconds": 240,
      "env": {},
      "command": [
        "cargo",
        "+nightly",
        "miri",
        "test",
        "--locked",
        "-p",
        "sifr_runtime",
        "timeouts::tests::rejects_non_finite_non_positive_and_overflow_sized_timeouts"
      ],
      "skip_reason": "requires nightly Rust with the miri component installed",
      "finding_promotion": "Promote minimized Miri UB findings into runtime regression coverage before closing."
    },
    {
      "id": "deterministic-concurrency-model-full",
      "suites": ["sanitizer-full"],
      "scope": "async_concurrency_runtime",
      "tool": "loom-or-shuttle",
      "supported_host_triples": ["*"],
      "required_tools": [],
      "required_rustup_toolchains": [],
      "always_skip": true,
      "timeout_seconds": 0,
      "env": {},
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "sifr_stdlib",
        "ipc_request_tracker"
      ],
      "skip_reason": "no Loom/Shuttle-style deterministic concurrency model is currently vendored; this structured skip records the required reproduction boundary",
      "finding_promotion": "When a deterministic model is introduced, promote explored interleavings into merge-blocking stdlib/runtime regressions."
    }
  ]
}
