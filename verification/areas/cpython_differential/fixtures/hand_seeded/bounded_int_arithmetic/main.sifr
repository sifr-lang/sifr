from sifr.json import dumps, from_array, from_int


def main() -> None:
    print(
        dumps(
            from_array(
                [
                    from_int(1 + 2 * 3),
                    from_int(17 // 5),
                    from_int(17 % 5),
                    from_int(-5 + 9),
                    from_int((8 - 3) * 4),
                ]
            )
        )
    )
