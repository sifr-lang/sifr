from sifr.json import dumps, from_array, from_bool


def main() -> None:
    items: list[int] = [3, 1, 4, 1, 5]
    total: int = 0
    for value in items:
        total = total + value
    print(
        dumps(
            from_array(
                [
                    from_bool(len(items) == 5),
                    from_bool(items[0] == 3),
                    from_bool(items[2] == 4),
                    from_bool(total == 14),
                ]
            )
        )
    )
