from sifr.json import dumps, from_array, from_bool


def same_prefix(value: str) -> bool:
    return value == "sifr" or value == "python"


def main() -> None:
    print(
        dumps(
            from_array(
                [
                    from_bool(True and not False),
                    from_bool(same_prefix("sifr")),
                    from_bool(same_prefix("rust")),
                    from_bool(len("safe") == 4),
                    from_bool("si" + "fr" == "sifr"),
                ]
            )
        )
    )
