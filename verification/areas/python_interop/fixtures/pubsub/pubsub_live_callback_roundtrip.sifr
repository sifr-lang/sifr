from sifr.env import getenv
from sifr.python import PythonError, ResourceDiagnostics, resource_diagnostics


@python.callback(handler, lifetime=call, dispatch=foreign, concurrency=serial)
@python(bridge.aws_live.run_sns_to_sqs)
def run_live(
    handler: Callable[[str], str],
    endpoint: str,
    token: str,
    case_id: str,
) -> Result[str, PythonError]: ...


def acknowledge(message: str) -> str:
    return "ack:" + message


def main() -> Result[None, PythonError]:
    try:
        before: ResourceDiagnostics = resource_diagnostics()
        marker: str = run_live(
            acknowledge,
            getenv("SIFR_LIVE_ENDPOINT", ""),
            getenv("SIFR_LIVE_TOKEN", ""),
            "pubsub",
        )
        after: ResourceDiagnostics = resource_diagnostics()
        if after.live_objects != before.live_objects or after.leaked_objects != before.leaked_objects:
            raise PythonError("Pub/sub live declaration leaked Python resources")
        print(marker)
    except PythonError as error:
        raise error
    return None
