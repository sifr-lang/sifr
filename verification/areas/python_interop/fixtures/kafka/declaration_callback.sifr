from sifr.python import PythonError


@python.callback(handler, lifetime=call, dispatch=foreign, concurrency=serial)
@python(bridge.kafka_declaration.poll)
def kafka_poll(
    handler: Callable[[int], int],
    partition: int,
) -> Result[int, PythonError]: ...


def acknowledge(partition: int) -> int:
    return partition + 40


def main() -> Result[None, PythonError]:
    try:
        result: int = kafka_poll(acknowledge, 2)
        print("sifr-python-interop:callback:kafka=" + str(result))
    except PythonError as error:
        raise error
    return None
