# ============================================================
# Test 8: sifr.env
# ============================================================

from sifr.env import getenv_opt, setenv

def main():
    home: str | None = getenv_opt("HOME")
    if home is not None:
        print("HOME exists")

    missing: str | None = getenv_opt("SIFR_NONEXISTENT_12345")
    if missing is None:
        print("missing is None")

    setenv("SIFR_TEST_VAR", "hello")
    val: str | None = getenv_opt("SIFR_TEST_VAR")
    if val is not None:
        print(f"set/get: {val}")
