# ============================================================
# Test 8: read-only sifr.env
# ============================================================

from sifr.env import getenv, getenv_opt, items

def main():
    home: str | None = getenv_opt("HOME")
    if home is not None:
        print("HOME exists")

    missing: str | None = getenv_opt("SIFR_NONEXISTENT_12345")
    if missing is None:
        print("missing is None")

    assert getenv("SIFR_NONEXISTENT_12345", "fallback") == "fallback"
    pairs: list[str] = items()
    assert len(pairs) >= 0
