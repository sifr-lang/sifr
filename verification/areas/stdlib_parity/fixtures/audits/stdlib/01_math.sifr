# ============================================================
# Test 1: sifr.math -- Full Coverage
# ============================================================

from sifr.math import sqrt, floor, ceil, pi, e, log, sin, cos, tan, fabs, pow

def main():
    print(sqrt(16.0))
    print(sqrt(2.0))
    print(floor(3.7))
    print(ceil(3.2))
    print(pi > 3.14)
    print(e > 2.71)
    print(log(1.0))
    print(sin(0.0))
    print(cos(0.0))
    print(fabs(-5.0))
    print(pow(2.0, 3.0))
