# ============================================================
# Test 2: sifr.json -- Full Coverage
# ============================================================

from sifr.json import JsonValue, loads, dumps

def main():
    # Dumps various types
    print(dumps("hello"))
    print(dumps(42))
    print(dumps(True))
    print(dumps(3.14))

    # Loads
    try:
        data: JsonValue = loads("{\"key\":\"value\"}")
        print(dumps(data))
    except JSONDecodeError as error:
        print(error.message)
