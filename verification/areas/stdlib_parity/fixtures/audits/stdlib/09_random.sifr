# ============================================================
# Test 9: sifr.random
# ============================================================

from sifr.random import random, randint, choice

def main():
    r: float = random()
    print(r >= 0.0)

    try:
        n: int = randint(1, 100)
        print(n >= 1)

        items: list[str] = ["a", "b", "c"]
        picked: str = choice(items)
        print(len(picked) == 1)
    except ValueError as err:
        print(err.message)
