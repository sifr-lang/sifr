# fixture: proc_macro_trust
# scenario-example: proc_macro_trust_package
# execution-kind: cargo-probe
# expected-result: scenario-example

class DecodeError(Error):
    message: str

@rust(bridge.generated.decode, panic=trusted_no_panic)
def decode(input: bytes) -> str: ...

def verify_proc_macro_trust_package() -> Result[str, DecodeError | RustPanicError]:
    try:
        decoded: str = decode(b"sifr-rust-interop")
        assert decoded == "id=1404|payload=sifr-rust-interop|serde_derive=1.0.229;upstream=compiled;sifr_wrapper_macro=executed|prost-build=0.14.4;message=sifr.probe.Probe"
        return decoded
    except DecodeError as error:
        raise error
    except RustPanicError as error:
        raise error
