# fixture: proc_macro_trust
# package-example: prost-build
# required-crate: prost-build
# execution-kind: cargo-probe
# expected-result: package-example
class PackageExampleError(Error):
    message: str

@rust(bridge.generated.decode, panic=trusted_no_panic)
def decode_generated_schema(input: bytes) -> str: ...

def verify_prost_build_package() -> Result[str, PackageExampleError | RustPanicError]:
    try:
        marker: str = decode_generated_schema(b"sifr-rust-interop")
        assert "prost-build=0.14.4;message=sifr.probe.Probe" in marker
        return marker
    except PackageExampleError as error:
        raise error
    except RustPanicError as error:
        raise error
