# fixture: proc_macro_trust
# package-example: serde_derive
# required-crate: serde_derive
# execution-kind: cargo-probe
# expected-result: package-example
class PackageExampleError(Error):
    message: str

@rust(bridge.generated.decode, panic=trusted_no_panic)
def decode_generated_record(input: bytes) -> str: ...

def verify_serde_derive_package() -> Result[str, PackageExampleError | RustPanicError]:
    try:
        marker: str = decode_generated_record(b"sifr-rust-interop")
        assert "serde_derive=1.0.228;upstream=compiled;sifr_wrapper_macro=executed" in marker
        return marker
    except PackageExampleError as error:
        raise error
    except RustPanicError as error:
        raise error
