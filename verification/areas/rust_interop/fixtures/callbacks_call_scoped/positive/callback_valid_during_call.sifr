# fixture: callbacks_call_scoped
# evidence: positive/callback_valid_during_call
# evidence-status: passing
# execution-kind: runtime-observed
# expected-result: pass
class EventError(Error):
    message: str

@rust(bridge.callbacks.visit)
def invoke_callback(mode: str, handler: Callable[[str], Result[None, EventError]]) -> Result[str, EventError | RustPanicError]: ...

def sample_result_callback(event: str) -> Result[None, EventError]:
    assert event != "panic"
    if event == "reject":
        raise EventError("callback rejected")
    return None

def verify_callback_valid_during_call() -> str:
    safe: str = ""
    try:
        safe_value: str = invoke_callback("safe", sample_result_callback)
        safe = safe_value
    except EventError as error:
        safe = "unexpected ordinary error: " + error.message
    except RustPanicError as error:
        safe = "unexpected panic error: " + error.message
    assert safe == "first,second"

    ordinary_error: str = ""
    try:
        unexpected_ordinary: str = invoke_callback("error", sample_result_callback)
        ordinary_error = unexpected_ordinary
    except EventError as error:
        ordinary_error = error.message
    except RustPanicError as error:
        ordinary_error = "unexpected panic error: " + error.message
    assert ordinary_error == "callback rejected"

    callback_panic: str = ""
    try:
        unexpected_panic: str = invoke_callback("panic", sample_result_callback)
        callback_panic = unexpected_panic
    except RustPanicError as error:
        callback_panic = error.message
    except EventError as error:
        callback_panic = "unexpected ordinary error: " + error.message
    assert callback_panic == "Rust bridge panicked"

    return safe + "|" + ordinary_error + "|" + callback_panic
