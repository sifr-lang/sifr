# fixture: callback_subscription_ecosystem
# evidence: negative/invalid_thread_capture_rejected
# evidence-status: passing
# execution-kind: runtime-observed
# expected-result: diagnostic
# expected-diagnostic: SIFR-RUST-CB-0001
class SubscriptionError(Error):
    message: str

class LocalState(NonSend):
    value: int

@rust.opaque(
    type=bridge.events.Subscription,
    send=False,
    sync=False,
    borrow=exclusive,
    thread_affinity=tokio_current_thread,
)
class Subscription:
    lifecycle_token: int

@rust.callback(backpressure=bounded(2), overflow=error, shutdown=drain)
@rust(bridge.events.subscribe, panic=map_error(bridge.events.map_panic))
def subscribe(own handler: Callable[[str], Result[None, SubscriptionError]]) -> Result[Subscription, SubscriptionError | RustPanicError]: ...

def verify_invalid_thread_capture_rejected(
    state: LocalState,
) -> Result[Subscription, SubscriptionError | RustPanicError]:
    def handler(event: str) -> Result[None, SubscriptionError]:
        _value: int = state.value
        return None

    result: Result[Subscription, SubscriptionError | RustPanicError] = subscribe(handler)
    return result

def verify_unprovable_callable_capture_rejected(
    own hook: Callable[[str], Result[None, SubscriptionError]],
) -> Result[Subscription, SubscriptionError | RustPanicError]:
    def handler(event: str) -> Result[None, SubscriptionError]:
        return hook(event)

    result: Result[Subscription, SubscriptionError | RustPanicError] = subscribe(handler)
    return result

