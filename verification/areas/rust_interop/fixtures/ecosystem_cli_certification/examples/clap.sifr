class PackageExampleError(Error):
    message: str

@rust(bridge.cli.parse_and_trace, panic=map_error(bridge.cli.map_panic))
def clap_command(args: list[str]) -> Result[str, PackageExampleError | RustPanicError]: ...

def verify_clap_package() -> Result[str, PackageExampleError | RustPanicError]:
    sample_result: Result[str, PackageExampleError | RustPanicError] = clap_command(["sifr", "--mode", "check"])
    return sample_result
