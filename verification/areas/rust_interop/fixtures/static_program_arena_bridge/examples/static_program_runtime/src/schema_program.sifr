class ProgramIssueArgs:
    problem: str


class ProgramIssue:
    package: str
    reason_code: str
    severity: str
    arguments: ProgramIssueArgs
    notes: list[str]


class ProgramPayload:
    absent: str | None
    active: bool
    count: int
    ratio: float
    name: str
    raw: bytes
    pair: tuple[str, int]
    labels: list[str]
    settings: dict[str, str]


class ProgramOutcome:
    status: str
    value: ProgramPayload | None
    issues: list[ProgramIssue]


@const_eval
def derive(shape: dict[str, str]) -> ProgramOutcome:
    identity: str | None = shape["canonical_identity"]
    if identity is None:
        issue: ProgramIssue = ProgramIssue(
            "fixture.static_program",
            "missing_identity",
            "fatal",
            ProgramIssueArgs("shape has no canonical identity"),
            [],
        )
        return ProgramOutcome("failed", None, [issue])
    value: ProgramPayload = ProgramPayload(
        None,
        True,
        7,
        1.5,
        identity,
        b"typed",
        ("node", 2),
        ["model", "fields"],
        {"mode": "checked"},
    )
    return ProgramOutcome("produced", value, [])
