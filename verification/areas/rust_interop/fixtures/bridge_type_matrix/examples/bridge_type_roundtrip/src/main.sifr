# fixture: bridge_type_matrix
# scenario-example: bridge_type_roundtrip
# execution-kind: cargo-probe
# expected-result: scenario-example

class DiagnosticError(Error):
    message: str

@rust(bridge.types.serde_json_roundtrip, panic=trusted_no_panic)
def serde_json_roundtrip(input: str) -> Result[str, DiagnosticError]: ...

@rust(bridge.types.bytes_roundtrip, panic=trusted_no_panic)
def bytes_roundtrip(input: bytes) -> bytes: ...

@rust(bridge.types.indexmap_roundtrip, panic=trusted_no_panic)
def indexmap_roundtrip(input: dict[str, list[str]]) -> dict[str, list[str]]: ...

@rust(bridge.types.nested_indexmap_roundtrip, panic=trusted_no_panic)
def nested_indexmap_roundtrip(input: dict[str, dict[str, str]]) -> dict[str, dict[str, str]]: ...

@rust(bridge.types.indexmap_list_roundtrip, panic=trusted_no_panic)
def indexmap_list_roundtrip(type: list[dict[str, str]]) -> list[dict[str, str]]: ...

def verify_bridge_type_roundtrip() -> str:
    json_result: str = ""
    try:
        parsed_json: str = serde_json_roundtrip('{"label":"serde","tags":["nested"]}')
        json_result = parsed_json
    except DiagnosticError as error:
        json_result = error.message
    assert json_result == '{"label":"serde","tags":["nested"]}'

    byte_result: bytes = bytes_roundtrip(b"\x00sifr\xff")
    assert byte_result == b"\x00sifr\xff"

    nested: dict[str, list[str]] = {
        "primary": ["serde", "indexmap"],
        "secondary": ["bytes"],
    }
    nested_result: dict[str, list[str]] = indexmap_roundtrip(nested)
    assert nested_result == nested

    nested_dicts: dict[str, dict[str, str]] = {
        "outer": {"primary": "serde", "secondary": "bytes"},
    }
    nested_dict_result: dict[str, dict[str, str]] = nested_indexmap_roundtrip(nested_dicts)
    assert nested_dict_result == nested_dicts

    dict_list: list[dict[str, str]] = [
        {"primary": "serde"},
        {"secondary": "bytes"},
    ]
    dict_list_result: list[dict[str, str]] = indexmap_list_roundtrip(dict_list)
    assert dict_list_result == dict_list

    error_text: str = ""
    try:
        unexpected: str = serde_json_roundtrip('{"label":1}')
        error_text = unexpected
    except DiagnosticError as error:
        error_text = error.message
    assert "invalid nested payload" in error_text
    return "serde:nested|bytes:6|invalid nested payload"

def main() -> None:
    print(verify_bridge_type_roundtrip())
