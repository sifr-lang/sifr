# fixture: shared_bridge_crate
# scenario-example: shared_hash_bridge
# execution-kind: contract-only
# expected-result: scenario-example

class SharedDigest:
    algorithm: str
    bytes: bytes

@rust(sifr_shared_hash_bridge.digest, panic=trusted_no_panic)
def digest(input: bytes) -> SharedDigest: ...

@rust(sifr_shared_hash_bridge.digest_hex, panic=trusted_no_panic)
def digest_hex(input: bytes) -> str: ...

def verify_shared_hash_bridge() -> SharedDigest:
    digest_result: SharedDigest = digest(b"sifr-rust-interop")
    hex_result: str = digest_hex(b"sifr-rust-interop")
    checked_digest: SharedDigest = SharedDigest(algorithm=hex_result, bytes=digest_result.bytes)
    return checked_digest
