# fixture: async_runtime_reqwest
# scenario-example: reqwest_loopback_runtime
# execution-kind: runtime-observed
# expected-result: loopback-reused-and-cleaned

class HttpError(Error):
    message: str

@rust(bridge.http.request_roundtrip, panic=trusted_no_panic)
async def request_roundtrip(payload: str, mode: str) -> Result[str, HttpError]:
    await task.sleep(0.0)
    return ""

@rust(bridge.http.runtime_snapshot, panic=trusted_no_panic)
def runtime_snapshot() -> str: ...

async def verify_reqwest_loopback_runtime() -> Result[str, TimeoutError]:
    first: str = ""
    second: str = ""
    try:
        first_value: str = await request_roundtrip("alpha", "fast")
        first = first_value
        second_value: str = await request_roundtrip("beta", "fast")
        second = second_value
    except HttpError as error:
        return "unexpected request error:" + error.message

    timed_out: bool = False
    try:
        async with task.timeout(0.05):
            delayed: str = await request_roundtrip("cancel", "slow")
            second = delayed
    except TimeoutError:
        timed_out = True
    except HttpError as error:
        return "unexpected delayed error:" + error.message

    await task.sleep(0.05)
    snapshot: str = runtime_snapshot()
    assert first == "echo:alpha"
    assert second == "echo:beta"
    assert timed_out
    assert snapshot == "active_requests=0;active_servers=0;completed=2;cancelled=1;runtime_calls=3;runtime_reused=true"
    return first + "|" + second + "|timeout-clean|" + snapshot

async def main() -> Result[None, TimeoutError]:
    try:
        verified: str = await verify_reqwest_loopback_runtime()
        print(verified)
    except TimeoutError:
        print("unexpected outer timeout")
    return None
