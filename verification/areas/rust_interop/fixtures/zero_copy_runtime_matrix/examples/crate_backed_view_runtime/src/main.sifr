# fixture: zero_copy_runtime_matrix
# scenario-example: crate_backed_view_runtime
# execution-kind: runtime-observed
# expected-result: zero-copy-runtime-clean

class ViewError(Error):
    message: str

@rust.opaque(type=bridge.zero_copy.CrateBackedView, send=True, sync=True, clone=none, close=close)
class CrateBackedView:
    @rust(bridge.zero_copy.observe, panic=trusted_no_panic)
    def observe(self) -> Result[str, ViewError]: ...

    @rust(bridge.zero_copy.close, panic=trusted_no_panic)
    def close(own self) -> Result[None, ViewError]: ...

@rust.zero_copy(owner=data, view=bridge.zero_copy.CrateBackedView)
@rust.view(owner=data, lifetime=owner, mutability=immutable, send=True, sync=True)
@rust(bridge.zero_copy.create, panic=trusted_no_panic)
def crate_backed_view_lifecycle(own data: bytes) -> Result[CrateBackedView, ViewError]:
    raise ViewError("declaration only")

@rust(bridge.zero_copy.release_observation, panic=trusted_no_panic)
def release_observation() -> Result[str, ViewError]: ...

def verify_crate_backed_view_runtime() -> Result[str, ViewError]:
    try:
        view: CrateBackedView = crate_backed_view_lifecycle(b"sifr-zero-copy")
        summary: str = view.observe()
        _closed: None = view.close()
        released: str = release_observation()
        verified: str = summary + ";release=" + released
        assert verified == "bytes=alias+owner;memmap2=alias+readonly;bytemuck=alias+mutated-value;zerocopy=alias+parsed-value;mutation=exclusive+sealed;send-sync=type-probed;release=released=1;active=0"
        return verified
    except ViewError as error:
        raise error

def main() -> Result[None, ViewError]:
    try:
        print(verify_crate_backed_view_runtime())
    except ViewError as error:
        raise error
    return None
