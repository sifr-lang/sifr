# ============================================================
# Test 8: Move Type Passed to Function (consumed via own)
# Python: passing a list to a function doesn't affect caller
# Rust: passing a Vec to a function moves it; caller can't use it
# Sifr should: borrow by default; use `own` to explicitly move
# ============================================================

def consume(own items: list[int]) -> int:
    return len(items)

def main():
    nums: list[int] = [1, 2, 3]
    result: int = consume(nums)
    print(result)
