# ============================================================
# Test 12: While Loops
# Python: while, break, continue, while/else
# ============================================================

def main():
    # Basic while
    i: int = 0
    while i < 5:
        print(i)
        i += 1

    # While with break
    j: int = 0
    while True:
        if j >= 3:
            break
        print(f"loop: {j}")
        j += 1

    # While with continue
    k: int = 0
    while k < 5:
        k += 1
        if k == 3:
            continue
        print(f"skip3: {k}")

    # Countdown
    count: int = 5
    while count > 0:
        print(count)
        count -= 1
    print("done!")
