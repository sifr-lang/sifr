# ============================================================
# Test 6: String Slicing and Indexing
# Python: s[0], s[-1], s[1:3], s[:3], s[3:], s[::-1]
# ============================================================

def main():
    s: str = "hello world"

    # Single char indexing (safe -- returns str | None)
    ch: str | None = s[0]
    if ch is not None:
        print(ch)

    # Negative indexing
    last: str | None = s[-1]
    if last is not None:
        print(last)

    # Slicing
    print(s[0:5])
    print(s[6:11])
    print(s[:5])
    print(s[6:])

    # Step slicing
    print(s[::2])

    # Reverse
    print(s[::-1])

    # String length
    print(len(s))
