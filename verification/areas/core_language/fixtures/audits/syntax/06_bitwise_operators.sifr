# ============================================================
# Test 6: Bitwise Operators
# Python: &, |, ^, ~, <<, >>
# ============================================================

def main():
    # AND
    print(0b1100 & 0b1010)  # 0b1000 = 8

    # OR
    print(0b1100 | 0b1010)  # 0b1110 = 14

    # XOR
    print(0b1100 ^ 0b1010)  # 0b0110 = 6

    # NOT (bitwise complement)
    print(~0)    # -1
    print(~1)    # -2

    # Left shift
    print(1 << 4)   # 16
    print(3 << 2)   # 12

    # Right shift
    print(16 >> 2)   # 4
    print(255 >> 4)  # 15

    # Combined
    flags: int = 0b0000
    flags = flags | 0b0001  # set bit 0
    flags = flags | 0b0100  # set bit 2
    print(flags)            # 5 = 0b0101
    print(flags & 0b0001)   # 1 (bit 0 is set)
    print(flags & 0b0010)   # 0 (bit 1 is not set)
