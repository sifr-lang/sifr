{
  "schema_version": 1,
  "rules": "editor_tooling",
  "rules_version": "vscode-extension-current",
  "validation_stage": "extension-active",
  "repository": {
    "owner": "sifr-lang",
    "name": "sifr-vscode",
    "full_name": "sifr-lang/sifr-vscode",
    "location_env": "SIFR_VSCODE_REPO",
    "submodule_checkout": "editor_integrations/vscode",
    "sibling_checkout": "../sifr-vscode",
    "boundary": "separate-repository"
  },
  "extension": {
    "publisher": "sifr",
    "name": "sifr-vscode",
    "extension_id": "sifr.sifr-vscode",
    "display_name": "Sifr",
    "language_id": "sifr",
    "extensions": [".sifr"],
    "minimum_vscode_engine": "^1.90.0",
    "categories": ["Programming Languages"],
    "keywords": ["sifr", "language", "lsp", "compiler"]
  },
  "launch": {
    "default_command": "sifr",
    "default_args": ["lsp", "--stdio"],
    "required_transport": "stdio",
    "path_setting": "sifr.lsp.path"
  },
  "settings": [
    {"key": "sifr.lsp.path", "type": "string", "required": true},
    {"key": "sifr.lsp.trace.server", "type": "enum", "values": ["off", "messages", "verbose"], "required": true},
    {"key": "sifr.diagnostics.mode", "type": "enum", "values": ["off", "open-files", "workspace"], "required": true},
    {"key": "sifr.format.enable", "type": "boolean", "required": true},
    {"key": "sifr.lint.enable", "type": "boolean", "required": true}
  ],
  "commands": [
    {"command": "sifr.restartLanguageServer", "title": "Sifr: Restart Language Server", "backend": "lsp"},
    {"command": "sifr.showLanguageServerLogs", "title": "Sifr: Show Language Server Logs", "backend": "lsp"},
    {"command": "sifr.locateBinary", "title": "Sifr: Locate Sifr Binary", "backend": "extension-ui"},
    {"command": "sifr.runCheck", "title": "Sifr: Run Check", "backend": "cli:sifr check"},
    {"command": "sifr.runTests", "title": "Sifr: Run Tests", "backend": "cli:sifr test"},
    {"command": "sifr.runLint", "title": "Sifr: Run Lint", "backend": "cli:sifr lint"},
    {"command": "sifr.checkFormat", "title": "Sifr: Check Format", "backend": "cli:sifr fmt --check"},
    {"command": "sifr.formatDocument", "title": "Sifr: Format Document", "backend": "lsp-or-cli:sifr fmt"},
    {"command": "sifr.showGeneratedRust", "title": "Sifr: Show Generated Rust", "backend": "lsp:sifr.server.showGeneratedRust"},
    {"command": "sifr.explainDiagnostic", "title": "Sifr: Explain Diagnostic", "backend": "lsp:sifr.server.explainDiagnostic"}
  ],
  "package_scripts": ["lint", "typecheck", "test", "test:extension", "package"],
  "forbidden_extension_behavior": [
    "parser",
    "typeChecker",
    "ownershipAnalysis",
    "diagnosticDerivation",
    "symbolAnalysis",
    "formatter",
    "linter",
    "codegen",
    "pythonLanguageServerFallback",
    "pyrightFallback",
    "ruffServerFallback",
    "tyServerFallback"
  ],
  "required_validation": {
    "rules_check": "python3 verification/areas/developer_tooling/check_vscode_extension_rules.py",
    "package_check": "python3 verification/areas/developer_tooling/check_vscode_extension.py",
    "activation_requirement": "36.7"
  }
}
