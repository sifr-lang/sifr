{
  "schema_version": 1,
  "owner": "developer-tooling",
  "rules": [
    {
      "id": "check-valid-program-success",
      "command": "sifr check <valid-file.sifr>",
      "expected_exit_code": 0,
      "integration_test": "crates/sifr/tests/validation_suites.rs",
      "profile_surface": "cli_exit_codes"
    },
    {
      "id": "check-invalid-program-diagnostic-failure",
      "command": "sifr check <invalid-file.sifr>",
      "expected_exit_code": 1,
      "integration_test": "crates/sifr/tests/validation_suites.rs",
      "profile_surface": "cli_exit_codes"
    },
    {
      "id": "run-valid-program-success",
      "command": "sifr run <valid-file.sifr>",
      "expected_exit_code": 0,
      "integration_test": "crates/sifr/tests/e2e.rs",
      "profile_surface": "cli_exit_codes"
    },
    {
      "id": "build-valid-program-success",
      "command": "sifr build <valid-file.sifr>",
      "expected_exit_code": 0,
      "integration_test": "crates/sifr/tests/build_output_behavior.rs",
      "profile_surface": "cli_exit_codes"
    },
    {
      "id": "emit-valid-program-success",
      "command": "sifr emit <valid-file.sifr>",
      "expected_exit_code": 0,
      "integration_test": "crates/sifr/tests/validation_suites.rs",
      "profile_surface": "cli_exit_codes"
    }
  ]
}
