{
  "schema_version": 1,
  "contract": "editor_tooling",
  "contract_version": "lsp-protocol-current",
  "protocol": {
    "name": "Language Server Protocol",
    "target_version": "3.17",
    "transport": "stdio",
    "launch": ["sifr", "lsp", "--stdio"]
  },
  "crate_names": {
    "analysis": "sifr_analysis",
    "formatter": "sifr_format",
    "lint": "sifr_lint",
    "lsp": "sifr_lsp"
  },
  "diagnostics_modes": ["off", "open-files", "workspace"],
  "semantic_token_legend": [
    "keyword",
    "type",
    "function",
    "method",
    "variable",
    "parameter",
    "property",
    "module",
    "comment",
    "string",
    "number",
    "operator",
    "decorator",
    "mutableBinding",
    "ownershipSensitive"
  ],
  "code_action_kinds": [
    "quickfix",
    "refactor.rename",
    "source.organizeImports",
    "source.fixAll.sifr",
    "source.sifr.suppressPolicyRule"
  ],
  "settings": [
    {"key": "sifr.diagnostics.mode", "type": "enum", "values": ["off", "open-files", "workspace"]},
    {"key": "sifr.lsp.trace.server", "type": "enum", "values": ["off", "messages", "verbose"]},
    {"key": "sifr.format.enable", "type": "boolean"},
    {"key": "sifr.lint.enable", "type": "boolean"}
  ],
  "required_methods": [
    {"method": "initialize", "owner": "sifr_lsp::initialize", "analysis_owner": null, "positive": "initialize capabilities snapshot includes formatting only when sifr.format.enable is true", "negative": "disabled formatter initialization omits document formatting capabilities", "budget_id": "lsp-cold-start"},
    {"method": "initialized", "owner": "sifr_lsp::notifications::initialized", "analysis_owner": null, "positive": "initialized registers dynamic diagnostics/watchers when supported", "negative": "duplicate initialized is ignored/logged", "budget_id": null},
    {"method": "shutdown", "owner": "sifr_lsp::shutdown", "analysis_owner": null, "positive": "shutdown returns null once", "negative": "requests after shutdown fail deterministically", "budget_id": null},
    {"method": "exit", "owner": "sifr_lsp::notifications::exit", "analysis_owner": null, "positive": "exit after shutdown returns code 0", "negative": "exit before shutdown returns protocol failure code", "budget_id": null},
    {"method": "workspace/didChangeConfiguration", "owner": "sifr_lsp::notifications::workspace_did_change_configuration", "analysis_owner": "sifr_analysis settings refresh", "positive": "diagnostics, trace, lint, and formatter settings update", "negative": "disabled formatter setting rejects formatting requests", "budget_id": null},
    {"method": "workspace/didChangeWatchedFiles", "owner": "sifr_lsp::notifications::workspace_did_change_watched_files", "analysis_owner": "AnalysisHost project invalidation", "positive": "changed workspace file invalidates snapshots", "negative": "excluded implicit file does not alter explicit target semantics", "budget_id": null},
    {"method": "workspace/symbol", "owner": "sifr_lsp::requests::workspace_symbol", "analysis_owner": "AnalysisHost::workspace_symbols", "positive": "workspace symbols are deterministic", "negative": "empty query obeys configured limits", "budget_id": "lsp-workspace-symbols"},
    {"method": "workspace/executeCommand", "owner": "sifr_lsp::requests::execute_command", "analysis_owner": "CommandRegistry", "positive": "required Sifr commands execute", "negative": "unknown command returns protocol error", "budget_id": null},
    {"method": "textDocument/didOpen", "owner": "sifr_lsp::notifications::text_document_did_open", "analysis_owner": "AnalysisHost::update_document", "positive": "open buffer overrides disk source", "negative": "non-sifr language id is rejected or ignored deterministically", "budget_id": "lsp-did-open-diagnostics"},
    {"method": "textDocument/didChange", "owner": "sifr_lsp::notifications::text_document_did_change", "analysis_owner": "AnalysisHost::update_document", "positive": "full and incremental edits update line index", "negative": "stale version and invalid ranges fail deterministically", "budget_id": "lsp-did-change-diagnostics"},
    {"method": "textDocument/didSave", "owner": "sifr_lsp::notifications::text_document_did_save", "analysis_owner": "AnalysisHost save refresh", "positive": "save refreshes diagnostics without losing overrides", "negative": "save for unopened document is logged and ignored", "budget_id": null},
    {"method": "textDocument/didClose", "owner": "sifr_lsp::notifications::text_document_did_close", "analysis_owner": "AnalysisHost close refresh", "positive": "close clears open-buffer override", "negative": "close for unopened document is logged and ignored", "budget_id": null},
    {"method": "textDocument/publishDiagnostics", "owner": "DiagnosticsController", "analysis_owner": "AnalysisHost::diagnostics", "positive": "push diagnostics preserve codes and versions", "negative": "stale diagnostics are suppressed", "budget_id": "lsp-did-open-diagnostics"},
    {"method": "textDocument/diagnostic", "owner": "sifr_lsp::requests::text_document_diagnostic", "analysis_owner": "AnalysisHost::diagnostics", "positive": "pull diagnostics match push diagnostics", "negative": "result id stale response clears deterministically", "budget_id": "lsp-did-change-diagnostics"},
    {"method": "workspace/diagnostic", "owner": "sifr_lsp::requests::workspace_diagnostic", "analysis_owner": "AnalysisHost::workspace_diagnostics", "positive": "workspace diagnostics match frontend project diagnostics", "negative": "workspace mode off disables publication only", "budget_id": "lsp-workspace-diagnostics"},
    {"method": "textDocument/completion", "owner": "sifr_lsp::requests::completion", "analysis_owner": "AnalysisHost::completion", "positive": "locals/functions/types/modules/imports/std/current-workspace candidates", "negative": "invalid position returns protocol error", "budget_id": "lsp-completion"},
    {"method": "completionItem/resolve", "owner": "sifr_lsp::requests::completion_item_resolve", "analysis_owner": "AnalysisHost completion resolve data", "positive": "documentation/details resolve without candidate drift", "negative": "unknown item data returns original item", "budget_id": "lsp-completion"},
    {"method": "textDocument/hover", "owner": "sifr_lsp::requests::hover", "analysis_owner": "AnalysisHost::hover", "positive": "type/symbol/mutability/ownership/docs shown", "negative": "empty span returns null", "budget_id": "lsp-hover"},
    {"method": "textDocument/signatureHelp", "owner": "sifr_lsp::requests::signature_help", "analysis_owner": "AnalysisHost::signature_help", "positive": "active parameter selected", "negative": "outside call returns null", "budget_id": "lsp-signature-help"},
    {"method": "textDocument/definition", "owner": "sifr_lsp::requests::definition", "analysis_owner": "AnalysisHost::definition", "positive": "local/imported/std targets resolve", "negative": "ambiguous missing target returns empty result", "budget_id": "lsp-definition"},
    {"method": "textDocument/declaration", "owner": "sifr_lsp::requests::declaration", "analysis_owner": "AnalysisHost::declaration", "positive": "declaration targets resolve where distinct", "negative": "unsupported distinction returns precise empty result", "budget_id": "lsp-definition"},
    {"method": "textDocument/typeDefinition", "owner": "sifr_lsp::requests::type_definition", "analysis_owner": "AnalysisHost::type_definition", "positive": "type-definition targets resolve", "negative": "value without type definition returns empty result", "budget_id": "lsp-definition"},
    {"method": "textDocument/references", "owner": "sifr_lsp::requests::references", "analysis_owner": "AnalysisHost::references", "positive": "workspace references are stable", "negative": "ambiguous target returns deterministic error or empty result", "budget_id": "lsp-references"},
    {"method": "textDocument/prepareRename", "owner": "sifr_lsp::requests::prepare_rename", "analysis_owner": "AnalysisHost::prepare_rename", "positive": "safe rename target returns range", "negative": "unsafe or ambiguous target is rejected", "budget_id": "lsp-rename"},
    {"method": "textDocument/rename", "owner": "sifr_lsp::requests::rename", "analysis_owner": "AnalysisHost::rename", "positive": "workspace edit covers all safe references", "negative": "invalid new name and stale version rejected", "budget_id": "lsp-rename"},
    {"method": "textDocument/documentSymbol", "owner": "sifr_lsp::requests::document_symbol", "analysis_owner": "AnalysisHost::document_symbols", "positive": "hierarchical symbols are deterministic", "negative": "syntax-recovered file returns partial safe symbols", "budget_id": "lsp-document-symbols"},
    {"method": "textDocument/semanticTokens/full", "owner": "sifr_lsp::requests::semantic_tokens_full", "analysis_owner": "AnalysisHost::semantic_tokens", "positive": "legend categories emitted in stable order", "negative": "stale token result is suppressed", "budget_id": "lsp-semantic-tokens"},
    {"method": "textDocument/semanticTokens/range", "owner": "sifr_lsp::requests::semantic_tokens_range", "analysis_owner": "AnalysisHost::semantic_tokens", "positive": "range tokens match full-token subset", "negative": "invalid range rejected", "budget_id": "lsp-semantic-tokens"},
    {"method": "textDocument/inlayHint", "owner": "sifr_lsp::requests::inlay_hint", "analysis_owner": "AnalysisHost::inlay_hints", "positive": "types/parameter names/generic hints emitted", "negative": "imprecise ownership hint omitted", "budget_id": "lsp-inlay-hints"},
    {"method": "textDocument/documentHighlight", "owner": "sifr_lsp::requests::document_highlight", "analysis_owner": "AnalysisHost::document_highlights", "positive": "read/write highlights classify stable ranges", "negative": "invalid target returns empty result", "budget_id": "lsp-document-highlights"},
    {"method": "textDocument/foldingRange", "owner": "sifr_lsp::requests::folding_range", "analysis_owner": "AnalysisHost::folding_ranges", "positive": "syntax-aware ranges are deterministic", "negative": "malformed recovered syntax avoids panics", "budget_id": "lsp-folding-ranges"},
    {"method": "textDocument/selectionRange", "owner": "sifr_lsp::requests::selection_range", "analysis_owner": "AnalysisHost::selection_ranges", "positive": "outer-to-inner syntax ancestry returned", "negative": "invalid position rejected", "budget_id": "lsp-selection-range"},
    {"method": "textDocument/prepareTypeHierarchy", "owner": "sifr_lsp::requests::prepare_type_hierarchy", "analysis_owner": "AnalysisHost::prepare_type_hierarchy", "positive": "meaningful Sifr hierarchy item returned", "negative": "symbol without hierarchy returns null", "budget_id": "lsp-type-hierarchy"},
    {"method": "typeHierarchy/supertypes", "owner": "sifr_lsp::requests::type_hierarchy_supertypes", "analysis_owner": "AnalysisHost::type_hierarchy_supertypes", "positive": "Sifr supertypes returned where meaningful", "negative": "unknown hierarchy id rejected", "budget_id": "lsp-type-hierarchy"},
    {"method": "typeHierarchy/subtypes", "owner": "sifr_lsp::requests::type_hierarchy_subtypes", "analysis_owner": "AnalysisHost::type_hierarchy_subtypes", "positive": "Sifr subtypes returned where meaningful", "negative": "unknown hierarchy id rejected", "budget_id": "lsp-type-hierarchy"},
    {"method": "textDocument/codeAction", "owner": "sifr_lsp::requests::code_action", "analysis_owner": "AnalysisHost::code_actions", "positive": "policy suppressions, safe fixes, and deferred fix-all actions are emitted from typed policy diagnostics", "negative": "hard diagnostics never offer suppression or lint fixes", "budget_id": "lsp-code-actions"},
    {"method": "codeAction/resolve", "owner": "sifr_lsp::requests::code_action_resolve", "analysis_owner": "AnalysisHost code-action resolve data", "positive": "deferred safe policy fix-all edits resolve deterministically", "negative": "unknown or stale action data is rejected", "budget_id": "lsp-code-actions"},
    {"method": "textDocument/formatting", "owner": "sifr_lsp::requests::formatting", "analysis_owner": "AnalysisHost::format_document", "positive": "edits match sifr fmt using discovered formatter config and LSP options", "negative": "disabled formatter setting rejects document formatting", "budget_id": "lsp-formatting"},
    {"method": "textDocument/rangeFormatting", "owner": "sifr_lsp::requests::range_formatting", "analysis_owner": "AnalysisHost::format_range", "positive": "range edits match formatter contract using discovered formatter config and LSP options", "negative": "invalid range and disabled formatter setting are rejected", "budget_id": "lsp-formatting"}
  ],
  "required_commands": [
    {"command": "sifr.restartServer", "owner": "CommandRegistry", "positive": "server restart request is logged", "negative": "restart during shutdown is rejected"},
    {"command": "sifr.showServerLogs", "owner": "CommandRegistry", "positive": "server log location or content returned", "negative": "missing log file reports actionable error"},
    {"command": "sifr.explainDiagnostic", "owner": "AnalysisHost::explain_diagnostic", "positive": "diagnostic explanation preserves canonical schema", "negative": "unknown diagnostic id rejected"},
    {"command": "sifr.showGeneratedRust", "owner": "AnalysisHost::generated_rust_preview", "positive": "preview uses compiler codegen/source maps", "negative": "content-modified cancellation rejects partial output"},
    {"command": "sifr.checkWorkspace", "owner": "sifr CLI check", "positive": "workspace check command metadata invokes Sifr", "negative": "workspace load failure reports diagnostics"},
    {"command": "sifr.runTests", "owner": "sifr CLI test metadata", "positive": "test command metadata invokes Sifr test runner", "negative": "project without tests returns empty tree"}
  ],
  "unsupported_surfaces": [
    {"surface": "notebookDocumentSync", "policy": "do not advertise; reject notebook URIs deterministically"},
    {"surface": "textDocument/implementation", "policy": "defer unless Sifr type model exposes implementation relationships"},
    {"surface": "textDocument/linkedEditingRange", "policy": "defer until a paired-edit Sifr surface exists"},
    {"surface": "textDocument/prepareCallHierarchy", "policy": "defer; references and workspace symbols cover editor tooling"},
    {"surface": "textDocument/documentLink", "policy": "defer until package/module UX stabilizes"},
    {"surface": "textDocument/willSave", "policy": "do not advertise in editor tooling"},
    {"surface": "textDocument/willSaveWaitUntil", "policy": "do not advertise in editor tooling"},
    {"surface": "python.importResolution", "policy": "forbidden; Sifr workspace resolution only"},
    {"surface": "python.environmentDiscovery", "policy": "forbidden"}
  ]
}
