{
  "schema_version": 2,
  "name": "package_management",
  "owner": "compiler/package-management",
  "description": "Package graph, package fixtures, demo repository corpora, and Cargo-aligned package guardrails.",
  "parallel_safe": false,
  "resource_classes": [
    "default-local",
    "external-corpus"
  ],
  "timeout_seconds": 900,
  "suites": [
    {
      "name": "guardrails",
      "kind": "adapter",
      "cases": [
        {
          "id": "package-manager-guardrails",
          "entry": "verification/areas/package_management/tools/check_package_manager_guardrails.py",
          "command": "package-manager-guardrails",
          "expect_exit_code": 0,
          "diagnostic_formats": []
        }
      ]
    },
    {
      "name": "offline-merge-smoke",
      "kind": "adapter",
      "cases": [
        {
          "id": "offline-registry-lock-graph",
          "entry": "verification/areas/package_management/tools/check_offline_package_merge_smoke.py",
          "command": "offline-package-merge-smoke",
          "expect_exit_code": 0,
          "diagnostic_formats": []
        },
        {
          "id": "offline-registry-lock-graph-self-test",
          "entry": "verification/areas/package_management/tools/check_offline_package_merge_smoke.py",
          "command": "offline-package-merge-smoke-self-test",
          "expect_exit_code": 0,
          "diagnostic_formats": []
        }
      ]
    },
    {
      "name": "offline-integration",
      "kind": "adapter",
      "cases": [
        {
          "id": "demo-corpus-lockfile-determinism",
          "entry": "verification/areas/package_management/tools/check_offline_package_merge_smoke.py",
          "command": "offline-package-demo-corpus-smoke",
          "expect_exit_code": 0,
          "diagnostic_formats": []
        }
      ]
    }
  ],
  "network_mode": "offline",
  "pinned_corpus": {
    "required": false,
    "revision": "not-applicable",
    "checksum": "not-applicable"
  },
  "skip_policy": {
    "allowed": false,
    "requires_reason": true
  },
  "baseline_metadata_rules": {
    "required": false,
    "source": "not-applicable"
  }
}
