{
  "schema_version": 2,
  "name": "release",
  "description": "Highest-confidence local publication qualification with full breadth except where an expiry-bound release policy applies.",
  "budgets": {
    "warm_wall_time_minutes": 45,
    "cold_wall_time_minutes": 60
  },
  "step_budgets": {
    "cargo_cache_setup": {
      "budget_ms": 300000,
      "enforcement": "advisory"
    }
  },
  "resource_policy": {
    "classes": [
      "default-local",
      "external-corpus",
      "long-running"
    ],
    "max_parallel": 6,
    "thermal_policy": "explicit-opt-in-release",
    "memory_policy": "explicit-opt-in-release"
  },
  "network_policy": {
    "mode": "offline",
    "live_network_allowed": false
  },
  "cargo_policy": {
    "locked": true,
    "offline": true,
    "setup_command": "cargo fetch --locked"
  },
  "reference_host": {
    "os": "darwin-or-linux",
    "arch": "aarch64-or-x86_64",
    "notes": "Release qualification archives local evidence and may add broader host-specific artifacts through explicit suite metadata."
  },
  "execution_sandbox": {
    "tempdir_only": true,
    "external_network": "forbidden",
    "loopback_network": "declared-only",
    "subprocess_cleanup": true,
    "stdout_stderr_byte_limit": 10485760
  },
