    "hir-maintainability",
    "file-size",
    "source-crate-dependency-direction",
    "driver-maintainability",
    "package-manager"
  ],
  "retry_policy": {
    "max_attempts": 1,
    "retry_flaky_only": false
  },
  "shard_policy": {
    "strategy": "deterministic",
    "shards": 1
  },
  "resume_policy": {
    "enabled": true,
    "failure_reproduction": "profile-and-case"
  },
  "report": {
    "format": "json-v1",
    "output_dir": "target/validation_lane_reports"
  },
  "legacy_facade": {
    "matrix_suites": [
      "frontend_mode_parity",
      "project_graph_isolation",
      "integer_dtype_rules",
      "hir_analysis_behaviors",
      "cfg_flow_behaviors",
      "syntax_parser_lexer_matrix"
