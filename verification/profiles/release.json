    ],
    "distribution": "full",
    "generated_code_quality": "full",
    "performance_budget": "full",
    "crate_tests": "full",
    "e2e": {
      "fixture_manifest": "",
      "sifr_jobs": 6,
      "rust_jobs": 4,
      "run_jobs": 4,
      "cargo_build_jobs": 1,
      "max_group_fixtures": 16,
      "disable_cache": false
    },
    "hardening_suites": [
      "diagnostics",
      "project",
      "fixedbugs",
      "crashes",
      "property",
      "fuzz-smoke",
      "oss-curated",
      "ecosystem-broader",
