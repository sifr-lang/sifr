{
  "schema_version": 2,
  "name": "nightly",
  "description": "Broad nightly breadth with the full pass corpus and the full hardening manifest.",
  "budgets": {
    "warm_wall_time_minutes": 30,
    "cold_wall_time_minutes": 45
  },
  "resource_policy": {
    "classes": [
      "default-local",
      "external-corpus",
      "long-running"
    ],
    "max_parallel": 6
  },
  "network_policy": {
    "mode": "offline",
    "live_network_allowed": false
  },
  "cargo_policy": {
    "locked": true,
    "offline": true,
    "setup_command": "cargo fetch --locked"
  },
  "reference_host": {
    "os": "darwin-or-linux",
    "arch": "aarch64-or-x86_64",
    "notes": "Nightly may add broader evidence, but local execution remains reproducible unless a suite is explicitly live-network classified."
  },
  "execution_sandbox": {
    "tempdir_only": true,
    "external_network": "forbidden",
    "loopback_network": "declared-only",
    "subprocess_cleanup": true,
    "stdout_stderr_byte_limit": 10485760
  },
  "profile_plan": {
    "emit_command": "scripts/run_all_tests.sh --profile nightly --emit-plan",
    "compare_command": "uv run --project verification --locked python -m sifr_verify profiles compare-plans --local <local-plan.json> --ci <ci-plan.json>"
  },
  "selected_areas": [
    {
      "area": "core_language",
      "suites": [
        "integer_dtype_contract",
        "phase24_hir_analysis",
        "phase25_cfg_flow"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "diagnostics",
      "suites": [
        "contracts",
        "baselines"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "runtime_platform",
      "suites": [
        "platform-golden"
      ],
      "resource_classes": [
        "platform-specific"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "full"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "generated_code_quality",
      "suites": [
        "full"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "performance",
      "suites": [
        "full"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "distribution_release",
      "suites": [
        "full"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "project_workspace",
      "suites": [
        "frontend_mode_parity",
        "phase23_graph_isolation",
        "baselines"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "regression",
      "suites": [
        "fixedbugs"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "regression",
      "suites": [
        "crashes"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "fuzz_property",
      "suites": [
        "property"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "fuzz_property",
      "suites": [
        "fuzz-smoke"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "ecosystem_compatibility",
      "suites": [
        "oss-curated"
      ],
      "resource_classes": [
        "external-corpus"
      ]
    },
    {
      "area": "ecosystem_compatibility",
      "suites": [
        "ecosystem-broader"
      ],
      "resource_classes": [
        "external-corpus"
      ]
    }
  ],
  "toolchain_steps": [
    "cargo-test-sifr-full"
  ],
  "guardrail_steps": [
    "hir-maintainability",
    "file-size",
    "source-crate-dependency-direction",
    "driver-maintainability",
    "package-manager"
  ],
  "retry_policy": {
    "max_attempts": 1,
    "retry_flaky_only": false
  },
  "shard_policy": {
    "strategy": "deterministic",
    "shards": 1
  },
  "resume_policy": {
    "enabled": true,
    "failure_reproduction": "profile-and-case"
  },
  "report": {
    "format": "json-v1",
    "output_dir": "target/validation_lane_reports"
  },
  "legacy_facade": {
    "matrix_suites": [
      "frontend_mode_parity",
      "phase23_graph_isolation",
      "integer_dtype_contract",
      "phase24_hir_analysis",
      "phase25_cfg_flow"
    ],
    "tooling_suites": [
      "full"
    ],
    "distribution": "full",
    "generated_code_quality": "full",
    "performance_budget": "full",
    "crate_tests": "full",
    "e2e": {
      "fixture_manifest": "",
      "sifr_jobs": 6,
      "rust_jobs": 4,
      "run_jobs": 4,
      "cargo_build_jobs": 1,
      "max_group_fixtures": 16,
      "disable_cache": false
    },
    "hardening_suites": [
      "diagnostics",
      "project",
      "fixedbugs",
      "crashes",
      "property",
      "fuzz-smoke",
      "oss-curated",
      "ecosystem-broader",
      "determinism-scale"
    ],
    "extra_checks": [],
    "thermal_policy": "opt-in-broad",
    "memory_policy": "opt-in-broad"
  }
}
