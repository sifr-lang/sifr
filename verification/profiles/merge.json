{
  "schema_version": 2,
  "name": "merge",
  "description": "Authoritative merge gate with full contract matrices, representative e2e, and selected hardening.",
  "budgets": {
    "warm_wall_time_minutes": 15,
    "cold_wall_time_minutes": 25
  },
  "resource_policy": {
    "classes": [
      "default-local"
    ],
    "max_parallel": 4
  },
  "network_policy": {
    "mode": "offline",
    "live_network_allowed": false
  },
  "cargo_policy": {
    "locked": true,
    "offline": true,
    "setup_command": "cargo fetch --locked"
  },
  "reference_host": {
    "os": "darwin-or-linux",
    "arch": "aarch64-or-x86_64",
    "notes": "Merge budget decisions use this local reference envelope until a stricter host inventory lands."
  },
  "execution_sandbox": {
    "tempdir_only": true,
    "external_network": "forbidden",
    "loopback_network": "declared-only",
    "subprocess_cleanup": true,
    "stdout_stderr_byte_limit": 10485760
  },
  "profile_plan": {
    "emit_command": "scripts/run_all_tests.sh --profile merge --emit-plan",
    "compare_command": "uv run --project verification --locked python -m sifr_verify profiles compare-plans --local <local-plan.json> --ci <ci-plan.json>"
  },
  "selected_areas": [
    {
      "area": "coverage_matrix",
      "suites": [
        "advisory"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "core_language",
      "suites": [
        "integer_dtype_contract",
        "phase24_hir_analysis",
        "phase25_cfg_flow"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "diagnostics",
      "suites": [
        "contracts",
        "baselines"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "runtime_platform",
      "suites": [
        "platform-golden"
      ],
      "resource_classes": [
        "platform-specific"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "static"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "formatter"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "analysis"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "lsp-smoke"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "generated_code_quality",
      "suites": [
        "representative"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "performance",
      "suites": [
        "representative"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "distribution_release",
      "suites": [
        "representative"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "project_workspace",
      "suites": [
        "frontend_mode_parity",
        "phase23_graph_isolation",
        "baselines"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "regression",
      "suites": [
        "fixedbugs"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "regression",
      "suites": [
        "crashes"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "ecosystem_compatibility",
      "suites": [
        "oss-curated"
      ],
      "resource_classes": [
        "external-corpus"
      ]
    }
  ],
  "toolchain_steps": [
    "cargo-test-sifr-full"
  ],
  "guardrail_steps": [
    "hir-maintainability",
    "file-size",
    "source-crate-dependency-direction",
    "driver-maintainability",
    "package-manager"
  ],
  "retry_policy": {
    "max_attempts": 1,
    "retry_flaky_only": false
  },
  "shard_policy": {
    "strategy": "deterministic",
    "shards": 1
  },
  "resume_policy": {
    "enabled": true,
    "failure_reproduction": "profile-and-case"
  },
  "report": {
    "format": "json-v1",
    "output_dir": "target/validation_lane_reports"
  },
  "legacy_facade": {
    "matrix_suites": [
      "frontend_mode_parity",
      "phase23_graph_isolation",
      "integer_dtype_contract",
      "phase24_hir_analysis",
      "phase25_cfg_flow"
    ],
    "tooling_suites": [
      "static",
      "formatter",
      "analysis",
      "lsp-smoke"
    ],
    "distribution": "representative",
    "generated_code_quality": "representative",
    "performance_budget": "representative",
    "crate_tests": "full",
    "e2e": {
      "fixture_manifest": "verification/areas/core_language/data/merge_e2e_manifest.json",
      "sifr_jobs": 4,
      "rust_jobs": 3,
      "run_jobs": 3,
      "cargo_build_jobs": 1,
      "max_group_fixtures": 12,
      "disable_cache": false
    },
    "hardening_suites": [
      "diagnostics",
      "project",
      "fixedbugs",
      "crashes",
      "oss-curated"
    ],
    "extra_checks": [],
    "thermal_policy": "balanced-merge-gate",
    "memory_policy": "bounded-merge-gate"
  }
}
