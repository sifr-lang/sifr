  "toolchain_steps": [
    "cargo-test-sifr-full"
  ],
  "guardrail_steps": [
    "hir-maintainability",
    "file-size",
    "source-crate-dependency-direction",
    "driver-maintainability",
    "package-manager"
  ],
  "retry_policy": {
    "max_attempts": 1,
    "retry_flaky_only": false
  },
  "shard_policy": {
    "strategy": "deterministic",
    "shards": 1
  },
  "resume_policy": {
    "enabled": true,
    "failure_reproduction": "profile-and-case"
  },
  "report": {
    "format": "json-v1",
    "output_dir": "target/validation_lane_reports"
  },
  "legacy_facade": {
    "matrix_suites": [
      "frontend_mode_parity",
      "phase23_graph_isolation",
      "integer_dtype_contract",
      "phase24_hir_analysis",
      "phase25_cfg_flow",
      "syntax_parser_lexer_matrix"
    ],
    "tooling_suites": [
      "static",
      "formatter",
      "analysis",
      "lsp-smoke"
    ],
    "distribution": "representative",
    "generated_code_quality": "representative",
    "performance_budget": "representative",
    "crate_tests": "full",
    "e2e": {
      "fixture_manifest": "",
      "sifr_jobs": 4,
      "rust_jobs": 3,
      "run_jobs": 3,
      "cargo_build_jobs": 1,
      "max_group_fixtures": 12,
      "disable_cache": false
    },
    "hardening_suites": [
      "diagnostics",
      "project",
      "fixedbugs",
      "crashes",
      "oss-curated"
    ],
    "extra_checks": [],
    "thermal_policy": "balanced-merge-gate",
    "memory_policy": "bounded-merge-gate"
  }
}
