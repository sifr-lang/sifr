{
  "schema_version": 1,
  "name": "merge",
  "description": "Authoritative merge gate with full contract matrices, representative e2e, and selected hardening.",
  "budgets": {
    "warm_wall_time_minutes": 15,
    "cold_wall_time_minutes": 25
  },
  "resource_policy": {
    "classes": [
      "default-local"
    ],
    "max_parallel": 4
  },
  "selected_areas": [
    {
      "area": "core_language",
      "suites": [
        "e2e-pass"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "diagnostics",
      "suites": [
        "contracts",
        "baselines"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "runtime_platform",
      "suites": [
        "platform-golden"
      ],
      "resource_classes": [
        "platform-specific"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "static"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "formatter"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "analysis"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "lsp-smoke"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "generated_code_quality",
      "suites": [
        "representative"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "performance",
      "suites": [
        "representative"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "distribution_release",
      "suites": [
        "representative"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "regression",
      "suites": [
        "diagnostics"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "regression",
      "suites": [
        "project"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "regression",
      "suites": [
        "fixedbugs"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "regression",
      "suites": [
        "crashes"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "ecosystem_compatibility",
      "suites": [
        "oss-curated"
      ],
      "resource_classes": [
        "external-corpus"
      ]
    }
  ],
  "toolchain_steps": [
    "cargo-test-sifr-full"
  ],
  "guardrail_steps": [
    "hir-maintainability",
    "file-size",
    "cursor-hygiene",
    "source-crate-dependency-direction",
    "driver-maintainability",
    "package-manager"
  ],
  "retry_policy": {
    "max_attempts": 1,
    "retry_flaky_only": false
  },
  "shard_policy": {
    "strategy": "deterministic",
    "shards": 1
  },
  "resume_policy": {
    "enabled": true,
    "failure_reproduction": "profile-and-case"
  },
  "report": {
    "format": "json-v1",
    "output_dir": "target/validation_lane_reports"
  },
  "legacy_facade": {
    "matrix_suites": [
      "frontend_mode_parity",
      "phase23_graph_isolation",
      "integer_dtype_contract",
      "phase24_hir_analysis",
      "phase25_cfg_flow"
    ],
    "tooling_suites": [
      "static",
      "formatter",
      "analysis",
      "lsp-smoke"
    ],
    "distribution": "representative",
    "generated_code_quality": "representative",
    "performance_budget": "representative",
    "crate_tests": "full",
    "e2e": {
      "fixture_manifest": "verification/validation_lanes/merge_e2e_manifest.json",
      "sifr_jobs": 4,
      "rust_jobs": 3,
      "run_jobs": 3,
      "cargo_build_jobs": 1,
      "max_group_fixtures": 12,
      "disable_cache": false
    },
    "hardening_suites": [
      "diagnostics",
      "project",
      "fixedbugs",
      "crashes",
      "oss-curated"
    ],
    "extra_checks": [],
    "thermal_policy": "balanced-merge-gate",
    "memory_policy": "bounded-merge-gate"
  }
}
