{
  "schema_version": 2,
  "name": "create-pr",
  "description": "Fast local developer confidence with bounded contract coverage and representative e2e only.",
  "budgets": {
    "warm_wall_time_minutes": 2,
    "cold_wall_time_minutes": 5
  },
  "resource_policy": {
    "classes": [
      "default-local"
    ],
    "max_parallel": 2
  },
  "network_policy": {
    "mode": "offline",
    "live_network_allowed": false
  },
  "cargo_policy": {
    "locked": true,
    "offline": true,
    "setup_command": "cargo fetch --locked"
  },
  "reference_host": {
    "os": "darwin-or-linux",
    "arch": "aarch64-or-x86_64",
    "notes": "Create-pr uses bounded local defaults and must not depend on external network during profile execution."
  },
  "execution_sandbox": {
    "tempdir_only": true,
    "external_network": "forbidden",
    "loopback_network": "declared-only",
    "subprocess_cleanup": true,
    "stdout_stderr_byte_limit": 10485760
  },
  "profile_plan": {
    "emit_command": "scripts/run_all_tests.sh --profile create-pr --emit-plan",
    "compare_command": "uv run --project verification --locked python -m sifr_verify profiles compare-plans --local <local-plan.json> --ci <ci-plan.json>"
  },
  "crate_test_membership": {
    "suites": [
      {"id": "sifr_diagnostics", "package": "sifr_diagnostics", "command": ["test", "-p", "sifr_diagnostics"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_lowering", "package": "sifr_lowering", "command": ["test", "-p", "sifr_lowering", "--", "--skip", "test_e2e_pass"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_syntax", "package": "sifr_syntax", "command": ["test", "-p", "sifr_syntax"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_frontend", "package": "sifr_frontend", "command": ["test", "-p", "sifr_frontend"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_analysis", "package": "sifr_analysis", "command": ["test", "-p", "sifr_analysis"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_lsp", "package": "sifr_lsp", "command": ["test", "-p", "sifr_lsp"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_package", "package": "sifr_package", "command": ["test", "-p", "sifr_package"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_stdlib", "package": "sifr_stdlib", "command": ["test", "-p", "sifr_stdlib"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_runtime", "package": "sifr_runtime", "command": ["test", "-p", "sifr_runtime"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_runtime_http", "package": "sifr_runtime", "command": ["test", "-p", "sifr_runtime", "--features", "http"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_type_system", "package": "sifr_type_system", "command": ["test", "-p", "sifr_type_system"], "modes": ["full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_format", "package": "sifr_format", "command": ["test", "-p", "sifr_format"], "modes": ["full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_lint", "package": "sifr_lint", "command": ["test", "-p", "sifr_lint"], "modes": ["full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_source", "package": "sifr_source", "command": ["test", "-p", "sifr_source"], "modes": ["full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_ir", "package": "sifr_ir", "command": ["test", "-p", "sifr_ir"], "modes": ["full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_cli_bin", "package": "sifr", "command": ["test", "-p", "sifr", "--bin", "sifr"], "modes": ["smoke"], "status": "blocking", "executed_in_merge": false},
      {"id": "sifr_cli_full", "package": "sifr", "command": ["test", "-p", "sifr", "--", "--skip", "test_e2e_pass"], "modes": ["full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_driver_lib", "package": "sifr_driver", "command": ["test", "-p", "sifr_driver", "--lib"], "modes": ["smoke", "full"], "status": "blocking", "executed_in_merge": true},
      {"id": "sifr_codegen", "package": "sifr_codegen", "command": ["test", "-p", "sifr_codegen"], "modes": ["full"], "status": "red-blocker", "executed_in_merge": false, "must_be_executed_by": "Wave 2.final", "reason": "Known red suite tracked by codegen red-blocker inventory until Wave 2.final."}
    ]
  },
  "selected_areas": [
    {
      "area": "coverage_matrix",
      "suites": [
        "advisory"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "diagnostics",
      "suites": [
        "contracts"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "runtime_platform",
      "suites": [
        "platform-golden"
      ],
      "resource_classes": [
        "platform-specific"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "static"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "developer_tooling",
      "suites": [
        "lsp-smoke"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "generated_code_quality",
      "suites": [
        "smoke"
      ],
      "resource_classes": [
        "default-local"
      ]
    },
    {
      "area": "performance",
      "suites": [
        "smoke"
      ],
      "resource_classes": [
        "default-local"
      ]
    }
  ],
  "toolchain_steps": [
    "cargo-test-sifr-smoke"
  ],
  "guardrail_steps": [
    "hir-maintainability",
    "file-size",
    "source-crate-dependency-direction",
    "driver-maintainability",
    "package-manager"
  ],
  "retry_policy": {
    "max_attempts": 1,
    "retry_flaky_only": false
  },
  "shard_policy": {
    "strategy": "deterministic",
    "shards": 1
  },
  "resume_policy": {
    "enabled": true,
    "failure_reproduction": "profile-and-case"
  },
  "report": {
    "format": "json-v1",
    "output_dir": "target/validation_lane_reports"
  },
  "legacy_facade": {
    "matrix_suites": [],
    "tooling_suites": [
      "static",
      "lsp-smoke"
    ],
    "distribution": "none",
    "generated_code_quality": "smoke",
    "performance_budget": "smoke",
    "crate_tests": "smoke",
    "e2e": {
      "fixture_manifest": "verification/areas/core_language/data/create_pr_e2e_manifest.json",
      "sifr_jobs": 2,
      "rust_jobs": 2,
      "run_jobs": 2,
      "cargo_build_jobs": 1,
      "max_group_fixtures": 8,
      "disable_cache": false
    },
    "hardening_suites": [],
    "extra_checks": [],
    "thermal_policy": "bounded-local-defaults",
    "memory_policy": "avoid-swap-defaults"
  }
}
