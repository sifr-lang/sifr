  "resource_policy": {
    "classes": [
      "default-local"
    ],
    "max_parallel": 2,
    "thermal_policy": "bounded-local-defaults",
    "memory_policy": "avoid-swap-defaults"
  },
  "network_policy": {
    "mode": "offline",
    "live_network_allowed": false
  },
  "cargo_policy": {
    "locked": true,
    "offline": true,
    "setup_command": "cargo fetch --locked"
  },
  "reference_host": {
    "os": "darwin-or-linux",
    "arch": "aarch64-or-x86_64",
    "notes": "Create-pr permits only the reported locked Cargo cache-setup prelude to contact the configured registry; every validation step after that boundary is offline."
  },
  "execution_sandbox": {
    "tempdir_only": true,
    "external_network": "forbidden",
    "loopback_network": "declared-only",
    "subprocess_cleanup": true,
    "stdout_stderr_byte_limit": 10485760
  },
