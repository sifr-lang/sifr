def documented(own mut values: list[int]) -> list[int]:
    """
    Sifr snippets in docstrings format when enabled.

    ```sifr
    def sample(own mut items: list[int]) -> list[int]:
        return [item for item in items if item > 0]
    ```

    .. code-block:: sifr

        def passthrough(own item: Result[int, str]) -> Result[int, str]:
            return item
    """
    return values
