# ============================================================
# Test 34: sorted() Borrows the Collection
# Python: sorted() returns new list; original unchanged
# Rust: sorted requires borrowing the collection
# Sifr should: sorted borrows — original reusable
# ============================================================

def main():
    nums: list[int] = [3, 1, 4, 1, 5]
    ordered: list[int] = sorted(nums)
    print(ordered)
    print(nums)  # Should work: sorted borrows, not moves
