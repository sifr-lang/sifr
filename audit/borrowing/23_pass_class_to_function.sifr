# ============================================================
# Test 23: Pass Class Instance to Function (consumed via own)
# Python: passing an object to a function doesn't affect caller
# Rust: passing by value moves the object
# Sifr should: borrow by default; use `own` to explicitly move
# ============================================================

class Point:
    x: int
    y: int

def describe(own p: Point) -> str:
    return f"({p.x}, {p.y})"

def main():
    p: Point = Point(3, 4)
    desc: str = describe(p)
    print(desc)
