# ============================================================
# Test 23: Pass Class Instance to Function (move)
# Python: passing an object to a function doesn't affect caller
# Rust: passing by value moves the object
# Sifr should: move by default for function arguments
# ============================================================

class Point:
    x: int
    y: int

def describe(p: Point) -> str:
    return f"({p.x}, {p.y})"

def main():
    p: Point = Point(3, 4)
    desc: str = describe(p)
    print(desc)
