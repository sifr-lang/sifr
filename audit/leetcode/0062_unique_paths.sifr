# LeetCode 62: Unique Paths

def uniquePaths(m: int, n: int) -> int:
    row = [1] * n

    for i in range(m - 1):
        newRow = [1] * n
        for j in range(n - 2, -1, -1):
            newRow[j] = newRow[j + 1] + row[j]
        row = newRow
    return row[0]

    # O(n * m) O(n)

def main():
    print(uniquePaths(3, 7))
    print(uniquePaths(3, 2))

# expect-stdout: 28
# expect-stdout: 3

