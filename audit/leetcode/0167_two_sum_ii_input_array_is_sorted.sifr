# LeetCode 167: Two Sum Ii Input Array Is Sorted

def twoSum(numbers: list[int], target: int) -> list[int]:
    l, r = 0, len(numbers) - 1

    while l < r:
        curSum = numbers[l] + numbers[r]

        if curSum > target:
            r -= 1
        elif curSum < target:
            l += 1
        else:
            return [l + 1, r + 1]

def main():
    print(twoSum([2,7,11,15], 9))
    print(twoSum([2,3,4], 6))

# expect-stdout: [1, 2]
# expect-stdout: [1, 3]

