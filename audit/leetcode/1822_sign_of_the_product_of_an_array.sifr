# LeetCode 1822: Sign Of The Product Of An Array

def arraySign(nums: list[int]) -> int:
    flag = True
    for i in nums:
        if i == 0:
            return 0
        if i < 0:
            flag = not flag
    
    return 1 if flag else -1

def main():
    print(arraySign([-1,-2,-3,-4,3,2,1]))
    print(arraySign([1,5,0,2,-3]))
    print(arraySign([-1,1,-1,1,-1]))

# expect-stdout: 1
# expect-stdout: 0
# expect-stdout: -1

