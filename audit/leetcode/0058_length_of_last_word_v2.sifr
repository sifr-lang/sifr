# LeetCode 58: Length of Last Word
# v2: Sifr-idiomatic with safe indexing

def lengthOfLastWord(s: str) -> int:
    length: int = 0
    i: int = len(s) - 1
    # Skip trailing spaces
    while i >= 0:
        ch: str | None = s[i]
        if ch is not None:
            if ch == " ":
                i -= 1
            else:
                break
        else:
            break
    # Count last word characters
    while i >= 0:
        ch2: str | None = s[i]
        if ch2 is not None:
            if ch2 != " ":
                length += 1
                i -= 1
            else:
                break
        else:
            break
    return length

def main():
    print(lengthOfLastWord("Hello World"))
    print(lengthOfLastWord("   fly me   to   the moon  "))
    print(lengthOfLastWord("luffy is still joyboy"))
    print(lengthOfLastWord("a"))

# expect-stdout: 5
# expect-stdout: 4
# expect-stdout: 6
# expect-stdout: 1
