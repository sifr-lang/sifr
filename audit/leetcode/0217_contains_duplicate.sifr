# LeetCode 217: Contains Duplicate

def containsDuplicate(nums: list[int]) -> bool:
    hashset = set()

    for n in nums:
        if n in hashset:
            return True
        hashset.add(n)
    return False

def main():
    print(containsDuplicate([1,2,3,1]))
    print(containsDuplicate([1,2,3,4]))

# expect-stdout: true
# expect-stdout: false

