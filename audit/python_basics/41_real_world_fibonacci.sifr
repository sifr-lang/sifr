# ============================================================
# Test 41: Real-World -- Fibonacci Sequence
# ============================================================

def fib_recursive(n: int) -> int:
    if n <= 1:
        return n
    return fib_recursive(n - 1) + fib_recursive(n - 2)

def fib_iterative(n: int) -> int:
    if n <= 1:
        return n
    a: int = 0
    b: int = 1
    for i in range(2, n + 1):
        a, b = b, a + b
    return b

def main():
    # Recursive
    for i in range(10):
        print(fib_recursive(i))

    # Iterative
    print(fib_iterative(20))
    print(fib_iterative(30))
