# ============================================================
# Test 15: List Comprehensions
# Python: [expr for x in iterable], [expr for x in it if cond],
#         nested comprehensions
# ============================================================

def main():
    # Basic comprehension
    squares: list[int] = [x * x for x in range(6)]
    print(squares)

    # With filter
    evens: list[int] = [x for x in range(10) if x % 2 == 0]
    print(evens)

    # String transformation
    names: list[str] = ["alice", "bob", "charlie"]
    upper_names: list[str] = [n.upper() for n in names]
    print(upper_names)

    # Expression in comprehension
    labels: list[str] = [f"item_{i}" for i in range(4)]
    print(labels)

    # Comprehension with function call
    lengths: list[int] = [len(n) for n in names]
    print(lengths)

    # Nested comprehension (flatten)
    matrix: list[list[int]] = [[1, 2], [3, 4], [5, 6]]
    flat: list[int] = [x for row in matrix for x in row]
    print(flat)
