# ============================================================
# Test 22: Lambda Expressions
# Python: lambda x: x * 2, lambda x, y: x + y
# ============================================================

def main():
    nums: list[int] = [1, 2, 3, 4, 5]

    # Lambda with map
    doubled: list[int] = map(lambda x: x * 2, nums)
    print(doubled)

    # Lambda with filter
    evens: list[int] = filter(lambda x: x % 2 == 0, nums)
    print(evens)

    # Lambda with sorted (if key= is supported)
    # sorted_by_neg: list[int] = sorted(nums, key=lambda x: -x)

    # Chained
    result: list[int] = map(lambda x: x + 10, filter(lambda x: x > 2, nums))
    print(result)

    # Lambda returning bool
    positives: list[int] = filter(lambda x: x > 3, nums)
    print(positives)
