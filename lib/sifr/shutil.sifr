# sifr.shutil — High-level file operations (wraps _sifr.fs)
from _sifr.fs import copy_file, remove_file, rename, rmdir_all

def copy(src: str, dst: str):
    copy_file(src, dst)

def move_file(src: str, dst: str):
    copy_file(src, dst)
    remove_file(src)

def rmtree(path: str):
    rmdir_all(path)
