# sifr.argparse — Command-line argument parsing (pure Sifr)
# Class/object-model shim over the existing helper functions.


def parse_flag(args: list[str], flag: str) -> bool:
    for arg in args:
        if arg == flag:
            return True
    return False


def _split_inline_option(token: str) -> tuple[bool, str, str]:
    key: str = ""
    i: int = 0
    while i < len(token):
        ch: str | None = token[i]
        if ch is not None and ch == "=":
            value: str = ""
            j: int = i + 1
            while j < len(token):
                part: str | None = token[j]
                if part is not None:
                    value = value + part
                j = j + 1
            return (True, key, value)
        if ch is not None:
            key = key + ch
        i = i + 1
    return (False, token + "", "")


def parse_option(args: list[str], name: str, default: str) -> str:
    i: int = 0
    while i < len(args):
        arg: str | None = args[i]
        if arg is not None:
            if arg == name and i + 1 < len(args):
                next_val: str | None = args[i + 1]
                if next_val is not None:
                    if next_val == "--" or next_val.startswith("--"):
                        pass
                    else:
                        return next_val + ""
            inline_has_value, inline_name, inline_value = _split_inline_option(arg)
            if inline_has_value and inline_name == name:
                return inline_value + ""
        i = i + 1
    return default + ""


def parse_positional(args: list[str], index: int, default: str) -> str:
    positionals: list[str] = []
    skip_next: bool = False
    force_positional: bool = False
    for arg in args:
        if force_positional:
            positionals.append(arg)
            continue
        if skip_next:
            skip_next = False
        elif arg == "--":
            force_positional = True
        elif arg.startswith("-"):
            inline_has_value, inline_name, inline_value = _split_inline_option(arg)
            if inline_has_value:
                continue
            skip_next = True
        else:
            positionals.append(arg)
    if index < len(positionals):
        value: str | None = positionals[index]
        if value is not None:
            return value + ""
    return default + ""


class ArgumentSpec:
    name: str
    dest: str
    kind: str
    default_value: str

    def __init__(self, name: str, dest: str, kind: str, default_value: str):
        self.name = name + ""
        self.dest = dest + ""
        self.kind = kind + ""
        self.default_value = default_value + ""


class Namespace:
    _str_values: list[tuple[str, str]]
    _bool_values: list[tuple[str, bool]]

    def __init__(self):
        self._str_values = []
        self._bool_values = []

    def set(self, name: str, value: str) -> None:
        updated: list[tuple[str, str]] = []
        replaced: bool = False
        for key, current in self._str_values:
            if key == name:
                updated.append((name + "", value + ""))
                replaced = True
            else:
                updated.append((key, current))
        if not replaced:
            updated.append((name + "", value + ""))
        self._str_values = updated

    def set_bool(self, name: str, value: bool) -> None:
        updated: list[tuple[str, bool]] = []
        replaced: bool = False
        for key, current in self._bool_values:
            if key == name:
                updated.append((name + "", value))
                replaced = True
            else:
                updated.append((key, current))
        if not replaced:
            updated.append((name + "", value))
        self._bool_values = updated

    def get(self, name: str, default: str = "") -> str:
        for key, value in self._str_values:
            if key == name:
                return value + ""
        return default + ""

    def get_bool(self, name: str, default: bool = False) -> bool:
        for key, value in self._bool_values:
            if key == name:
                return value
        return default


def _derive_dest(name: str) -> str:
    return name + ""


def _is_option_like_token(specs: list[ArgumentSpec], token: str) -> bool:
    if token == "--":
        return True
    if token.startswith("--"):
        return True
    inline_has_value, inline_name, inline_value = _split_inline_option(token)
    _ = inline_value
    lookup_name: str = token + ""
    if inline_has_value:
        lookup_name = inline_name + ""
    for spec in specs:
        if spec.kind == "positional":
            continue
        if spec.name == lookup_name:
            return True
    return False


class ArgumentParser:
    _prog: str
    _specs: list[ArgumentSpec]

    def __init__(self, prog: str = ""):
        self._prog = prog + ""
        self._specs = []

    def prog(self) -> str:
        return self._prog + ""

    def add_argument(
        self,
        name: str,
        dest: str = "",
        action: str = "store",
        default: str = "",
    ) -> None:
        resolved_dest: str = dest + ""
        if resolved_dest == "":
            resolved_dest = _derive_dest(name)
        kind: str = "positional"
        if name.startswith("-"):
            if action == "store_true":
                kind = "flag"
            else:
                kind = "option"
        spec: ArgumentSpec = ArgumentSpec(name, resolved_dest, kind, default)
        self._specs.append(spec)

    def parse_args(self, args: list[str]) -> Namespace:
        ns: Namespace = Namespace()
        for spec in self._specs:
            if spec.kind == "flag":
                ns.set_bool(spec.dest, False)
            elif spec.kind == "option":
                ns.set(spec.dest, spec.default_value)
            else:
                ns.set(spec.dest, spec.default_value)

        pending_option_dest: str = ""
        has_pending_option: bool = False
        positional_index: int = 0
        force_positional: bool = False
        for token in args:
            process_current_token: bool = True

            if has_pending_option:
                if _is_option_like_token(self._specs, token):
                    has_pending_option = False
                    if token == "--" and not force_positional:
                        force_positional = True
                        process_current_token = False
                else:
                    ns.set(pending_option_dest, token)
                    has_pending_option = False
                    continue

            if not process_current_token:
                continue

            if token == "--" and not force_positional:
                force_positional = True
                continue

            if token.startswith("-") and not force_positional:
                inline_has_value, inline_name, inline_value = _split_inline_option(token)
                lookup_name: str = token + ""
                if inline_has_value:
                    lookup_name = inline_name + ""
                matched: bool = False
                matched_kind: str = ""
                matched_dest: str = ""
                for spec in self._specs:
                    if spec.kind == "positional":
                        continue
                    if spec.name == lookup_name:
                        matched = True
                        matched_kind = spec.kind
                        matched_dest = spec.dest
                        break
                if matched:
                    if matched_kind == "flag":
                        ns.set_bool(matched_dest, True)
                    elif matched_kind == "option":
                        if inline_has_value:
                            ns.set(matched_dest, inline_value)
                        else:
                            pending_option_dest = matched_dest
                            has_pending_option = True
                continue

            position_cursor: int = 0
            positional_found: bool = False
            positional_dest: str = ""
            for spec in self._specs:
                if spec.kind != "positional":
                    continue
                if position_cursor == positional_index:
                    positional_found = True
                    positional_dest = spec.dest
                    break
                position_cursor = position_cursor + 1
            if positional_found:
                ns.set(positional_dest, token)
                positional_index = positional_index + 1
        return ns
