# sifr.base64 — Base64 encoding/decoding (renamed from sifr.encoding)
from _sifr.crypto import base64_encode, base64_decode, base64_encode_opts, base64_decode_opts, urlsafe_b64encode, urlsafe_b64decode, b32encode, b32decode, b32hexencode, b32hexdecode
from sifr.bytes import encode_utf8, decode_utf8, bytes_to_hex, bytes_from_hex

# CPython-compatible aliases
def b64encode(s: str) -> str:
    return base64_encode(s)

def b64decode(s: str) -> Result[str, ParseError]:
    return base64_decode(s)

def b64encode_opts(s: str, altchars: str = "", wrapcol: int = 0) -> Result[str, ParseError]:
    return base64_encode_opts(s, altchars, wrapcol)

def b64decode_opts(s: str, altchars: str = "", validate: bool = False, ignorechars: str = "") -> Result[str, ParseError]:
    return base64_decode_opts(s, altchars, validate, ignorechars)

def standard_b64encode(s: str) -> str:
    return base64_encode(s)

def standard_b64decode(s: str) -> Result[str, ParseError]:
    return base64_decode(s)

def encodebytes(s: str) -> str:
    return base64_encode(s)

def decodebytes(s: str) -> Result[str, ParseError]:
    return base64_decode(s)

def b16encode(s: str) -> Result[str, ParseError]:
    try:
        raw: str = bytes_to_hex(encode_utf8(s))
        return raw.upper()
    except ParseError as e:
        raise e

def b16decode(s: str) -> Result[str, ParseError]:
    try:
        data: list[int] = bytes_from_hex(s)
        return decode_utf8(data)
    except ParseError as e:
        raise e
