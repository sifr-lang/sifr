# sifr.textwrap — Text wrapping and filling (pure Sifr)

def _replace_whitespace_chars(text: str, replace_tabs: bool) -> str:
    normalized: str = text.replace("\n", " ").replace("\r", " ").replace("\v", " ").replace("\f", " ")
    if replace_tabs:
        return normalized.replace("\t", " ")
    return normalized


def _expand_tabs_impl(text: str, tabsize: int) -> str:
    effective_tabsize: int = tabsize
    if effective_tabsize <= 0:
        effective_tabsize = 1

    result: str = ""
    column: int = 0
    i: int = 0
    while i < len(text):
        ch_opt: str | None = text[i]
        if ch_opt is not None:
            ch: str = ch_opt
            if ch == "\t":
                spaces: int = effective_tabsize - (column % effective_tabsize)
                if spaces <= 0:
                    spaces = effective_tabsize
                j: int = 0
                while j < spaces:
                    result = result + " "
                    j = j + 1
                column = column + spaces
            elif ch == "\n" or ch == "\r":
                result = result + ch
                column = 0
            else:
                result = result + ch
                column = column + 1
        i = i + 1
    return result


def _prepare_text(
    text: str,
    expand_tabs: bool,
    tabsize: int,
    replace_whitespace: bool,
) -> str:
    prepared: str = text + ""
    if expand_tabs:
        prepared = _expand_tabs_impl(prepared, tabsize)
    if replace_whitespace:
        prepared = _replace_whitespace_chars(prepared, True)
    return prepared


def _normalize_whitespace(text: str) -> str:
    return _prepare_text(text, True, 8, True)


def _has_non_whitespace(text: str) -> bool:
    i: int = 0
    while i < len(text):
        ch: str | None = text[i]
        if ch is not None:
            if ch != " ":
                if ch != "\t":
                    if ch != "\n":
                        if ch != "\r":
                            if ch != "\v":
                                if ch != "\f":
                                    return True
        i = i + 1
    return False


def _split_word_units(word: str, break_on_hyphens: bool) -> list[str]:
    if not break_on_hyphens:
        return [word + ""]

    parts: list[str] = word.split("-")
    if len(parts) <= 1:
        return [word + ""]

    units: list[str] = []
    index: int = 0
    for part in parts:
        is_last: bool = index == len(parts) - 1
        if is_last:
            if len(part) > 0:
                units.append(part)
        else:
            if len(part) == 0:
                units.append("-")
            else:
                units.append(part + "-")
        index = index + 1

    if len(units) == 0:
        units.append(word + "")
    return units


def _trim_line(line: str) -> str:
    start: int = 0
    while start < len(line) and line[start] == " ":
        start = start + 1

    end: int = len(line)
    while end > start and line[end - 1] == " ":
        end = end - 1

    return line[start:end]


def _finalize_line(line: str, drop_whitespace: bool) -> str:
    if drop_whitespace:
        return _trim_line(line)
    return line + ""


def _wrap_impl(text: str, width: int) -> list[str]:
    normalized: str = _normalize_whitespace(text)
    return _wrap_with_indents(normalized, width, "", "", True, True)


def _apply_line_indents(
    lines: list[str], initial_indent: str, subsequent_indent: str
) -> list[str]:
    result: list[str] = []
    index: int = 0
    for line in lines:
        if index == 0:
            result.append(initial_indent + line)
        else:
            result.append(subsequent_indent + line)
        index = index + 1
    return result


def _effective_content_width(total_width: int, indent: str) -> int:
    available: int = total_width - len(indent)
    if available <= 0:
        return 1
    return available


def _push_current_line(
    mut result: list[str],
    line: str,
    indent: str,
    drop_whitespace: bool,
) -> None:
    candidate: str = _finalize_line(indent + line, drop_whitespace)
    if drop_whitespace:
        if len(candidate) > 0:
            result.append(candidate)
    else:
        result.append(candidate)


def _wrap_with_indents(
    text: str,
    total_width: int,
    initial_indent: str,
    subsequent_indent: str,
    break_on_hyphens: bool,
    drop_whitespace: bool,
) -> list[str]:
    words: list[str] = text.split(" ")
    result: list[str] = []
    current: str = ""
    first_line: bool = True
    current_limit: int = _effective_content_width(total_width, initial_indent)

    for raw_word in words:
        units: list[str] = _split_word_units(raw_word, break_on_hyphens)
        for word in units:
            if len(word) == 0:
                if drop_whitespace:
                    continue
                if len(current) > 0:
                    if len(current) + 1 <= current_limit:
                        current = current + " "
                continue

            if len(current) == 0:
                current = word
            elif len(current) + 1 + len(word) <= current_limit:
                current = current + " " + word
            else:
                if first_line:
                    _push_current_line(result, current, initial_indent, drop_whitespace)
                    first_line = False
                    current_limit = _effective_content_width(total_width, subsequent_indent)
                else:
                    _push_current_line(result, current, subsequent_indent, drop_whitespace)
                current = word

    if len(current) > 0:
        if first_line:
            _push_current_line(result, current, initial_indent, drop_whitespace)
        else:
            _push_current_line(result, current, subsequent_indent, drop_whitespace)
    return result


def _apply_sentence_endings_line(text: str) -> str:
    result: str = ""
    i: int = 0
    while i < len(text):
        ch_opt: str | None = text[i]
        if ch_opt is not None:
            ch: str = ch_opt
            result = result + ch
            if ch == "." or ch == "!" or ch == "?":
                next_opt: str | None = None
                if i + 1 < len(text):
                    next_opt = text[i + 1]
                next2_opt: str | None = None
                if i + 2 < len(text):
                    next2_opt = text[i + 2]
                if next_opt is not None and next_opt == " ":
                    if next2_opt is None or next2_opt != " ":
                        result = result + " "
        i = i + 1
    return result


def _apply_sentence_endings_lines(lines: list[str]) -> list[str]:
    result: list[str] = []
    for line in lines:
        result.append(_apply_sentence_endings_line(line))
    return result


def _clone_lines(lines: list[str]) -> list[str]:
    copied: list[str] = []
    for line in lines:
        copied.append(line)
    return copied


def _apply_max_lines(
    lines: list[str],
    width: int,
    max_lines: int | None,
    placeholder: str,
    drop_whitespace: bool,
) -> list[str]:
    if max_lines is None:
        return _clone_lines(lines)

    limit: int = max_lines
    if limit <= 0:
        return []
    if len(lines) <= limit:
        return _clone_lines(lines)

    result: list[str] = []
    i: int = 0
    while i < limit:
        line_opt: str | None = lines[i]
        if line_opt is not None:
            result.append(line_opt)
        i = i + 1

    if len(result) == 0:
        return result

    effective_placeholder: str = placeholder + ""
    if width > 0:
        if len(effective_placeholder) > width:
            effective_placeholder = effective_placeholder[0:width]

    last_index: int = len(result) - 1
    last_opt: str | None = result[last_index]
    if last_opt is not None:
        last: str = last_opt
        base: str = _trim_line(last)
        available: int = width - len(effective_placeholder)
        if available < 0:
            available = 0
        if len(base) > available:
            base = _trim_line(base[0:available])
        if drop_whitespace:
            base = _trim_line(base)
        result[last_index] = base + effective_placeholder
    return result


class TextWrapper:
    width: int
    initial_indent: str
    subsequent_indent: str
    expand_tabs: bool
    tabsize: int
    replace_whitespace: bool
    drop_whitespace: bool
    break_on_hyphens: bool
    fix_sentence_endings: bool
    max_lines: int | None
    placeholder: str

    def __init__(
        self,
        width: int = 70,
        initial_indent: str = "",
        subsequent_indent: str = "",
        expand_tabs: bool = True,
        tabsize: int = 8,
        replace_whitespace: bool = True,
        drop_whitespace: bool = True,
        break_on_hyphens: bool = True,
        fix_sentence_endings: bool = False,
        max_lines: int | None = None,
        placeholder: str = " [...]",
    ) -> None:
        self.width = width
        self.initial_indent = initial_indent + ""
        self.subsequent_indent = subsequent_indent + ""
        self.expand_tabs = expand_tabs
        safe_tabsize: int = tabsize
        if safe_tabsize <= 0:
            safe_tabsize = 1
        self.tabsize = safe_tabsize
        self.replace_whitespace = replace_whitespace
        self.drop_whitespace = drop_whitespace
        self.break_on_hyphens = break_on_hyphens
        self.fix_sentence_endings = fix_sentence_endings
        self.max_lines = max_lines
        self.placeholder = placeholder + ""

    def wrap(self, text: str) -> list[str]:
        if self.width <= 0:
            return []
        prepared: str = _prepare_text(
            text,
            self.expand_tabs,
            self.tabsize,
            self.replace_whitespace,
        )
        lines: list[str] = _wrap_with_indents(
            prepared,
            self.width,
            self.initial_indent,
            self.subsequent_indent,
            self.break_on_hyphens,
            self.drop_whitespace,
        )
        if self.fix_sentence_endings:
            lines = _apply_sentence_endings_lines(lines)
        return _apply_max_lines(
            lines,
            self.width,
            self.max_lines,
            self.placeholder,
            self.drop_whitespace,
        )

    def fill(self, text: str) -> str:
        if self.width <= 0:
            return ""
        lines: list[str] = self.wrap(text)
        result: str = ""
        i: int = 0
        for line in lines:
            if i > 0:
                result = result + "\n"
            result = result + line
            i = i + 1
        return result


def wrap(text: str, width: int) -> Result[list[str], ValueError]:
    if width <= 0:
        raise ValueError("wrap: width must be > 0")
    return _wrap_impl(text, width)


def fill(text: str, width: int) -> Result[str, ValueError]:
    if width <= 0:
        raise ValueError("fill: width must be > 0")
    lines: list[str] = _wrap_impl(text, width)
    result: str = ""
    i: int = 0
    for line in lines:
        if i > 0:
            result = result + "\n"
        result = result + line
        i = i + 1
    return result


def dedent(text: str) -> str:
    lines: list[str] = text.split("\n")
    min_indent: int = 0
    have_indent: bool = False
    for line in lines:
        if _has_non_whitespace(line):
            spaces: int = 0
            j: int = 0
            done: bool = False
            while j < len(line):
                if not done:
                    ch: str | None = line[j]
                    if ch is not None:
                        if ch == " ":
                            spaces = spaces + 1
                        else:
                            done = True
                j = j + 1
            if not have_indent:
                min_indent = spaces
                have_indent = True
            elif spaces < min_indent:
                min_indent = spaces
    result: str = ""
    first: bool = True
    for line2 in lines:
        if not first:
            result = result + "\n"
        first = False
        if have_indent:
            if len(line2) > min_indent:
                result = result + line2[min_indent:]
            else:
                result = result + line2
        else:
            result = result + line2[min_indent:]
    return result


def indent(text: str, prefix: str) -> str:
    lines: list[str] = text.split("\n")
    result: str = ""
    first: bool = True
    for line in lines:
        if not first:
            result = result + "\n"
        first = False
        if _has_non_whitespace(line):
            result = result + prefix + line
        else:
            result = result + line
    return result


def shorten(text: str, width: int) -> str:
    normalized: str = _normalize_whitespace(text)
    words: list[str] = normalized.split(" ")
    result: str = ""
    for word in words:
        if len(word) == 0:
            pass
        elif len(result) == 0:
            result = word
        elif len(result) + 1 + len(word) + 4 <= width:
            result = result + " " + word
        else:
            return result + " [...]"
    return result
