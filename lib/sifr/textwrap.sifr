# sifr.textwrap — Text wrapping and filling (pure Sifr)

def _normalize_whitespace(text: str) -> str:
    return text.replace("\t", " ").replace("\n", " ").replace("\r", " ").replace("\v", " ").replace("\f", " ")

def _has_non_whitespace(text: str) -> bool:
    i: int = 0
    while i < len(text):
        ch: str | None = text[i]
        if ch is not None:
            if ch != " ":
                if ch != "\t":
                    if ch != "\n":
                        if ch != "\r":
                            if ch != "\v":
                                if ch != "\f":
                                    return True
        i = i + 1
    return False

def _wrap_impl(text: str, width: int) -> list[str]:
    normalized: str = _normalize_whitespace(text)
    words: list[str] = normalized.split(" ")
    result: list[str] = []
    current: str = ""
    for word in words:
        if len(word) == 0:
            pass
        elif len(current) == 0:
            current = word
        elif len(current) + 1 + len(word) > width:
            result.append(current)
            current = word
        else:
            current = current + " " + word
    if len(current) > 0:
        result.append(current)
    return result

def _apply_line_indents(
    lines: list[str], initial_indent: str, subsequent_indent: str
) -> list[str]:
    result: list[str] = []
    index: int = 0
    for line in lines:
        if index == 0:
            result.append(initial_indent + line)
        else:
            result.append(subsequent_indent + line)
        index = index + 1
    return result

def _effective_content_width(total_width: int, indent: str) -> int:
    available: int = total_width - len(indent)
    if available <= 0:
        return 1
    return available

def _wrap_with_indents(
    text: str, total_width: int, initial_indent: str, subsequent_indent: str
) -> list[str]:
    normalized: str = _normalize_whitespace(text)
    words: list[str] = normalized.split(" ")
    result: list[str] = []
    current: str = ""
    first_line: bool = True
    current_limit: int = _effective_content_width(total_width, initial_indent)

    for word in words:
        if len(word) == 0:
            continue
        if len(current) == 0:
            current = word
        elif len(current) + 1 + len(word) <= current_limit:
            current = current + " " + word
        else:
            if first_line:
                result.append(initial_indent + current)
                first_line = False
                current_limit = _effective_content_width(total_width, subsequent_indent)
            else:
                result.append(subsequent_indent + current)
            current = word

    if len(current) > 0:
        if first_line:
            result.append(initial_indent + current)
        else:
            result.append(subsequent_indent + current)
    return result

class TextWrapper:
    width: int
    initial_indent: str
    subsequent_indent: str

    def __init__(
        self,
        width: int = 70,
        initial_indent: str = "",
        subsequent_indent: str = "",
    ) -> None:
        self.width = width
        self.initial_indent = initial_indent + ""
        self.subsequent_indent = subsequent_indent + ""

    def wrap(self, text: str) -> list[str]:
        if self.width <= 0:
            return []
        return _wrap_with_indents(
            text, self.width, self.initial_indent, self.subsequent_indent
        )

    def fill(self, text: str) -> str:
        if self.width <= 0:
            return ""
        lines: list[str] = _wrap_with_indents(
            text, self.width, self.initial_indent, self.subsequent_indent
        )
        result: str = ""
        i: int = 0
        for line in lines:
            if i > 0:
                result = result + "\n"
            result = result + line
            i = i + 1
        return result

def wrap(text: str, width: int) -> Result[list[str], ValueError]:
    if width <= 0:
        raise ValueError("wrap: width must be > 0")
    return _wrap_impl(text, width)

def fill(text: str, width: int) -> Result[str, ValueError]:
    if width <= 0:
        raise ValueError("fill: width must be > 0")
    lines: list[str] = _wrap_impl(text, width)
    result: str = ""
    i: int = 0
    for line in lines:
        if i > 0:
            result = result + "\n"
        result = result + line
        i = i + 1
    return result

def dedent(text: str) -> str:
    lines: list[str] = text.split("\n")
    min_indent: int = 0
    have_indent: bool = False
    for line in lines:
        if _has_non_whitespace(line):
            spaces: int = 0
            j: int = 0
            done: bool = False
            while j < len(line):
                if not done:
                    ch: str | None = line[j]
                    if ch is not None:
                        if ch == " ":
                            spaces = spaces + 1
                        else:
                            done = True
                j = j + 1
            if not have_indent:
                min_indent = spaces
                have_indent = True
            elif spaces < min_indent:
                min_indent = spaces
    result: str = ""
    first: bool = True
    for line2 in lines:
        if not first:
            result = result + "\n"
        first = False
        if have_indent:
            if len(line2) > min_indent:
                result = result + line2[min_indent:]
            else:
                result = result + line2
        else:
            result = result + line2[min_indent:]
    return result

def indent(text: str, prefix: str) -> str:
    lines: list[str] = text.split("\n")
    result: str = ""
    first: bool = True
    for line in lines:
        if not first:
            result = result + "\n"
        first = False
        if _has_non_whitespace(line):
            result = result + prefix + line
        else:
            result = result + line
    return result

def shorten(text: str, width: int) -> str:
    normalized: str = _normalize_whitespace(text)
    words: list[str] = normalized.split(" ")
    result: str = ""
    for word in words:
        if len(word) == 0:
            pass
        elif len(result) == 0:
            result = word
        elif len(result) + 1 + len(word) + 4 <= width:
            result = result + " " + word
        else:
            return result + " [...]"
    return result
