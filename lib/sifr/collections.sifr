# sifr.collections — Extended collection types
from _sifr.collections import new_set, set_from_list, set_add, set_contains, set_remove, set_len, set_union, set_intersection, defaultdict_new, defaultdict_get, defaultdict_set

class Counter[T: Hashable]:
    # A multiset (bag) mapping elements to their counts.
    counts: dict[T, int]

    def get(self, key: T) -> int:
        val: int | None = self.counts[key]
        if val is not None:
            return val
        return 0

    def increment(self, key: T) -> None:
        val: int | None = self.counts[key]
        if val is not None:
            self.counts[key] = val + 1
        else:
            self.counts[key] = 1

    def total(self) -> int:
        total: int = 0
        for count in self.counts.values():
            total = total + count
        return total

    def most_common(self, n: int) -> list[T]:
        all_keys: list[T] = self.counts.keys()
        result: list[T] = []
        for k in all_keys:
            result.append(k)
        sz: int = len(result)
        i: int = 0
        while i < sz:
            j: int = i + 1
            while j < sz:
                ki: T | None = result[i]
                kj: T | None = result[j]
                if ki is not None:
                    if kj is not None:
                        ci: int | None = self.counts[ki]
                        cj: int | None = self.counts[kj]
                        ci_val: int = 0
                        cj_val: int = 0
                        if ci is not None:
                            ci_val = ci
                        if cj is not None:
                            cj_val = cj
                        if cj_val > ci_val:
                            result[i] = kj
                            result[j] = ki
                j = j + 1
            i = i + 1
        top: list[T] = []
        count: int = 0
        while count < n:
            if count >= len(result):
                return top
            val: T | None = result[count]
            if val is not None:
                top.append(val)
            count = count + 1
        return top

    def keys(self) -> list[T]:
        return self.counts.keys()

    def values(self) -> list[int]:
        return self.counts.values()

    def update(self, other: Counter[T]) -> None:
        for key in other.counts.keys():
            other_val: int | None = other.counts[key]
            if other_val is not None:
                existing: int | None = self.counts[key]
                if existing is not None:
                    self.counts[key] = existing + other_val
                else:
                    self.counts[key] = other_val

    def subtract(self, other: Counter[T]) -> None:
        for key in other.counts.keys():
            other_val: int | None = other.counts[key]
            if other_val is not None:
                existing: int | None = self.counts[key]
                if existing is not None:
                    self.counts[key] = existing - other_val
                else:
                    self.counts[key] = 0 - other_val

    def elements(self) -> list[T]:
        result: list[T] = []
        all_keys: list[T] = self.counts.keys()
        ki: int = 0
        while ki < len(all_keys):
            key_opt: T | None = all_keys[ki]
            if key_opt is not None:
                cnt: int | None = self.counts[key_opt]
                if cnt is not None:
                    i: int = 0
                    while i < cnt:
                        key_copy: T | None = all_keys[ki]
                        if key_copy is not None:
                            result.append(key_copy)
                        i = i + 1
            ki = ki + 1
        return result

    def __add__(self, other: Counter[T]) -> Counter[T]:
        new_counts: dict[T, int] = {}
        for key in self.counts.keys():
            a_val: int | None = self.counts[key]
            if a_val is not None:
                b_val: int | None = other.counts[key]
                b_count: int = 0
                if b_val is not None:
                    b_count = b_val
                total: int = a_val + b_count
                if total > 0:
                    new_counts[key] = total
        for key2 in other.counts.keys():
            already: int | None = new_counts[key2]
            if already is None:
                b_val2: int | None = other.counts[key2]
                if b_val2 is not None:
                    if b_val2 > 0:
                        new_counts[key2] = b_val2
        return Counter(new_counts)

    def __sub__(self, other: Counter[T]) -> Counter[T]:
        new_counts: dict[T, int] = {}
        for key in self.counts.keys():
            a_val: int | None = self.counts[key]
            if a_val is not None:
                b_val: int | None = other.counts[key]
                b_count: int = 0
                if b_val is not None:
                    b_count = b_val
                diff: int = a_val - b_count
                if diff > 0:
                    new_counts[key] = diff
        return Counter(new_counts)


def from_list[T: Hashable](items: list[T]) -> Counter[T]:
    counts: dict[T, int] = {}
    for item in items:
        val: int | None = counts[item]
        if val is not None:
            counts[item] = val + 1
        else:
            counts[item] = 1
    return Counter(counts)


class deque[T]:
    # A double-ended queue backed by VecDeque for O(1) front/back operations.
    _data: list[T]
    _maxlen: int

    def __init__(self, items: list[T] = [], maxlen: int = 0) -> None:
        data: list[T] = []
        start: int = 0
        if maxlen > 0 and len(items) > maxlen:
            start = len(items) - maxlen
        i: int = start
        while i < len(items):
            item: T | None = items[i]
            if item is not None:
                data.append(item)
            i += 1
        self._maxlen = maxlen
        self._data = data

    def append(self, val: T) -> None:
        self._data.append(val)
        if self._maxlen > 0 and len(self._data) > self._maxlen:
            self._data.popleft()

    def appendleft(self, val: T) -> None:
        self._data.appendleft(val)
        if self._maxlen > 0 and len(self._data) > self._maxlen:
            self._data.pop()

    def pop(self) -> T | None:
        if len(self._data) == 0:
            return None
        return self._data.pop()

    def popleft(self) -> T | None:
        if len(self._data) == 0:
            return None
        return self._data.popleft()

    def len(self) -> int:
        return len(self._data)

    def to_list(self) -> list[T]:
        result: list[T] = []
        for v in self._data:
            result.append(v)
        return result

    def clear(self) -> None:
        self._data = []

    def extend(self, items: list[T]) -> None:
        for v in items:
            self._data.append(v)
        if self._maxlen > 0:
            while len(self._data) > self._maxlen:
                self._data.popleft()

    def extendleft(self, items: list[T]) -> None:
        for v in items:
            self._data.appendleft(v)
        if self._maxlen > 0:
            while len(self._data) > self._maxlen:
                self._data.pop()
