# sifr.pathlib — Path manipulation (pure Sifr)

def join_path(base: str, child: str) -> str:
    if len(base) == 0:
        return child + ""
    last: str | None = base[len(base) - 1]
    if last is not None:
        if last == "/":
            return base + child
    return base + "/" + child

def basename(path: str) -> str:
    i: int = len(path) - 1
    while i >= 0:
        ch: str | None = path[i]
        if ch is not None:
            if ch == "/":
                return path[i + 1:]
        i = i - 1
    return path + ""

def dirname(path: str) -> str:
    i: int = len(path) - 1
    while i >= 0:
        ch: str | None = path[i]
        if ch is not None:
            if ch == "/":
                return path[:i]
        i = i - 1
    return ""

def extension(path: str) -> str:
    i: int = len(path) - 1
    while i >= 0:
        ch: str | None = path[i]
        if ch is not None:
            if ch == ".":
                return path[i:]
            if ch == "/":
                return ""
        i = i - 1
    return ""
