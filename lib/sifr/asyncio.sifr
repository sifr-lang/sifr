# sifr.asyncio — compatibility veneer over the canonical task model

from sifr.sync import ClosedError


def sleep(delay: float) -> None:
    return None


def wait_for(handle: Any, delay: float) -> None:
    return None


def gather(handles: Any) -> None:
    return None


def create_task(coroutine: Any) -> None:
    return None


class TaskGroup:
    pass


def timeout(delay: float) -> None:
    return None


class Queue[T]:
    _buffer: list[T]
    _closed: bool
    _capacity: int

    def __init__(self, maxsize: int):
        self._buffer = []
        self._closed = False
        self._capacity = maxsize

    def __str__(self) -> str:
        return "Queue"

    async def put(self, own value: T) -> Result[None, ClosedError]:
        if self._closed:
            raise ClosedError()
        self._buffer.append(value)
        return None

    async def get(self) -> Result[T, ClosedError]:
        if len(self._buffer) == 0:
            raise ClosedError()
        value: T = self._buffer[0]
        self._buffer.pop(0)
        return value

    def close(self) -> None:
        self._closed = True
