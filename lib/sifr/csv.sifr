# sifr.csv — CSV parsing and writing (pure Sifr)
# Simplified CSV: no quoting, comma-separated values.
from _sifr.fs import file_read, file_write, open_file, file_close
from sifr.io import FileHandle, open

def parse_row(line: str) -> list[str]:
    return line.split(",")

def parse_csv(text: str) -> list[list[str]]:
    rows: list[list[str]] = []
    lines: list[str] = text.split("\n")
    for line in lines:
        if len(line) > 0:
            row: list[str] = parse_row(line)
            rows.append(row)
    return rows

def format_row(fields: list[str]) -> str:
    result: str = ""
    i: int = 0
    for field in fields:
        if i > 0:
            result = result + ","
        result = result + field
        i = i + 1
    return result

def format_csv(rows: list[list[str]]) -> str:
    result: str = ""
    i: int = 0
    for row in rows:
        if i > 0:
            result = result + "\n"
        result = result + format_row(row)
        i = i + 1
    return result


class reader:
    # CSV reader object that parses text line by line.
    _rows: list[list[str]]
    _pos: int

    def __init__(self, text: str) -> None:
        self._rows = parse_csv(text)
        self._pos = 0

    def __next__(self) -> list[str] | None:
        if self._pos >= len(self._rows):
            return None
        row: list[str] = []
        pos: int = self._pos
        for i, v in enumerate(self._rows):
            if i == pos:
                for cell in v:
                    row.append(cell)
        self._pos = pos + 1
        return row

    def rows(self) -> list[list[str]]:
        result: list[list[str]] = []
        for row in self._rows:
            copy: list[str] = []
            for cell in row:
                copy.append(cell)
            result.append(copy)
        return result

    def line_num(self) -> int:
        return self._pos


class writer:
    # CSV writer object that accumulates rows.
    _rows: list[list[str]]

    def __init__(self) -> None:
        self._rows = []

    def writerow(self, row: list[str]) -> None:
        new_rows: list[list[str]] = []
        for existing in self._rows:
            copy_e: list[str] = []
            for v in existing:
                copy_e.append(v)
            new_rows.append(copy_e)
        copy: list[str] = []
        for v in row:
            copy.append(v)
        new_rows.append(copy)
        self._rows = new_rows

    def writerows(self, rows: list[list[str]]) -> None:
        new_rows: list[list[str]] = []
        for existing in self._rows:
            copy_e: list[str] = []
            for v in existing:
                copy_e.append(v)
            new_rows.append(copy_e)
        for row in rows:
            copy: list[str] = []
            for v in row:
                copy.append(v)
            new_rows.append(copy)
        self._rows = new_rows

    def getvalue(self) -> str:
        return format_csv(self._rows)


class DictReader:
    # CSV reader that returns rows as dict[str, str] using header row as keys.
    _headers: list[str]
    _rows: list[list[str]]
    _pos: int

    def __init__(self, text: str) -> None:
        all_rows: list[list[str]] = parse_csv(text)
        headers: list[str] = []
        data_rows: list[list[str]] = []
        for i, v in enumerate(all_rows):
            if i == 0:
                for h in v:
                    headers.append(h)
            else:
                copy_r: list[str] = []
                for cell in v:
                    copy_r.append(cell)
                data_rows.append(copy_r)
        self._headers = headers
        self._rows = data_rows
        self._pos = 0

    def fieldnames(self) -> list[str]:
        result: list[str] = []
        for h in self._headers:
            result.append(h)
        return result

    def rows(self) -> list[dict[str, str]]:
        result: list[dict[str, str]] = []
        for row in self._rows:
            d: dict[str, str] = {}
            for i, key in enumerate(self._headers):
                for j, val in enumerate(row):
                    if i == j:
                        d[key + ""] = val + ""
            result.append(d)
        return result


class DictWriter:
    # CSV writer that writes rows from dict[str, str].
    _headers: list[str]
    _rows: list[list[str]]

    def __init__(self, fieldnames: list[str]) -> None:
        copy_fn: list[str] = []
        for h in fieldnames:
            copy_fn.append(h)
        self._headers = copy_fn
        self._rows = []

    def writeheader(self) -> None:
        new_rows: list[list[str]] = []
        for existing in self._rows:
            copy_e: list[str] = []
            for v in existing:
                copy_e.append(v)
            new_rows.append(copy_e)
        copy: list[str] = []
        for h in self._headers:
            copy.append(h)
        new_rows.append(copy)
        self._rows = new_rows

    def writerow(self, row: dict[str, str]) -> None:
        new_rows: list[list[str]] = []
        for existing in self._rows:
            copy_e: list[str] = []
            for v in existing:
                copy_e.append(v)
            new_rows.append(copy_e)
        data: list[str] = []
        for key in self._headers:
            val: str | None = row[key + ""]
            if val is not None:
                data.append(val + "")
            else:
                data.append("")
        new_rows.append(data)
        self._rows = new_rows

    def getvalue(self) -> str:
        return format_csv(self._rows)


def reader_from_handle(fh: FileHandle) -> Result[reader, IOError]:
    try:
        text: str = fh.read()
        return reader(text)
    except IOError as e:
        raise IOError(e.message)


def writer_to_handle(fh: FileHandle, rows: list[list[str]]) -> Result[None, IOError]:
    try:
        content: str = format_csv(rows)
        _: None = fh.write(content)
        return None
    except IOError as e:
        raise IOError(e.message)


def reader_from_file(handle: int) -> Result[reader, IOError]:
    try:
        text: str = file_read(handle)
        return reader(text)
    except IOError as e:
        raise IOError(e.message)


def writer_to_file(handle: int, rows: list[list[str]]) -> Result[None, IOError]:
    try:
        content: str = format_csv(rows)
        _: None = file_write(handle, content)
    except IOError as e:
        raise IOError(e.message)


def reader_from_path(path: str) -> Result[reader, IOError]:
    # Create a csv.reader by reading a file at the given path.
    try:
        handle: int = open_file(path, "r")
        text: str = file_read(handle)
        file_close(handle)
        return reader(text)
    except IOError as e:
        raise IOError(e.message)


def writer_to_path(path: str, rows: list[list[str]]) -> Result[None, IOError]:
    # Write CSV rows to a file at the given path.
    try:
        handle: int = open_file(path, "w")
        content: str = format_csv(rows)
        _: None = file_write(handle, content)
        file_close(handle)
        return None
    except IOError as e:
        raise IOError(e.message)
