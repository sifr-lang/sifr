# sifr.timeit — Execution timing (matches CPython's timeit module)
from typing import Callable
from _sifr.time import perf_counter

def default_timer() -> float:
    return perf_counter()

def _elapsed_non_negative(start: float, end: float) -> float:
    elapsed: float = end - start
    if elapsed < 0.0:
        return 0.0
    return elapsed

def timeit(stmt: Callable[[], None], number: int) -> float:
    start: float = perf_counter()
    i: int = 0
    while i < number:
        stmt()
        i = i + 1
    end: float = perf_counter()
    return _elapsed_non_negative(start, end)

def repeat(stmt: Callable[[], None], count: int, number: int) -> list[float]:
    results: list[float] = []
    r: int = 0
    while r < count:
        start: float = perf_counter()
        i: int = 0
        while i < number:
            stmt()
            i = i + 1
        end: float = perf_counter()
        elapsed: float = _elapsed_non_negative(start, end)
        results.append(elapsed)
        r = r + 1
    return results


class Timer:
    def __init__(self) -> None:
        pass

    def timeit(self, stmt: Callable[[], None], number: int = 1000000) -> float:
        return timeit(stmt, number)

    def repeat(self, stmt: Callable[[], None], count: int = 5, number: int = 1000000) -> list[float]:
        return repeat(stmt, count, number)

    def __call__(self, stmt: Callable[[], None], number: int = 1000000) -> float:
        return self.timeit(stmt, number)
