# sifr.timeit — Execution timing (matches CPython's timeit module)
from typing import Callable
from _sifr.time import perf_counter

def default_timer() -> float:
    return perf_counter()

def timeit(stmt: Callable[[], None], number: int) -> float:
    start: float = perf_counter()
    i: int = 0
    while i < number:
        stmt()
        i = i + 1
    return perf_counter() - start

def repeat(stmt: Callable[[], None], count: int, number: int) -> list[float]:
    results: list[float] = []
    r: int = 0
    while r < count:
        start: float = perf_counter()
        i: int = 0
        while i < number:
            stmt()
            i = i + 1
        elapsed: float = perf_counter() - start
        results.append(elapsed)
        r = r + 1
    return results
