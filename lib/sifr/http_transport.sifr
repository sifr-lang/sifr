# sifr.http_transport - internal HTTP transport harness surface
from _sifr.http import (
    http1_client_roundtrip_tcp,
    http1_client_roundtrip_tls,
    http1_server_respond_tcp,
    http1_server_respond_tls,
    http2_client_roundtrip_tcp,
    http2_client_roundtrip_tls,
    http2_server_respond_tcp,
    http2_server_respond_tls,
)
from sifr.http import HttpError


def transport_http1_client_roundtrip_tcp(
    handle: int,
    method: str,
    path: str,
    headers: list[tuple[str, str]],
    body: bytes,
    max_request_bytes: int,
    max_response_bytes: int,
) -> Awaitable[Result[tuple[int, str, list[tuple[str, str]], bytes], HttpError]]:
    return http1_client_roundtrip_tcp(handle, method, path, headers, body, max_request_bytes, max_response_bytes)


