# sifr.signal - Structured signal identifiers and shutdown surfaces
from _sifr.signal import signal_ctrl_c, signal_shutdown, signal_terminate


class SignalError(Error):
    message: str


class Signal:
    name: str
    number: int

    def __init__(self, name: str, number: int):
        self.name = name
        self.number = number

    def __str__(self) -> str:
        return self.name


def sigint() -> Signal:
    return Signal("SIGINT", 2)


def sigterm() -> Signal:
    return Signal("SIGTERM", 15)


def strsignal(signal: Signal) -> str:
    return str(signal)


SIGINT: Signal = Signal("SIGINT", 2)
SIGTERM: Signal = Signal("SIGTERM", 15)


def ctrl_c() -> Awaitable[Result[Signal, SignalError]]:
    return signal_ctrl_c()


def terminate() -> Awaitable[Result[Signal, SignalError]]:
    return signal_terminate()


class ShutdownStream:
    def next(self) -> Awaitable[Result[Signal, SignalError]]:
        return signal_shutdown()


def shutdown_stream() -> ShutdownStream:
    return ShutdownStream()
