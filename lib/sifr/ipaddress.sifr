# sifr.ipaddress — IP address manipulation (pure Sifr)


class AddressValueError(Error):
    message: str

    def __init__(self, message: str) -> None:
        self.message = message + ""

def is_valid_ipv4(addr: str) -> bool:
    parts: list[str] = addr.split(".")
    if len(parts) != 4:
        return False
    for part in parts:
        if len(part) == 0:
            return False
        if len(part) > 3:
            return False
        if len(part) > 1:
            first_digit: str | None = part[0]
            if first_digit is not None and first_digit == "0":
                return False
        val: int = _parse_int(part)
        if val < 0:
            return False
        if val > 255:
            return False
    return True

def _parse_int(s: str) -> int:
    result: int = 0
    i: int = 0
    while i < len(s):
        ch: str | None = s[i]
        if ch is not None:
            if ch == "0":
                result = result * 10
            elif ch == "1":
                result = result * 10 + 1
            elif ch == "2":
                result = result * 10 + 2
            elif ch == "3":
                result = result * 10 + 3
            elif ch == "4":
                result = result * 10 + 4
            elif ch == "5":
                result = result * 10 + 5
            elif ch == "6":
                result = result * 10 + 6
            elif ch == "7":
                result = result * 10 + 7
            elif ch == "8":
                result = result * 10 + 8
            elif ch == "9":
                result = result * 10 + 9
            else:
                return -1
        i = i + 1
    return result

def _ip_to_int_raw(addr: str) -> int:
    parts: list[str] = addr.split(".")
    result: int = 0
    for part in parts:
        val: int = _parse_int(part)
        result = result * 256 + val
    return result

def ip_to_int(addr: str) -> Result[int, ValueError]:
    if not is_valid_ipv4(addr):
        raise ValueError("invalid IPv4 address")
    return _ip_to_int_raw(addr)

def is_private(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    val: int = _ip_to_int_raw(addr)
    # 10.0.0.0/8
    if val >= 167772160:
        if val <= 184549375:
            return True
    # 172.16.0.0/12
    if val >= 2886729728:
        if val <= 2887778303:
            return True
    # 192.168.0.0/16
    if val >= 3232235520:
        if val <= 3232301055:
            return True
    return False

def is_loopback(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    parts: list[str] = addr.split(".")
    if len(parts) == 4:
        first: str | None = parts[0]
        if first is not None:
            if first == "127":
                return True
    return False

def int_to_ip(val: int) -> str:
    if val < 0 or val > 4294967295:
        return "0.0.0.0"
    a: int = val // 16777216
    rem: int = val % 16777216
    b: int = rem // 65536
    rem = rem % 65536
    c: int = rem // 256
    d: int = rem % 256
    return str(a) + "." + str(b) + "." + str(c) + "." + str(d)

def is_multicast(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    parts: list[str] = addr.split(".")
    if len(parts) == 4:
        first: str | None = parts[0]
        if first is not None:
            val: int = _parse_int(first)
            if val >= 224:
                if val <= 239:
                    return True
    return False

def is_global(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    if is_private(addr):
        return False
    if is_loopback(addr):
        return False
    if is_multicast(addr):
        return False
    parts: list[str] = addr.split(".")
    if len(parts) == 4:
        first: str | None = parts[0]
        if first is not None:
            if first == "0":
                return False
            if first == "255":
                return False
    return True


class IPv4Address:
    _text: str
    _value: int

    def __init__(self, addr: str) -> None:
        normalized_text: str = addr + ""
        normalized_value: int = -1
        if is_valid_ipv4(addr):
            parsed: int = _ip_to_int_raw(addr)
            normalized_value = parsed
            normalized_text = int_to_ip(parsed)
        self._value = normalized_value
        self._text = normalized_text

    def to_str(self) -> str:
        return self._text + ""

    def packed_int(self) -> int:
        return self._value

    def version(self) -> int:
        return 4

    def is_private(self) -> bool:
        return is_private(self._text)

    def is_loopback(self) -> bool:
        return is_loopback(self._text)

    def is_multicast(self) -> bool:
        return is_multicast(self._text)

    def is_global(self) -> bool:
        return is_global(self._text)


def ip_address(addr: str) -> Result[IPv4Address, AddressValueError]:
    if not is_valid_ipv4(addr):
        raise AddressValueError("invalid IPv4 address")
    return IPv4Address(addr)


def ipv4_address(addr: str) -> Result[IPv4Address, AddressValueError]:
    return ip_address(addr)
