# sifr.heapq — Heap queue algorithm (pure Sifr, generic)
# Implements a min-heap.
#
# In-place API (borrow-by-default with `mut`):
#   heapify(mut data)   -- convert list to a min-heap in-place
#   heappush(mut heap, item) -- push item onto heap in-place
#   heappop(mut heap) -> item | None -- pop smallest item, heapify in-place
#
# Functional API (for backward compatibility):
#   heapify_copy(data) -> list   -- returns a new heap (copy)
#   heappush_copy(heap, item) -> list
#   heappop_val(heap) -> item | None   -- returns only the popped value
T = TypeVar("T")

# ── Internal helpers ──────────────────────────────────────────────────────────

def _sift_down(mut data: list[T], pos: int, n: int) -> None:
    done: bool = False
    while not done:
        smallest: int = pos
        left: int = 2 * pos + 1
        right: int = 2 * pos + 2
        if left < n:
            s_val: T | None = data[smallest]
            l_val: T | None = data[left]
            if s_val is not None:
                if l_val is not None:
                    if l_val < s_val:
                        smallest = left
        if right < n:
            s_val2: T | None = data[smallest]
            r_val: T | None = data[right]
            if s_val2 is not None:
                if r_val is not None:
                    if r_val < s_val2:
                        smallest = right
        if smallest == pos:
            done = True
        else:
            tmp_pos: T | None = data[pos]
            tmp_sm: T | None = data[smallest]
            if tmp_pos is not None:
                if tmp_sm is not None:
                    data[pos] = tmp_sm
                    data[smallest] = tmp_pos
            pos = smallest

def _sift_up(mut heap: list[T], pos: int) -> None:
    done: bool = False
    while not done:
        if pos <= 0:
            done = True
        else:
            parent: int = (pos - 1) // 2
            p_val: T | None = heap[parent]
            c_val: T | None = heap[pos]
            if p_val is not None:
                if c_val is not None:
                    if c_val < p_val:
                        heap[parent] = c_val
                        heap[pos] = p_val
                        pos = parent
                    else:
                        done = True
                else:
                    done = True
            else:
                done = True

# ── In-place API (mut parameters) ────────────────────────────────────────────

def heapify(mut data: list[T]) -> None:
    """Convert list to a min-heap in-place. O(n) time."""
    n: int = len(data)
    i: int = n // 2 - 1
    while i >= 0:
        _sift_down(data, i, n)
        i = i - 1

def heappush(mut heap: list[T], item: T) -> None:
    """Push item onto the heap in-place. O(log n) time."""
    heap.append(item)
    pos: int = len(heap) - 1
    _sift_up(heap, pos)

def heappop(mut heap: list[T]) -> T | None:
    """Pop and return the smallest item. Heap is modified in-place. O(log n) time.
    Returns None if the heap is empty."""
    n: int = len(heap)
    if n == 0:
        return None
    top: T | None = heap[0]
    last: T | None = heap[n - 1]
    heap.pop()
    n2: int = len(heap)
    if n2 > 0:
        if last is not None:
            heap[0] = last
        _sift_down(heap, 0, n2)
    return top

# ── Functional API (backward compatibility) ───────────────────────────────────

def _swap(data: list[T], i: int, j: int) -> list[T]:
    result: list[T] = []
    k: int = 0
    while k < len(data):
        if k == i:
            val_j: T | None = data[j]
            if val_j is not None:
                result.append(val_j)
        elif k == j:
            val_i: T | None = data[i]
            if val_i is not None:
                result.append(val_i)
        else:
            val: T | None = data[k]
            if val is not None:
                result.append(val)
        k = k + 1
    return result

def heapify_copy(data: list[T]) -> list[T]:
    result: list[T] = []
    for val in data:
        result.append(val)
    heapify(result)
    return result

def heappush_copy(heap: list[T], item: T) -> list[T]:
    result: list[T] = []
    for val in heap:
        result.append(val)
    heappush(result, item)
    return result

def heappop_val(heap: list[T]) -> T | None:
    """Return the smallest item without modifying the original heap.
    Creates a temporary copy."""
    if len(heap) == 0:
        return None
    tmp: list[T] = []
    for val in heap:
        tmp.append(val)
    return heappop(tmp)

def heappop_rest(heap: list[T]) -> list[T]:
    result: list[T] = []
    for val in heap:
        result.append(val)
    heappop(result)
    return result

def heapreplace(heap: list[T], item: T) -> T | None:
    if len(heap) == 0:
        return None
    top: T | None = heap[0]
    rest: list[T] = heappop_rest(heap)
    rest = heappush_copy(rest, item)
    return top

def heappushpop(heap: list[T], item: T) -> T | None:
    # Push item then pop smallest. Equivalent to heappush + heappop but more efficient.
    pushed: list[T] = heappush_copy(heap, item)
    val: T | None = heappop(pushed)
    return val

def nsmallest(n: int, data: list[T]) -> list[T]:
    heap: list[T] = heapify_copy(data)
    result: list[T] = []
    count: int = 0
    while count < n:
        if len(heap) == 0:
            return result
        val: T | None = heappop(heap)
        if val is not None:
            result.append(val)
        count = count + 1
    return result

def nlargest(n: int, data: list[T]) -> list[T]:
    # Uses a selection approach: find n largest by repeated scanning.
    if n <= 0:
        return []
    if n >= len(data):
        result: list[T] = []
        for val in data:
            result.append(val)
        return result
    # Collect all into a heap, then pop all and take last n
    heap: list[T] = heapify_copy(data)
    all_sorted: list[T] = []
    while len(heap) > 0:
        val2: T | None = heappop(heap)
        if val2 is not None:
            all_sorted.append(val2)
    # Take last n elements (largest) in descending order
    result2: list[T] = []
    i: int = len(all_sorted) - 1
    count: int = 0
    while count < n:
        if i < 0:
            return result2
        v: T | None = all_sorted[i]
        if v is not None:
            result2.append(v)
        i = i - 1
        count = count + 1
    return result2
