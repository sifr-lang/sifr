# sifr.itertools — Iterator building blocks (pure Sifr)
# Note: Higher-order functions (map, filter, groupby) require callable support.
# This module provides functions that work with the current type system.
#
# Functions that can use lazy generators (yield) do so. Functions that require
# list indexing (which returns Option<T>) or for-loop iteration remain eager
# because the generator codegen doesn't yet handle Option unwrapping in yield
# expressions or for-loop-based generators.

def chain(a: list[int], b: list[int]) -> list[int]:
    # Eager: uses for-loop iteration (generator codegen requires while+yield)
    result: list[int] = []
    for val in a:
        result.append(val)
    for val2 in b:
        result.append(val2)
    return result

def chain_str(a: list[str], b: list[str]) -> list[str]:
    # Eager: uses for-loop iteration
    result: list[str] = []
    for val in a:
        result.append(val)
    for val2 in b:
        result.append(val2)
    return result

def repeat_val(value: int, times: int) -> list[int]:
    # Lazy generator: simple while+yield pattern
    i: int = 0
    while i < times:
        yield value
        i = i + 1

def take(n: int, data: list[int]) -> list[int]:
    # Eager: list indexing returns Option<T>, incompatible with yield
    result: list[int] = []
    i: int = 0
    while i < n:
        if i >= len(data):
            return result
        val: int | None = data[i]
        if val is not None:
            result.append(val)
        i = i + 1
    return result

def flatten(lists: list[list[int]]) -> list[int]:
    # Eager: nested for-loop iteration
    result: list[int] = []
    for inner in lists:
        for val in inner:
            result.append(val)
    return result

def enumerate_list(data: list[str]) -> list[int]:
    # Eager: references borrowed parameter inside loop condition,
    # which conflicts with move closure in generator codegen
    result: list[int] = []
    i: int = 0
    while i < len(data):
        result.append(i)
        i = i + 1
    return result

def pairwise(data: list[int]) -> list[list[int]]:
    # Eager: list indexing returns Option<T>, incompatible with yield
    result: list[list[int]] = []
    i: int = 0
    while i < len(data) - 1:
        pair: list[int] = []
        a: int | None = data[i]
        b: int | None = data[i + 1]
        if a is not None:
            pair.append(a)
        if b is not None:
            pair.append(b)
        result.append(pair)
        i = i + 1
    return result

def batched(data: list[int], n: int) -> Result[list[list[int]], ValueError]:
    if n <= 0:
        raise ValueError("batched: n must be > 0")
    # Eager: nested while loop + list indexing
    result: list[list[int]] = []
    i: int = 0
    while i < len(data):
        batch: list[int] = []
        j: int = 0
        while j < n:
            if i + j < len(data):
                val: int | None = data[i + j]
                if val is not None:
                    batch.append(val)
            j = j + 1
        result.append(batch)
        i = i + n
    return result

def islice(data: list[int], stop: int) -> list[int]:
    # Eager: list indexing returns Option<T>, incompatible with yield
    result: list[int] = []
    i: int = 0
    while i < stop:
        if i >= len(data):
            return result
        val: int | None = data[i]
        if val is not None:
            result.append(val)
        i = i + 1
    return result
