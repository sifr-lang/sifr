from typing import Callable

A = TypeVar("A")
B = TypeVar("B")
R = TypeVar("R")
T = TypeVar("T")


def _prepend[T](own head: T, tails: list[list[T]]) -> list[list[T]]:
    result: list[list[T]] = []
    head_holder: list[T] = [head]
    for tail in tails:
        current: T | None = head_holder[0]
        if current is not None:
            item: list[T] = [current]
            for value in tail:
                item.append(value)
            result.append(item)
    return result


def _product_impl[T](pools: list[list[T]], index: int) -> list[list[T]]:
    if index >= len(pools):
        return [[]]

    suffixes: list[list[T]] = _product_impl(pools, index + 1)
    result: list[list[T]] = []
    current_pool: list[T] | None = pools[index]
    if current_pool is None:
        return result

    i: int = 0
    while i < len(current_pool):
        j: int = 0
        while j < len(suffixes):
            value: T | None = current_pool[i]
            suffix: list[T] | None = suffixes[j]
            if value is not None:
                if suffix is not None:
                    entry: list[T] = [value]
                    for suffix_value in suffix:
                        entry.append(suffix_value)
                    result.append(entry)
            j = j + 1
        i = i + 1
    return result


def _permutations_impl[T](data: list[T], target: int) -> list[list[T]]:
    if target == 0:
        return [[]]

    result: list[list[T]] = []
    i: int = 0
    while i < len(data):
        current: T | None = data[i]
        if current is not None:
            rest: list[T] = []
            j: int = 0
            while j < len(data):
                if j != i:
                    item: T | None = data[j]
                    if item is not None:
                        rest.append(item)
                j = j + 1
            tails: list[list[T]] = _permutations_impl(rest, target - 1)
            for entry in _prepend(current, tails):
                result.append(entry)
        i = i + 1
    return result


def _combinations_impl[T](data: list[T], start: int, r: int) -> list[list[T]]:
    if r == 0:
        return [[]]

    result: list[list[T]] = []
    i: int = start
    while i <= len(data) - r:
        current: T | None = data[i]
        if current is not None:
            tails: list[list[T]] = _combinations_impl(data, i + 1, r - 1)
            for entry in _prepend(current, tails):
                result.append(entry)
        i = i + 1
    return result


def _combinations_with_replacement_impl[T](data: list[T], start: int, r: int) -> list[list[T]]:
    if r == 0:
        return [[]]

    result: list[list[T]] = []
    i: int = start
    while i < len(data):
        current: T | None = data[i]
        if current is not None:
            tails: list[list[T]] = _combinations_with_replacement_impl(data, i, r - 1)
            for entry in _prepend(current, tails):
                result.append(entry)
        i = i + 1
    return result


def _compress_impl[T](data: list[T], selectors: list[bool]) -> list[T]:
    result: list[T] = []
    i: int = 0
    while i < len(data):
        if i >= len(selectors):
            i = len(data)
        else:
            sel: bool | None = selectors[i]
            val: T | None = data[i]
            if sel is not None:
                if val is not None:
                    if sel:
                        result.append(val)
            i = i + 1
    return result


def _takewhile_impl[T](pred: Callable[[T], bool], data: list[T]) -> list[T]:
    result: list[T] = []
    i: int = 0
    while i < len(data):
        val: T | None = data[i]
        if val is not None:
            if pred(val):
                result.append(val)
            else:
                i = len(data)
        i = i + 1
    return result


def _zip_longest_impl[T](a: list[T], b: list[T], fill: T) -> list[list[T]]:
    result: list[list[T]] = []
    len_a: int = len(a)
    len_b: int = len(b)
    max_len: int = len_a
    if len_b > max_len:
        max_len = len_b
    i: int = 0
    while i < max_len:
        pair: list[T] = []
        if i < len_a:
            va: T | None = a[i]
            if va is not None:
                pair.append(va)
            else:
                pair.append(fill)
        else:
            pair.append(fill)
        if i < len_b:
            vb: T | None = b[i]
            if vb is not None:
                pair.append(vb)
            else:
                pair.append(fill)
        else:
            pair.append(fill)
        result.append(pair)
        i = i + 1
    return result


def chain[T](*iterables: list[T]) -> Iterator[T]:
    iterables_owned: list[list[T]] = []
    for iterable in iterables:
        iterables_owned.append(iterable)
    outer_index: int = 0
    inner_index: int = 0
    while outer_index < len(iterables_owned):
        if inner_index < len(iterables_owned[outer_index]):
            yield iterables_owned[outer_index][inner_index]
            inner_index = inner_index + 1
        else:
            outer_index = outer_index + 1
            inner_index = 0


def repeat(own value: T, times: int) -> Iterator[T]:
    holder: list[T] = [value]
    i: int = 0
    while i < times:
        if len(holder) > 0:
            yield holder[0]
        i = i + 1


def take(n: int, data: list[T]) -> list[T]:
    result: list[T] = []
    i: int = 0
    while i < n:
        if i >= len(data):
            return result
        val: T | None = data[i]
        if val is not None:
            result.append(val)
        i = i + 1
    return result


def flatten(lists: list[list[T]]) -> list[T]:
    result: list[T] = []
    for inner in lists:
        for val in inner:
            result.append(val)
    return result


def pairwise(data: list[T]) -> list[list[T]]:
    result: list[list[T]] = []
    i: int = 0
    while i < len(data) - 1:
        pair: list[T] = []
        a: T | None = data[i]
        b: T | None = data[i + 1]
        if a is not None:
            pair.append(a)
        if b is not None:
            pair.append(b)
        result.append(pair)
        i = i + 1
    return result


def batched(data: list[T], n: int) -> Result[list[list[T]], ValueError]:
    if n <= 0:
        raise ValueError("batched: n must be > 0")
    result: list[list[T]] = []
    i: int = 0
    while i < len(data):
        batch: list[T] = []
        j: int = 0
        while j < n:
            if i + j < len(data):
                val: T | None = data[i + j]
                if val is not None:
                    batch.append(val)
            j = j + 1
        result.append(batch)
        i = i + n
    return result


def islice(data: list[T], start_or_stop: int, stop: int | None = None, step: int = 1) -> Iterator[T]:
    data_owned: list[T] = []
    for item in data:
        data_owned.append(item)
    actual_start: int = 0
    actual_stop: int = start_or_stop
    if stop is not None:
        actual_start = start_or_stop
        actual_stop = stop
    if actual_start < 0:
        actual_start = 0
    if actual_stop < 0:
        actual_stop = 0

    stride: int = step
    if stride <= 0:
        stride = 1
        actual_stop = actual_start

    index: int = actual_start
    while index < actual_stop:
        if index < len(data_owned):
            yield data_owned[index]
        else:
            index = actual_stop
        index = index + stride


def count(start: int = 0, step: int = 1) -> Iterator[int]:
    current: int = start
    while True:
        yield current
        current = current + step


def product[T](*iterables: list[T], repeat: int = 1) -> Iterator[list[T]]:
    result: list[list[T]] = []
    if repeat >= 0:
        pools: list[list[T]] = []
        i: int = 0
        while i < repeat:
            for iterable in iterables:
                pools.append(iterable)
            i = i + 1
        if len(pools) == 0:
            result = [[]]
        else:
            result = _product_impl(pools, 0)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def permutations(data: list[T], r: int | None = None) -> Iterator[list[T]]:
    result: list[list[T]] = []
    target: int = len(data)
    if r is not None:
        target = r
    if target >= 0 and target <= len(data):
        if target == 0:
            result = [[]]
        else:
            result = _permutations_impl(data, target)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def combinations(data: list[T], r: int) -> Iterator[list[T]]:
    result: list[list[T]] = []
    if r >= 0 and r <= len(data):
        if r == 0:
            result = [[]]
        else:
            result = _combinations_impl(data, 0, r)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def combinations_with_replacement(data: list[T], r: int) -> Iterator[list[T]]:
    result: list[list[T]] = []
    if r >= 0:
        if r == 0:
            result = [[]]
        elif len(data) > 0:
            result = _combinations_with_replacement_impl(data, 0, r)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def starmap(func: Callable[[A, B], R], pairs: list[tuple[A, B]]) -> Iterator[R]:
    result: list[R] = []
    for first, second in pairs:
        result.append(func(first, second))
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def accumulate[T: Addable](data: list[T], initial: T | None = None) -> Iterator[T]:
    result: list[T] = []
    if initial is not None:
        result.append(initial)
    for item in data:
        if len(result) == 0:
            result.append(item)
        else:
            prev: T | None = result[len(result) - 1]
            if prev is not None:
                next_val: T = prev + item
                result.append(next_val)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def compress(data: list[T], selectors: list[bool]) -> Iterator[T]:
    result: list[T] = _compress_impl(data, selectors)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def dropwhile(pred: Callable[[T], bool], data: list[T]) -> Iterator[T]:
    result: list[T] = []
    dropping: bool = True
    for val in data:
        if dropping:
            if not pred(val):
                dropping = False
                result.append(val)
        else:
            result.append(val)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def takewhile(pred: Callable[[T], bool], data: list[T]) -> Iterator[T]:
    result: list[T] = _takewhile_impl(pred, data)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def filterfalse(pred: Callable[[T], bool], data: list[T]) -> Iterator[T]:
    result: list[T] = []
    for val in data:
        if not pred(val):
            result.append(val)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def zip_longest(a: list[T], b: list[T], fill: T) -> Iterator[list[T]]:
    result: list[list[T]] = _zip_longest_impl(a, b, fill)
    i: int = 0
    while i < len(result):
        yield result[i]
        i = i + 1


def count_from(start: int, step: int, n: int) -> Iterator[int]:
    i: int = 0
    current: int = start
    while i < n:
        yield current
        current = current + step
        i = i + 1


def cycle(data: list[T], n: int) -> Iterator[T]:
    result: list[T] = []
    if len(data) > 0:
        i: int = 0
        while i < n:
            idx: int = i % len(data)
            val: T | None = data[idx]
            if val is not None:
                result.append(val)
            i = i + 1
    j: int = 0
    while j < len(result):
        yield result[j]
        j = j + 1
