from typing import Callable

A = TypeVar("A")
B = TypeVar("B")
R = TypeVar("R")
T = TypeVar("T")


def _prepend[T](own head: T, tails: list[list[T]]) -> list[list[T]]:
    result: list[list[T]] = []
    head_holder: list[T] = [head]
    for tail in tails:
        current: T | None = head_holder[0]
        if current is not None:
            item: list[T] = [current]
            for value in tail:
                item.append(value)
            result.append(item)
    return result


def _product_impl[T](pools: list[list[T]], index: int) -> list[list[T]]:
    if index >= len(pools):
        return [[]]

    suffixes: list[list[T]] = _product_impl(pools, index + 1)
    result: list[list[T]] = []
    current_pool: list[T] | None = pools[index]
    if current_pool is None:
        return result

    i: int = 0
    while i < len(current_pool):
        j: int = 0
        while j < len(suffixes):
            value: T | None = current_pool[i]
            suffix: list[T] | None = suffixes[j]
            if value is not None:
                if suffix is not None:
                    entry: list[T] = [value]
                    for suffix_value in suffix:
                        entry.append(suffix_value)
                    result.append(entry)
            j = j + 1
        i = i + 1
    return result


def chain[T](*iterables: list[T]) -> list[T]:
    result: list[T] = []
    for iterable in iterables:
        for value in iterable:
            result.append(value)
    return result


def repeat(value: T, times: int) -> list[T]:
    result: list[T] = []
    i: int = 0
    while i < times:
        result.append(value)
        i = i + 1
    return result


def take(n: int, data: list[T]) -> list[T]:
    result: list[T] = []
    i: int = 0
    while i < n:
        if i >= len(data):
            return result
        val: T | None = data[i]
        if val is not None:
            result.append(val)
        i = i + 1
    return result


def flatten(lists: list[list[T]]) -> list[T]:
    result: list[T] = []
    for inner in lists:
        for val in inner:
            result.append(val)
    return result


def pairwise(data: list[T]) -> list[list[T]]:
    result: list[list[T]] = []
    i: int = 0
    while i < len(data) - 1:
        pair: list[T] = []
        a: T | None = data[i]
        b: T | None = data[i + 1]
        if a is not None:
            pair.append(a)
        if b is not None:
            pair.append(b)
        result.append(pair)
        i = i + 1
    return result


def batched(data: list[T], n: int) -> Result[list[list[T]], ValueError]:
    if n <= 0:
        raise ValueError("batched: n must be > 0")
    result: list[list[T]] = []
    i: int = 0
    while i < len(data):
        batch: list[T] = []
        j: int = 0
        while j < n:
            if i + j < len(data):
                val: T | None = data[i + j]
                if val is not None:
                    batch.append(val)
            j = j + 1
        result.append(batch)
        i = i + n
    return result


def islice(data: list[T], start_or_stop: int, stop: int | None = None, step: int = 1) -> list[T]:
    if step <= 0:
        return []

    actual_start: int = 0
    actual_stop: int = start_or_stop
    if stop is not None:
        actual_start = start_or_stop
        actual_stop = stop
    if actual_start < 0:
        actual_start = 0
    if actual_stop < 0:
        actual_stop = 0

    result: list[T] = []
    i: int = actual_start
    while i < actual_stop:
        if i >= len(data):
            return result
        val: T | None = data[i]
        if val is not None:
            result.append(val)
        i = i + step
    return result


def product[T](*iterables: list[T], repeat: int = 1) -> list[list[T]]:
    if repeat < 0:
        return []

    pools: list[list[T]] = []
    i: int = 0
    while i < repeat:
        for iterable in iterables:
            pools.append(iterable)
        i = i + 1
    if len(pools) == 0:
        return [[]]
    return _product_impl(pools, 0)


def permutations(data: list[T], r: int | None = None) -> list[list[T]]:
    target: int = len(data)
    if r is not None:
        target = r
    if target < 0 or target > len(data):
        return []
    if target == 0:
        return [[]]

    result: list[list[T]] = []
    i: int = 0
    while i < len(data):
        current: T | None = data[i]
        if current is not None:
            rest: list[T] = chain(data[:i], data[i + 1:])
            tails: list[list[T]] = permutations(rest, target - 1)
            for entry in _prepend(current, tails):
                result.append(entry)
        i = i + 1
    return result


def combinations(data: list[T], r: int) -> list[list[T]]:
    if r < 0 or r > len(data):
        return []
    if r == 0:
        return [[]]

    result: list[list[T]] = []
    i: int = 0
    while i <= len(data) - r:
        current: T | None = data[i]
        if current is not None:
            tails: list[list[T]] = combinations(data[i + 1:], r - 1)
            for entry in _prepend(current, tails):
                result.append(entry)
        i = i + 1
    return result


def combinations_with_replacement(data: list[T], r: int) -> list[list[T]]:
    if r < 0:
        return []
    if r == 0:
        return [[]]
    if len(data) == 0:
        return []

    result: list[list[T]] = []
    i: int = 0
    while i < len(data):
        current: T | None = data[i]
        if current is not None:
            tails: list[list[T]] = combinations_with_replacement(data[i:], r - 1)
            for entry in _prepend(current, tails):
                result.append(entry)
        i = i + 1
    return result


def starmap(func: Callable[[A, B], R], pairs: list[tuple[A, B]]) -> list[R]:
    result: list[R] = []
    for first, second in pairs:
        result.append(func(first, second))
    return result


def accumulate[T: Addable](data: list[T]) -> list[T]:
    result: list[T] = []
    if len(data) == 0:
        return result
    first: T | None = data[0]
    if first is not None:
        result.append(first)
    i: int = 1
    while i < len(data):
        prev: T | None = result[len(result) - 1]
        cur: T | None = data[i]
        if prev is not None:
            if cur is not None:
                next_val: T = prev + cur
                result.append(next_val)
        i = i + 1
    return result


def compress(data: list[T], selectors: list[bool]) -> list[T]:
    result: list[T] = []
    i: int = 0
    while i < len(data):
        if i >= len(selectors):
            return result
        sel: bool | None = selectors[i]
        val: T | None = data[i]
        if sel is not None:
            if val is not None:
                if sel:
                    result.append(val)
        i = i + 1
    return result


def dropwhile(pred: Callable[[T], bool], data: list[T]) -> list[T]:
    result: list[T] = []
    dropping: bool = True
    for val in data:
        if dropping:
            if not pred(val):
                dropping = False
                result.append(val)
        else:
            result.append(val)
    return result


def takewhile(pred: Callable[[T], bool], data: list[T]) -> list[T]:
    result: list[T] = []
    for val in data:
        if not pred(val):
            return result
        result.append(val)
    return result


def filterfalse(pred: Callable[[T], bool], data: list[T]) -> list[T]:
    result: list[T] = []
    for val in data:
        if not pred(val):
            result.append(val)
    return result


def zip_longest(a: list[T], b: list[T], fill: T) -> list[list[T]]:
    result: list[list[T]] = []
    len_a: int = len(a)
    len_b: int = len(b)
    max_len: int = len_a
    if len_b > max_len:
        max_len = len_b
    i: int = 0
    while i < max_len:
        pair: list[T] = []
        if i < len_a:
            va: T | None = a[i]
            if va is not None:
                pair.append(va)
            else:
                pair.append(fill)
        else:
            pair.append(fill)
        if i < len_b:
            vb: T | None = b[i]
            if vb is not None:
                pair.append(vb)
            else:
                pair.append(fill)
        else:
            pair.append(fill)
        result.append(pair)
        i = i + 1
    return result


def count_from(start: int, step: int, n: int) -> list[int]:
    result: list[int] = []
    i: int = 0
    val: int = start
    while i < n:
        result.append(val)
        val = val + step
        i = i + 1
    return result


def cycle(data: list[T], n: int) -> list[T]:
    result: list[T] = []
    if len(data) == 0:
        return result
    i: int = 0
    while i < n:
        idx: int = i % len(data)
        val: T | None = data[idx]
        if val is not None:
            result.append(val)
        i = i + 1
    return result
