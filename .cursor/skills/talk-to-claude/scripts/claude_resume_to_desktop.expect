set timeout 60
set sid $env(CLAUDE_SESSION_ID)
set command $env(CLAUDE_RESUME_COMMAND)

puts "Starting handoff for session $sid"
flush stdout

spawn claude --resume $sid

expect {
  -re {\? for shortcuts} {}
  timeout {
    puts stderr "Timed out waiting for Claude resume UI"
    exit 1
  }
}

# Slash commands first open a picker, then need Enter again to execute.
after 3000
send -- "$command"
after 1000
send -- "\r"
after 1000
send -- "\r"

expect {
  eof {}
  timeout {
    puts "Handoff command sent; exiting after timeout"
    exit 0
  }
}
