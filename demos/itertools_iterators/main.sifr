from sifr.itertools import chain, repeat, islice, count

# iterator Iterator behavior demo: itertools subset now returns Iterator[T].
# chain, repeat, islice, and count are lazy; list(...) is the eager boundary.

def main():
    chained: Iterator[int] = chain([1, 2], [3])
    print(list(chained))

    repeated: Iterator[int] = repeat(7, 3)
    print(list(repeated))

    try:
        sliced: Iterator[int] = islice(iter([10, 20, 30, 40, 50]), 1, 5, 2)
        print(list(sliced))
    except ValueError as e:
        print("islice error: " + e.message)

    counter: Iterator[int] = count(5, 2)
    print(next(counter))
    print(next(counter))
    print(next(counter))
    print(next(counter))
