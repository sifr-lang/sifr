# Reference: env
# Read-only environment access demo.
from sifr.env import getenv, getenv_opt, keys, values, items
from sifr.test import assert_bool_vector_eq

def main():
    with_default: str = getenv("SIFR_ENV_SAMPLE_MISSING", "fallback")
    print(with_default)
    assert str(with_default) == "fallback"

    without_default: str | None = getenv_opt("SIFR_ENV_SAMPLE_MISSING")
    assert str(without_default is None) == "true"

    invalid_expected_lookup_found: list[bool] = [False, False]
    invalid_actual_lookup_found: list[bool] = []
    invalid_actual_lookup_found.append(getenv_opt("") is not None)
    invalid_actual_lookup_found.append(getenv_opt("A=B") is not None)
    assert_bool_vector_eq(invalid_actual_lookup_found, invalid_expected_lookup_found)

    assert str(len(keys()) == len(values())) == "true"
    assert str(len(keys()) == len(items())) == "true"
    print("env read-only access demo: pass")
