from sifr.io import exists
from sifr.os import remove_file


def main():
    path: str = "/tmp/sifr_bytes_bytes_file_io.bin"
    loaded_ok: bool = False
    ints_ok: bool = False
    cleanup_ok: bool = False

    try:
        writer = open(path, "wb")
        _w: None = writer.write_bytes(b"bytes_file_io")
        writer.close()

        reader = open(path, "rb")
        loaded: bytes = reader.read_bytes()
        reader.close()
        loaded_ok = loaded == b"bytes_file_io"
        ints_ok = str(loaded.to_ints()) == "[98, 121, 116, 101, 115, 95, 102, 105, 108, 101, 95, 105, 111]"
    except IOError as e:
        _ = str(e.message)

    try:
        if exists(path):
            _rm: None = remove_file(path)
        cleanup_ok = not exists(path)
    except IOError as e:
        _ = str(e.message)

    assert loaded_ok
    assert ints_ok
    assert cleanup_ok
