# Reference: os
from sifr.os import run_command, mkdir, listdir, rmdir, getpid, is_dir, is_file, remove_file, stat
from sifr.io import write_text
from sifr.test import assert_bool_vector_eq


def collect_runtime_actual() -> list[bool]:
    actual: list[bool] = []
    shell_ok: bool = False
    try:
        output: str = run_command("echo sifr_os_demo")
        shell_ok = output == "sifr_os_demo"
    except IOError as e:
        _ = str(e.message)
    actual.append(shell_ok)
    return actual


def collect_filesystem_actual() -> list[bool]:
    actual: list[bool] = []
    base: str = "/tmp/sifr_os_os_demo_" + str(getpid())
    file_path: str = base + "/demo.txt"
    os_flow_ok: bool = False
    list_ok: bool = False
    stat_ok: bool = False
    cleanup_ok: bool = False
    try:
        _mk: None = mkdir(base)
        _w: None = write_text(file_path, "demo")
        os_flow_ok = is_dir(base) and is_file(file_path)

        entries: list[str] = listdir(base)
        list_ok = len(entries) >= 1

        size: int = stat(file_path)
        stat_ok = size > 0

        _rm: None = remove_file(file_path)
        _rd: None = rmdir(base)
        cleanup_ok = not is_dir(base)
    except IOError as e:
        _ = str(e.message)

    actual.append(os_flow_ok)
    actual.append(list_ok)
    actual.append(stat_ok)
    actual.append(cleanup_ok)
    return actual


def collect_missing_actual() -> list[bool]:
    actual: list[bool] = []
    missing_rejected: bool = False
    try:
        _bad: None = rmdir("/tmp/sifr_os_os_demo_missing")
    except IOError as e:
        _ = str(e.message)
        missing_rejected = True
    actual.append(missing_rejected)
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_runtime_actual())
    append_all(actual, collect_filesystem_actual())
    append_all(actual, collect_missing_actual())

    assert_bool_vector_eq(actual, expected)
    print("os os parity demo: pass")
