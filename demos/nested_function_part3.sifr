# Reference: ad_hoc_nested_function_part3
# Source issue: ad-hoc-full-nested-function-pipeline-part3-execution.md
# Ad hoc nested functions phase, part 3 demo: typed captures and nonlocal updates.

def accumulate(values: list[int]) -> int:
    total = 0

    def apply() -> None:
        nonlocal total
        for value in values:
            total += value

    apply()
    return total

def main():
    assert str(accumulate([3, 1, 4, 1, 5])) == '14'
