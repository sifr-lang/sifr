# ============================================================
# Feature Demo: Extended Standard Library Demo
# ============================================================
# Demonstrates all extended stdlib modules:
#   sifr.time     — Time operations
#   sifr.random   — Random number generation
#   sifr.re       — Regular expressions
#   sifr.hashlib  — Cryptographic hashing
#   sifr.base64   — Base64 encoding/decoding
# ============================================================

from sifr.time import time, sleep
from sifr.random import randint, random
from sifr.re import search, sub

def has_match(pattern: str, text: str) -> Result[bool, RegexError]:
    try:
        found: str | None = search(pattern, text)
        return found is not None
    except RegexError as error:
        raise RegexError(error.message)
from sifr.hashlib import sha256, md5
from sifr.base64 import b64encode, b64decode

def main():
    # ----------------------------------------------------------
    # 1. sifr.time — Time operations
    # ----------------------------------------------------------
    print("=== sifr.time ===")
    t1: float = time()
    print(f"Current epoch: {t1}")
    sleep(0.01)
    t2: float = time()
    print(f"Time advanced: {t2 > t1}")

    # ----------------------------------------------------------
    # 2. sifr.random — Random numbers
    # ----------------------------------------------------------
    print("=== sifr.random ===")
    try:
        r: int = randint(1, 100)
        print(f"Random int [1,100]: {r}")
    except ValueError as err:
        print(f"Random integer error: {err.message}")
    f: float = random()
    print(f"Random float [0,1): {f}")

    # ----------------------------------------------------------
    # 3. sifr.re — Regular expressions
    # ----------------------------------------------------------
    print("=== sifr.re ===")
    try:
        matched: bool = has_match("[0-9]+", "hello 42")
        print(f"Match digits in 'hello 42': {matched}")
        found: str | None = search("[0-9]+", "price is $42.99")
        if found is not None:
            print(f"Found: {found}")
        replaced: str = sub("[0-9]+", "N", "a1b2c3")
        print(f"Replace: {replaced}")
    except RegexError as err:
        print(f"regex error: {err.message}")

    # ----------------------------------------------------------
    # 4. sifr.hashlib — Cryptographic hashing
    # ----------------------------------------------------------
    print("=== sifr.hashlib ===")
    print(f"SHA-256('sifr'): {sha256(b'sifr').hexdigest()}")
    print(f"MD5('sifr'): {md5(b'sifr').hexdigest()}")

    # ----------------------------------------------------------
    # 5. sifr.base64 — Base64
    # ----------------------------------------------------------
    print("=== sifr.base64 ===")
    encoded: str = b64encode("Hello, Sifr!")
    print(f"Base64 encode: {encoded}")
    try:
        decoded_b64: str = b64decode(encoded)
        print(f"Base64 decode: {decoded_b64}")
    except ParseError as err:
        print(f"base64 error: {err.message}")

    print("=== Demo complete ===")
