# Declare recursive aliases whose cycles pass through collections.

type Payload = Response
type Response = list[int]
type Json = None | bool | int | float | str | list[Json] | dict[str, Json]
type Node = Branch
type Branch = list[Node]

def payload_size(data: Payload) -> int:
    return len(data)

def main():
    print(payload_size([1, 2, 3]))
    print("well-formed recursive aliases accepted")
