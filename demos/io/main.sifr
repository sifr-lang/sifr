# Reference: m30_1e
# Source issue: phase30-reliability-parity-and-performance-budgets-execution.md
from sifr.io import read_text, write_text, exists, append_text, read_lines
from sifr.test import assert_bool_vector_eq


def collect_io_roundtrip_actual() -> list[bool]:
    actual: list[bool] = []
    path: str = "/tmp/sifr_m30_1e_io_demo.txt"
    text_roundtrip_ok: bool = False
    try:
        _w: None = write_text(path, "hello")
        _a: None = append_text(path, "\nworld")
        content: str = read_text(path)
        text_roundtrip_ok = content == "hello\nworld"
    except IOError as e:
        _ = str(e.message)
    actual.append(text_roundtrip_ok)
    actual.append(exists(path))
    return actual


def collect_open_actual() -> list[bool]:
    actual: list[bool] = []
    path: str = "/tmp/sifr_m30_1e_io_demo.txt"
    first_ok: bool = False
    second_ok: bool = False
    eof_ok: bool = False
    missing_rejected: bool = False
    try:
        lines: list[str] = read_lines(path)
        first_ok = len(lines) >= 1 and lines[0] == "hello"
        second_ok = len(lines) >= 2 and lines[1] == "world"
        eof_ok = len(lines) == 2
    except IOError as e:
        _ = str(e.message)

    try:
        _ = open("/tmp/sifr_m30_1e_io_demo_missing.txt", "r", encoding="utf-8")
    except IOError as e:
        _ = str(e.message)
        missing_rejected = True

    actual.append(first_ok)
    actual.append(second_ok)
    actual.append(eof_ok)
    actual.append(missing_rejected)
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_io_roundtrip_actual())
    append_all(actual, collect_open_actual())

    assert_bool_vector_eq(actual, expected)
    print("m30_1e io parity demo: pass")
