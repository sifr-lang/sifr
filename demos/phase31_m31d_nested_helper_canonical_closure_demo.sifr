# Reference: phase31_m31d
# Source issue: phase31-m31d-nested-helper-canonical-closure-execution.md
# Phase 31 m31_d demo: nested-helper canonical closure

# Example 1: typed nested helper with explicit dict-key guard.
def demo_letter_combinations(digits: str) -> list[str]:
    res: list[str] = []
    digit_to_chars: dict[str, list[str]] = {
        "2": ["a", "b", "c"],
        "3": ["d", "e", "f"],
    }

    def backtrack(i: int, cur: str) -> None:
        if i >= len(digits):
            res.append(str(cur))
            return
        d = digits[i]
        if d not in digit_to_chars:
            return
        for ch in digit_to_chars[d]:
            backtrack(i + 1, cur + ch)

    if len(digits) > 0:
        backtrack(0, "")
    return res

# Example 2: recursive helper returns count directly (no nonlocal mutation).
def demo_total_n_queens(n: int) -> int:
    def backtrack(i: int, cols: set[int], posdiag: set[int], negdiag: set[int]) -> int:
        if i == n:
            return 1
        count = 0
        for j in range(n):
            if j in cols or (i + j) in posdiag or (i - j) in negdiag:
                continue
            cols.add(j)
            posdiag.add(i + j)
            negdiag.add(i - j)
            count += backtrack(i + 1, cols, posdiag, negdiag)
            cols.remove(j)
            posdiag.remove(i + j)
            negdiag.remove(i - j)
        return count

    return backtrack(0, set(), set(), set())

# Example 3: top-level helper pipeline for DSU to avoid nested closure borrow issues.
def find_root(n: int, par: list[int]) -> int:
    if n < 0 or n >= len(par):
        return 0
    p = n
    while p >= 0 and p < len(par) and par[p] != p:
        p = par[p]
    return p

def union_nodes(n1: int, n2: int, mut par: list[int], mut rank: list[int]) -> bool:
    p1 = find_root(n1, par)
    p2 = find_root(n2, par)
    if p1 < 0 or p1 >= len(rank) or p2 < 0 or p2 >= len(rank):
        return False
    if p1 == p2:
        return False
    if rank[p1] > rank[p2]:
        par[p2] = p1
        rank[p1] = rank[p1] + rank[p2]
    else:
        par[p1] = p2
        rank[p2] = rank[p2] + rank[p1]
    return True

def demo_redundant_connection(edges: list[tuple[int, int]]) -> list[int]:
    par: list[int] = [i for i in range(len(edges) + 1)]
    rank: list[int] = [1 for _ in range(len(edges) + 1)]
    for n1, n2 in edges:
        if not union_nodes(n1, n2, par, rank):
            return [n1, n2]
    return []

def main():
    assert str(demo_letter_combinations("23")) == '["ad", "ae", "af", "bd", "be", "bf", "cd", "ce", "cf"]'
    assert demo_total_n_queens(4) == 2
    assert demo_redundant_connection([(1, 2), (1, 3), (2, 3)]) == [2, 3]
