# Source issue: 195-enum type-system work.md
# Demo: enum type-system work
# Showcases enum types with variants, values, methods, pattern matching, and dict keys.

from enum import Enum

# --- 1. Simple enum with integer values ---
class Color(Enum):
    RED = 1
    GREEN = 2
    BLUE = 3

# --- 2. Enum with semantic integer values ---
class HttpStatus(Enum):
    OK = 200
    NOT_FOUND = 404
    INTERNAL_ERROR = 500

# --- 3. Enum with methods ---
class Direction(Enum):
    NORTH = 1
    SOUTH = 2
    EAST = 3
    WEST = 4

    def is_vertical(self) -> bool:
        match self:
            case Direction.NORTH | Direction.SOUTH:
                return True
            case _:
                return False

    def opposite(self) -> str:
        match self:
            case Direction.NORTH:
                return "SOUTH"
            case Direction.SOUTH:
                return "NORTH"
            case Direction.EAST:
                return "WEST"
            case _:
                return "EAST"

# --- 4. Pattern matching on enums ---
def describe_color(c: Color) -> str:
    match c:
        case Color.RED:
            return "red"
        case Color.GREEN:
            return "green"
        case Color.BLUE:
            return "blue"
        case _:
            return "unknown"

def handle_status(s: HttpStatus) -> str:
    match s:
        case HttpStatus.OK:
            return "success"
        case HttpStatus.NOT_FOUND:
            return "not found"
        case HttpStatus.INTERNAL_ERROR:
            return "server error"
        case _:
            return "unknown status"

def main():
    # Basic enum usage
    print("=== Basic Enum ===")
    c: Color = Color.RED
    print(c)
    print(c.name())
    print(c.value())

    # Enum comparison
    print("=== Comparison ===")
    print(c == Color.RED)
    print(c == Color.BLUE)

    # Pattern matching
    print("=== Pattern Matching ===")
    print(describe_color(Color.GREEN))
    print(describe_color(Color.BLUE))

    # HTTP status enum
    print("=== HTTP Status ===")
    s: HttpStatus = HttpStatus.NOT_FOUND
    print(s)
    print(s.value())
    print(handle_status(HttpStatus.OK))
    print(handle_status(HttpStatus.INTERNAL_ERROR))

    # Enum methods
    print("=== Enum Methods ===")
    d: Direction = Direction.NORTH
    print(d.is_vertical())
    print(Direction.EAST.is_vertical())
    print(d.opposite())
    print(Direction.EAST.opposite())

    # Enum as dict key
    print("=== Enum as Dict Key ===")
    scores: dict[Color, int] = {}
    scores[Color.RED] = 10
    scores[Color.GREEN] = 20
    scores[Color.BLUE] = 30
    v: int | None = scores[Color.GREEN]
    if v is not None:
        print(v)
