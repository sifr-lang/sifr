# Reference: stdlib_polish
# Source issue: stdlib_polish.md
# stdlib_polish Demo
# Showcases: API alignment, monotonic clocks, timeit with Callable, new intrinsics

from typing import Callable
from sifr.time import perf_counter, monotonic
from sifr.timeit import default_timer, timeit, repeat
from sifr.glob import glob
from sifr.shutil import copy, move_file, rmtree
from sifr.tomllib import TomlValue, loads
from sifr.io import write_text, read_text, exists
from sifr.os import run_command

def do_work():
    total: int = 0
    i: int = 0
    while i < 1000:
        total = total + i
        i = i + 1

def main():
    # ── 1. Monotonic clocks (perf_counter / monotonic) ──
    print("=== Monotonic Clocks ===")
    t1: float = perf_counter()
    t2: float = perf_counter()
    print(t2 >= t1)

    m1: float = monotonic()
    m2: float = monotonic()
    print(m2 >= m1)

    # ── 2. timeit with Callable ──
    print("=== timeit (Callable API) ===")
    dt: float = default_timer()
    print(dt >= 0.0)

    elapsed: float = timeit(do_work, 100)
    print(elapsed >= 0.0)

    results: list[float] = repeat(do_work, 3, 50)
    print(len(results))

    # ── 3. glob (renamed from glob_match) ──
    print("=== glob ===")
    try:
        _r1: str = run_command("mkdir -p /tmp/sifr_polish_demo")
        _w1: None = write_text("/tmp/sifr_polish_demo/a.txt", "aaa")
        _w2: None = write_text("/tmp/sifr_polish_demo/b.txt", "bbb")
        _w3: None = write_text("/tmp/sifr_polish_demo/c.csv", "1,2")
    except IOError as err:
        print(f"setup error: {err.message}")
    matches: list[str] = glob("/tmp/sifr_polish_demo", "*.txt")
    print(len(matches))

    # ── 4. shutil (copy, move_file, rmtree) ──
    print("=== shutil ===")
    try:
        _cp: None = copy("/tmp/sifr_polish_demo/a.txt", "/tmp/sifr_polish_demo/a_copy.txt")
    except IOError as err:
        print(f"copy error: {err.message}")
    print(exists("/tmp/sifr_polish_demo/a_copy.txt"))

    try:
        _mv: None = move_file("/tmp/sifr_polish_demo/a_copy.txt", "/tmp/sifr_polish_demo/a_moved.txt")
    except IOError as err:
        print(f"move error: {err.message}")
    print(exists("/tmp/sifr_polish_demo/a_moved.txt"))
    print(exists("/tmp/sifr_polish_demo/a_copy.txt"))

    try:
        _r2: str = run_command("mkdir -p /tmp/sifr_polish_demo/sub")
        _w4: None = write_text("/tmp/sifr_polish_demo/sub/nested.txt", "nested")
        _rm: None = rmtree("/tmp/sifr_polish_demo/sub")
    except IOError as err:
        print(f"rmtree error: {err.message}")
    print(exists("/tmp/sifr_polish_demo/sub"))

    # ── 5. tomllib.loads ──
    print("=== tomllib ===")
    try:
        inline: TomlValue = loads("key = \"value\"")
        key_value: TomlValue | None = inline.get("key")
        print(key_value is not None)
    except TOMLDecodeError as err:
        print(f"toml loads error: {err.message}")

    # Cleanup
    try:
        _cleanup: str = run_command("rm -rf /tmp/sifr_polish_demo")
    except IOError as err:
        print(f"cleanup error: {err.message}")
    print("=== Done ===")
