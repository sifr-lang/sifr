# Reference: clone_collection_cloning
# Reference: ownership-aware-collection-lowering-and-clone-elision
def double(n: int) -> int:
    return n * 2


def is_even(n: int) -> bool:
    return n % 2 == 0


def main() -> None:
    nums: list[int] = [1, 2, 3, 4]

    mapped: list[int] = list(map(double, nums))
    filtered: list[int] = list(filter(is_even, nums))

    first: int = 0
    rest: list[int] = []
    first, *rest = nums

    print(str(mapped))
    print(str(filtered))
    print(str(first))
    print(str(rest))
    print("clone_collection_cloning_lock_demo: pass")
