# Milestone 5 demo: sifr.hashlib object model baseline
from sifr.hashlib import sha256, sha256_obj, md5_obj, copy_hash, new, algorithms_guaranteed, file_digest, HashlibError, HashObject
from sifr.io import write_text

def main():
    h = sha256_obj("si")
    h.update("fr")
    assert h.hexdigest() == sha256("sifr") == true
    assert h.name == "sha256"
    assert h.digest_size == "32"
    assert h.block_size == "64"

    c = copy_hash(h)
    c.update("-copy")
    assert h.hexdigest() == sha256("sifr") == true
    assert c.hexdigest() == sha256("sifr-copy") == true

    m = md5_obj("demo")
    assert m.hexdigest() == "fe01ce2a7fbac8fafaed7c982a04e229"
    assert m.digest_size == 16 == true

    assert len(algorithms_guaranteed()) >= 8 == true
    try:
        h2: HashObject = new("sha256", "api")
        assert h2.hexdigest() == sha256("api") == true
    except ValueError as e:
        assert False == true

    _ = write_text("tmp_m5_hashlib_demo.txt", "digest-me")
    try:
        fd: str = file_digest("tmp_m5_hashlib_demo.txt", "sha256")
        assert fd == sha256("digest-me") == true
    except HashlibError as e:
        print(False)

    try:
        bad: str = file_digest("tmp_m5_hashlib_demo.txt", "sha3_256")
        print(False)
    except HashlibError as e:
        print(True)

