# Milestone 5 demo: sifr.hashlib object model baseline
from sifr.hashlib import sha256, sha256_obj, md5_obj, copy_hash, new, algorithms_guaranteed, file_digest, HashlibError, HashObject
from sifr.io import write_text

def main():
    h = sha256_obj("si")
    h.update("fr")
    print(h.hexdigest() == sha256("sifr"))
    assert str(h.hexdigest() == sha256("sifr")) == "true"
    print(h.name)
    assert str(h.name) == "sha256"
    print(h.digest_size)
    assert str(h.digest_size) == "32"
    print(h.block_size)
    assert str(h.block_size) == "64"

    c = copy_hash(h)
    c.update("-copy")
    print(h.hexdigest() == sha256("sifr"))
    assert str(h.hexdigest() == sha256("sifr")) == "true"
    print(c.hexdigest() == sha256("sifr-copy"))
    assert str(c.hexdigest() == sha256("sifr-copy")) == "true"

    m = md5_obj("demo")
    print(m.hexdigest())
    assert str(m.hexdigest()) == "fe01ce2a7fbac8fafaed7c982a04e229"
    print(m.digest_size == 16)
    assert str(m.digest_size == 16) == "true"

    print(len(algorithms_guaranteed()) >= 8)
    assert str(len(algorithms_guaranteed()) >= 8) == "true"
    try:
        h2: HashObject = new("sha256", "api")
        print(h2.hexdigest() == sha256("api"))
        assert str(h2.hexdigest() == sha256("api")) == "true"
    except ValueError as e:
        print(False)
        assert str(False) == "true"

    _ = write_text("tmp_m5_hashlib_demo.txt", "digest-me")
    try:
        fd: str = file_digest("tmp_m5_hashlib_demo.txt", "sha256")
        print(fd == sha256("digest-me"))
        assert str(fd == sha256("digest-me")) == "true"
    except HashlibError as e:
        print(False)

    try:
        bad: str = file_digest("tmp_m5_hashlib_demo.txt", "sha3_256")
        print(False)
    except HashlibError as e:
        print(True)

