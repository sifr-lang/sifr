# Milestone 5 demo: sifr.hashlib object model baseline
from sifr.hashlib import sha256, sha256_obj, md5_obj, copy_hash, new, algorithms_guaranteed, file_digest, HashlibError, HashObject
from sifr.io import write_text

def main():
    h = sha256_obj("si")
    h.update("fr")
    print(h.hexdigest() == sha256("sifr"))
    print(h.name)
    print(h.digest_size)
    print(h.block_size)

    c = copy_hash(h)
    c.update("-copy")
    print(h.hexdigest() == sha256("sifr"))
    print(c.hexdigest() == sha256("sifr-copy"))

    m = md5_obj("demo")
    print(m.hexdigest())
    print(m.digest_size == 16)

    print(len(algorithms_guaranteed()) >= 8)
    try:
        h2: HashObject = new("sha256", "api")
        print(h2.hexdigest() == sha256("api"))
    except ValueError as e:
        print(False)

    _ = write_text("tmp_m5_hashlib_demo.txt", "digest-me")
    try:
        fd: str = file_digest("tmp_m5_hashlib_demo.txt", "sha256")
        print(fd == sha256("digest-me"))
    except HashlibError as e:
        print(False)

    try:
        bad: str = file_digest("tmp_m5_hashlib_demo.txt", "sha3_256")
        print(False)
    except HashlibError as e:
        print(True)

# expect-stdout: true
