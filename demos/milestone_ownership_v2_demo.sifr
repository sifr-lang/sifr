# milestone_ownership_v2 Demo
# Values can now be used after printing and passing to builtins

# expect-stdout: hello
# expect-stdout: hello
# expect-stdout: length: 5
# expect-stdout: sum: 15

def main():
    # print() no longer consumes values
    s: str = "hello"
    print(s)
    print(s)

    # len() and other builtins borrow
    nums: list[int] = [1, 2, 3, 4, 5]
    print(f"length: {len(nums)}")
    print(f"sum: {sum(nums)}")
