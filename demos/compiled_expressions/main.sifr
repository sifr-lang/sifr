# Reference: compiled_expressions
# compiled-expressions-sample demo
# Exercises representative lowering paths after lower.rs decomposition.

from sifr.math import floor

def add(a: int, b: int) -> int:
    return a + b

def main():
    total: int = add(10, 11)
    if total > 20:
        print("compiled_expressions lower decomposition demo:")
    print(total)
    print(floor(3.9))
