from sifr.parallel import Pool, PoolConfig, WorkerError, WorkerRuntimeError, map, try_map


class MapError(Error):
    pass


def double(value: int) -> int:
    return value * 2


def stringify(value: int) -> Result[str, MapError]:
    if value < 0:
        raise MapError("negative item")
    return str(value)


def triple(value: int) -> int:
    return value * 3


def main() -> Result[None, Error]:
    # Default pool map preserves input ordering for successful CPU work.
    values: list[int] = [1, 2, 3]
    doubled: Result[list[int], WorkerRuntimeError] = map(values, double)
    assert str(doubled) == "Ok([2, 4, 6])"

    # try_map carries user errors through the typed worker error channel.
    labels: Result[list[str], WorkerError] = try_map([4, 5], stringify)
    assert str(labels) == "Ok([\"4\", \"5\"])"

    # Configured pools use the same ordered result rules.
    pool: Pool = Pool(PoolConfig(2))
    tripled: Result[list[int], WorkerRuntimeError] = pool.map([2, 3], triple)
    assert str(tripled) == "Ok([6, 9])"
    return None
