# loop_try_match canonical traversal layer behavior demo
# Exercises loop-else, try/except, and match arms in one executable flow.

def normalize(n: int) -> int:
    match n:
        case value if value > 0:
            return value
        case _:
            return 0

def compute(values: list[int]) -> int:
    total: int = 0
    for value in values:
        try:
            total = total + normalize(value)
        except Error as e:
            total = total + 100
    else:
        total = total + 1
    return total

def main():
    print('loop_try_match canonical traversal layer behavior demo:')
    print(compute([3, 2, -1]))
