from sifr.json import dumps

def main():
    print("decimal_verification verification corpus and determinism gates demo")

    d: decimal = Decimal("-7.5")
    bd: bigdecimal = BigDecimal("-7.5")

    print(dumps(Decimal("1.2300")))
    print(dumps(BigDecimal("1.2300")))

    try:
        d_floor: decimal = d // Decimal("2")
        d_remainder: decimal = d % Decimal("2")
        bd_floor: bigdecimal = bd // BigDecimal("2")
        bd_remainder: bigdecimal = bd % BigDecimal("2")
        print(d_floor)
        print(d_remainder)
        print(bd_floor)
        print(bd_remainder)

        baseline_tmp_d: decimal = Decimal("1.2345") * Decimal("3.0")
        baseline_d: str = str(baseline_tmp_d.quantize(3))
        baseline_bd: str = str((BigDecimal("1.2345678901234567890123456789") + BigDecimal("0")).round(6))

        i: int = 0
        while i < 20:
            loop_tmp_d: decimal = Decimal("1.2345") * Decimal("3.0")
            assert str(loop_tmp_d.quantize(3)) == baseline_d
            assert str((BigDecimal("1.2345678901234567890123456789") + BigDecimal("0")).round(6)) == baseline_bd
            i = i + 1
    except DivisionError as error:
        assert False, str(error)
    except DecimalConversionError as error:
        assert False, str(error)

    print("deterministic decimal and bigdecimal corpus checks passed")
