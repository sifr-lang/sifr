# milestone_test_infra demo
# Demonstrates new test assertion intrinsics and corrected statistics functions


from sifr.statistics import mean, variance, pvariance, stdev, pstdev, StatisticsError
from sifr.test import assert_almost_eq, assert_gt, assert_lt

def main():
    # ============================================================
    # Part 1: Corrected statistics functions
    # ============================================================
    data: list[float] = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]

    try:
        m: float = mean(data)
        sv: float = variance(data)
        pv: float = pvariance(data)
        sd: float = stdev(data)
        pd: float = pstdev(data)
        assert "mean = " + str(m) == "mean = 5"
        assert "sample variance = " + str(sv) == "sample variance = 4.571428571428571"
        assert "population variance = " + str(pv) == "population variance = 4"
        assert "sample stdev = " + str(sd) == "sample stdev = 2.138089935299395"
        assert "population stdev = " + str(pd) == "population stdev = 2"
        assert_almost_eq(m, 5.0, 0.001)
        assert_almost_eq(sv, 4.571, 0.01)
        assert_almost_eq(pv, 4.0, 0.001)
        assert_almost_eq(sd, 2.138, 0.01)
        assert_almost_eq(pd, 2.0, 0.001)
    except StatisticsError as e:
        assert "statistics error: " + e.message == "All assertions passed!"

    # ============================================================
    # Part 2: New test assertion intrinsics
    # ============================================================

    # assert_gt / assert_lt: range-based assertions
    assert_gt(10, 5)
    assert_lt(3, 7)
    assert_gt(100, 0)
    assert_lt(0, 1)

    print("All assertions passed!")
