# Reference: test_infra
# Reference: compiler-feature-history
# test_infra demo
# Demonstrates new test assertion intrinsics and corrected statistics functions


from sifr.statistics import mean, variance, pvariance, stdev, pstdev, StatisticsError
from sifr.test import assert_almost_eq, assert_gt, assert_lt

def main():
    # ============================================================
    # Part 1: Corrected statistics functions
    # ============================================================
    data: list[float] = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]

    try:
        m: float = mean(data)
        sv: float = variance(data)
        pv: float = pvariance(data)
        sd: float = stdev(data)
        pd: float = pstdev(data)
        print("mean = " + str(m))
        assert str("mean = " + str(m)) == "mean = 5"
        print("sample variance = " + str(sv))
        assert str("sample variance = " + str(sv)) == "sample variance = 4.571428571428571"
        print("population variance = " + str(pv))
        assert str("population variance = " + str(pv)) == "population variance = 4"
        print("sample stdev = " + str(sd))
        assert str("sample stdev = " + str(sd)) == "sample stdev = 2.138089935299395"
        print("population stdev = " + str(pd))
        assert str("population stdev = " + str(pd)) == "population stdev = 2"
        assert_almost_eq(m, 5.0, 0.001)
        assert_almost_eq(sv, 4.571, 0.01)
        assert_almost_eq(pv, 4.0, 0.001)
        assert_almost_eq(sd, 2.138, 0.01)
        assert_almost_eq(pd, 2.0, 0.001)
    except StatisticsError as e:
        print("statistics error: " + e.message)
        assert str("statistics error: " + e.message) == "All assertions passed!"

    # ============================================================
    # Part 2: New test assertion intrinsics
    # ============================================================

    # assert_gt / assert_lt: range-based assertions
    assert_gt(10, 5)
    assert_lt(3, 7)
    assert_gt(100, 0)
    assert_lt(0, 1)

    print("All assertions passed!")
