# Reference: max_heap
from sifr.heapq import _heapify_max, _heappop_max, _heapreplace_max

def drain(mut heap: list[int]) -> list[int]:
    result: list[int] = []
    while len(heap) > 0:
        value: int | None = _heappop_max(heap)
        if value is not None:
            result.append(value)
    return result

def main():
    # Section 1: private max-heap helpers behave as a real max-heap surface.
    stones: list[int] = [2, 7, 4, 1, 8, 1]
    _heapify_max(stones)
    print(str(drain(stones)))

    # Section 2: replacement keeps the max-heap ordering intact.
    probe: list[int] = [4, 10, 7]
    _heapify_max(probe)
    _heapreplace_max(probe, 6)
    print(str(drain(probe)))
