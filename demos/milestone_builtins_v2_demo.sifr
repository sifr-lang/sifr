# milestone_builtins_v2 Demo

def main():
    assert f"max(3, 7) = {max(3, 7)}" == "max(3, 7) = 7"
    assert f"min(3, 7) = {min(3, 7)}" == "min(3, 7) = 3"
    assert f"pow(2, 10) = {pow(2, 10)}" == "pow(2, 10) = 1024"

    result: str = ""
    for i in range(0, 10, 2):
        if len(result) > 0:
            result = result + " "
        result = result + str(i)
    assert result == "0 2 4 6 8"
