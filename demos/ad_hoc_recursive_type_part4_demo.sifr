# Ad hoc recursive type feature, part 4:
# recursive node values behave like normal typed class values after guard narrowing.

class TreeNode:
    val: int
    left: TreeNode | None
    right: TreeNode | None

    def __init__(self, val: int, left: TreeNode | None, right: TreeNode | None):
        self.val = val
        self.left = left
        self.right = right

def tree_sum(node: TreeNode | None) -> int:
    if not node:
        return 0
    left: TreeNode | None = node.left
    right: TreeNode | None = node.right
    return node.val + tree_sum(left) + tree_sum(right)

def same_shape_and_sum(p: TreeNode | None, q: TreeNode | None) -> int:
    if not p and not q:
        return 0
    if not p or not q:
        return -1
    return p.val + q.val + same_shape_and_sum(p.left, q.left) + same_shape_and_sum(p.right, q.right)

def main():
    leaf_left: TreeNode = TreeNode(2, None, None)
    leaf_right: TreeNode = TreeNode(3, None, None)
    root: TreeNode = TreeNode(1, leaf_left, leaf_right)
    assert tree_sum(root) == 6
    assert same_shape_and_sum(root, root) == 12
