# Reference: entrypoint-compilation-unification-and-dependency-metadata-readiness
from sifr.tomllib import TomlValue, loads


def render() -> str:
    try:
        parsed: TomlValue = loads("name = \"five\"\nvalue = 5")
        name_value: TomlValue | None = parsed.get("name")
        value_value: TomlValue | None = parsed.get("value")
        if name_value is not None and value_value is not None:
            return "dependency closure demo: pass"
        return "dependency closure demo: empty"
    except TOMLDecodeError as e:
        return e.message
