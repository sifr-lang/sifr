# m27_2 indexing and semantics parity fixes demo
#
# Positive path: negative-index mutations and delete semantics are deterministic,
# parity-aligned, and panic-free.

def main():
    items: list[int] = [1, 2, 3]
    items[-1] = 9
    items[-2] += 5
    del items[-1]
    del items[-5]

    print("m27_2 indexing and semantics parity fixes demo:")
    print(items)
