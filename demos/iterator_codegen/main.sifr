# Reference: iter_fix_iterator_codegen
# Reference: canonical-iteration-model-and-lazy-parity-readiness
def greater_than_two(x: int) -> bool:
    return x > 2


def main():
    nums: list[int] = [5, 1, 3, 4]
    flags: list[bool] = [False, True, False]

    print(any(iter(flags)))
    print(list(filter(greater_than_two, iter(nums))))
    print(sorted(iter(nums)))
