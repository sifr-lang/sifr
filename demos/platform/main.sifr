# Reference: platform
from sifr.platform import system, machine, node, release, version, processor
from sifr.platform import platform_system, platform_arch, platform_node
from sifr.test import assert_bool_vector_eq


def collect_core_actual() -> list[bool]:
    actual: list[bool] = []
    sys_name: str = system()
    actual.append(len(sys_name) > 0 and sys_name != "linux" and sys_name != "macos" and sys_name != "windows")
    actual.append(len(machine()) > 0)
    actual.append(len(processor()) > 0)
    return actual


def collect_host_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(len(node()) > 0)
    actual.append(len(release()) > 0)
    actual.append(len(version()) > 0)
    return actual


def collect_alias_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(platform_system() == system() and platform_arch() == machine() and platform_node() == node())
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_core_actual())
    append_all(actual, collect_host_actual())
    append_all(actual, collect_alias_actual())

    assert_bool_vector_eq(actual, expected)
    print("platform platform parity demo: pass")
