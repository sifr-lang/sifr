# Reference: tempfile
from sifr.tempfile import mktemp_path, mkstemp, mkdtemp
from sifr.io import exists
from sifr.os import run_command
from sifr.pathlib import basename, dirname
from sifr.test import assert_bool_vector_eq


def collect_tempfile_actual() -> list[bool]:
    actual: list[bool] = []
    preview_path: str = mktemp_path("sifr_tempfile_preview_")
    try:
        file_path: str = mkstemp("sifr_tempfile_tmp_")
        dir_path: str = mkdtemp("sifr_tempfile_tmpd_")

        actual.append(exists(file_path))
        actual.append(exists(dir_path))

        preview_name: str = basename(preview_path)
        file_name: str = basename(file_path)
        dir_name: str = basename(dir_path)
        preview_has_prefix: bool = len(preview_name) > len("sifr_tempfile_preview_") and preview_name[0:len("sifr_tempfile_preview_")] == "sifr_tempfile_preview_"
        file_has_prefix: bool = len(file_name) > len("sifr_tempfile_tmp_") and file_name[0:len("sifr_tempfile_tmp_")] == "sifr_tempfile_tmp_"
        dir_has_prefix: bool = len(dir_name) > len("sifr_tempfile_tmpd_") and dir_name[0:len("sifr_tempfile_tmpd_")] == "sifr_tempfile_tmpd_"
        actual.append(preview_has_prefix and file_has_prefix and dir_has_prefix)

        temp_root: str = dirname(preview_path)
        missing_parent_name: str = "__sifr_tempfile_missing_parent__"
        missing_parent_path: str = temp_root + "/" + missing_parent_name
        missing_prefix: str = missing_parent_name + "/bad_"
        _rm_missing: str = run_command("rm -rf " + missing_parent_path)
        missing_error: bool = False
        try:
            unexpected_file: str = mkstemp(missing_prefix)
            _rm_unexpected: str = run_command("rm -f " + unexpected_file)
            missing_error = False
        except IOError as e:
            _ = str(e.message)
            missing_error = True
        actual.append(missing_error)

        _c1: str = run_command("rm -f " + file_path)
        _c2: str = run_command("rm -rf " + dir_path)
        _c3: str = run_command("rm -rf " + missing_parent_path)
        cleaned: bool = (not exists(file_path)) and (not exists(dir_path))
        actual.append(cleaned)

        next_path: str = mkstemp("sifr_tempfile_tmp_")
        actual.append(next_path != file_path)
        _c4: str = run_command("rm -f " + next_path)
    except IOError as e:
        _ = str(e.message)
        actual = [False, False, False, False, False, False]
    return actual


def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = collect_tempfile_actual()

    assert_bool_vector_eq(actual, expected)
    print("tempfile tempfile parity demo: pass")
