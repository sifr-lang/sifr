from sifr.datetime import timedelta, datetime, now, from_timestamp, timezone
from sifr.test import assert_bool_vector_eq

def collect_positive_actual() -> list[bool]:
    actual: list[bool] = []
    dt: datetime = datetime(2024, 1, 15, 10, 30, 0)
    actual.append(dt.isoformat() == "2024-01-15T10:30:00")

    base_td: timedelta = timedelta(0, 3600)
    extra_td: timedelta = timedelta(0, 1800)
    td: timedelta = base_td + extra_td
    actual.append(td.total_seconds() == 5400)

    current: datetime = now()
    actual.append(current.year > 2020 and current.month >= 1 and current.month <= 12)

    epoch_ok: bool = False
    try:
        epoch: datetime = from_timestamp(0.0)
        epoch_ok = epoch.isoformat() == "1970-01-01T00:00:00"
    except ValueError as e:
        _ = str(e.message)
    actual.append(epoch_ok)

    actual.append(str(timezone(-19800)) == "UTC-05:30")
    return actual

def collect_negative_actual() -> list[bool]:
    actual: list[bool] = []
    invalid_rejected: bool = False
    try:
        _bad: datetime = from_timestamp(100000000000000000000.0)
        _ = _bad
    except ValueError as e:
        invalid_rejected = len(e.message) > 0
    actual.append(invalid_rejected)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_positive_actual())
    append_all(actual, collect_negative_actual())

    assert_bool_vector_eq(actual, expected)
    print("datetime datetime parity demo: pass")
