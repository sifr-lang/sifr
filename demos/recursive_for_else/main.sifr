# recursive_for_else canonical walker coverage demo
# Demonstrates recursive-call detection through for-else branches.

def main():
    def rec(n: int) -> int:
        items: list[int] = [1]
        for i in items:
            pass
        else:
            if n > 0:
                return rec(n - 1)
        return 0

    print('recursive_for_else canonical walker coverage demo:')
    print(rec(3))
