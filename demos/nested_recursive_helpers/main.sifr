# Reference: nested_recursive_helpersl
# Nested recursive helpers can update local state without exposing it.

class Entry:
    value: int
    next: Entry | None

    def __init__(
        self,
        value: int = 0,
        next: Entry | None = None,
    ):
        self.value = value
        self.next = next


def collect_values(root: Entry | None) -> str:
    values: list[int] = []

    def visit(node: Entry | None) -> None:
        if node is None:
            return
        values.append(node.value)
        visit(node.next)

    visit(root)
    return str(values)


def main():
    short = Entry(1, Entry(2))
    long = Entry(4, Entry(5, Entry(6)))

    assert collect_values(None) == "[]"
    assert collect_values(short) == "[1, 2]"
    assert collect_values(long) == "[4, 5, 6]"
    print("nested_recursive_helpers: ok")
