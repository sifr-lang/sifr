# Reference: recursive_type_part2
# Reference: full-recursive-type-feature-part2
# Recursive-type feature part 2 demo.
# Shows that well-formed recursive aliases are accepted while invalid cycles are reserved for diagnostics.

type Payload = Response
type Response = list[int]
type Json = None | bool | int | float | str | list[Json] | dict[str, Json]
type Node = Branch
type Branch = list[Node]

def payload_size(data: Payload) -> int:
    return len(data)

def main():
    print(payload_size([1, 2, 3]))
    print("well-formed recursive aliases accepted")
