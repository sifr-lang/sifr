# Reference: own_mut_parameter_convention_part3
# Reference: own-mut-parameter-convention-part3
# `own mut` parameters should support simple append-and-return helpers.

def append_zero(own mut values: list[int]) -> list[int]:
    values.append(0)
    return values


def append_marker(own mut words: list[str]) -> list[str]:
    words.append("done")
    return words


def main():
    assert str(append_zero([2, 3, 4])) == "[2, 3, 4, 0]"
    assert str(append_marker(["compile", "check"])) == "[\"compile\", \"check\", \"done\"]"
    print("own_mut_appends: ok")
