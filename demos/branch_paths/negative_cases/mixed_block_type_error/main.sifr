# hir analysis negative case
# Mixed block forms with reachable return mismatch must fail.

def bad(flag: bool) -> int:
    try:
        if flag:
            return 1
        else:
            return 'bad'
    except ValueError as e:
        return 0

def main():
    print(bad(False))
