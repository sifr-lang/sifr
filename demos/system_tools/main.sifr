# Reference: wave_psp_d2
# Source issue: ad-hoc-python-source-parity-and-builtin-stdlib-surface-execution.md
from sifr.os import run_command, getcwd
from sifr.env import getenv, setenv, unsetenv
from sifr.sys import argv, version, platform
from sifr.logging import getLogger, INFO, Logger
from sifr.platform import system, machine, processor
from sifr.time import time, strftime
from sifr.timeit import timeit, repeat


def workload():
    i: int = 0
    total: int = 0
    while i < 100:
        total = total + i
        i = i + 1


def main():
    try:
        shell_out: str = run_command("echo wave_psp_d2")
        cwd: str = getcwd()
        print("os.run_command = " + shell_out)
        print("os.getcwd len > 0 = " + str(len(cwd) > 0))
    except IOError as e:
        print("os error: " + e.message)

    setenv("SIFR_WAVE_D2_DEMO", "ok")
    print("env getenv = " + getenv("SIFR_WAVE_D2_DEMO", "fallback"))
    unsetenv("SIFR_WAVE_D2_DEMO")

    print("sys.argv len = " + str(len(argv())))
    print("sys.version = " + version())
    print("sys.platform = " + platform())

    logger: Logger = getLogger("wave_psp_d2_demo")
    logger.set_level(INFO)
    logger.info("logging demo line")

    print("platform.system = " + system())
    print("platform.machine = " + machine())
    print("platform.processor = " + processor())

    print("time.time > 0 = " + str(time() > 0.0))
    print("time.strftime epoch0 = " + strftime("%Y-%m-%d %H:%M:%S", 0.0))
    print("timeit.timeit = " + str(timeit(workload, 5)))
    print("timeit.repeat count = " + str(len(repeat(workload, 3, 4))))
