# Reference: fixed_indexing
# driver/package architecture / fixed_indexing behavior group 12 demo: fixed-index reads after explicit len guards.

def second_or_zero(values: list[int]) -> int:
    if len(values) < 2:
        return 0
    return values[1]

def neighbor_min_cost(mut cost: list[int]) -> int:
    if len(cost) < 2:
        return 0
    for i in range(len(cost) - 3, -1, -1):
        cost[i] = cost[i] + min(cost[i + 1], cost[i + 2])
    return min(cost[0], cost[1])

def main():
    assert second_or_zero([8, 13]) == 13
    assert second_or_zero([8]) == 0
    assert neighbor_min_cost([10, 15, 20]) == 15
