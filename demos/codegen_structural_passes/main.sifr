# Reference: codegen_structural_passes
# Reference: compiler-feature-history
# Demo: codegen_structural_passes (RawCode-zero slice for datetime intrinsics)
from sifr.datetime import now, today, from_timestamp, datetime


def main():
    current = now()
    current_iso: str = current.isoformat()
    current_has_t: bool = "T" in current_iso
    print(f"current_has_t = {current_has_t}")
    assert str(f"current_has_t = {current_has_t}") == "current_has_t = true"

    day = today()
    today_iso: str = day.isoformat()
    today_has_dash: bool = "-" in today_iso
    print(f"today_has_dash = {today_has_dash}")
    assert str(f"today_has_dash = {today_has_dash}") == "today_has_dash = true"

    try:
        epoch: datetime = from_timestamp(0.0)
        epoch_text: str = epoch.isoformat()
        print(f"from_timestamp_ok = {epoch_text}")
        assert str(f"from_timestamp_ok = {epoch_text}") == "from_timestamp_ok = 1970-01-01T00:00:00"
    except ValueError as e:
        print(f"unexpected_error = {e.message}")
        assert str(f"unexpected_error = {e.message}") == "from_timestamp_invalid = invalid timestamp"

    try:
        bad: datetime = from_timestamp(-99999999999999.0)
        print(f"from_timestamp_invalid_unexpected = {bad}")
    except ValueError as e:
        print(f"from_timestamp_invalid = {e.message}")

