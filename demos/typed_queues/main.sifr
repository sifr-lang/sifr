# Reference: phase31
# Source issue: phase31-m31a-canonical-word-ladder-execution.md
# Typed queues should support simple pop-front and append flows.

def drain_queue(mut queue: list[str]) -> list[str]:
    order: list[str] = []

    while queue:
        order.append(queue.pop(0))
    return order


def append_missing(mut queue: list[str], item: str) -> list[str]:
    for existing in queue:
        if existing == item:
            return queue
    queue.append(item)
    return queue


def main():
    assert str(drain_queue(["parse", "check", "emit"])) == "[\"parse\", \"check\", \"emit\"]"
    assert str(append_missing(["parse", "check"], "emit")) == "[\"parse\", \"check\", \"emit\"]"
    assert str(append_missing(["parse", "check"], "check")) == "[\"parse\", \"check\"]"
    print("typed_queues: ok")
