# Reference: integer_safety
# Source issue: 196-integer_safety.md
# Demo: integer_safety
# Showcases exact int arithmetic and explicit fixed-width integer checks.

def factorial(n: int) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def fibonacci(n: int) -> int:
    if n <= 1:
        return n
    a: int = 0
    b: int = 1
    i: int = 2
    while i <= n:
        c: int = a + b
        a = b
        b = c
        i = i + 1
    return b

def main():
    # --- 1. Basic exact int creation ---
    print("=== Basic exact int ===")
    x: int = 42
    y: int = 100
    print(x)
    print(y)

    # --- 2. Arithmetic ---
    print("=== Arithmetic ===")
    print(x + y)
    print(y - x)
    print(x * y)
    print(10 ** 9)

    # --- 3. Exact integer constants ---
    print("=== Exact integer constants ===")
    exact_value: int = 2 ** 30
    print(exact_value)

    # --- 4. Comparison ---
    print("=== Comparison ===")
    a: int = 100
    b: int = 200
    print(a < b)
    print(a == 100)
    print(b > a)

    # --- 5. Fixed-width representation checks ---
    print("=== Fixed-width checks ===")
    byte_value: uint8 = 255
    print(byte_value)
    widened: int = int(byte_value)
    print(widened + 1)

    # --- 6. Factorial (large numbers) ---
    print("=== Factorial ===")
    print(factorial(10))
    print(factorial(12))

    # --- 7. Fibonacci (large numbers) ---
    print("=== Fibonacci ===")
    print(fibonacci(20))
    print(fibonacci(40))
