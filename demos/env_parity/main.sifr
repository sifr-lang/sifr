# Reference: m30_1a
# Source issue: phase30-reliability-parity-and-performance-budgets-execution.md
# m30_1a env parity demo
from sifr.env import env_get, env_set, env_unset, getenv, getenv_opt
from sifr.test import assert_bool_vector_eq

def main():
    env_unset("SIFR_M30_ENV_DEMO")
    env_set("SIFR_M30_ENV_DEMO", "phase30")

    with_default: str = getenv("SIFR_M30_ENV_DEMO", "fallback")
    print(with_default)
    assert str(with_default) == "phase30"

    env_unset("SIFR_M30_ENV_DEMO")
    without_default: str | None = getenv_opt("SIFR_M30_ENV_DEMO")
    assert str(without_default is None) == "true"
    assert str(getenv("SIFR_M30_ENV_DEMO", "fallback")) == "fallback"

    invalid_expected_lookup_found: list[bool] = [False, False]
    invalid_actual_lookup_found: list[bool] = []
    env_set("", "x")
    invalid_actual_lookup_found.append(env_get("") is not None)
    env_set("A=B", "x")
    invalid_actual_lookup_found.append(env_get("A=B") is not None)
    assert_bool_vector_eq(invalid_actual_lookup_found, invalid_expected_lookup_found)

    print("m30_1a env parity demo: pass")
