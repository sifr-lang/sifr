# Reference: phase31_m31e
# Source issue: phase31-m31e-recursive-tree-canonical-closure-execution.md
# Recursive record fields should stay typed through nested construction and access.

class Entry:
    value: int
    next: Entry | None

    def __init__(
        self,
        value: int = 0,
        next: Entry | None = None,
    ):
        self.value = value
        self.next = next


def chain_text(entry: Entry | None) -> str:
    if entry is None:
        return "."
    return str(entry.value) + "->" + chain_text(entry.next)


def second_value(entry: Entry | None) -> int:
    if entry is None or entry.next is None:
        return 0
    return entry.next.value


def main():
    chain = Entry(4, Entry(2, Entry(6)))
    short = Entry(9)

    assert chain_text(chain) == "4->2->6->."
    assert chain_text(None) == "."
    assert second_value(chain) == 2
    assert second_value(short) == 0
    print("recursive_records: ok")
