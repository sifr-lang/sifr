# Reference: recursive_recordse
# Recursive record fields should stay typed through nested construction and access.

class Entry:
    value: int
    next: Entry | None

    def __init__(
        self,
        value: int = 0,
        next: Entry | None = None,
    ):
        self.value = value
        self.next = next


def chain_text(entry: Entry | None) -> str:
    if entry is None:
        return "."
    next_entry: Entry | None = entry.next
    return str(entry.value) + "->" + chain_text(next_entry)


def second_value(entry: Entry | None) -> int:
    if entry is None:
        return 0
    next_entry: Entry | None = entry.next
    if next_entry is None:
        return 0
    return next_entry.value


def main():
    chain: Entry | None = Entry(4, Entry(2, Entry(6)))
    short: Entry | None = Entry(9)

    assert chain_text(chain) == "4->2->6->."
    assert chain_text(None) == "."
    assert second_value(chain) == 2
    assert second_value(short) == 0
    print("recursive_records: ok")
