# Reference: json
from sifr.json import JsonValue, loads, json_dumps
from sifr.test import assert_bool_vector_eq

def collect_positive_actual() -> list[bool]:
    actual: list[bool] = []
    parse_obj_ok: bool = False
    parse_arr_ok: bool = False
    roundtrip_ok: bool = False
    try:
        parsed_obj: JsonValue = loads("{\"name\":\"sifr\"}")
        parsed_arr: JsonValue = loads("[1,2,3]")
        parsed_roundtrip: JsonValue = loads(json_dumps(7))
        parse_obj_ok = str(parsed_obj) == "{\"name\":\"sifr\"}"
        parse_arr_ok = str(parsed_arr) == "[1,2,3]"
        roundtrip_ok = str(parsed_roundtrip) == "7"
    except JSONDecodeError as e:
        _ = str(e.message)
    actual.append(parse_obj_ok)
    actual.append(parse_arr_ok)
    actual.append(roundtrip_ok)
    actual.append(json_dumps("hello") == "\"hello\"")
    actual.append(json_dumps(False) == "false")
    return actual

def collect_negative_actual() -> list[bool]:
    actual: list[bool] = []
    invalid_rejected: bool = False
    try:
        _bad: JsonValue = loads("{")
        _ = _bad
    except JSONDecodeError as e:
        invalid_rejected = len(e.message) > 0
    actual.append(invalid_rejected)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_positive_actual())
    append_all(actual, collect_negative_actual())

    assert_bool_vector_eq(actual, expected)
    print("json json parity demo: pass")
