# Exclusivity Error Demo
# ======================
# This file demonstrates that Sifr correctly detects
# mutable borrow exclusivity violations at compile time.
# This file is EXPECTED to produce a compile error.

def swap(mut a: list[int], mut b: list[int]):
    pass

def main():
    items: list[int] = [1, 2, 3]
    # ERROR: cannot borrow 'items' as mutable more than once
    swap(items, items)
