# Reference: subscript_mutation
# Reference: compiler-feature-history
# subscript_mutation Demo

def main():
    # List subscript assignment
    nums: list[int] = [1, 2, 3]
    try:
        nums[0] = 10
        nums[2] = 30
    except IndexError:
        return
    print(nums)
    assert str(nums) == "[10, 2, 30]"

    # Dict subscript assignment
    d: dict[str, int] = {"a": 1}
    d["b"] = 2
    val: int | None = d["b"]
    if val is not None:
        print(val)
        assert str(val) == "2"
