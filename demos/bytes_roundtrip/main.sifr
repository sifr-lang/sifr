

def main() -> None:
    payload: bytes = b"binary-sample"
    assert payload.startswith(b"binary")
    assert payload.endswith(b"sample")

    conversion_ok: bool = False
    try:
        as_hex: str = payload.hex()
        restored: bytes = bytes.from_hex(as_hex)
        text: str = restored.decode()
        conversion_ok = text == "binary-sample"
    except ParseError as e:
        _ = str(e.message)
    assert conversion_ok
