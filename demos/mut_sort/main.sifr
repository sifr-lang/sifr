# Reference: phase31_m31i
# Source issue: phase31-m31i-corpus-fixture-canonicalization-execution.md
# `mut` parameters should support in-place list sorting.

def sort_values(mut values: list[int]) -> list[int]:
    values.sort()
    return values


def main():
    assert str(sort_values([5, 1, 4, 2])) == "[1, 2, 4, 5]"
    assert str(sort_values([3])) == "[3]"
    print("mut_sort: ok")
