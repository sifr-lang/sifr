# Reference: phase31_m31i
# Source issue: phase31-m31i-corpus-fixture-canonicalization-execution.md
# Sorting nested lists should stay simple and deterministic.

def sort_nested_lists(mut groups: list[list[int]]) -> str:
    normalized: list[str] = []
    for group in groups:
        group.sort()
        normalized.append(str(group))
    normalized.sort()
    return str(normalized)


def main():
    actual = sort_nested_lists([[5, 1], [4, 2], [2, 4]])
    assert actual == "[\"[1, 5]\", \"[2, 4]\", \"[2, 4]\"]"
    print("nested_sorting: ok")
