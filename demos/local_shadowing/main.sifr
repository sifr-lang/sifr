# Local rebinding should stay predictable inside functions and branches.


def shadow_parameter(mut value: int) -> int:
    value = value + 2
    return value


def choose_label(flag: bool) -> str:
    label = "cold"
    if flag:
        label = "warm"
    return label


def main():
    assert shadow_parameter(5) == 7
    assert choose_label(True) == "warm"
    assert choose_label(False) == "cold"
    print("local_shadowing: ok")
