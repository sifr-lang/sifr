# Reference: phase31_m31h
# Source issue: phase31-m31h-local-binding-shadowing-closure-execution.md
# User-defined locals can shadow builtin names while rebinding stays predictable.

def sum(left: int, right: int) -> int:
    return left + right


def sum_values(values: list[int]) -> int:
    total = 0
    for value in values:
        total = sum(total, value)
    return total


def shadow_parameter(value: int) -> int:
    value = value + 2
    return value


def choose_label(flag: bool) -> str:
    label = "cold"
    if flag:
        label = "warm"
    return label


def main():
    assert sum_values([1, 2, 3, 4]) == 10
    assert shadow_parameter(5) == 7
    assert choose_label(True) == "warm"
    assert choose_label(False) == "cold"
    print("local_shadowing: ok")
