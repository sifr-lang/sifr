# Reference: phase31
# Source issue: phase31-m31a-two-pointer-while-guard-execution.md
# Phase 31 m31_a slice 2 demo: same-sequence two-pointer `while` guards.

def trap(height: list[int]) -> int:
    if not height:
        return 0

    l, r = 0, len(height) - 1
    left_max: int = height[l]
    right_max: int = height[r]
    total = 0

    while l < r:
        if left_max < right_max:
            l += 1
            left_max = max(left_max, height[l])
            total += left_max - height[l]
        else:
            r -= 1
            right_max = max(right_max, height[r])
            total += right_max - height[r]

    return total


def main():
    print("two_pointer_water_1 = " + str(trap([0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1])))
    print("two_pointer_water_2 = " + str(trap([4, 2, 0, 3, 2, 5])))
