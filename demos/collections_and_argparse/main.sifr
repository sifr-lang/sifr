# Reference: struct_collections_and_argparse
# Reference: structured-data-and-class-surface-parity-expansion
from sifr.collections import Counter, defaultdict
from sifr.argparse import ArgumentParser


def main() -> None:
    counter: Counter[str] = Counter(iterable=["parse", "parse", "emit"])
    assert counter.get("parse") == 2

    attempts = defaultdict(int)
    attempts["collections_and_argparse"] += 1
    assert attempts["collections_and_argparse"] == 1

    parser: ArgumentParser = ArgumentParser("sifr")
    parser.add_subparsers(dest="cmd")
    run_parser: ArgumentParser = ArgumentParser("run")
    run_parser.add_argument_typed("--strict", "strict", "store_true")
    run_parser.add_argument_typed("--level", "level", "store", "0", "1", "int")
    run_parser.add_argument_typed("--custom-level", "custom_level", "store", "0", "1", "int")
    run_parser.add_argument_typed("targets", "targets", "store", "", "+", "str")
    parser.add_parser("run", run_parser)

    parsed = parser.parse_args(["run", "--strict", "--level", "2", "--custom-level", "3", "main.sifr"])
    assert parsed.get("cmd", "") == "run"
    assert parsed.get_bool("strict", False)
    assert parsed.get("level", "") == "2"
    assert parsed.get("custom_level", "") == "3"
    assert str(parsed.get_list("targets")) == "[\"main.sifr\"]"
