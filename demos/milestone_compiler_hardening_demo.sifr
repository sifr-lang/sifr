# Demo: milestone_compiler_hardening — Import Errors, Context Managers, Callable Fix
# This demo showcases the three compiler correctness improvements.

from typing import Callable

# ===== 1. Context Manager with Drop-based cleanup =====
# __exit__() is now called on ALL exit paths: normal, return, break, continue

class FileResource:
    path: str

    def __init__(self, path: str):
        self.path = path

    def __enter__(self) -> FileResource:
        events.append("Opening: " + self.path)
        return self

    def __exit__(self) -> None:
        events.append("Closing: " + self.path)

class DBConnection:
    name: str

    def __init__(self, name: str):
        self.name = name

    def __enter__(self) -> DBConnection:
        events.append("Connecting: " + self.name)
        return self

    def __exit__(self) -> None:
        events.append("Disconnecting: " + self.name)

# ===== 2. Callable-as-struct-field =====
# Callable fields emit Box<dyn Fn(...)> for struct fields

class Config:
    value: int
    callback: Callable[[int], int]

    def __init__(self, value: int, callback: Callable[[int], int]):
        self.value = value
        self.callback = callback


def double(x: int) -> int:
    return x * 2

# ===== Demo functions =====

def demo_early_return() -> int:
    with FileResource("data.csv") as f:
        events.append("Reading: " + f.path)
        return 42


def main():
    events.append("=== Context Manager: Normal Exit ===")
    with FileResource("config.json") as f:
        events.append("Using: " + f.path)

    events.append("")
    events.append("=== Context Manager: Early Return ===")
    result: int = demo_early_return()
    events.append(str(result))

    events.append("")
    events.append("=== Context Manager: Break in Loop ===")
    i: int = 0
    while i < 3:
        with DBConnection("db") as conn:
            if i == 1:
                break
            events.append("Query on: " + conn.name)
        i = i + 1

    events.append("")
    events.append("=== Multiple Context Managers ===")
    with FileResource("input.txt") as fin, DBConnection("postgres") as db:
        events.append("Processing with: " + fin.path + " and " + db.name)

    events.append("")
    events.append("=== Callable Struct Field ===")
    c: Config = Config(21, double)
    events.append(str(c.value))

    events.append("")
    events.append("=== Compiler Hardening Demo Complete ===")

    assert events == [
        "=== Context Manager: Normal Exit ===",
        "Opening: config.json",
        "Using: config.json",
        "Closing: config.json",
        "=== Context Manager: Early Return ===",
        "Opening: data.csv",
        "Reading: data.csv",
        "Closing: data.csv",
        "42",
        "=== Context Manager: Break in Loop ===",
        "Connecting: db",
        "Query on: db",
        "Disconnecting: db",
        "Connecting: db",
        "Disconnecting: db",
        "=== Multiple Context Managers ===",
        "Opening: input.txt",
        "Connecting: postgres",
        "Processing with: input.txt and postgres",
        "Disconnecting: postgres",
        "Closing: input.txt",
        "=== Callable Struct Field ===",
        "21",
        "=== Compiler Hardening Demo Complete ===",
    ]


events: list[str] = []
