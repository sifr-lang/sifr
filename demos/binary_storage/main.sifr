# Reference: bytes_binary_storage
# Reference: first-class-bytes-and-binary-surface-foundation
from sifr.io import exists
from sifr.os import remove_file


def sum_bytes(data: bytes) -> int:
    total: int = 0
    values: list[int] = data.to_ints()
    for value in values:
        total = total + value
    return total


def main():
    payload: bytes = b"binary_storage"

    second: uint8 | None = payload[1]
    second_ok: bool = False
    if second is not None:
        expected_second: uint8 = 105
        second_ok = second == expected_second

    iter_ok: bool = sum_bytes(payload) == 1497
    contains_ok: bool = payload.contains(98) and (not payload.contains(512))
    count_ok: bool = payload.count(98) == 1 and payload.count(512) == 0

    hex_ok: bool = False
    try:
        hexed: str = payload.hex()
        roundtrip: bytes = bytes.from_hex(hexed)
        hex_ok = roundtrip == payload
    except ParseError as e:
        _ = str(e.message)

    path: str = "/tmp/sifr_bytes_binary_storage.bin"
    io_ok: bool = False
    cleanup_ok: bool = False
    try:
        writer = open(path, "wb")
        _w: None = writer.write_bytes(payload)
        writer.close()

        reader = open(path, "rb")
        loaded: bytes = reader.read_bytes()
        reader.close()
        io_ok = loaded == payload and str(loaded.to_ints()) == "[98, 105, 110, 97, 114, 121, 95, 115, 116, 111, 114, 97, 103, 101]"
    except IOError as e:
        _ = str(e.message)

    try:
        if exists(path):
            _rm: None = remove_file(path)
        cleanup_ok = not exists(path)
    except IOError as e:
        _ = str(e.message)

    assert second_ok
    assert iter_ok
    assert contains_ok
    assert count_ok
    assert hex_ok
    assert io_ok
    assert cleanup_ok
