# Reference: parse_safety
# Reference: compiler-feature-history
# Demo: parse_safety
# All parse/decode intrinsics now return Result[T, E] instead of panicking.
# Invalid input is caught via try/except with specific error types:
#   - JSONDecodeError for loads
#   - TOMLDecodeError for toml_parse / tomllib.loads
#   - RegexError for search/search/sub/findall/split
#   - ParseError for b64decode, urlsafe_b64decode, decode_utf8, bytes_from_hex

from sifr.json import JsonValue, JSONDecoder, dumps
from sifr.tomllib import TomlValue, loads
from sifr.re import search, sub, findall, split
from sifr.base64 import b64encode, b64decode
from sifr.bytes import encode_utf8, decode_utf8, bytes_from_hex

def _load_json(text: str) -> Result[JsonValue, JSONDecodeError]:
    decoder: JSONDecoder = JSONDecoder()
    return decoder.decode(text)

def has_match(pattern: str, text: str) -> Result[bool, RegexError]:
    try:
        found: str | None = search(pattern, text)
        return found is not None
    except RegexError as error:
        raise RegexError(error.message)

# --- 1. JSON parse safety ---

def demo_json():
    print("=== JSON Parse Safety ===")

    # Success path
    try:
        data: JsonValue = _load_json("{\"language\":\"sifr\",\"safe\":true}")
        print(f"parsed: {data}")
    except JSONDecodeError as e:
        print(f"error: {e.message}")

    # Error path — invalid JSON no longer panics!
    try:
        bad: JsonValue = _load_json("{not valid json")
        _ = bad
        print("should not reach here")
    except JSONDecodeError as e:
        print(f"caught JSONDecodeError: {e.message}")

    # dumps still works as before (infallible for basic types)
    dumped: str = dumps(42)
    print(f"dumped: {dumped}")

# --- 2. TOML parse safety ---

def demo_toml():
    print("=== TOML Parse Safety ===")

    # Success path
    try:
        toml_data: TomlValue = loads("name = \"sifr\"\nversion = 1")
        print(f"toml parsed: {len(toml_data.keys()) > 0}")
    except TOMLDecodeError as e:
        print(f"error: {e.message}")

    # Error path — invalid TOML
    try:
        bad_toml: TomlValue = loads("[broken toml ===")
        _ = bad_toml
        print("should not reach here")
    except TOMLDecodeError as e:
        print(f"caught TOMLDecodeError: {e.message}")

# --- 3. Regex safety ---

def demo_regex():
    print("=== Regex Safety ===")

    try:
        # search success
        matched: bool = has_match("\\d+", "abc123")
        print(f"match found: {matched}")

        # search success
        found: str | None = search("\\d+", "hello 42 world")
        if found is not None:
            print(f"found: {found}")

        # sub success
        replaced: str = sub("\\d+", "NUM", "test 1 2 3")
        print(f"replaced: {replaced}")

        # findall success
        all_matches: list[str] = findall("[a-z]+", "Hello World Sifr")
        print(f"findall count: {len(all_matches)}")

        # split success
        parts: list[str] = split(",", "a,b,c")
        print(f"split count: {len(parts)}")
    except RegexError as e:
        print(f"unexpected: {e.message}")

    # Error path — invalid regex pattern
    try:
        bad_match: bool = has_match("[unclosed", "text")
        print("should not reach here")
    except RegexError as e:
        print(f"caught RegexError: {e.message}")

# --- 4. Base64 safety ---

def demo_base64():
    print("=== Base64 Safety ===")

    # Success path
    encoded: str = b64encode("safe decoding!")
    try:
        decoded: str = b64decode(encoded)
        print(f"decoded: {decoded}")
    except ParseError as e:
        print(f"unexpected: {e.message}")

    # Error path — invalid base64
    try:
        bad_decoded: str = b64decode("!!!not-base64!!!")
        print("should not reach here")
    except ParseError as e:
        print(f"caught base64 ParseError: {e.message}")

# --- 5. Bytes/UTF-8 safety ---

def demo_bytes():
    print("=== Bytes Safety ===")

    # decode_utf8 success
    try:
        text: str = decode_utf8(encode_utf8("hello sifr"))
        print(f"utf8: {text}")
    except ParseError as e:
        print(f"unexpected: {e.message}")

    # decode_utf8 error — invalid bytes
    try:
        bad_bytes: bytes = b"\xff\xfe\xfd"
        bad_text: str = decode_utf8(bad_bytes)
        print("should not reach here")
    except ParseError as e:
        print(f"caught utf8 ParseError: {e.message}")

    # bytes_from_hex success
    try:
        hex_data: bytes = bytes_from_hex("48656c6c6f")
        decoded_hex: str = decode_utf8(hex_data)
        print(f"from hex: {decoded_hex}")
    except ParseError as e:
        print(f"unexpected: {e.message}")

    # bytes_from_hex error — invalid hex
    try:
        bad_hex: bytes = bytes_from_hex("ZZZZ")
        print("should not reach here")
    except ParseError as e:
        print(f"caught hex ParseError: {e.message}")

# --- Entry point ---

def main():
    demo_json()
    demo_toml()
    demo_regex()
    demo_base64()
    demo_bytes()
    print("=== All parse safety demos passed ===")
