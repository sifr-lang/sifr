# driver/package architecture / guarded_sequence_index behavior group 1 demo: guarded sequence indexes narrow to definite values

def collect_vowels(text: str) -> str:
    result: str = ""
    i: int = 0
    # `i < len(text)` proves `text[i]` is a `str`, not `str | None`.
    while i < len(text):
        ch: str = text[i]
        if ch in "aeiou":
            result = result + ch
        i = i + 1
    return result

def sum_all(values: list[int]) -> int:
    total: int = 0
    # `for i in range(len(values))` proves `values[i]` is an `int`.
    for i in range(len(values)):
        total = total + values[i]
    return total

def head_or_zero(values: list[int]) -> int:
    # After the early return on the empty case, `values[0]` is definite.
    if len(values) == 0:
        return 0
    first: int = values[0]
    return first

def main():
    assert collect_vowels("sequoia") == "euoia"
    assert sum_all([4, 5, 6]) == 15
    assert head_or_zero([]) == 0
    assert head_or_zero([9, 1]) == 9
