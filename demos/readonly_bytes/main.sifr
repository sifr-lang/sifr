from sifr.io import exists
from sifr.os import remove_file


def sum_bytes(data: bytes) -> int:
    total: int = 0
    values: list[int] = data.to_ints()
    for value in values:
        total = total + value
    return total


def main():
    # Behavior Group 5 governance lock: successors consume bytes as the canonical
    # read-only binary carrier and only widen to int at explicit read boundaries.
    payload: bytes = b"ffi-ready"

    second: uint8 | None = payload[1]
    second_ok: bool = False
    if second is not None:
        expected_second: uint8 = 102
        second_ok = second == expected_second

    iter_ok: bool = sum_bytes(payload) > 0
    contains_ok: bool = payload.contains(102) and (not payload.contains(512))
    to_ints_ok: bool = str(payload.to_ints()) == "[102, 102, 105, 45, 114, 101, 97, 100, 121]"

    path: str = "/tmp/sifr_bytes_readonly_bytes.bin"
    io_ok: bool = False
    cleanup_ok: bool = False
    try:
        writer = open(path, "wb")
        _w: None = writer.write_bytes(payload)
        writer.close()

        reader = open(path, "rb")
        loaded: bytes = reader.read_bytes()
        reader.close()
        io_ok = loaded == payload and str(loaded.to_ints()) == "[102, 102, 105, 45, 114, 101, 97, 100, 121]"
    except IOError as e:
        _ = str(e.message)

    try:
        if exists(path):
            _rm: None = remove_file(path)
        cleanup_ok = not exists(path)
    except IOError as e:
        _ = str(e.message)

    assert second_ok
    assert iter_ok
    assert contains_ok
    assert to_ints_ok
    assert io_ok
    assert cleanup_ok
