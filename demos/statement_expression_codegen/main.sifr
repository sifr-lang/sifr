# Reference: codegen_stmt_expr_migration
# Reference: compiler-feature-history
# Demo: codegen_stmt_expr_migration (in scaffold)
# This demo exercises statement + expression-heavy control flow while
# process runtime migration is rolled out incrementally in multiple PRs.

def main():
    total: int = 0
    for i in range(1, 6):
        if i % 2 == 0:
            total += i
        else:
            total += i * 2

    verdict: str = "high" if total > 10 else "low"
    print(f"total = {total}")
    assert str(f"total = {total}") == "total = 24"
    print(f"verdict = {verdict}")
    assert str(f"verdict = {verdict}") == "verdict = high"

