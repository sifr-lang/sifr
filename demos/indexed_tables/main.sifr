# Reference: phase31
# Source issue: phase31-m31a-canonical-coin-change-execution.md
# Pre-sized tables should support direct indexed writes.

def write_indices(size: int) -> list[int]:
    out: list[int] = [0 for i in range(size)]

    for i in range(len(out)):
        out[i] = i + 1
    return out


def main():
    assert str(write_indices(4)) == "[1, 2, 3, 4]"
    assert str(write_indices(0)) == "[]"
    print("indexed_tables: ok")
