# Reference: runtime_subprocess
# Reference: runtime-and-file-object-parity-expansion
from sifr.os import run_command


def main() -> None:
    demo_ok: bool = False

    try:
        out: str = run_command("echo runtime_subprocess")
        demo_ok = out == "runtime_subprocess"
    except IOError as e:
        _ = e.message

    assert demo_ok
    print("runtime_subprocess_subprocess_removed_demo: ok")
