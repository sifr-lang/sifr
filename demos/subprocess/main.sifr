from sifr.os import run_command


def main() -> None:
    demo_ok: bool = False

    try:
        out: str = run_command("echo runtime_wave4_demo")
        demo_ok = out == "runtime_wave4_demo"
    except IOError as e:
        _ = e.message

    assert demo_ok
    print("ad_hoc_runtime_wave4_legacy_subprocess_removed_demo: ok")
