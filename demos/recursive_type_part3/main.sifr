# Recursive-type feature part 3 demo.
# Shows that recursive aliases keep alias identity and generic arguments through lowering.

type Json = None | bool | int | float | str | list[Json] | dict[str, Json]
type Node[T] = T | list[Node[T]]

def main():
    print("recursive type representation preserved")
