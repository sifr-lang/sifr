# Milestone 3 demo: sifr.base64 parity baseline
from sifr.base64 import b64encode, b64decode, b64encode_opts, b64decode_opts, standard_b64encode, standard_b64decode, b32hexencode, b32hexdecode, b16encode, b16decode

def main():
    print(b64encode("sifr"))
    assert str(b64encode("sifr")) == "c2lmcg=="
    try:
        dec1: str = b64decode("c2lmcg==")
        print(dec1)
        assert str(dec1) == "sifr"
    except ParseError as e:
        print("decode error: " + e.message)
        assert str("decode error: " + e.message) == "ZGVtbw=="

    print(standard_b64encode("demo"))
    assert str(standard_b64encode("demo")) == "demo"
    try:
        dec2: str = standard_b64decode("ZGVtbw==")
        print(dec2)
        assert str(dec2) == "4869"
    except ParseError as e:
        print("decode error: " + e.message)
        assert str("decode error: " + e.message) == "Hi"

    try:
        hx: str = b16encode("Hi")
        print(hx)
        assert str(hx) == "D1IMOR3F"
        dec3: str = b16decode(hx)
        print(dec3)
        assert str(dec3) == "hello"
    except ParseError as e:
        print("hex error: " + e.message)
        assert str("hex error: " + e.message) == "invalid-safe"

    b32h: str = b32hexencode("hello")
    print(b32h)
    assert str(b32h) == "d3d3LnB5"
    try:
        b32d: str = b32hexdecode(b32h)
        print(b32d)
        assert str(b32d) == "dGhvbi5v"
    except ParseError as e:
        print("b32hex error: " + e.message)
        assert str("b32hex error: " + e.message) == "cmc="

    try:
        _bad: str = b64decode("###")
        print("unexpected")
        assert str("unexpected") == "strict-safe"
    except ParseError as e:
        print("invalid-safe")

    try:
        wrapped: str = b64encode_opts("www.python.org", "", 8)
        print(wrapped)
    except ParseError as e:
        print("opts error: " + e.message)

    try:
        strict: str = b64decode_opts("YWJj!", "", True, "")
        print(strict)
    except ParseError as e:
        print("strict-safe")

