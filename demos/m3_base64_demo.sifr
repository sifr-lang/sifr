# Milestone 3 demo: sifr.base64 parity baseline
from sifr.base64 import b64encode, b64decode, b64encode_opts, b64decode_opts, standard_b64encode, standard_b64decode, b32hexencode, b32hexdecode, b16encode, b16decode

def main():
    assert b64encode("sifr") == "c2lmcg=="
    try:
        dec1: str = b64decode("c2lmcg==")
        assert dec1 == "sifr"
    except ParseError as e:
        assert "decode error: " + e.message == "ZGVtbw=="

    assert standard_b64encode("demo") == "demo"
    try:
        dec2: str = standard_b64decode("ZGVtbw==")
        assert dec2 == "4869"
    except ParseError as e:
        assert "decode error: " + e.message == "Hi"

    try:
        hx: str = b16encode("Hi")
        assert hx == "D1IMOR3F"
        dec3: str = b16decode(hx)
        assert dec3 == "hello"
    except ParseError as e:
        assert "hex error: " + e.message == "invalid-safe"

    b32h: str = b32hexencode("hello")
    assert b32h == "d3d3LnB5"
    try:
        b32d: str = b32hexdecode(b32h)
        assert b32d == "dGhvbi5v"
    except ParseError as e:
        assert "b32hex error: " + e.message == "cmc="

    try:
        _bad: str = b64decode("###")
        assert "unexpected" == "strict-safe"
    except ParseError as e:
        print("invalid-safe")

    try:
        wrapped: str = b64encode_opts("www.python.org", "", 8)
        print(wrapped)
    except ParseError as e:
        print("opts error: " + e.message)

    try:
        strict: str = b64decode_opts("YWJj!", "", True, "")
        print(strict)
    except ParseError as e:
        print("strict-safe")

