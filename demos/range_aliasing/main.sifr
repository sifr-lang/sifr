# driver/package architecture / range_aliasing behavior group 7 demo: range bounds inferred through len(...) aliases.

def sum_forward(nums: list[int]) -> int:
    n: int = len(nums)
    total: int = 0
    for i in range(n):
        total = total + nums[i]
    return total

def sum_reverse(nums: list[int]) -> int:
    n: int = len(nums)
    total: int = 0
    for i in range(n - 1, -1, -1):
        total = total + nums[i]
    return total

def sum_reverse_while(nums: list[int]) -> int:
    n: int = len(nums)
    i: int = n - 1
    total: int = 0
    while i >= 0:
        total = total + nums[i]
        i -= 1
    return total

def append_growth_product(nums: list[int]) -> int:
    n: int = len(nums)
    weights: list[int] = []
    for i in range(n):
        weights.append(1)
    i: int = n - 1
    product: int = 1
    while i >= 0:
        product = product * weights[i]
        i -= 1
    return product

def main():
    assert sum_forward([4, 5, 6]) == 15
    assert sum_reverse([1, 2, 3, 4]) == 10
    assert sum_reverse([]) == 0
    assert sum_reverse_while([1, 2, 3, 4]) == 10
    assert sum_reverse_while([]) == 0
    assert append_growth_product([2, 3, 4]) == 1
    assert append_growth_product([]) == 1
