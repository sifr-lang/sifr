# Reference: iter_fix_reversible_iterables
# Reference: canonical-iteration-model-and-lazy-parity-readiness
# canonical-iteration Iterator behavior demo
# Verifies capability-aware reversible typing and homogeneous tuple iteration readiness.


def tail_first(values: Reversible[int]) -> int:
    rev: Iterator[int] = reversed(values)
    first: int | None = next(rev)
    if first is None:
        return 0
    return first


def main() -> None:
    nums: list[int] = [10, 20, 30]
    print(tail_first(nums))

    tup: tuple[int, int, int] = (4, 5, 6)
    total: int = 0
    for item in tup:
        total = total + item
    print(total)

    rev_tup: Iterator[int] = reversed(tup)
    print(list(rev_tup))
