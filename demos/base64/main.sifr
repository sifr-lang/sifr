# base64 base64 parity demo
from sifr.base64 import (
    b64encode, b64decode,
    urlsafe_b64encode, urlsafe_b64decode,
    b16encode, b16decode
)
from sifr.test import assert_vector_eq, assert_bool_vector_eq

def encode_b64_or_empty(payload: str) -> str:
    return b64encode(payload)

def encode_urlsafe_b64_or_empty(payload: str) -> str:
    return urlsafe_b64encode(payload)

def decode_b64_or_empty(payload: str) -> str:
    try:
        decoded: str = b64decode(payload)
        return decoded
    except ParseError as e:
        _ = str("unexpected: " + e.message)
        return ""

def decode_urlsafe_b64_or_empty(payload: str) -> str:
    try:
        decoded: str = urlsafe_b64decode(payload)
        return decoded
    except ParseError as e:
        _ = str("unexpected: " + e.message)
        return ""

def b16_encode_or_empty(payload: str) -> str:
    encoded: str = ""
    try:
        out: str = b16encode(payload)
        encoded = out
    except ParseError as e:
        _ = str("unexpected: " + e.message)
    return encoded

def b16_decode_or_empty(payload: str) -> str:
    decoded: str = ""
    try:
        out: str = b16decode(payload)
        decoded = out
    except ParseError as e:
        _ = str("unexpected: " + e.message)
    return decoded

def collect_positive_actual() -> list[str]:
    actual: list[str] = []
    actual.append(encode_b64_or_empty("foo"))
    actual.append(decode_b64_or_empty("Zm9v"))
    urlsafe_encoded: str = encode_urlsafe_b64_or_empty("hello")
    urlsafe_encoded_for_decode: str = urlsafe_encoded + ""
    actual.append(urlsafe_encoded)
    actual.append(decode_urlsafe_b64_or_empty(urlsafe_encoded_for_decode))

    b16_encoded: str = b16_encode_or_empty("Hi")
    b16_encoded_for_decode: str = b16_encoded + ""
    actual.append(b16_encoded)
    actual.append(b16_decode_or_empty(b16_encoded_for_decode))
    return actual

def collect_decode_actual_ok(inputs: list[str]) -> list[bool]:
    actual_ok: list[bool] = []
    for payload in inputs:
        try:
            decoded: str = b64decode(payload)
            _ = str(decoded)
            actual_ok.append(True)
        except ParseError as e:
            actual_ok.append(False)
    return actual_ok

def main():
    expected: list[str] = ["Zm9v", "foo", "aGVsbG8=", "hello", "4869", "Hi"]
    actual: list[str] = collect_positive_actual()
    assert_vector_eq(actual, expected)

    decode_inputs: list[str] = ["not base64!!!", "Zm9v"]
    expected_ok: list[bool] = [False, True]
    actual_ok: list[bool] = collect_decode_actual_ok(decode_inputs)
    assert_bool_vector_eq(actual_ok, expected_ok)

    print("base64 base64 parity demo: pass")
