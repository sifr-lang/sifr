# Reference: nested_function_part2
# Reference: full-nested-function-pipeline-part2
# Nested-function pipeline part 2 demo
# Proves recursive nested helpers infer their parameter and return types from
# supported call sites and body usage.

def power_two(exp: int) -> int:
    def helper(n):
        if n == 0:
            return 1
        return 2 * helper(n - 1)

    return helper(exp)

def sum_to(limit: int) -> int:
    def helper(i, acc):
        if i > limit:
            return acc
        return helper(i + 1, acc + i)

    return helper(1, 0)

def main():
    assert power_two(10) == 1024
    assert sum_to(10) == 55
