# This program exercises several sysroot features from one typed compiler plan.
from sifr.base64 import b64decode, b64encode
from sifr.hashlib import sha256
from sifr.io import exists


def main() -> None:
    assert not exists("/sifr-authoritative-plan-demo-missing")
    assert sha256(b"").hexdigest() == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

    encoded: str = b64encode("typed dependency metadata")
    try:
        decoded: str = b64decode(encoded)
        assert decoded == "typed dependency metadata"
    except ParseError:
        assert False

    print("authoritative dependency plan: ok")
