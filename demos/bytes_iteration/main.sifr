# Reference: bytes_bytes_iteration
# Reference: first-class-bytes-and-binary-surface-foundation
# bytes-surface-sample demo: iteration, equality, and index semantics

def main() -> None:
    a: bytes = b"\x01\x02\x03"
    b: bytes = b"\x01\x02"
    c: bytes = b + b"\x03"

    assert a == c
    assert len(a) == 3

    idx0: uint8 | None = a[0]
    idx1: uint8 | None = a[1]
    idx2: uint8 | None = a[2]
    if idx0 is not None:
        expected0: uint8 = 1
        assert idx0 == expected0
    else:
        assert False
    if idx1 is not None:
        expected1: uint8 = 2
        assert idx1 == expected1
    else:
        assert False
    if idx2 is not None:
        expected2: uint8 = 3
        assert idx2 == expected2
    else:
        assert False

    acc: int = 0
    items: list[int] = a.to_ints()
    for item in items:
        acc += item
    assert acc == 6
