# Reference: runtime_tempfiles_and_zip
# Reference: runtime-and-file-object-parity-expansion
from sifr.tempfile import mkstemp, mkdtemp
from sifr.io import write_text, exists
from sifr.zipfile import ZipFile
from sifr.os import remove_file, rmdir


def main():
    temp_file: str = ""
    temp_dir: str = ""
    zip_path: str = ""

    tempfile_ok: bool = False
    zip_ok: bool = False
    cleanup_ok: bool = False

    try:
        temp_file_created: str = mkstemp("sifr_runtime_tempfiles_and_zip_")
        temp_dir_created: str = mkdtemp("sifr_runtime_tempfiles_and_zip_")
        temp_file = temp_file_created + ""
        temp_dir = temp_dir_created + ""
        tempfile_ok = exists(temp_file) and exists(temp_dir)

        _w: None = write_text(temp_file, "payload")
        zip_path = temp_file + ".zip"
        archive: ZipFile = ZipFile(zip_path + "")
        _create: None = archive.create()
        _add: None = archive.write("entry.txt", "payload")
        names: list[str] = archive.namelist()
        content: str = archive.read("entry.txt")
        zip_ok = len(names) == 1 and names[0] == "entry.txt" and content == "payload"
    except IOError as e:
        _ = str(e.message)

    try:
        if len(zip_path) > 0 and exists(zip_path):
            _rm_zip: None = remove_file(zip_path)
        if len(temp_file) > 0 and exists(temp_file):
            _rm_file: None = remove_file(temp_file)
        if len(temp_dir) > 0 and exists(temp_dir):
            _rm_dir: None = rmdir(temp_dir)
        cleanup_ok = (len(temp_file) == 0 or not exists(temp_file)) and (len(temp_dir) == 0 or not exists(temp_dir)) and (len(zip_path) == 0 or not exists(zip_path))
    except IOError as e:
        _ = str(e.message)

    assert tempfile_ok
    assert zip_ok
    assert cleanup_ok
    print("runtime_tempfiles_and_zip_zip_lifecycle_demo: ok")
