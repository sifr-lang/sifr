# Forward type references allow functions to mention classes declared later.

# --- Functions using classes defined BELOW ---
# Note: class params are borrowed by default (&T). Copy fields (int) can be
# returned directly, but Move fields (str) need `own` to take ownership.
def get_node_val(node: Node) -> int:
    return node.value

def describe_person(own p: Person) -> str:
    return p.name

# --- Classes defined after the functions that use them ---
class Node:
    value: int

class Person:
    name: str
    age: int

# --- Mutual reference pattern ---
def process(item: Item) -> int:
    return item.priority

class Item:
    priority: int
    label: str

def main():
    n: Node = Node(42)
    assert get_node_val(n) == 42

    p: Person = Person("Alice", 30)
    assert describe_person(p) == "Alice"

    it: Item = Item(5, "urgent")
    assert process(it) == 5
    print("forward_refs: ok")
