# Milestone 1 demo: sifr.env parity baseline
# Demonstrates set/get/unset plus CPython-style getenv default.
from sifr.env import env_get, env_set, env_unset, getenv

def main():
    env_set("SIFR_DEMO_ENV", "demo-value")
    raw: str | None = env_get("SIFR_DEMO_ENV")
    if raw is not None:
        print(raw)

    print(getenv("SIFR_DEMO_ENV", "fallback"))

    env_unset("SIFR_DEMO_ENV")
    print(getenv("SIFR_DEMO_ENV", "fallback"))

    # Invalid keys are safely ignored and never panic.
    env_set("BAD=KEY", "x")
    bad: str | None = env_get("BAD=KEY")
    if bad is None:
        print("invalid-key-safe")

# expect-stdout: demo-value
# expect-stdout: demo-value
# expect-stdout: fallback
# expect-stdout: invalid-key-safe
