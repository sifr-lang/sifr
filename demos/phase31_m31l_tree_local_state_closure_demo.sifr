# Reference: phase31_m31l
# Source issue: phase31-m31l-tree-local-state-closure-execution.md
# Phase 31 m31_l demo: tree local-state closure

class TreeNode:
    val: int
    left: TreeNode | None
    right: TreeNode | None

    def __init__(
        self,
        val: int = 0,
        left: TreeNode | None = None,
        right: TreeNode | None = None,
    ):
        self.val = val
        self.left = left
        self.right = right

def isBalanced(root: TreeNode | None) -> bool:
    def treeHeight(node: TreeNode | None) -> int:
        if node is None:
            return 0
        left = treeHeight(node.left)
        if left == -1:
            return -1
        right = treeHeight(node.right)
        if right == -1:
            return -1
        if abs(left - right) > 1:
            return -1
        return 1 + max(left, right)

    return treeHeight(root) != -1

def main():
    assert isBalanced(None) == True
    assert isBalanced(TreeNode(1, None, None)) == True
