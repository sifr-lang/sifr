from sifr.textwrap import wrap, fill, dedent, indent, shorten
from sifr.test import assert_bool_vector_eq

def collect_wrap_fill_actual() -> list[bool]:
    actual: list[bool] = []
    try:
        lines: list[str] = wrap("alpha\tbeta\ngamma", 10)
        actual.append(str(lines) == "[\"alpha beta\", \"gamma\"]")
    except ValueError as e:
        actual.append(False)

    try:
        filled: str = fill("alpha\tbeta\ngamma", 10)
        actual.append(filled == "alpha beta\ngamma")
    except ValueError as e:
        actual.append(False)
    return actual

def collect_other_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(dedent("  x\n  y") == "x\ny")
    actual.append(indent("x\n \ny", ">> ") == ">> x\n \n>> y")
    actual.append(shorten("alpha beta gamma", 16) == "alpha beta [...]")

    try:
        wrap_empty: list[str] = wrap("", 5)
        actual.append(str(wrap_empty) == "[]")
    except ValueError as e:
        actual.append(False)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_wrap_fill_actual())
    append_all(actual, collect_other_actual())

    assert_bool_vector_eq(actual, expected)
    print("textwrap textwrap parity demo: pass")
