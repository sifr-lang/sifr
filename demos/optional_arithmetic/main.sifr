# Reference: optional_arithmetic
# optional_arithmetic optional arithmetic soundness demo
# Demonstrates that optional arithmetic only works after explicit narrowing.

def safe_add_one(x: int | None) -> int:
    if x is None:
        return 0
    return x + 1

def main():
    print('optional_arithmetic optional arithmetic soundness demo:')
    print(safe_add_one(5))
    print(safe_add_one(None))

    total: int | None = 9
    count: int | None = 3
    if total is not None:
        if count is not None:
            print(total / count)

    missing_total: int | None = None
    if missing_total is None:
        print(0)
