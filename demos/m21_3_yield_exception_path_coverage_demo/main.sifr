# Reference: m21_3
# Source issue: phase21-traversal-completeness-and-control-flow-correctness-execution.md
# m21_3 yield/loop-path coverage demo
# Demonstrates lazy generator iteration through break/else paths.

def gen(flag: bool) -> Iterator[int]:
    i: int = 0
    while i < 2:
        if flag and i == 0:
            break
        yield i
        i += 1
    if not flag and i == 2:
        yield 99


def main():
    print('m21_3 yield/loop-path coverage demo:')
    for v in gen(False):
        print(v)
    for v in gen(True):
        print(v)
