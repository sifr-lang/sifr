# Source issue: intrinsics.md
# intrinsics Demo
#
# This demo showcases the three-tier hybrid stdlib architecture:
# 1. sifr.test is resolved from stdlib/sifr/test.sifr (a .sifr stdlib file)
# 2. sifr.math is resolved via intrinsic fallback (_sifr.math)
# 3. _sifr.* imports are blocked for user code

from sifr.test import assert_eq, assert_true
from sifr.math import sqrt, pi

def main():
    # sifr.test functions come from stdlib/sifr/test.sifr
    assert_eq(1 + 1, 2)
    assert_eq("hello" + " world", "hello world")
    assert_true(True)

    # sifr.math functions come from intrinsic fallback
    result: float = sqrt(16.0)
    assert_true(result == 4.0)
    assert_true(pi > 3.14)

    print("intrinsics demo: all checks passed!")
    assert str("intrinsics demo: all checks passed!") == "intrinsics demo: all checks passed!"
