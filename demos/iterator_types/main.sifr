# Reference: ad_hoc_iter_wave1
# Source issue: ad-hoc-first-class-lazy-iterators-and-python-iterable-protocol-execution.md
# ad-hoc iterator wave 1 demo
# Verifies first-class type-system support for Iterable[T] / Iterator[T].


def sum_iterable(values: Iterable[int]) -> int:
    total: int = 0
    for value in values:
        total = total + value
    return total


def passthrough(own it: Iterator[int]) -> Iterator[int]:
    # Wave 1 is type-system/protocol contract only; runtime iter()/next() lands in wave 2.
    return it


def main() -> None:
    nums: list[int] = [2, 4, 6]
    print(sum_iterable(nums))
