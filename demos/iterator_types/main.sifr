# iterator Iterator behavior demo
# Verifies first-class type-system support for Iterable[T] / Iterator[T].


def sum_iterable(values: Iterable[int]) -> int:
    total: int = 0
    for value in values:
        total = total + value
    return total


def passthrough(own it: Iterator[int]) -> Iterator[int]:
    # Behavior Group 1 is type-system/protocol rules only; runtime iter()/next() lands in behavior group 2.
    return it


def main() -> None:
    nums: list[int] = [2, 4, 6]
    print(sum_iterable(nums))
