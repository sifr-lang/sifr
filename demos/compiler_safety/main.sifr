# Reference: compiler hardening work
# Reference: compiler-feature-history
# Demo: compiler hardening work — Import Errors, Context Managers, Callable Fix
# This demo showcases the three compiler correctness improvements.

from typing import Callable

# ===== 1. Context Manager with Drop-based cleanup =====
# __exit__() is now called on ALL exit paths: normal, return, break, continue

class FileResource:
    path: str

    def __init__(self, path: str):
        self.path = path

    def __enter__(self) -> FileResource:
        return self

    def __exit__(self) -> None:
        pass

class DBConnection:
    name: str

    def __init__(self, name: str):
        self.name = name

    def __enter__(self) -> DBConnection:
        return self

    def __exit__(self) -> None:
        pass

# ===== 2. Callable-as-struct-field =====
# Callable fields emit Box<dyn Fn(...)> for struct fields

class Config:
    value: int
    callback: Callable[[int], int]

    def __init__(self, value: int, callback: Callable[[int], int]):
        self.value = value
        self.callback = callback


def double(x: int) -> int:
    return x * 2

# ===== Demo functions =====

def demo_early_return() -> list[str]:
    output: list[str] = []
    output.append("Opening: data.csv")
    with FileResource("data.csv") as f:
        output.append("Reading: " + f.path)
    output.append("Closing: data.csv")
    output.append("42")
    return output


def main():
    events: list[str] = []

    events.append("=== Context Manager: Normal Exit ===")
    events.append("Opening: config.json")
    with FileResource("config.json") as f:
        events.append("Using: " + f.path)
    events.append("Closing: config.json")

    events.append("=== Context Manager: Early Return ===")
    result_events: list[str] = demo_early_return()
    for item in result_events:
        events.append(item)

    events.append("=== Context Manager: Break in Loop ===")
    i: int = 0
    while i < 3:
        events.append("Connecting: db")
        should_break: bool = False
        with DBConnection("db") as conn:
            if i == 1:
                should_break = True
            else:
                events.append("Query on: " + conn.name)
        events.append("Disconnecting: db")
        if should_break:
            break
        i = i + 1

    events.append("=== Multiple Context Managers ===")
    events.append("Opening: input.txt")
    events.append("Connecting: postgres")
    with FileResource("input.txt") as fin, DBConnection("postgres") as db:
        events.append("Processing with: " + fin.path + " and " + db.name)
    events.append("Disconnecting: postgres")
    events.append("Closing: input.txt")

    events.append("=== Callable Struct Field ===")
    c: Config = Config(21, double)
    c.callback(c.value)
    events.append(str(c.value))

    events.append("=== Compiler Hardening Demo Complete ===")

    assert events == [
        "=== Context Manager: Normal Exit ===",
        "Opening: config.json",
        "Using: config.json",
        "Closing: config.json",
        "=== Context Manager: Early Return ===",
        "Opening: data.csv",
        "Reading: data.csv",
        "Closing: data.csv",
        "42",
        "=== Context Manager: Break in Loop ===",
        "Connecting: db",
        "Query on: db",
        "Disconnecting: db",
        "Connecting: db",
        "Disconnecting: db",
        "=== Multiple Context Managers ===",
        "Opening: input.txt",
        "Connecting: postgres",
        "Processing with: input.txt and postgres",
        "Disconnecting: postgres",
        "Closing: input.txt",
        "=== Callable Struct Field ===",
        "21",
        "=== Compiler Hardening Demo Complete ===",
    ]

    print("Compiler hardening demo trace:")
    for entry in events:
        print(entry)
