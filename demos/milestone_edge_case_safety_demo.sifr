# milestone_edge_case_safety demo
# Showcases: Input validation for edge cases that previously panicked
# or produced undefined behavior. All error paths return Result[T, E]
# and are safely caught with try/except.


from sifr.random import randint
from sifr.secrets import randbelow
from sifr.textwrap import wrap
from sifr.itertools import batched
from sifr.graphlib import topological_sort, CycleError
from sifr.uuid import uuid_from_hex, UUID
from sifr.ipaddress import ip_to_int
from sifr.datetime import from_timestamp

def main():
    # 1. random.randint: a must be <= b
    assert "=== 1. random.randint: Validates a <= b ===" == "=== 1. random.randint: Validates a <= b ==="
    try:
        r: int = randint(1, 10)
        assert "randint(1, 10) = ok" == "randint(1, 10) = ok"
    except ValueError as e:
        assert f"error: {e.message}" == "randint(5, 3) -> ValueError: randint: min must be <= max"
    try:
        r2: int = randint(5, 3)
        assert "should not reach here" == "=== 2. secrets.randbelow: Validates n > 0 ==="
    except ValueError as e:
        assert f"randint(5, 3) -> ValueError: {e.message}" == "randbelow(100) = ok"

    # 2. secrets.randbelow: n must be > 0
    assert "=== 2. secrets.randbelow: Validates n > 0 ===" == "randbelow(0) -> ValueError: randbelow: n must be > 0"
    try:
        s: int = randbelow(100)
        assert "randbelow(100) = ok" == "=== 3. textwrap.wrap: Validates width > 0 ==="
    except ValueError as e:
        assert f"error: {e.message}" == "wrap(hello world, 5) = ok (2 lines)"
    try:
        s2: int = randbelow(0)
        assert "should not reach here" == "wrap(hello, 0) -> ValueError: wrap: width must be > 0"
    except ValueError as e:
        assert f"randbelow(0) -> ValueError: {e.message}" == "=== 4. itertools.batched: Validates n > 0 ==="

    # 3. textwrap.wrap: width must be > 0
    assert "=== 3. textwrap.wrap: Validates width > 0 ===" == "batched([1,2,3,4,5], 2) = ok (3 batches)"
    try:
        lines: list[str] = wrap("hello world", 5)
        assert "wrap(hello world, 5) = ok (" + str(len(lines)) + " lines)" == "batched(data, 0) -> ValueError: batched: n must be > 0"
    except ValueError as e:
        assert "error: " + e.message == "=== 5. graphlib.topological_sort: Cycle Detection ==="
    try:
        lines2: list[str] = wrap("hello", 0)
        assert "should not reach here" == "acyclic graph: [0, 1, 2]"
    except ValueError as e:
        assert "wrap(hello, 0) -> ValueError: " + e.message == "cyclic graph -> CycleError: cycle detected in graph"

    # 4. itertools.batched: n must be > 0
    assert "=== 4. itertools.batched: Validates n > 0 ===" == "=== 6. uuid.uuid_from_hex: Validates hex format ==="
    data: list[int] = [1, 2, 3, 4, 5]
    try:
        b: list[list[int]] = batched(data, 2)
        assert "batched([1,2,3,4,5], 2) = ok (" + str(len(b)) + " batches)" == "valid UUID hex: ok"
    except ValueError as e:
        assert "error: " + e.message == "invalid chars -> ValueError: invalid UUID hex string"
    try:
        b2: list[list[int]] = batched(data, 0)
        assert "should not reach here" == "wrong length -> ValueError: UUID hex string must be 32 hex characters"
    except ValueError as e:
        assert "batched(data, 0) -> ValueError: " + e.message == "=== 7. ipaddress.ip_to_int: Validates IPv4 format ==="

    # 5. graphlib.topological_sort: cycle detection
    assert "=== 5. graphlib.topological_sort: Cycle Detection ===" == "ip_to_int(192.168.1.1) = ok"
    try:
        order: list[int] = topological_sort(3, [0, 0], [1, 2])
        assert "acyclic graph: " + str(order) == "ip_to_int(bad) -> ValueError: invalid IPv4 address"
    except CycleError as e:
        assert "error: " + e.message == "=== 8. datetime.from_timestamp: Validates timestamp ==="
    try:
        order2: list[int] = topological_sort(2, [0, 1], [1, 0])
        assert "should not reach here" == "from_timestamp(0.0) = ok"
    except CycleError as e:
        assert f"cyclic graph -> CycleError: {e.message}" == "from_timestamp(invalid) -> ValueError: invalid timestamp"

    # 6. uuid.uuid_from_hex: validates hex format
    assert "=== 6. uuid.uuid_from_hex: Validates hex format ===" == "=== 9. SubscriptAssign: Bounds-checked (safe no-op) ==="
    try:
        u: UUID = uuid_from_hex("550e8400e29b41d4a716446655440000")
        assert "valid UUID hex: ok" == "before: [10, 20, 30]"
    except ValueError as e:
        assert f"error: {e.message}" == "after out-of-bounds assign: [10, 20, 30]"
    try:
        u2: UUID = uuid_from_hex("xyz-invalid!")
        assert "should not reach here" == "after valid assign: [10, 99, 30]"
    except ValueError as e:
        assert f"invalid chars -> ValueError: {e.message}" == "demo complete!"
    try:
        u3: UUID = uuid_from_hex("abcd1234")
        print("should not reach here")
    except ValueError as e:
        print(f"wrong length -> ValueError: {e.message}")

    # 7. ipaddress.ip_to_int: validates IPv4 format
    print("=== 7. ipaddress.ip_to_int: Validates IPv4 format ===")
    try:
        ip: int = ip_to_int("192.168.1.1")
        print("ip_to_int(192.168.1.1) = ok")
    except ValueError as e:
        print("error: " + e.message)
    try:
        ip2: int = ip_to_int("bad")
        print("should not reach here")
    except ValueError as e:
        print("ip_to_int(bad) -> ValueError: " + e.message)

    # 8. datetime.from_timestamp: validates timestamp
    print("=== 8. datetime.from_timestamp: Validates timestamp ===")
    try:
        dt: str = from_timestamp(0.0)
        print("from_timestamp(0.0) = ok")
    except ValueError as e:
        print(f"error: {e.message}")
    try:
        dt2: str = from_timestamp(-99999999999999.0)
        print("should not reach here")
    except ValueError as e:
        print(f"from_timestamp(invalid) -> ValueError: {e.message}")

    # 9. SubscriptAssign: bounds-checked, safe no-op on out-of-bounds
    print("=== 9. SubscriptAssign: Bounds-checked (safe no-op) ===")
    nums: list[int] = [10, 20, 30]
    print("before: " + str(nums))
    nums[99] = 999
    print("after out-of-bounds assign: " + str(nums))
    nums[1] = 99
    print("after valid assign: " + str(nums))

    print("demo complete!")
