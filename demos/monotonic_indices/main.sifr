# Reference: monotonic_indices
# `range(len(seq))` loops should keep indexed access definite.

def active_indices(flags: list[bool]) -> list[int]:
    out: list[int] = []

    for index in range(len(flags)):
        if flags[index]:
            out.append(index)
    return out


def main():
    assert str(active_indices([True, False, True, True])) == "[0, 2, 3]"
    assert str(active_indices([False, False])) == "[]"
    print("monotonic_indices: ok")
