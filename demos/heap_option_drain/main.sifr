# Reference: heap_option_drain
# `heapq` push/pop should expose ordered values and `None` on exhaustion.

from sifr.heapq import heappush, heappop


def drain_sorted(values: list[int]) -> list[int]:
    heap: list[int] = []
    order: list[int] = []

    for value in values:
        heappush(heap, value)

    while heap:
        item = heappop(heap)
        if item is not None:
            order.append(item)
    return order


def main():
    assert str(drain_sorted([5, 1, 3])) == "[1, 3, 5]"

    heap: list[int] = []
    heappush(heap, 7)
    assert heappop(heap) == 7
    assert heappop(heap) is None
    print("heap_option_drain: ok")
