# Reference: milestone_recursive_types
# Source issue: revised_phase_roadmap_698c629c.md
# Milestone 8: Recursive Types Demo
# Showcases self-referential types with automatic Box<T> wrapping

# === Linked List ===
class ChainCell:
    val: int
    next: ChainCell | None

    def __init__(self, val: int, next: ChainCell | None):
        self.val = val
        self.next = next

# === Binary Tree ===
class BinaryBranch:
    val: int
    left: BinaryBranch | None
    right: BinaryBranch | None

    def __init__(self, val: int, left: BinaryBranch | None, right: BinaryBranch | None):
        self.val = val
        self.left = left
        self.right = right

def main():
    # Build a linked list: 1 -> 2 -> 3 -> None
    n3: ChainCell = ChainCell(3, None)
    n2: ChainCell = ChainCell(2, n3)
    n1: ChainCell = ChainCell(1, n2)
    print(n1.val)  # 1

    # Build a binary tree:
    #       1
    #      / \
    #     2   3
    left: BinaryBranch = BinaryBranch(2, None, None)
    right: BinaryBranch = BinaryBranch(3, None, None)
    root: BinaryBranch = BinaryBranch(1, left, right)
    print(root.val)  # 1
