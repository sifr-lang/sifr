# milestone_iteration_v2 Demo

from typing import Dict

def main():
    output: list[str] = []

    # String iteration
    s: str = "hello"
    for c in s:
        output.append(c)

    # Dict iteration (keys)
    d: dict[str, int] = {"a": 1, "b": 2}
    for k in d:
        output.append(k)

    assert output == ["h", "e", "l", "l", "o", "a", "b"]
