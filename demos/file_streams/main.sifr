# Reference: runtime_file_streams
# Reference: runtime-and-file-object-parity-expansion
from sifr.io import write_text, read_text, read_lines, exists
from sifr.os import remove_file


def main():
    path: str = "/tmp/sifr_runtime_file_streams_demo.txt"
    text_ok: bool = False
    binary_ok: bool = False
    cleanup_ok: bool = False

    try:
        _w: None = write_text(path, "alpha\nbeta")
        lines: list[str] = read_lines(path)
        text_ok = len(lines) == 2 and lines[0] == "alpha" and lines[1] == "beta"

        wb = open(path, "wb")
        _bw: None = wb.write_bytes(b"raw-bytes")
        wb.close()

        rb = open(path, "rb")
        payload: bytes = rb.read_bytes()
        rb.close()
        binary_ok = payload == b"raw-bytes"
    except IOError as e:
        _ = str(e.message)

    try:
        if exists(path):
            _rm: None = remove_file(path)
        cleanup_ok = not exists(path)
    except IOError as e:
        _ = str(e.message)

    assert text_ok
    assert binary_ok
    assert cleanup_ok
    print("runtime_file_streams_hierarchy_demo: ok")
