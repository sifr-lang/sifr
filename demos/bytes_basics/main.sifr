# bytes-surface-sample demo: first-class bytes core behavior

def total(data: bytes) -> int:
    out: int = 0
    values: list[int] = data.to_ints()
    for value in values:
        out += value
    return out

def main() -> None:
    payload: bytes = b"sifr"
    suffix: bytes = b"\x00\x01"
    combined: bytes = payload + suffix

    assert len(combined) == 6
    head: uint8 | None = combined[0]
    if head is not None:
        expected_head: uint8 = 115
        assert head == expected_head
    else:
        assert False

    window: bytes = combined[1:4]
    assert total(window) == 321

    raw: list[int] = window.to_ints()
    assert raw == [105, 102, 114]
