# Reference: core_stdlib
# Reference: core-stdlib
# ============================================================
# Feature Demo: Core Standard Library Demo
# ============================================================
# Demonstrates the stdlib infrastructure and all 5 core modules:
#   sifr.io    — File I/O
#   sifr.json  — JSON parsing
#   sifr.env   — Environment variables
#   sifr.os    — OS operations
#   sifr.math  — Math functions and constants
# ============================================================

from sifr.io import read_text, write_text, exists, read_lines
from sifr.json import JsonValue, json_loads
from sifr.env import getenv_opt, setenv
from sifr.os import run_command
from sifr.math import sqrt, floor, ceil, pi, e

def main():
    # ----------------------------------------------------------
    # 1. sifr.io — File I/O operations
    # ----------------------------------------------------------
    print("=== sifr.io ===")

    # Write a file
    try:
        _w: None = write_text("/tmp/sifr_demo.txt", "Hello from Sifr!\nLine 2")
    except IOError as err:
        print(f"write error: {err.message}")

    # Check it exists
    file_exists: bool = exists("/tmp/sifr_demo.txt")
    print(f"File exists: {file_exists}")

    # Read it back
    try:
        content: str = read_text("/tmp/sifr_demo.txt")
        print(f"Content: {content}")
    except IOError as err:
        print(f"read error: {err.message}")

    # Read as lines
    try:
        lines: list[str] = read_lines("/tmp/sifr_demo.txt")
        print(f"Line count: {len(lines)}")
    except IOError as err:
        print(f"lines error: {err.message}")

    # ----------------------------------------------------------
    # 2. sifr.json — JSON parsing
    # ----------------------------------------------------------
    print("=== sifr.json ===")

    try:
        data: JsonValue = json_loads("{\"language\":\"sifr\",\"version\":1}")
        print(f"Parsed JSON: {data}")
    except JSONDecodeError as err:
        print(f"json error: {err.message}")

    # ----------------------------------------------------------
    # 3. sifr.env — Environment variables
    # ----------------------------------------------------------
    print("=== sifr.env ===")

    _: None = setenv("SIFR_DEMO", "active")
    val: str | None = getenv_opt("SIFR_DEMO")
    if val is not None:
        print(f"SIFR_DEMO = {val}")

    missing: str | None = getenv_opt("SIFR_NONEXISTENT")
    if missing is None:
        print("SIFR_NONEXISTENT not set")

    # ----------------------------------------------------------
    # 4. sifr.os — OS operations
    # ----------------------------------------------------------
    print("=== sifr.os ===")

    try:
        output: str = run_command("echo Sifr OS module works")
        print(output)
    except IOError as err:
        print(f"os error: {err.message}")

    # ----------------------------------------------------------
    # 5. sifr.math — Math functions and constants
    # ----------------------------------------------------------
    print("=== sifr.math ===")

    print(f"sqrt(25.0) = {sqrt(25.0)}")
    print(f"floor(3.7) = {floor(3.7)}")
    print(f"ceil(3.2) = {ceil(3.2)}")
    print(f"pi = {pi}")
    print(f"e = {e}")

    print("=== Demo complete ===")
