from sifr.shutil import copy, move_file, rmtree, which, disk_usage
from sifr.io import write_text, read_text, exists
from sifr.os import mkdir, run_command
from sifr.tempfile import mktemp_path
from sifr.test import assert_bool_vector_eq


def collect_copy_move_tree_actual() -> list[bool]:
    actual: list[bool] = []
    base: str = mktemp_path("sifr_shutil_shutil_demo_")
    src: str = base + "/src.txt"
    copied: str = base + "/copied.txt"
    moved: str = base + "/moved.txt"
    tree: str = base + "/tree"
    nested: str = tree + "/nested.txt"

    copy_ok: bool = False
    move_ok: bool = False
    rmtree_ok: bool = False
    try:
        _mk: None = mkdir(base)
        _w: None = write_text(src, "demo")
        _cp: None = copy(src, copied)
        copied_content_ok: bool = False
        try:
            copied_content: str = read_text(copied)
            copied_content_ok = copied_content == "demo"
        except IOError as e:
            _ = str(e.message)
        copy_ok = exists(src) and exists(copied) and copied_content_ok

        _mv: None = move_file(copied, moved)
        move_ok = exists(moved) and (not exists(copied))

        _mk_tree: None = mkdir(tree)
        _w_nested: None = write_text(nested, "nested")
        _rm_tree: None = rmtree(tree)
        rmtree_ok = not exists(tree)
    except IOError as e:
        _ = str(e.message)

    actual.append(copy_ok)
    actual.append(move_ok)
    actual.append(rmtree_ok)
    return actual


def collect_tooling_and_cleanup_actual() -> list[bool]:
    actual: list[bool] = []
    base: str = mktemp_path("sifr_shutil_shutil_demo_cleanup_")
    base_ready: bool = False
    try:
        _mk: None = mkdir(base)
        base_ready = exists(base)
    except IOError as e:
        _ = str(e.message)

    which_ok: bool = False
    tool: str | None = which("sh")
    if tool is not None:
        which_ok = len(tool) > 0
    actual.append(which_ok)

    usage: list[int] = disk_usage(base + "")
    usage_ok: bool = False
    if len(usage) == 3:
        total: int | None = usage[0]
        if total is not None:
            usage_ok = total > 0
    usage_ok = usage_ok and base_ready
    actual.append(usage_ok)

    missing_copy_rejected: bool = False
    try:
        _bad: None = copy(base + "/missing_src.txt", base + "/missing_dst.txt")
    except IOError as e:
        _ = str(e.message)
        missing_copy_rejected = True
    actual.append(missing_copy_rejected)

    cleanup_ok: bool = False
    try:
        _cleanup: str = run_command("rm -rf " + base)
        cleanup_ok = not exists(base)
    except IOError as e:
        _ = str(e.message)
        cleanup_ok = not exists(base)
    actual.append(cleanup_ok)
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_copy_move_tree_actual())
    append_all(actual, collect_tooling_and_cleanup_actual())

    assert_bool_vector_eq(actual, expected)
    print("shutil shutil parity demo: pass")
