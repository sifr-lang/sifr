# milestone_new_modules_demo.sifr
# Demonstrates all new modules added in milestone_new_modules:
# operator, calendar, html, sys, subprocess, configparser, gzip, zipfile

# expect-stdout: === operator ===
# expect-stdout: add(10, 5) = 15
# expect-stdout: sub(10, 5) = 5
# expect-stdout: mul(3, 4) = 12
# expect-stdout: floordiv(7, 2) = 3
# expect-stdout: mod_val(7, 2) = 1
# expect-stdout: neg(42) = -42
# expect-stdout: lt(3, 5) = true
# expect-stdout: eq(5, 5) = true
# expect-stdout: itemgetter([1,2,3], 1) = 2
# expect-stdout: === calendar ===
# expect-stdout: isleap(2000) = true
# expect-stdout: isleap(1900) = false
# expect-stdout: isleap(2024) = true
# expect-stdout: weekday(2024,1,1) = 0
# expect-stdout: monthrange(2024,2)[1] = 29
# expect-stdout: === html ===
# expect-stdout: escape(<b>Hi & Bye</b>) = &lt;b&gt;Hi &amp; Bye&lt;/b&gt;
# expect-stdout: unescape(&lt;b&gt;Hi &amp; Bye&lt;/b&gt;) = <b>Hi & Bye</b>
# expect-stdout: === sys ===
# expect-stdout: version = sifr 0.1.0
# expect-stdout: maxsize > 0 = true
# expect-stdout: === subprocess ===
# expect-stdout: echo hello = hello
# expect-stdout: === configparser ===
# expect-stdout: host = db.example.com
# expect-stdout: port = 5432
# expect-stdout: has_host = true
# expect-stdout: has_missing = false
# expect-stdout: === gzip ===
# expect-stdout: compressed len > 0 = true
# expect-stdout: decompressed = Sifr stdlib gzip compression!
# expect-stdout: === zipfile ===
# expect-stdout: zip created = true
# expect-stdout: zip content = Hello from ZipFile!
# expect-stdout: zip namelist len = 1

from sifr.operator import add, sub, mul, floordiv, mod_val, neg, lt, eq, itemgetter
from sifr.calendar import isleap, weekday, monthrange
from sifr.html import escape, unescape
from sifr.sys import version, maxsize
from sifr.subprocess import run
from sifr.configparser import ConfigParser
from sifr.gzip import compress, decompress
from sifr.zipfile import ZipFile
from sifr.os import remove_file

def demo_operator() -> None:
    print("=== operator ===")
    print("add(10, 5) = " + str(add(10, 5)))
    print("sub(10, 5) = " + str(sub(10, 5)))
    print("mul(3, 4) = " + str(mul(3, 4)))
    print("floordiv(7, 2) = " + str(floordiv(7, 2)))
    print("mod_val(7, 2) = " + str(mod_val(7, 2)))
    print("neg(42) = " + str(neg(42)))
    print("lt(3, 5) = " + str(lt(3, 5)))
    print("eq(5, 5) = " + str(eq(5, 5)))
    items: list[int] = [1, 2, 3]
    print("itemgetter([1,2,3], 1) = " + str(itemgetter(items, 1)))

def demo_calendar() -> None:
    print("=== calendar ===")
    print("isleap(2000) = " + str(isleap(2000)))
    print("isleap(1900) = " + str(isleap(1900)))
    print("isleap(2024) = " + str(isleap(2024)))
    wd: int = weekday(2024, 1, 1)
    print("weekday(2024,1,1) = " + str(wd))
    mr: list[int] = monthrange(2024, 2)
    print("monthrange(2024,2)[1] = " + str(mr[1]))

def demo_html() -> None:
    print("=== html ===")
    s: str = "<b>Hi & Bye</b>"
    esc: str = escape(s)
    print("escape(<b>Hi & Bye</b>) = " + esc)
    unesc: str = unescape(esc)
    print("unescape(&lt;b&gt;Hi &amp; Bye&lt;/b&gt;) = " + unesc)

def demo_sys() -> None:
    print("=== sys ===")
    print("version = " + version())
    ms: int = maxsize()
    print("maxsize > 0 = " + str(ms > 0))

def demo_subprocess() -> None:
    print("=== subprocess ===")
    try:
        result: str = run("echo hello")
        print("echo hello = " + result)
    except IOError as e:
        print("error: " + e.message)

def demo_configparser() -> None:
    print("=== configparser ===")
    config: ConfigParser = ConfigParser()
    config.read_string("[database]\nhost = db.example.com\nport = 5432\n")
    print("host = " + config.get("database", "host"))
    print("port = " + config.get("database", "port"))
    print("has_host = " + str(config.has_option("database", "host")))
    print("has_missing = " + str(config.has_option("database", "missing")))

def demo_gzip() -> None:
    print("=== gzip ===")
    data: str = "Sifr stdlib gzip compression!"
    compressed: list[int] = compress(data)
    print("compressed len > 0 = " + str(len(compressed) > 0))
    try:
        decompressed: str = decompress(compressed)
        print("decompressed = " + decompressed)
    except IOError as e:
        print("error: " + e.message)

def demo_zipfile() -> None:
    print("=== zipfile ===")
    zf: ZipFile = ZipFile("/tmp/sifr_demo_zipfile.zip")
    try:
        _c: None = zf.create()
        print("zip created = true")
    except IOError as e:
        print("create error: " + e.message)
    try:
        _w: None = zf.write("demo.txt", "Hello from ZipFile!")
        content: str = zf.read("demo.txt")
        print("zip content = " + content)
        names: list[str] = zf.namelist()
        print("zip namelist len = " + str(len(names)))
    except IOError as e:
        print("zip error: " + e.message)
    try:
        _r: None = remove_file("/tmp/sifr_demo_zipfile.zip")
    except IOError as e:
        pass

def main():
    demo_operator()
    demo_calendar()
    demo_html()
    demo_sys()
    demo_subprocess()
    demo_configparser()
    demo_gzip()
    demo_zipfile()
