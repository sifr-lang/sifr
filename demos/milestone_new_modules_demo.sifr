# milestone_new_modules_demo.sifr
# Demonstrates all new modules added in milestone_new_modules:
# operator, calendar, html, sys, subprocess, configparser, gzip, zipfile


from sifr.operator import add, sub, mul, floordiv, mod_val, neg, lt, eq, itemgetter
from sifr.calendar import isleap, weekday, monthrange
from sifr.html import escape, unescape
from sifr.sys import version, maxsize
from sifr.subprocess import run
from sifr.configparser import ConfigParser
from sifr.gzip import compress, decompress
from sifr.zipfile import ZipFile
from sifr.os import remove_file

def demo_operator() -> None:
    assert "=== operator ===" == "=== operator ==="
    assert "add(10, 5) = " + str(add(10, 5)) == "add(10, 5) = 15"
    assert "sub(10, 5) = " + str(sub(10, 5)) == "sub(10, 5) = 5"
    assert "mul(3, 4) = " + str(mul(3, 4)) == "mul(3, 4) = 12"
    assert "floordiv(7, 2) = " + str(floordiv(7, 2)) == "floordiv(7, 2) = 3"
    assert "mod_val(7, 2) = " + str(mod_val(7, 2)) == "mod_val(7, 2) = 1"
    assert "neg(42) = " + str(neg(42)) == "neg(42) = -42"
    assert "lt(3, 5) = " + str(lt(3, 5)) == "lt(3, 5) = true"
    assert "eq(5, 5) = " + str(eq(5, 5)) == "eq(5, 5) = true"
    items: list[int] = [1, 2, 3]
    assert "itemgetter([1,2,3], 1) = " + str(itemgetter(items, 1)) == "itemgetter([1,2,3], 1) = 2"

def demo_calendar() -> None:
    assert "=== calendar ===" == "=== calendar ==="
    assert "isleap(2000) = " + str(isleap(2000)) == "isleap(2000) = true"
    assert "isleap(1900) = " + str(isleap(1900)) == "isleap(1900) = false"
    assert "isleap(2024) = " + str(isleap(2024)) == "isleap(2024) = true"
    wd: int = weekday(2024, 1, 1)
    assert "weekday(2024,1,1) = " + str(wd) == "weekday(2024,1,1) = 0"
    mr: list[int] = monthrange(2024, 2)
    assert "monthrange(2024,2)[1] = " + str(mr[1]) == "monthrange(2024,2)[1] = 29"

def demo_html() -> None:
    assert "=== html ===" == "=== html ==="
    s: str = "<b>Hi & Bye</b>"
    esc: str = escape(s)
    assert "escape(<b>Hi & Bye</b>) = " + esc == "escape(<b>Hi & Bye</b>) = &lt;b&gt;Hi &amp; Bye&lt;/b&gt;"
    unesc: str = unescape(esc)
    assert "unescape(&lt;b&gt;Hi &amp; Bye&lt;/b&gt;) = " + unesc == "unescape(&lt;b&gt;Hi &amp; Bye&lt;/b&gt;) = <b>Hi & Bye</b>"

def demo_sys() -> None:
    assert "=== sys ===" == "=== sys ==="
    assert "version = " + version() == "version = sifr 0.1.0"
    ms: int = maxsize()
    assert "maxsize > 0 = " + str(ms > 0) == "maxsize > 0 = true"

def demo_subprocess() -> None:
    assert "=== subprocess ===" == "=== subprocess ==="
    try:
        result: str = run("echo hello")
        assert "echo hello = " + result == "echo hello = hello"
    except IOError as e:
        assert "error: " + e.message == "=== configparser ==="

def demo_configparser() -> None:
    assert "=== configparser ===" == "host = db.example.com"
    config: ConfigParser = ConfigParser()
    config.read_string("[database]\nhost = db.example.com\nport = 5432\n")
    assert "host = " + config.get("database", "host") == "port = 5432"
    assert "port = " + config.get("database", "port") == "has_host = true"
    assert "has_host = " + str(config.has_option("database", "host")) == "has_missing = false"
    assert "has_missing = " + str(config.has_option("database", "missing")) == "=== gzip ==="

def demo_gzip() -> None:
    assert "=== gzip ===" == "compressed len > 0 = true"
    data: str = "Sifr stdlib gzip compression!"
    compressed: list[int] = compress(data)
    assert "compressed len > 0 = " + str(len(compressed) > 0) == "decompressed = Sifr stdlib gzip compression!"
    try:
        decompressed: str = decompress(compressed)
        assert "decompressed = " + decompressed == "=== zipfile ==="
    except IOError as e:
        assert "error: " + e.message == "zip created = true"

def demo_zipfile() -> None:
    assert "=== zipfile ===" == "zip content = Hello from ZipFile!"
    zf: ZipFile = ZipFile("/tmp/sifr_demo_zipfile.zip")
    try:
        _c: None = zf.create()
        assert "zip created = true" == "zip namelist len = 1"
    except IOError as e:
        print("create error: " + e.message)
    try:
        _w: None = zf.write("demo.txt", "Hello from ZipFile!")
        content: str = zf.read("demo.txt")
        print("zip content = " + content)
        names: list[str] = zf.namelist()
        print("zip namelist len = " + str(len(names)))
    except IOError as e:
        print("zip error: " + e.message)
    try:
        _r: None = remove_file("/tmp/sifr_demo_zipfile.zip")
    except IOError as e:
        pass

def main():
    demo_operator()
    demo_calendar()
    demo_html()
    demo_sys()
    demo_subprocess()
    demo_configparser()
    demo_gzip()
    demo_zipfile()
