# Reference: phase31
# Source issue: phase31-m31a-sliding-window-left-pointer-execution.md
# Phase 31 m31_a slice 3 demo
# Shows the compiler proving canonical sliding-window left pointers safe when a
# zero-based pointer advances monotonically under a range(len(seq)) driver.

def maxVowels(s: str, k: int) -> int:
    l, res, total = 0, 0, 0
    vowels = "aeiou"

    for r in range(len(s)):
        if s[r] in vowels:
            total += 1
        if (r - l + 1) > k:
            if s[l] in vowels:
                total -= 1
            l += 1
        res = max(res, total)
    return res

def lengthOfLongestSubstring(s: str) -> int:
    seen = set()
    l = 0
    best = 0

    for r in range(len(s)):
        while s[r] in seen:
            seen.remove(s[l])
            l += 1
        seen.add(s[r])
        best = max(best, r - l + 1)
    return best

def main():
    assert str(maxVowels("abciiidef", 3)) == '3'
    assert str(maxVowels("aeiou", 2)) == '2'
    assert str(lengthOfLongestSubstring("abcabcbb")) == '3'
    assert str(lengthOfLongestSubstring("pwwkew")) == '3'
