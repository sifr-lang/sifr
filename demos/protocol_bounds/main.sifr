# Reference: protocol_bounds
# protocol_bounds protocol-bound strictness closure demo
# Demonstrates strict protocol-bound validation when forwarding TypeVars.

def keep_comparable[T: Comparable](x: T) -> T:
    return x

def relay_comparable[U: Comparable](x: U) -> U:
    return keep_comparable(x)

def main():
    print('protocol_bounds protocol bound strictness closure demo:')
    print(relay_comparable(9))
    print(relay_comparable("ok"))
