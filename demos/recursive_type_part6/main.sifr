# Reference: ad_hoc_recursive_type_part6
# Source issue: ad-hoc-full-recursive-type-feature-part6-execution.md
# Ad hoc recursive type feature, part 6:
# the full regression matrix closes with runnable recursive classes and aliases.

class TreeNode:
    val: int
    left: TreeNode | None
    right: TreeNode | None

    def __init__(self, val: int, left: TreeNode | None, right: TreeNode | None):
        self.val = val
        self.left = left
        self.right = right

def tree_value_sum(node: TreeNode | None) -> int:
    if not node:
        return 0
    left: TreeNode | None = node.left
    right: TreeNode | None = node.right
    return node.val + tree_value_sum(left) + tree_value_sum(right)

type Packet[T] = T | list[Packet[T]]

def main():
    left: TreeNode = TreeNode(2, None, None)
    right: TreeNode = TreeNode(3, None, None)
    root: TreeNode = TreeNode(1, left, right)
    assert tree_value_sum(root) == 6
    print("tree sum ok")
    print("packet alias declared")
