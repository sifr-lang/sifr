# Demo: milestone_codegen_structural_passes (RawCode-zero slice for datetime intrinsics)
from sifr.datetime import now, today, from_timestamp


def main():
    current = now()
    current_iso: str = current.isoformat()
    current_has_t: bool = "T" in current_iso
    print(f"current_has_t = {current_has_t}")

    day = today()
    today_iso: str = day.isoformat()
    today_has_dash: bool = "-" in today_iso
    print(f"today_has_dash = {today_has_dash}")

    try:
        epoch: str = from_timestamp(0.0)
        print(f"from_timestamp_ok = {epoch}")
    except ValueError as e:
        print(f"unexpected_error = {e.message}")

    try:
        bad: str = from_timestamp(-99999999999999.0)
        print(f"from_timestamp_invalid_unexpected = {bad}")
    except ValueError as e:
        print(f"from_timestamp_invalid = {e.message}")


# expect-stdout: current_has_t = true
# expect-stdout: today_has_dash = true
# expect-stdout: from_timestamp_ok = 1970-01-01T00:00:00
# expect-stdout: from_timestamp_invalid = invalid timestamp
