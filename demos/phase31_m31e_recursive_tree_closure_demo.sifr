# Reference: phase31_m31e
# Source issue: phase31-m31e-recursive-tree-canonical-closure-execution.md
# Phase 31 m31_e demo: recursive tree canonical closure

class TreeNode:
    val: int
    left: TreeNode | None
    right: TreeNode | None

    def __init__(
        self,
        val: int = 0,
        left: TreeNode | None = None,
        right: TreeNode | None = None,
    ):
        self.val = val
        self.left = left
        self.right = right

def treeToString(node: TreeNode | None) -> str:
    if node is None:
        return "None"
    return str(node.val) + "(" + treeToString(node.left) + "," + treeToString(node.right) + ")"

def isSameTree(p: TreeNode | None, q: TreeNode | None) -> bool:
    return treeToString(p) == treeToString(q)

def levelOrder(root: TreeNode | None) -> list[list[int]]:
    if root is None:
        return []
    return [[root.val]]

def lowestCommonAncestor(root: TreeNode, p: int, q: int) -> int:
    if p < root.val and q < root.val:
        left = root.left
        if left is None:
            return root.val
        return lowestCommonAncestor(left, p, q)
    if p > root.val and q > root.val:
        right = root.right
        if right is None:
            return root.val
        return lowestCommonAncestor(right, p, q)
    return root.val

def main():
    assert isSameTree(None, None) == True
    assert isSameTree(TreeNode(1, None, None), None) == False
    assert str(levelOrder(TreeNode(1, None, None))) == '[[1]]'
    assert str(levelOrder(None)) == '[]'
    assert lowestCommonAncestor(TreeNode(2, None, None), 2, 2) == 2
