# Reference: test_runner
# Reference: test-runner
# ============================================================
# Test Runner Demo: Arithmetic Tests
# ============================================================
# Demonstrates sifr.test assertions with arithmetic operations
# ============================================================

from sifr.test import assert_eq, assert_ne, assert_true, assert_false

def test_addition():
    assert_eq(1 + 1, 2)
    assert_eq(10 + 20, 30)

def test_subtraction():
    assert_eq(10 - 3, 7)
    assert_eq(0 - 5, -5)

def test_multiplication():
    assert_eq(3 * 4, 12)
    assert_eq(-2 * 3, -6)

def test_comparison():
    assert_true(10 > 5)
    assert_true(3 <= 3)
    assert_false(1 > 2)
    assert_false(5 == 6)

def test_not_equal():
    assert_ne(1, 2)
    assert_ne(10, 20)
