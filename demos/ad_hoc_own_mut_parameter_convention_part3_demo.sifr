# Part 3 demo: canonical `own mut` Rust emission plus 1299-style consume-mutate-return.

def replaceElements(own mut arr: list[int]) -> list[int]:
    rightMax = -1
    for i in range(len(arr) - 1, -1, -1):
        newMax = max(rightMax, arr[i])
        arr[i] = rightMax
        rightMax = newMax
    return arr

def main():
    print(str(replaceElements([17, 18, 5, 4, 6, 1])))
