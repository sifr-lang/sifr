# Reference: optional_indexing
# optional_indexing remove data-dependent unwrap/expect demo
#
# Positive path: safe indexing remains Option-based and does not rely on
# generated data-dependent unwrap/expect in user-facing paths.

def main():
    items: list[int] = [10, 20, 30]
    value: int | None = items[1]
    if value is not None:
        print("optional_indexing remove data-dependent unwrap/expect demo:")
        print(value)
    else:
        print("optional_indexing remove data-dependent unwrap/expect demo:")
        print("missing")
