# milestone_narrowing_v2 Demo
# Showcases narrowing fixes in this milestone

# --- Fix 1: Early-return narrowing ---
# expect-stdout: Early return: 11

# --- Fix 2: And-based compound narrowing ---
# expect-stdout: And narrowing: 42

def safe_increment(x: int | None) -> int:
    if x is None:
        return 0
    # x is narrowed to int after early return
    return x + 1

def safe_multiply(a: int | None, b: int | None) -> int:
    if a is not None and b is not None:
        # Both a and b are narrowed to int
        return a * b
    return 0

def main():
    result1: int = safe_increment(10)
    print(f"Early return: {result1}")

    result2: int = safe_multiply(6, 7)
    print(f"And narrowing: {result2}")
