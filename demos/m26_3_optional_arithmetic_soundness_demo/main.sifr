# Reference: m26_3
# Source issue: phase26-type-system-soundness-execution.md
# m26_3 optional arithmetic soundness demo
# Demonstrates that optional arithmetic only works after explicit narrowing.

def safe_add_one(x: int | None) -> int:
    if x is None:
        return 0
    return x + 1

def safe_divide(total: int | None, count: int) -> float:
    if total is None:
        return 0.0
    return total / count

def main():
    print('m26_3 optional arithmetic soundness demo:')
    print(safe_add_one(5))
    print(safe_add_one(None))
    print(safe_divide(9, 3))
    print(safe_divide(None, 3))
