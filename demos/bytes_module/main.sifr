# bytes_module bytes parity demo
from sifr.test import assert_vector_eq, assert_bool_vector_eq

def render_opt_int(own value: int | None) -> str:
    if value is None:
        return "None"
    return str(value)

def collect_primary_actual(payload: bytes) -> list[str]:
    actual: list[str] = []
    actual.append(str(payload.count(115)))
    actual.append(render_opt_int(payload.find(45)))
    actual.append(str(payload.startswith(b"bytes")))
    actual.append(str(payload.endswith(b"e30")))
    return actual

def bytes_to_hex_or_empty(payload: bytes) -> str:
    try:
        hx: str = payload.hex()
        return hx
    except ParseError as e:
        _ = str(e.message)
        return ""

def bytes_from_hex_to_text_or_empty(payload: str) -> str:
    try:
        parsed: bytes = bytes.from_hex(payload)
        txt: str = parsed.decode()
        return txt
    except ParseError as e:
        _ = str(e.message)
        return ""

def collect_invalid_actual_ok() -> list[bool]:
    invalid_actual_ok: list[bool] = []
    try:
        odd: bytes = bytes.from_hex("abc")
        _ = str(len(odd))
        invalid_actual_ok.append(True)
    except ParseError as e:
        invalid_actual_ok.append(False)
    try:
        bad_utf8: str = b"\xff".decode()
        _ = str(bad_utf8)
        invalid_actual_ok.append(True)
    except ParseError as e:
        invalid_actual_ok.append(False)
    return invalid_actual_ok

def main():
    payload: bytes = b"bytes-bytes_module"
    expected: list[str] = ["2", "5", "true", "false"]
    actual: list[str] = collect_primary_actual(payload)
    assert_vector_eq(actual, expected)

    hex_text: str = bytes_to_hex_or_empty(b"Hi")
    assert str(len(hex_text) > 0) == "true"
    assert str(hex_text) == "4869"

    roundtrip_text: str = bytes_from_hex_to_text_or_empty("48 69")
    assert str(len(roundtrip_text) > 0) == "true"
    assert str(roundtrip_text) == "Hi"

    invalid_expected_ok: list[bool] = [False, False]
    invalid_actual_ok: list[bool] = collect_invalid_actual_ok()
    assert_bool_vector_eq(invalid_actual_ok, invalid_expected_ok)

    print("bytes_module bytes parity demo: pass")
