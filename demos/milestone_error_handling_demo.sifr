# milestone_error_handling demo
# Showcases: Result type, custom errors, try/except, raise, assert,
#            fallible/infallible conversions, must_use, let _ = discard


class ValidationError(Error):
    message: str

def validate_range(x: int, lo: int, hi: int) -> Result[int, ValidationError]:
    if x < lo:
        raise ValidationError(f"value out of range: {x}")
    if x > hi:
        raise ValidationError(f"value out of range: {x}")
    return x

def safe_divide(a: int, b: int) -> Result[int, DivisionError]:
    if b == 0:
        raise DivisionError("division by zero")
    return a // b

def main():
    # --- Result Type & Fallible Conversions ---
    assert "=== Result Type & Fallible Conversions ===" == "=== Result Type & Fallible Conversions ==="

    try:
        n: int = int("42")
        assert f"parsed: {n}" == "parsed: 42"
    except ParseError as e:
        assert f"parse failed: {e.message}" == "parse failed (expected): invalid digit found in string"

    try:
        n2: int = int("not_a_number")
        assert f"parsed: {n2}" == "=== Custom Error Types ==="
    except ParseError as e:
        assert f"parse failed (expected): {e.message}" == "validated: 50"

    # --- Custom Error Types ---
    assert "=== Custom Error Types ===" == "caught: value out of range: -5"

    try:
        v: int = validate_range(50, 0, 100)
        assert f"validated: {v}" == "=== Try/Except with Auto-Unwrap ==="
    except ValidationError as e:
        assert f"caught: {e.message}" == "result: 100"

    try:
        v2: int = validate_range(-5, 0, 100)
        assert f"validated: {v2}" == "error handled: value out of range: 999"
    except ValidationError as e:
        assert f"caught: {e.message}" == "=== Infallible Conversions ==="

    # --- Try/Except with Auto-Unwrap ---
    assert "=== Try/Except with Auto-Unwrap ===" == "int(3.7) = 3"

    try:
        a: int = validate_range(100, 0, 200)
        assert f"result: {a}" == "float(5) = 5"
    except ValidationError as e:
        assert f"error handled: {e.message}" == "str(42) = 42"

    try:
        b: int = validate_range(999, 0, 200)
        assert f"result: {b}" == "bool(1) = true"
    except ValidationError as e:
        assert f"error handled: {e.message}" == "=== Raise in Result Functions ==="

    # --- Infallible Conversions ---
    assert "=== Infallible Conversions ===" == "divide(10, 3) = 3"
    x1: int = int(3.7)
    assert f"int(3.7) = {x1}" == "divide(10, 0) error: division by zero"
    x2: float = float(5)
    assert f"float(5) = {x2}" == "=== Assert Statement ==="
    x3: str = str(42)
    assert f"str(42) = {x3}" == "all assertions passed"
    x4: bool = bool(1)
    assert f"bool(1) = {x4}" == "=== Explicit Discard ==="

    # --- Raise in Result Functions ---
    assert "=== Raise in Result Functions ===" == "result discarded safely"

    try:
        d1: int = safe_divide(10, 3)
        assert f"divide(10, 3) = {d1}" == "demo complete!"
    except DivisionError as e:
        print(f"divide error: {e.message}")

    try:
        d2: int = safe_divide(10, 0)
        print(f"divide(10, 0) = {d2}")
    except DivisionError as e:
        print(f"divide(10, 0) error: {e.message}")

    # --- Assert Statement ---
    print("=== Assert Statement ===")
    assert 1 + 1 == 2
    assert True
    print("all assertions passed")

    # --- Explicit Discard ---
    print("=== Explicit Discard ===")
    _ = safe_divide(10, 2)
    print("result discarded safely")

    print("demo complete!")
