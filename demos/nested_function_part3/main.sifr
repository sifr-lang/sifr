# Reference: nested_function_part3
# Reference: full-nested-function-pipeline-part3
# Nested functions part 3 demo: typed captures and nonlocal updates.

def accumulate(values: list[int]) -> int:
    total = 0

    def apply() -> None:
        nonlocal total
        for value in values:
            total += value

    apply()
    return total

def main():
    assert str(accumulate([3, 1, 4, 1, 5])) == '14'
