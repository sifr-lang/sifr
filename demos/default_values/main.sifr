# default_values defaults and panic-to-diagnostic conversion demo
#
# Positive path: non-literal defaults (list/dict literals) are preserved and list
# defaults are evaluated fresh per call.

class Payload:
    values: list[int] = [1, 2]
    counts: dict[str, int] = {"ok": 1}

def append_default(own mut items: list[int] = [1]) -> list[int]:
    items.append(9)
    return items

def main():
    first: list[int] = append_default()
    second: list[int] = append_default()
    payload: Payload = Payload()

    print("default_values defaults and panic-to-diagnostic conversion demo:")
    print(first)
    print(second)
    print(payload.values)
