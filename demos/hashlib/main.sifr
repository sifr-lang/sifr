# Reference: hashlib
# hashlib hashlib parity demo
from sifr.hashlib import (
    sha256, md5,
    sha256_obj, md5_obj, copy_hash,
    new, algorithms_guaranteed, file_digest,
    HashObject, HashlibError
)
from sifr.io import write_text
from sifr.test import assert_vector_eq, assert_bool_vector_eq

def contains(values: list[str], needle: str) -> bool:
    for v in values:
        if v == needle:
            return True
    return False

def collect_positive_actual(tmp_path: str) -> list[str]:
    actual: list[str] = []

    h = sha256_obj("")
    h.update("a")
    h.update("bc")
    actual.append(str(h.hexdigest() == sha256("abc")))
    actual.append(str(len(h.digest()) == 32 and h.digest_bytes() == h.digest()))

    c = copy_hash(h)
    c.update("x")
    actual.append(str(c.hexdigest() == sha256("abcx")))

    m = md5_obj("hello")
    actual.append(str(m.hexdigest() == md5("hello")))
    actual.append(str(contains(algorithms_guaranteed(), "sha256")))
    actual.append(m.hexdigest())
    try:
        out: str = file_digest(tmp_path, "sha256")
        actual.append(out)
    except HashlibError as e:
        actual.append("ERR")
    return actual

def collect_negative_actual_ok() -> list[bool]:
    actual_ok: list[bool] = []
    try:
        bad: HashObject = new("sha3_256", "")
        _ = str(bad.name)
        actual_ok.append(True)
    except ValueError as e:
        actual_ok.append(False)
    return actual_ok

def main():
    expected: list[str] = [
        "true",
        "true",
        "true",
        "true",
        "true",
        "5d41402abc4b2a76b9719d911017c592",
        "8e6537b695ff181bc341e32d8b8970485ac3513408e5eb1e8ba9fc5af1cd3f57",
    ]
    tmp_path: str = "tmp_hashlib_hashlib_demo.txt"
    _ = write_text(tmp_path, "file-data")

    actual: list[str] = collect_positive_actual(tmp_path)
    assert_vector_eq(actual, expected)

    expected_ok: list[bool] = [False]
    actual_ok: list[bool] = collect_negative_actual_ok()
    assert_bool_vector_eq(actual_ok, expected_ok)

    print("hashlib hashlib parity demo: pass")
