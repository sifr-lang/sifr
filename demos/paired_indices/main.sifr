# Reference: paired_indices
# Two index variables should safely read from both ends of one sequence.

def edge_pairs_text(text: str) -> str:
    left = 0
    right = len(text) - 1
    out = ""

    while left < right:
        out = out + "(" + text[left] + "," + text[right] + ")"
        left += 1
        right -= 1
    return out


def main():
    assert edge_pairs_text("code") == "(c,e)(o,d)"
    assert edge_pairs_text("xy") == "(x,y)"
    print("paired_indices: ok")
