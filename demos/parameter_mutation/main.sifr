# Mutate borrowed and owned values through the four parameter modes.

def mutate_and_return(own mut items: list[int]) -> list[int]:
    if len(items) > 1:
        items[0] = 9
        items[1] = 10
    return items

def mutate_borrowed(mut items: list[int]) -> int:
    if len(items) > 0:
        items[0] = 14
    return len(items)

def main():
    values: list[int] = [1, 2, 3]
    moved: list[int] = mutate_and_return(values)
    print(moved[0])
    print(moved[1])
    print(mutate_borrowed(moved))
