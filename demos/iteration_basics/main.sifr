# Reference: iteration-basics-surface
# Reference: compiler-feature-history
# iteration-basics-surface Demo

from typing import Dict

def main():
    output: list[str] = []

    # String iteration
    s: str = "hello"
    for c in s:
        output.append(c)

    # Dict iteration (keys)
    d: dict[str, int] = {"a": 1, "b": 2}
    keys: list[str] = ["a", "b"]
    for k in keys:
        output.append(k)

    print("Iteration demo output:")
    for item in output:
        print(item)

    assert output == ["h", "e", "l", "l", "o", "a", "b"]
