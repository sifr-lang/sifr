# Reverse `range` loops should keep indexed reads definite.

def reversed_values(values: list[int]) -> list[int]:
    out: list[int] = []

    for i in range(len(values) - 1, -1, -1):
        out.append(values[i])
    return out


def main():
    assert str(reversed_values([4, 5, 6])) == "[6, 5, 4]"
    assert str(reversed_values([])) == "[]"
    print("reverse_indices: ok")
