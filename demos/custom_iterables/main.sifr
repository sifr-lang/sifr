# Reference: iter_fix_custom_iterables
# Reference: canonical-iteration-model-and-lazy-parity-readiness
class CountdownIter:
    current: int

    def __init__(self, start: int):
        self.current = start

    def __iter__(self) -> Iterator[int]:
        return iter([self.current])

    def __next__(self) -> int | None:
        if self.current <= 0:
            return None
        value: int = self.current
        self.current = self.current - 1
        return value


class Countdown:
    start: int

    def __init__(self, start: int):
        self.start = start

    def __iter__(self) -> Iterator[int]:
        values: list[int] = []
        i: int = self.start
        while i > 0:
            values.append(i)
            i = i - 1
        return iter(values)

    def __reversed__(self) -> Iterator[int]:
        values: list[int] = []
        i: int = 1
        while i <= self.start:
            values.append(i)
            i = i + 1
        return iter(values)


def main():
    countdown: Countdown = Countdown(4)
    print(list(countdown))
    print(list(reversed(countdown)))

    running_total: int = 0
    for value in Countdown(4):
        running_total = running_total + value
    print(running_total)

    it: CountdownIter = CountdownIter(2)
    print(next(it))
    print(next(it))
    print(next(it))
