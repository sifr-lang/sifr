from sifr.collections import Counter, from_list, deque
from sifr.test import assert_bool_vector_eq

def collect_set_and_counter_actual() -> list[bool]:
    actual: list[bool] = []
    left: set[int] = set([1, 2, 3])
    right: set[int] = set([3, 4, 5])
    actual.append(len(left.union(right)) == 5)
    actual.append(len(left.intersection(right)) == 1)

    counts: Counter[str] = from_list(["x", "y", "x", "z", "x", "y"])
    actual.append(counts.get("x") == 3)
    actual.append(str(counts.most_common(2)) == "[(\"x\", 3), (\"y\", 2)]")
    return actual

def collect_deque_actual() -> list[bool]:
    actual: list[bool] = []
    d: deque[int] = deque(maxlen=2)
    d.append(10)
    d.append(20)
    d.append(30)
    actual.append(d.len() == 2 and d.popleft() == 20)

    _ = d.pop()
    actual.append(d.pop() is None)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_set_and_counter_actual())
    append_all(actual, collect_deque_actual())

    assert_bool_vector_eq(actual, expected)
    print("collections collections parity demo: pass")
