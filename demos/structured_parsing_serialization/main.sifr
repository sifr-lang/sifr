# Reference: structured-parsing-sample
# Reference: python-source-parity-and-builtin-stdlib-surface
from sifr.csv import DictReader, DictWriter, Dialect, QUOTE_ALL, format_row
from sifr.io import write_text
from sifr.json import JsonValue, dumps, from_array, from_bool, from_int, from_object, from_str, load
from sifr.configparser import ConfigParser, ParsingError
from sifr.tomllib import TomlValue, loads


def main() -> None:
    print("structured-parsing-sample structured parsing and serialization demo")

    try:
        json_path: str = "/tmp/sifr_structured_parsing_serialization.json"
        _: None = write_text(json_path, "{\"name\":\"sifr\",\"items\":[1,true]}")
        json_value: JsonValue = load(json_path)
        json_items: JsonValue | None = json_value.get("items")
        json_name: JsonValue | None = json_value.get("name")
        json_second: JsonValue | None = None
        if json_items is not None:
            json_second = json_items.at(1)
        if json_name is not None:
            print(json_name.as_str())
        if json_second is not None:
            print(json_second.as_bool())
    except IOError as e:
        print(e.message)
    except Error as e:
        print(e.message)
    print(dumps(from_object([("name", from_str("sifr")), ("items", from_array([from_int(1), from_bool(True)]))])))

    try:
        toml_value: TomlValue = loads("title = \"sifr\"\n[owner]\nactive = true\n")
        owner: TomlValue | None = toml_value.get("owner")
        title: TomlValue | None = toml_value.get("title")
        if owner is not None:
            active: TomlValue | None = owner.get("active")
            if title is not None:
                print(title.as_str())
            if active is not None:
                print(active.as_bool())
    except TOMLDecodeError as e:
        print(e.message)
    except Error as e:
        print(e.message)

    quoted: str = format_row(["alpha", "beta"], dialect=Dialect(quoting=QUOTE_ALL))
    print(quoted)
    dict_reader: DictReader = DictReader("name,age\nalice,30\n")
    print(str(dict_reader.rows()))
    dict_writer: DictWriter = DictWriter(["name", "age"])
    dict_writer.writeheader()
    dict_writer.writerow({"name": "alice", "age": "30"})
    print(dict_writer.getvalue())

    defaults: dict[str, str | None] = {}
    encoding_value: str | None = "utf-8"
    defaults["encoding"] = encoding_value
    parser: ConfigParser = ConfigParser(defaults=defaults, allow_no_value=True)
    try:
        _: None = parser.read_string("[server]\nport = 8080\nenabled = true\nfeature\n")
    except ParsingError as e:
        print(e.message)
        return
    print(parser.getint("server", "port"))
    print(parser.getboolean("server", "enabled"))
    fallback_value: str | None = "missing"
    print(parser.get("server", "feature", fallback_value))
