def gen_pairs(limit: int) -> Iterator[int]:
    i: int = 0
    while i < limit:
        yield i
        i = i + 1
        if i < limit:
            yield i
            i = i + 1


def gen_even(xs: list[int]) -> Iterator[int]:
    for x in xs:
        if x % 2 == 0:
            yield x


def main():
    xs: list[int] = [1, 2, 3, 4, 5]
    squares: Iterator[int] = (x * x for x in xs if x % 2 == 0)
    print(list(squares))
    print(list(gen_pairs(5)))
    print(list(gen_even(xs)))
