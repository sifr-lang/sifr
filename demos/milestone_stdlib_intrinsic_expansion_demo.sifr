# milestone_stdlib_intrinsic_expansion_demo.sifr
# Demonstrates all new intrinsics added in milestone_stdlib_intrinsic_expansion


from sifr.math import erf, erfc, gamma, lgamma, frexp, ldexp, modf, nextafter, ulp
from sifr.os import getpid, cpu_count
from sifr.hashlib import sha224, sha384, blake2b, blake2s
from sifr.platform import system, machine, processor
from sifr.time import gmtime, localtime, strptime
from sifr.base64 import b32encode, b32decode
from sifr.shutil import disk_usage

def demo_math() -> None:
    assert "=== math new intrinsics ===" == "=== math new intrinsics ==="
    e0: float = erf(0.0)
    assert "erf near 0 = " + str(e0 < 0.001 and e0 > -0.001) == "erf near 0 = true"
    ec0: float = erfc(0.0)
    assert "erfc near 1 = " + str(ec0 > 0.999 and ec0 < 1.001) == "erfc near 1 = true"
    g: float = gamma(5.0)
    assert "gamma(5) > 23 = " + str(g > 23.0) == "gamma(5) > 23 = true"
    lg: float = lgamma(5.0)
    assert "lgamma(5) > 3 = " + str(lg > 3.0) == "lgamma(5) > 3 = true"
    fp: list[float] = frexp(8.0)
    assert "frexp(8.0) mantissa = " + str(fp[0]) == "frexp(8.0) mantissa = 0.5"
    ld: float = ldexp(0.5, 4)
    assert "ldexp(0.5, 4) = " + str(ld) == "ldexp(0.5, 4) = 8"
    md: list[float] = modf(3.7)
    assert "modf(3.7) frac > 0 = " + str(md[0] > 0.0) == "modf(3.7) frac > 0 = true"
    na: float = nextafter(1.0, 2.0)
    assert "nextafter(1.0, 2.0) > 1.0 = " + str(na > 1.0) == "nextafter(1.0, 2.0) > 1.0 = true"
    u: float = ulp(1.0)
    assert "ulp(1.0) > 0 = " + str(u > 0.0) == "ulp(1.0) > 0 = true"

def demo_os() -> None:
    assert "=== os new intrinsics ===" == "=== os new intrinsics ==="
    pid: int = getpid()
    assert "pid > 0 = " + str(pid > 0) == "pid > 0 = true"
    cpus: int = cpu_count()
    assert "cpu_count >= 1 = " + str(cpus >= 1) == "cpu_count >= 1 = true"

def demo_hashlib() -> None:
    assert "=== hashlib new intrinsics ===" == "=== hashlib new intrinsics ==="
    s: str = "hello"
    assert "sha224 len = " + str(len(sha224(s))) == "sha224 len = 56"
    assert "sha384 len = " + str(len(sha384(s))) == "sha384 len = 96"
    assert "blake2b len = " + str(len(blake2b(s))) == "blake2b len = 128"
    assert "blake2s len = " + str(len(blake2s(s))) == "blake2s len = 64"

def demo_platform() -> None:
    assert "=== platform new intrinsics ===" == "=== platform new intrinsics ==="
    assert "system len > 0 = " + str(len(system()) > 0) == "system len > 0 = true"
    assert "machine len > 0 = " + str(len(machine()) > 0) == "machine len > 0 = true"
    assert "processor len > 0 = " + str(len(processor()) > 0) == "processor len > 0 = true"

def demo_time() -> None:
    assert "=== time new intrinsics ===" == "=== time new intrinsics ==="
    gmt: str = gmtime(0.0)
    assert "gmtime len > 0 = " + str(len(gmt) > 0) == "gmtime len > 0 = true"
    lt: str = localtime(0.0)
    assert "localtime len > 0 = " + str(len(lt) > 0) == "localtime len > 0 = true"
    try:
        parsed: str = strptime("2024-01-15 10:30:00", "%Y-%m-%d %H:%M:%S")
        assert "strptime ok = " + str(len(parsed) > 0) == "strptime ok = true"
    except ValueError as e:
        assert "strptime error: " + e.message == "=== base64 new intrinsics ==="

def demo_base64() -> None:
    assert "=== base64 new intrinsics ===" == "b32encode len > 0 = true"
    encoded: str = b32encode("hello world")
    assert "b32encode len > 0 = " + str(len(encoded) > 0) == "b32decode = hello world"
    try:
        decoded: str = b32decode(encoded)
        assert "b32decode = " + decoded == "=== shutil new intrinsics ==="
    except ParseError as e:
        assert "b32decode error: " + e.message == "disk_total > 0 = true"

def demo_shutil() -> None:
    print("=== shutil new intrinsics ===")
    usage: list[int] = disk_usage("/")
    print("disk_total > 0 = " + str(usage[0] > 0))

def main():
    demo_math()
    demo_os()
    demo_hashlib()
    demo_platform()
    demo_time()
    demo_base64()
    demo_shutil()
