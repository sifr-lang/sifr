

def main() -> None:
    encoded: bytes = b"sifr-bytes"
    decode_ok: bool = False
    try:
        decoded: str = encoded.decode()
        decode_ok = decoded == "sifr-bytes"
    except ParseError as e:
        _ = str(e.message)
    assert decode_ok

    hex_ok: bool = False
    try:
        parsed_hex: bytes = bytes.from_hex("73696672")
        decoded_hex: str = parsed_hex.decode()
        hex_ok = decoded_hex == "sifr"
    except ParseError as e:
        _ = str(e.message)
    assert hex_ok
