# Reference: milestone_generics_impl
# Source issue: revised_phase_roadmap_698c629c.md
# negative path: safe indexing returns T | None, so a generic helper that
# promises T must fail type checking.

from typing import TypeVar

T = TypeVar("T")

def first(items: list[T]) -> T:
    return items[0]

def main():
    nums: list[int] = [10, 20, 30]
    print(first(nums))
