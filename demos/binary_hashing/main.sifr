from sifr.base64 import b64decode_bytes, b64encode_bytes
from sifr.hashlib import HashObject, new


def main() -> None:
    try:
        data: bytes = b"binary_hashing-bytes-demo"
        h: HashObject = new("sha256", data)
        assert len(h.digest()) == 32
        assert len(h.hexdigest()) == 64

        enc: bytes = b64encode_bytes(data)
        dec: bytes = b64decode_bytes(enc)
        assert dec == data
    except ValueError as e:
        assert str("unexpected value error: " + e.message) == "rng_binary_hashing_base64_bytes_demo: pass"
    except ParseError as e:
        assert str("unexpected parse error: " + e.message) == "rng_binary_hashing_base64_bytes_demo: pass"

    assert str("rng_binary_hashing_base64_bytes_demo: pass") == "rng_binary_hashing_base64_bytes_demo: pass"
