# Reference: runtime_zipfile_io
# Reference: runtime-and-file-object-parity-expansion
from sifr.tempfile import NamedTemporaryFile
from sifr.zipfile import ZipFile, ZipReadHandle, is_zipfile, ZIP_STORED
from sifr.io import exists
from sifr.os import remove_file


def main() -> None:
    zip_path: str = "/tmp/sifr_runtime_zipfile_io.zip"
    demo_ok: bool = False

    try:
        temp_file: NamedTemporaryFile = NamedTemporaryFile("wb", False, "sifr_runtime_zipfile_io_")
        tmp_path: str = temp_file.name()
        _close_tmp: None = temp_file.close()
        _cleanup_tmp: None = temp_file.cleanup()
        tempfile_ok: bool = not exists(tmp_path)

        if exists(zip_path):
            _rm_old: None = remove_file(zip_path)

        writer: ZipFile = ZipFile(zip_path + "", "w", ZIP_STORED)
        _create: None = writer.create()
        _write_text: None = writer.write("note.txt", "runtime-zipfile_io")
        _write_bytes: None = writer.write_bytes("bin/raw.bin", b"\x00\x01\x02")

        reader: ZipFile = ZipFile(zip_path + "", "r", ZIP_STORED)
        payload: bytes = reader.read_bytes("bin/raw.bin")

        handle: ZipReadHandle = ZipReadHandle(b"abc")
        read_all: bytes = handle.read_bytes(-1)
        handle_negative_ok: bool = read_all == b"abc"

        _open_handle_result: Result[ZipReadHandle, IOError] = reader.open("bin/raw.bin", "rb")
        open_rejected: bool = False
        try:
            _open_handle: ZipReadHandle = _open_handle_result
        except IOError as e:
            _ = e.message
            open_rejected = True

        bad_mode_writer: ZipFile = ZipFile(zip_path + "", "rw", ZIP_STORED)
        _bad_mode_write_result: Result[None, IOError] = bad_mode_writer.write("bad.txt", "bad-mode")
        bad_mode_rejected: bool = False
        try:
            _bad_mode_ok: None = _bad_mode_write_result
        except IOError as e:
            _ = e.message
            bad_mode_rejected = True

        demo_ok = tempfile_ok and is_zipfile(zip_path) and payload == b"\x00\x01\x02" and handle_negative_ok and open_rejected and bad_mode_rejected
    except IOError as e:
        _ = e.message

    try:
        if exists(zip_path):
            _rm_zip: None = remove_file(zip_path)
    except IOError as e:
        _ = e.message

    assert demo_ok
    print("runtime_zipfile_io_zipfile_lifecycle_demo: ok")
