# Reference: own_mut_updatesj
# `own mut` parameters can be consumed, updated in place, and returned safely.

def increment_all(own mut values: list[int]) -> list[int]:
    for i in range(len(values)):
        values[i] = values[i] + 1
    return values


def clear_all(own mut values: list[int]) -> list[int]:
    for i in range(len(values)):
        values[i] = 0
    return values


def main():
    assert str(increment_all([1, 2, 3])) == "[2, 3, 4]"
    assert str(clear_all([4, 5, 6])) == "[0, 0, 0]"
    print("own_mut_updates: ok")
