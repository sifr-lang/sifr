from sifr.itertools import chain, pairwise, batched, accumulate, cycle
from sifr.test import assert_bool_vector_eq

def collect_core_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(str(list(chain([1, 2], [3]))) == "[1, 2, 3]")
    actual.append(str(pairwise([1, 2, 3, 4])) == "[[1, 2], [2, 3], [3, 4]]")

    batched_ok: bool = False
    try:
        bat: list[list[int]] = batched([1, 2, 3, 4, 5], 2)
        batched_ok = str(bat) == "[[1, 2], [3, 4], [5]]"
    except ValueError as e:
        _ = str(e.message)
    actual.append(batched_ok)

    actual.append(str(list(accumulate(iter([1, 2, 3])))) == "[1, 3, 6]")
    actual.append(str(list(cycle(iter([5, 6]), 5))) == "[5, 6, 5, 6, 5]")
    return actual

def collect_negative_actual() -> list[bool]:
    actual: list[bool] = []
    invalid_batch_rejected: bool = False
    try:
        _bad: list[list[int]] = batched([1], 0)
        _ = _bad
    except ValueError as e:
        invalid_batch_rejected = len(e.message) > 0
    actual.append(invalid_batch_rejected)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_core_actual())
    append_all(actual, collect_negative_actual())

    assert_bool_vector_eq(actual, expected)
    print("itertools itertools parity demo: pass")
