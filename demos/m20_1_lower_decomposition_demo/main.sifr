# milestone_20_1 demo
# Exercises representative lowering paths after lower.rs decomposition.

from sifr.math import floor

def add(a: int, b: int) -> int:
    return a + b

def main():
    total: int = add(10, 11)
    if total > 20:
        print("m20_1 lower decomposition demo:")
    print(total)
    print(floor(3.9))
