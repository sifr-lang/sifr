# Reference: clone_slice_unpacking
# Reference: ownership-aware-collection-lowering-and-clone-elision
def main():
    nums: list[int] = [3, 6, 9, 12]
    print(nums[0])
    print(nums[99])

    scores: dict[str, int] = {"x": 11, "y": 22}
    print(scores["x"])
    print(scores["z"])

    a, *mid, b = nums
    print(a)
    print(mid)
    print(b)

    print(nums[::2])
    print(len(nums))

    print("clone_slice_unpacking_slice_unpack_demo: pass")
