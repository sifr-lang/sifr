def main():
    nums: list[int] = [3, 6, 9, 12]
    print(nums[0])
    print(nums[99])

    scores: dict[str, int] = {"x": 11, "y": 22}
    print(scores["x"])
    print(scores["z"])

    try:
        a, *mid, b = nums
        print(a)
        print(mid)
        print(b)
    except ValueError as error:
        print(error.message)

    print(nums[::2])
    print(len(nums))

    print("clone_slice_unpacking_slice_unpack_demo: pass")
