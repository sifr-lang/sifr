# milestone_codegen_fixes Demo
# Showcases all codegen bug fixes in this milestone

# --- Fix 1: Tuple indexing (pair.0 instead of pair.0_i64) ---

# --- Fix 2: int/int true division (float result) ---

# --- Fix 3: print(None) ---

# --- Fix 4: bool() on collections ---

# --- Fix 5: **= power assignment on int ---

# --- Fix 6: Mixed int/float arithmetic ---

# --- Fix 7: Escaped quotes in strings ---

def main():
    # Fix 1: Tuple indexing
    pair: tuple[int, int] = (10, 20)
    a: int = pair[0]
    b: int = pair[1]
    assert f"Tuple index: {a}, {b}" == "Tuple index: 10, 20"

    # Fix 2: int/int true division
    x: int = 10
    y: int = 3
    result: float = x / y
    assert f"Division 10/3: {result}" == "Division 10/3: 3.3333333333333335"

    # Fix 3: print(None)
    val: int | None = None
    assert f"None value: {val}" == "None value: None"

    # Fix 4: bool() on collections
    nums: list[int] = [1, 2, 3]
    empty: list[int] = []
    assert f"bool([1,2,3]): {bool(nums)}" == "bool([1,2,3]): true"
    assert f"bool([]): {bool(empty)}" == "bool([]): false"

    # Fix 5: **= power assignment on int
    base: int = 2
    base **= 3
    assert f"2**3 = {base}" == "2**3 = 8"

    # Fix 6: Mixed int/float arithmetic
    i: int = 10
    f: float = 3.5
    mixed: float = i + f
    assert f"10 + 3.5 = {mixed}" == "10 + 3.5 = 13.5"

    # Fix 7: Escaped quotes
    msg: str = "She said \"hello\""
    assert msg == "She said \"hello\""
