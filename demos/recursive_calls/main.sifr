# Reference: recursive_calls
# recursive_calls semantic query layer standardization demo
# Validates canonical query behavior for call detection and local-scope analysis.

def main():
    def recurse(n: int) -> int:
        for i in [1]:
            pass
        else:
            if n > 0:
                return recurse(n - 1)
        return 0

    print('recursive_calls semantic query layer standardization demo:')
    print(recurse(4))
