from sifr.os import getpid
from sifr.platform import system
from sifr.process import AsyncChild, Command, ProcessError, Status, async_spawn
from sifr.signal import Signal, SignalError, shutdown_stream, strsignal, terminate


def signal_command(signal_name: str) -> Command:
    command: Command = Command("sh")
    command.args(["-c", "sleep 0.10; kill -" + signal_name + " " + str(getpid())])
    return command


async def expect_signal(signal_name: str, expected: str) -> None:
    # The helper child sends a signal to this process after the await is armed.
    try:
        child: AsyncChild = await async_spawn(signal_command(signal_name))
        try:
            received: Signal = await terminate()
            assert strsignal(received) == expected
        except SignalError as e:
            assert e.message == ""
        status: Status = await child.wait()
        assert status.success
    except ProcessError as e:
        assert e.message == ""


async def expect_shutdown_stream() -> None:
    try:
        child: AsyncChild = await async_spawn(signal_command("TERM"))
        try:
            received: Signal = await shutdown_stream().next()
            assert strsignal(received) == "SIGTERM"
        except SignalError as e:
            assert e.message == ""
        status: Status = await child.wait()
        assert status.success
    except ProcessError as e:
        assert e.message == ""


async def main() -> None:
    # Windows support is host-limited for SIGTERM delivery, so the demo exits
    # after validating the portable import/value shape on that host.
    if system() == "Windows":
        return

    await expect_signal("TERM", "SIGTERM")
    await expect_shutdown_stream()
