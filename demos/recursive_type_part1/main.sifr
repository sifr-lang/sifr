# Reference: recursive_type_part1
# Reference: full-recursive-type-feature-part1
# Recursive-type feature part 1 demo.
# Shows that type-alias symbols resolve deterministically before full body lowering.

type Payload = Response
type Response = list[int]
type Json = None | bool | int | float | str | list[Json] | dict[str, Json]

def payload_size(data: Payload) -> int:
    return len(data)

def main():
    print(payload_size([1, 2, 3]))
    print("recursive alias names resolved")
