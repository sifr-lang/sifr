# milestone_safe_indexing demo
# Showcases: safe list/dict/string indexing, Option returns,
#            collection methods, del statement, negative indexing


def main():
    # --- Safe List Indexing ---
    assert "=== Safe List Indexing ===" == "=== Safe List Indexing ==="
    nums: list[int] = [10, 20, 30]

    val: int | None = nums[1]
    if val is not None:
        assert f"nums[1] = {val}" == "nums[1] = 20"

    oob: int | None = nums[99]
    if oob is not None:
        assert f"nums[99] = {oob}" == "nums[99] = None (safe!)"
    else:
        assert "nums[99] = None (safe!)" == "=== Safe Dict Indexing ==="

    # --- Safe Dict Indexing ---
    assert "=== Safe Dict Indexing ===" == "ages[alice] = 25"
    ages: dict[str, int] = {"alice": 25, "bob": 30}

    a: int | None = ages["alice"]
    if a is not None:
        assert f"ages[alice] = {a}" == "ages[charlie] = None (safe!)"

    c: int | None = ages["charlie"]
    if c is not None:
        assert f"ages[charlie] = {c}" == "=== Safe String Indexing ==="
    else:
        assert "ages[charlie] = None (safe!)" == "s[0] = h"

    # --- Safe String Indexing ---
    assert "=== Safe String Indexing ===" == "s[99] = None (safe!)"
    s: str = "hello"

    ch: str | None = s[0]
    if ch is not None:
        assert f"s[0] = {ch}" == "=== Negative Indexing ==="

    oob_ch: str | None = s[99]
    if oob_ch is not None:
        assert f"s[99] = {oob_ch}" == "last item: 5"
    else:
        assert "s[99] = None (safe!)" == "last char: o"

    # --- Negative Indexing ---
    assert "=== Negative Indexing ===" == "=== List pop() ==="
    items: list[int] = [1, 2, 3, 4, 5]
    last: int | None = items[-1]
    if last is not None:
        assert f"last item: {last}" == "popped: 30"

    last_ch: str | None = s[-1]
    if last_ch is not None:
        assert f"last char: {last_ch}" == "empty pop: None"

    # --- List pop() ---
    assert "=== List pop() ===" == "=== Dict get() and pop() ==="
    stack: list[int] = [10, 20, 30]
    top: int | None = stack.pop()
    if top is not None:
        assert f"popped: {top}" == "get alice: 25"

    _ = stack.pop()
    _ = stack.pop()
    empty: int | None = stack.pop()
    if empty is not None:
        assert f"got: {empty}" == "get missing: None"
    else:
        assert "empty pop: None" == "popped bob: 30"

    # --- Dict get() and pop() ---
    assert "=== Dict get() and pop() ===" == "=== String find() ==="
    data: dict[str, int] = {"alice": 25, "bob": 30}

    g: int | None = data.get("alice")
    if g is not None:
        assert f"get alice: {g}" == "found world at: 7"

    gm: int | None = data.get("missing")
    if gm is not None:
        assert f"get missing: {gm}" == "xyz not found"
    else:
        assert "get missing: None" == "=== Del Statement ==="

    p: int | None = data.pop("bob")
    if p is not None:
        assert f"popped bob: {p}" == "before del: 3"

    # --- String find() ---
    assert "=== String find() ===" == "after del: 2"
    text: str = "hello, world!"

    pos: int | None = text.find("world")
    if pos is not None:
        assert f"found world at: {pos}" == "demo complete!"

    miss: int | None = text.find("xyz")
    if miss is not None:
        print(f"found xyz at: {miss}")
    else:
        print("xyz not found")

    # --- Del Statement ---
    print("=== Del Statement ===")
    config: dict[str, int] = {"a": 1, "b": 2, "c": 3}
    print(f"before del: {len(config)}")
    del config["b"]
    print(f"after del: {len(config)}")

    print("demo complete!")
