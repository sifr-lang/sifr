# Reference: ordering_remediation
# Reference: compiler-feature-history
# Feature Demo: Ordering Remediation Demo
# Fixes three gaps caused by out-of-order feature-set sequencing in stdlib parity architecture.

from typing import Callable
from sifr.itertools import repeat, chain, take
from sifr.json import JsonValue, loads
from sifr.re import search, sub, findall, split

# ─── Gap 3: Callable field invocation ────────────────────────────────
# Previously, storing a Callable in a struct field worked (Box<dyn Fn>),
# but calling it (obj.callback(args)) failed with "has no method".
# Now both storing AND calling work.

class Processor:
    name: str
    transform: Callable[[int], int]

    def __init__(self, name: str, transform: Callable[[int], int]):
        self.name = name
        self.transform = transform

def triple(x: int) -> int:
    return x * 3

def main():
    # ─── Gap 1: Lazy itertools ───────────────────────────────────────
    # repeat now returns Iterator[T]; eager list materialization is explicit.
    repeated: list[int] = list(repeat(7, 3))
    print(repeated)

    # Lazy generators work in for-loops too (no full materialization)
    for val in repeat(42, 2):
        print(val)

    # chain is now lazy too, so eager list materialization is explicit.
    chained: list[int] = list(chain([1, 2], [3, 4]))
    print(chained)

    first_two: list[int] = take(2, [10, 20, 30, 40])
    print(first_two)

    # ─── Gap 2: CPython-compatible names ─────────────────────────────
    # json: loads (alias for loads)
    try:
        parsed: JsonValue = loads("{\"key\": 42}")
        print(parsed)
    except JSONDecodeError as err:
        print(f"json error: {err.message}")

    # re: search, sub, findall, split (aliases for search, sub, etc.)
    try:
        found: str | None = search("\\d+", "abc123")
        if found is not None:
            print(found)
        replaced: str = sub("\\d", "X", "a1b2c3")
        print(replaced)
        words: list[str] = findall("\\w+", "hello world")
        print(words)
        parts: list[str] = split(",", "a,b,c")
        print(parts)
    except RegexError as err:
        print(f"regex error: {err.message}")

    # ─── Gap 3: Callable field invocation ────────────────────────────
    p: Processor = Processor("tripler", triple)
    print(p.name)
    result: int = p.transform(10)
    print(result)
