# Tuple assignment should work for locals, attributes, and simple running state.

class Pair:
    x: int
    y: int

    def __init__(self, x: int, y: int):
        self.x = x
        self.y = y


def swap_pair(mut pair: Pair) -> None:
    pair.x, pair.y = pair.y, pair.x


def add_points(points: list[tuple[int, int]]) -> int:
    total = 0
    for point in points:
        total += point[0] + point[1]
    return total


class RunningBounds:
    left: int
    right: int

    def __init__(self, left: int, right: int):
        self.left = left
        self.right = right

    def rotate(mut self, next_value: int) -> None:
        self.left, self.right = self.right, next_value

    def as_text(self) -> str:
        return "(" + str(self.left) + ", " + str(self.right) + ")"


def main():
    pair = Pair(2, 5)
    swap_pair(pair)
    assert pair.x == 5
    assert pair.y == 2

    assert add_points([(1, 2), (3, 4), (5, 6)]) == 21

    bounds = RunningBounds(10, 20)
    bounds.rotate(30)
    assert bounds.left == 20
    assert bounds.right == 30
    assert bounds.as_text() == "(20, 30)"
    print("tuple_assignment: ok")
