# milestone_lazy_iterators demo
# Demonstrates lazy iterator support for generator functions
# Generators now use std::iter::from_fn instead of eager Vec collection

def fibonacci(n: int) -> list[int]:
    a: int = 0
    b: int = 1
    count: int = 0
    while count < n:
        yield a
        temp: int = a + b
        a = b
        b = temp
        count = count + 1

# ============================================================
# Part 2: Generator collected into a list (squares)
# ============================================================

def squares(n: int) -> list[int]:
    i: int = 0
    while i < n:
        yield i * i
        i = i + 1

# ============================================================
# Part 3: Conditional yield (filter pattern — evens)
# ============================================================

def evens(limit: int) -> list[int]:
    i: int = 0
    while i < limit:
        if i % 2 == 0:
            yield i
        i = i + 1

# ============================================================
# Part 4: Simple count generator
# ============================================================

def count_up(n: int) -> list[int]:
    i: int = 0
    while i < n:
        yield i
        i = i + 1


def main():
    output: list[str] = []

    # Part 1: Lazy iteration — for loop consumes one value at a time
    output.append("=== Fibonacci (lazy for loop) ===")
    for fib in fibonacci(8):
        output.append(str(fib))

    # Part 2: Collect into a list
    output.append("=== Squares (collected) ===")
    sq: list[int] = squares(5)
    output.append(str(sq))

    # Part 3: Conditional yield — only even numbers
    output.append("=== Evens (conditional yield) ===")
    for e in evens(10):
        output.append(str(e))

    # Part 4: Simple count — both lazy and collected
    output.append("=== Count (lazy) ===")
    for c in count_up(3):
        output.append(str(c))
    output.append("=== Count (collected) ===")
    nums: list[int] = count_up(5)
    output.append(str(nums))

    assert output == [
        "=== Fibonacci (lazy for loop) ===",
        "0",
        "1",
        "1",
        "2",
        "3",
        "5",
        "8",
        "13",
        "=== Squares (collected) ===",
        "[0, 1, 4, 9, 16]",
        "=== Evens (conditional yield) ===",
        "0",
        "2",
        "4",
        "6",
        "8",
        "=== Count (lazy) ===",
        "0",
        "1",
        "2",
        "=== Count (collected) ===",
        "[0, 1, 2, 3, 4]",
    ]
