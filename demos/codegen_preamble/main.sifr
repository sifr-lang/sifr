# Demo: codegen_preamble_migration
# Exercises IR-emitted preamble pieces:
# - IOError + file handle infrastructure via open/read/close
# - logging global state via getLogger().set_level()/info()

from sifr.io import write_text
from sifr.logging import getLogger, Logger

def main():
    path: str = "/tmp/sifr_codegen_preamble_demo.txt"
    try:
        _: None = write_text(path, "codegen preamble")
        f = open(path, "r", encoding="utf-8")
        text: str = f.read()
        f.close()
        print("file = " + text)
        assert str("file = " + text) == "file = codegen preamble"
    except IOError as e:
        print("ioerror = " + e.message)
        assert str("ioerror = " + e.message) == "preamble demo complete"

    log: Logger = getLogger("codegen")
    log.set_level(20)
    log.info("preamble logging alive")
    print("preamble demo complete")
