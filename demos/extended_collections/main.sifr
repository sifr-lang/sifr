# ============================================================
# Feature Demo: Extended Collections Demo
# ============================================================
# Demonstrates extended collection types and binary data:
#   sifr.collections — Set, Counter, DefaultDict
#   bytes            — first-class encode/decode and hex conversion
# ============================================================

from sifr.collections import Counter, from_list

def main():
    # ----------------------------------------------------------
    # 1. Set operations
    # ----------------------------------------------------------
    print("=== Set Operations ===")

    # Create a set from a list (deduplicates)
    values: set[int] = set([1, 2, 2, 3, 3])
    print(f"Set from [1,2,2,3,3]: length = {len(values)}")

    # Add element
    values.add(4)
    print(f"After adding 4: length = {len(values)}")

    # Contains
    print(f"Contains 2: {values.contains(2)}")
    print(f"Contains 5: {values.contains(5)}")

    # Union and intersection
    left: set[int] = set([1, 2, 3])
    right: set[int] = set([3, 4, 5])
    print(f"Union [1,2,3] | [3,4,5]: length = {len(left.union(right))}")
    print(f"Intersection [1,2,3] & [3,4,5]: length = {len(left.intersection(right))}")

    # ----------------------------------------------------------
    # 2. Counter
    # ----------------------------------------------------------
    print("=== Counter ===")

    fruits: list[str] = ["apple", "banana", "apple", "cherry", "banana", "apple"]
    fruit_counter: Counter[str] = from_list(fruits)
    print(f"apple count: {fruit_counter.get('apple')}")
    print(f"banana count: {fruit_counter.get('banana')}")
    print(f"cherry count: {fruit_counter.get('cherry')}")

    # ----------------------------------------------------------
    # 3. Bytes / Binary Data
    # ----------------------------------------------------------
    print("=== Bytes ===")

    # Encode string to bytes
    print(f"'hello' encoded: {len(b'hello')} bytes")

    # Roundtrip: encode then decode
    try:
        roundtrip: str = b"Sifr".decode()
        print(f"Roundtrip: {roundtrip}")
    except ParseError as err:
        print(f"decode error: {err.message}")

    # Hex encoding
    try:
        hex_hello: str = b"hello".hex()
        print(f"'hello' as hex: {hex_hello}")
    except ParseError as err:
        print(f"hex encode error: {err.message}")

    # Hex decoding
    try:
        hex_bytes: bytes = bytes.from_hex("536966")
        decoded: str = hex_bytes.decode()
        print(f"Hex '536966' decoded: {decoded}")
    except ParseError as err:
        print(f"hex error: {err.message}")

    print("=== Demo complete ===")
