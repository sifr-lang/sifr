# Reference: pathlib
from sifr.pathlib import basename, join_path, Path
from sifr.os import getpid
from sifr.test import assert_bool_vector_eq


def collect_path_helpers_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(basename("/tmp/demo.txt") == "demo.txt")
    actual.append(join_path("/tmp", "demo.txt") == "/tmp/demo.txt")
    return actual


def collect_path_class_actual() -> list[bool]:
    actual: list[bool] = []
    base: str = "/tmp/sifr_pathlib_pathlib_demo_" + str(getpid())
    filep: Path = Path(base + "/demo.txt")
    dirp: Path = Path(base + "")
    path_flow_ok: bool = False
    glob_ok: bool = False
    cleanup_ok: bool = False
    try:
        _m: None = dirp.mkdir()
        _w: None = filep.write_text("hello")
        content: str = filep.read_text()
        path_flow_ok = filep.exists() and filep.is_file() and content == "hello"

        matches_it: Iterator[str] = dirp.glob("*.txt")
        matches: list[str] = list(matches_it)
        glob_ok = len(matches) >= 1

        _u: None = filep.unlink()
        _r: None = dirp.rmdir()
        cleanup_ok = not dirp.exists()
    except IOError as e:
        _ = str(e.message)

    actual.append(path_flow_ok)
    actual.append(glob_ok)
    actual.append(cleanup_ok)
    return actual


def collect_missing_path_actual() -> list[bool]:
    actual: list[bool] = []
    missing_rejected: bool = False
    try:
        _bad: str = Path("/tmp/sifr_pathlib_pathlib_demo_missing.txt").read_text()
    except IOError as e:
        _ = str(e.message)
        missing_rejected = True
    actual.append(missing_rejected)
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_path_helpers_actual())
    append_all(actual, collect_path_class_actual())
    append_all(actual, collect_missing_path_actual())

    assert_bool_vector_eq(actual, expected)
    print("pathlib pathlib parity demo: pass")
