# Reference: stdlib_generic_rewrite
# Source issue: 197-stdlib_generic_rewrite.md
# Demo: stdlib_generic_rewrite
# Showcases generic stdlib functions working with multiple types,
# predicate-based itertools, generic Counter[T] with operator overloads,
# generic deque[T], generic heapq with Comparable bounds, and exact int support.

from sifr.itertools import chain, take, flatten, cycle, islice, compress, pairwise, repeat, zip_longest, accumulate, dropwhile, takewhile, filterfalse
from sifr.heapq import nsmallest, nlargest
from sifr.collections import Counter, from_list, deque
from sifr.functools import reduce
from sifr.random import shuffle

def is_small(x: int) -> bool:
    return x < 5

def is_even(x: int) -> bool:
    return x % 2 == 0

def concat(a: str, b: str) -> str:
    return a + b

def main():
    # --- 1. Generic chain: works with any type ---
    print("=== Generic chain ===")
    ints: list[int] = list(chain([1, 2], [3, 4]))
    print(ints)
    strs: list[str] = list(chain(["a", "b"], ["c", "d"]))
    print(strs)

    # --- 2. Generic take ---
    print("=== Generic take ===")
    first3_int: list[int] = take(3, [10, 20, 30, 40, 50])
    print(first3_int)
    first2_str: list[str] = take(2, ["hello", "world", "foo"])
    print(first2_str)

    # --- 3. Generic flatten ---
    print("=== Generic flatten ===")
    nested_int: list[list[int]] = [[1, 2], [3, 4], [5]]
    flat_int: list[int] = flatten(nested_int)
    print(flat_int)

    # --- 4. Generic accumulate (Addable bound: works with int, float, str) ---
    print("=== Generic accumulate ===")
    sums: list[int] = list(accumulate([1, 2, 3, 4, 5]))
    print(sums)
    float_sums: list[float] = list(accumulate([1.0, 2.5, 3.5]))
    print(float_sums)

    # --- 5. Predicate-based dropwhile ---
    print("=== Predicate-based dropwhile ===")
    data: list[int] = [1, 3, 7, 2, 8]
    dropped: list[int] = list(dropwhile(is_small, data))
    print(dropped)

    # --- 6. Predicate-based takewhile ---
    print("=== Predicate-based takewhile ===")
    taken: list[int] = list(takewhile(is_small, data))
    print(taken)

    # --- 7. Predicate-based filterfalse ---
    print("=== Predicate-based filterfalse ===")
    odds: list[int] = list(filterfalse(is_even, [1, 2, 3, 4, 5, 6]))
    print(odds)

    # --- 8. Generic heapq (Comparable bound) ---
    print("=== Generic heapq ===")
    items: list[int] = [9, 3, 7, 1, 5]
    small: list[int] = nsmallest(3, items)
    print(small)
    big: list[int] = nlargest(2, items)
    print(big)

    # --- 9. Generic Counter[T] with operator overloads ---
    print("=== Generic Counter[T] ===")
    words: list[str] = ["apple", "banana", "apple", "cherry", "banana", "apple"]
    c: Counter[str] = from_list(words)
    print(c.get("apple"))
    print(c.total())
    top: list[tuple[str, int]] = c.most_common(2)
    print(top)

    nums: list[int] = [1, 2, 2, 3, 3, 3]
    ci: Counter[int] = from_list(nums)
    print(ci.get(3))

    c2: Counter[str] = from_list(["banana", "date"])
    combined: Counter[str] = c + c2
    print(combined.get("banana"))

    # --- 10. Generic deque[T] ---
    print("=== Generic deque[T] ===")
    d: deque[str] = deque()
    d.append("first")
    d.append("second")
    d.appendleft("zero")
    items_d: list[str] = d.to_list()
    print(items_d)
    print(d.len())

    # --- 11. Generic functools.reduce ---
    print("=== Generic reduce ===")
    sentence: str = reduce(concat, ["hello", " ", "world"], "")
    print(sentence)

    # --- 12. Generic compress ---
    print("=== Generic compress ===")
    data_c: list[str] = ["a", "b", "c", "d", "e"]
    sel: list[bool] = [True, False, True, False, True]
    compressed: list[str] = list(compress(data_c, sel))
    print(compressed)

    # --- 13. Generic zip_longest ---
    print("=== Generic zip_longest ===")
    zl_str: list[list[str]] = list(zip_longest(["a", "b", "c"], ["x", "y"], "-"))
    for pair in zl_str:
        print(pair)

    # --- 14. Generic shuffle ---
    print("=== Generic shuffle ===")
    shuffled_str: list[str] = ["a", "b", "c", "d", "e"]
    shuffle(shuffled_str)
    print(len(shuffled_str))
