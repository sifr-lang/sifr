# Reference: builtin-functions-surface
# Reference: compiler-feature-history
# builtin-functions-surface Demo

def main():
    print(f"max(3, 7) = {max(3, 7)}")
    assert str(f"max(3, 7) = {max(3, 7)}") == "max(3, 7) = 7"
    print(f"min(3, 7) = {min(3, 7)}")
    assert str(f"min(3, 7) = {min(3, 7)}") == "min(3, 7) = 3"
    print(f"pow(2, 10) = {pow(2, 10)}")
    assert str(f"pow(2, 10) = {pow(2, 10)}") == "pow(2, 10) = 1024"

    result: str = ""
    for i in range(0, 10, 2):
        if len(result) > 0:
            result = result + " "
        result = result + str(i)
    print(result)
    assert str(result) == "0 2 4 6 8"
