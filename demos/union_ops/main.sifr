# Reference: union_ops
# Reference: compiler-feature-history
# ============================================================
# compiler feature: Union Type Operations Demo
# ============================================================
# Demonstrates:
# 1. Arithmetic on T|None with explicit narrowing
# 2. len() on union/optional types
# 3. list + list concatenation

# --- 1. Arithmetic on T|None with explicit narrowing ---
def increment(x: int | None) -> int:
    if x is None:
        return 0
    return x + 1

def double(x: float | None) -> float:
    if x is None:
        return 0.0
    return x * 2.0

# --- 2. len() on union types ---
def safe_len(items: list[str] | None) -> int:
    return len(items)

# --- 3. list + list concatenation ---
# `own` needed: concatenation consumes both lists to produce a new one
def merge_lists(own a: list[int], own b: list[int]) -> list[int]:
    return a + b

def main():
    # 1. Arithmetic on T|None
    v: int | None = 10
    print(increment(v))
    f: float | None = 3.14
    print(double(f))

    # 2. len() on union types
    names: list[str] | None = ["alice", "bob", "charlie"]
    print(safe_len(names))

    # 3. list + list concatenation
    merged: list[int] = merge_lists([1, 2, 3], [4, 5, 6])
    print(len(merged))
