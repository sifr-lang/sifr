# Reference: m21_2
# Source issue: phase21-traversal-completeness-and-control-flow-correctness-execution.md
# m21_2 while-else structured support demo
# Demonstrates while-else behavior in borrowed-condition paths.

def classify(items: list[int]) -> str:
    result: str = 'init'
    while items:
        result = 'broke'
        break
    else:
        result = 'else'
    return result


def main():
    print('m21_2 while-else structured support demo:')
    print(classify([]))
    print(classify([1]))
