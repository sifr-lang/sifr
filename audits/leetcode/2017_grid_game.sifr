# LeetCode 2017: Grid Game

def gridGame(grid: list[list[int]]) -> int:
    if len(grid) < 2:
        return 0
    if len(grid[0]) == 0:
        return 0
    top = grid[0]
    bottom = grid[1]

    right = 0
    for v in top:
        right += v
    inf = 1 << 60
    result = inf
    left = 0

    for a, b in zip(top, bottom):
        right -= a
        result = min(result, max(left, right))
        left += b
    return result

def main():
    assert gridGame([[2, 5, 4], [1, 5, 1]]) == 4
    assert gridGame([[3, 3, 1], [8, 5, 2]]) == 4
    assert gridGame([[1, 3, 1, 15], [1, 3, 3, 1]]) == 7
