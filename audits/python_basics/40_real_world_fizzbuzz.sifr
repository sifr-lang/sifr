# ============================================================
# Test 40: Real-World -- FizzBuzz
# Classic Python interview problem
# ============================================================

def fizzbuzz(n: int) -> str:
    if n % 15 == 0:
        return "FizzBuzz"
    elif n % 3 == 0:
        return "Fizz"
    elif n % 5 == 0:
        return "Buzz"
    else:
        return str(n)

def main():
    for i in range(1, 16):
        print(fizzbuzz(i))
