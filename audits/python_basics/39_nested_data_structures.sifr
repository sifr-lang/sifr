# ============================================================
# Test 39: Nested Data Structures
# Python: list of dicts, dict of lists, etc.
# ============================================================

def main():
    # List of dicts
    users: list[dict[str, str]] = [
        {"name": "Alice", "email": "alice@example.com"},
        {"name": "Bob", "email": "bob@example.com"},
    ]
    print(len(users))

    # Dict of lists
    groups: dict[str, list[int]] = {
        "evens": [2, 4, 6],
        "odds": [1, 3, 5],
    }
    print(groups)

    # List of tuples
    points: list[tuple[int, int]] = [(1, 2), (3, 4), (5, 6)]
    print(points)

    # Nested list (matrix)
    matrix: list[list[int]] = [
        [1, 2, 3],
        [4, 5, 6],
        [7, 8, 9],
    ]
    print(matrix)
    print(len(matrix))
