# ============================================================
# Test 45: Real-World -- Matrix Operations
# ============================================================

def matrix_add(a: list[list[int]], b: list[list[int]]) -> list[list[int]]:
    result: list[list[int]] = []
    for i in range(len(a)):
        row: list[int] = []
        for j in range(len(a[0])):
            row.append(a[i][j] + b[i][j])
        result.append(row)
    return result

def matrix_print(m: list[list[int]]) -> None:
    for row in m:
        print(row)

def main():
    a: list[list[int]] = [[1, 2], [3, 4]]
    b: list[list[int]] = [[5, 6], [7, 8]]

    print("Matrix A:")
    matrix_print(a)

    print("Matrix B:")
    matrix_print(b)

    print("A + B:")
    c: list[list[int]] = matrix_add(a, b)
    matrix_print(c)
