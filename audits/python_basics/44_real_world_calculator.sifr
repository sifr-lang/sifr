# ============================================================
# Test 44: Real-World -- Simple Calculator
# ============================================================

def calculate(a: float, op: str, b: float) -> Result[float, str]:
    if op == "+":
        return a + b
    elif op == "-":
        return a - b
    elif op == "*":
        return a * b
    elif op == "/":
        if b == 0.0:
            raise "division by zero"
        return a / b
    raise f"unknown operator: {op}"

def main():
    try:
        print(calculate(10.0, "+", 5.0))
    except str as e:
        print(e)

    try:
        print(calculate(10.0, "-", 3.0))
    except str as e:
        print(e)

    try:
        print(calculate(4.0, "*", 3.0))
    except str as e:
        print(e)

    try:
        print(calculate(10.0, "/", 3.0))
    except str as e:
        print(e)

    try:
        print(calculate(10.0, "/", 0.0))
    except str as e:
        print(e)

    try:
        print(calculate(1.0, "^", 2.0))
    except str as e:
        print(e)
