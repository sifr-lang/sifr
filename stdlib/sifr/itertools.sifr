from typing import Callable

A = TypeVar("A")
B = TypeVar("B")
R = TypeVar("R")
T = TypeVar("T")


def _collect_iterator[T](own data: Iterator[T]) -> list[T]:
    collected: list[T] = []
    for item in data:
        collected.append(item)
    return collected


def chain[T](*iterables: list[T]) -> Iterator[T]:
    for iterable in iterables:
        for item in iterable:
            yield item


def repeat(own value: T, times: int) -> Iterator[T]:
    holder: list[T] = [value]
    i: int = 0
    while i < times:
        if len(holder) > 0:
            current: T | None = holder[0]
            if current is not None:
                yield current
        i = i + 1


def take(n: int, data: Iterable[T]) -> list[T]:
    result: list[T] = []
    count: int = 0
    for item in data:
        if count >= n:
            return result
        result.append(item)
        count = count + 1
    return result


def flatten(lists: Iterable[Iterable[T]]) -> list[T]:
    result: list[T] = []
    for inner in lists:
        for val in inner:
            result.append(val)
    return result


def pairwise(data: Iterable[T]) -> list[list[T]]:
    result: list[list[T]] = []
    prev_values: list[T] = []
    for value in data:
        if len(prev_values) > 0:
            pair: list[T] = []
            prev: T | None = prev_values[0]
            if prev is not None:
                pair.append(prev)
            pair.append(value)
            result.append(pair)
            try:
                prev_values[0] = value
            except IndexError:
                return result
        else:
            prev_values.append(value)
    return result


def batched(data: Iterable[T], n: int) -> Result[list[list[T]], ValueError]:
    if n <= 0:
        raise ValueError("batched: n must be > 0")
    result: list[list[T]] = []
    current_batch: list[T] = []
    for value in data:
        current_batch.append(value)
        if len(current_batch) == n:
            result.append(current_batch)
            current_batch = []
    if len(current_batch) > 0:
        result.append(current_batch)
    return result


def _islice_impl[T](own data: Iterator[T], start: int, stop: int, unbounded: bool, step: int) -> Iterator[T]:
    index: int = 0
    next_yield: int = start.clone()
    for value in data:
        if not unbounded and index >= stop:
            return
        if index == next_yield:
            yield value
            next_yield = next_yield + step
        index = index + 1


def islice(own data: Iterator[T], start_or_stop: int | None, *slice_args: int | None) -> Result[Iterator[T], ValueError]:
    if len(slice_args) > 2:
        raise ValueError("islice: expected at most stop and step after start")
    actual_start: int = 0
    actual_stop: int = 0
    unbounded: bool = start_or_stop is None
    if start_or_stop is not None:
        actual_stop = start_or_stop.clone()
    actual_step: int = 1
    argument_index: int = 0
    for argument in slice_args:
        if argument_index == 0:
            if start_or_stop is None:
                raise ValueError("islice: start must be an integer when stop is provided")
            actual_start = start_or_stop.clone()
            if argument is None:
                unbounded = True
            else:
                actual_stop = argument.clone()
        else:
            if argument is not None:
                actual_step = argument.clone()
        argument_index = argument_index + 1
    if actual_start < 0:
        raise ValueError("islice: indices must be non-negative")
    if not unbounded and actual_stop < 0:
        raise ValueError("islice: indices must be non-negative")
    if actual_step <= 0:
        raise ValueError("islice: step must be greater than zero")
    return _islice_impl(data, actual_start, actual_stop, unbounded, actual_step)

def count(start: int = 0, step: int = 1) -> Iterator[int]:
    current: int = start.clone()
    while True:
        yield current
        current = current + step


def product[T](*iterables: list[T], repeat: int = 1) -> Iterator[list[T]]:
    if repeat < 0:
        return
    pools: list[list[T]] = []
    repetition: int = 0
    while repetition < repeat:
        for iterable in iterables:
            pools.append(iterable)
        repetition = repetition + 1
    if len(pools) == 0:
        yield []
        return
    for pool in pools:
        if len(pool) == 0:
            return

    indices: list[int] = []
    for _pool in pools:
        indices.append(0)
    finished: bool = False
    while not finished:
        row: list[T] = []
        pool_index: int = 0
        while pool_index < len(pools):
            pool_value: list[T] | None = pools[pool_index]
            value_index: int | None = indices[pool_index]
            if pool_value is None or value_index is None:
                return
            value: T | None = pool_value[value_index]
            if value is None:
                return
            row.append(value)
            pool_index = pool_index + 1
        yield row

        position: int = len(pools) - 1
        advanced: bool = False
        while position >= 0 and not advanced:
            current_pool: list[T] | None = pools[position]
            current_index: int | None = indices[position]
            if current_pool is None or current_index is None:
                return
            next_index: int = current_index + 1
            if next_index < len(current_pool):
                try:
                    indices[position] = next_index
                except IndexError:
                    return
                advanced = True
            else:
                try:
                    indices[position] = 0
                except IndexError:
                    return
                position = position - 1
        if not advanced:
            finished = True


def permutations(own data: Iterator[T], r: int | None = None) -> Iterator[list[T]]:
    materialized: list[T] = _collect_iterator(data)
    target: int = len(materialized)
    if r is not None:
        target = r
    size: int = len(materialized)
    if target < 0 or target > size:
        return
    if target == 0:
        yield []
        return

    indices: list[int] = []
    index: int = 0
    while index < size:
        indices.append(index)
        index = index + 1
    cycles: list[int] = []
    index = 0
    while index < target:
        cycles.append(size - index)
        index = index + 1

    first: list[T] = []
    index = 0
    while index < target:
        source_index: int | None = indices[index]
        if source_index is None:
            return
        value: T | None = materialized[source_index]
        if value is None:
            return
        first.append(value)
        index = index + 1
    yield first

    while True:
        position: int = target - 1
        produced: bool = False
        while position >= 0 and not produced:
            remaining: int | None = cycles[position]
            if remaining is None:
                return
            next_remaining: int = remaining - 1
            try:
                cycles[position] = next_remaining
            except IndexError:
                return
            if next_remaining == 0:
                rotated: int | None = indices[position]
                if rotated is None:
                    return
                cursor: int = position.clone()
                while cursor < size - 1:
                    shifted: int | None = indices[cursor + 1]
                    if shifted is None:
                        return
                    try:
                        indices[cursor] = shifted
                    except IndexError:
                        return
                    cursor = cursor + 1
                try:
                    indices[size - 1] = rotated
                    cycles[position] = size - position
                except IndexError:
                    return
                position = position - 1
            else:
                swap_position: int = size - next_remaining
                left_index: int | None = indices[position]
                right_index: int | None = indices[swap_position]
                if left_index is None or right_index is None:
                    return
                left_value: int = left_index
                right_value: int = right_index
                try:
                    indices[position] = right_value
                    indices[swap_position] = left_value
                except IndexError:
                    return
                row: list[T] = []
                row_index: int = 0
                while row_index < target:
                    item_index: int | None = indices[row_index]
                    if item_index is None:
                        return
                    item: T | None = materialized[item_index]
                    if item is None:
                        return
                    row.append(item)
                    row_index = row_index + 1
                yield row
                produced = True
        if not produced:
            return


def combinations(own data: Iterator[T], r: int) -> Iterator[list[T]]:
    materialized: list[T] = _collect_iterator(data)
    size: int = len(materialized)
    if r < 0 or r > size:
        return
    if r == 0:
        yield []
        return
    indices: list[int] = []
    index: int = 0
    while index < r:
        indices.append(index)
        index = index + 1
    while True:
        row: list[T] = []
        for source_index in indices:
            value: T | None = materialized[source_index]
            if value is None:
                return
            row.append(value)
        yield row

        position: int = r - 1
        while position >= 0:
            current: int | None = indices[position]
            if current is None:
                return
            if current != position + size - r:
                break
            position = position - 1
        if position < 0:
            return
        current = indices[position]
        if current is None:
            return
        next_position: int = current + 1
        try:
            indices[position] = next_position
        except IndexError:
            return
        cursor: int = position.clone() + 1
        while cursor < r:
            previous: int | None = indices[cursor - 1]
            if previous is None:
                return
            next_position = previous + 1
            try:
                indices[cursor] = next_position
            except IndexError:
                return
            cursor = cursor + 1


def combinations_with_replacement(own data: Iterator[T], r: int) -> Iterator[list[T]]:
    materialized: list[T] = _collect_iterator(data)
    size: int = len(materialized)
    if r < 0:
        return
    if r == 0:
        yield []
        return
    if size == 0:
        return
    indices: list[int] = []
    index: int = 0
    while index < r:
        indices.append(0)
        index = index + 1
    while True:
        row: list[T] = []
        for source_index in indices:
            value: T | None = materialized[source_index]
            if value is None:
                return
            row.append(value)
        yield row

        position: int = r - 1
        while position >= 0:
            current: int | None = indices[position]
            if current is None:
                return
            if current != size - 1:
                break
            position = position - 1
        if position < 0:
            return
        next_index: int | None = indices[position]
        if next_index is None:
            return
        next_value: int = next_index + 1
        cursor: int = position.clone()
        while cursor < r:
            try:
                indices[cursor] = next_value
            except IndexError:
                return
            cursor = cursor + 1


def starmap(func: Callable[[A, B], R], own pairs: Iterator[tuple[A, B]]) -> Iterator[R]:
    for first, second in pairs:
        yield func(first, second)

def accumulate[T: Addable](own data: Iterator[T], own initial: T | None = None) -> Iterator[T]:
    state: list[T] = []
    if initial is not None:
        state.append(initial)
        initial_value: T | None = state[0]
        if initial_value is not None:
            yield initial_value
    for item in data:
        if len(state) == 0:
            state.append(item)
        else:
            prev: T | None = state[0]
            if prev is not None:
                next_val: T = prev + item
                try:
                    state[0] = next_val
                except IndexError:
                    return
        current: T | None = state[0]
        if current is not None:
            yield current

def compress(own data: Iterator[T], own selectors: Iterator[bool]) -> Iterator[T]:
    for value, selector in zip(data, selectors):
        if selector:
            yield value

def dropwhile(pred: Callable[[T], bool], own data: Iterator[T]) -> Iterator[T]:
    dropping: bool = True
    for val in data:
        if dropping:
            if not pred(val):
                dropping = False
                yield val
        else:
            yield val

def takewhile(pred: Callable[[T], bool], own data: Iterator[T]) -> Iterator[T]:
    for val in data:
        if not pred(val):
            return
        yield val

def filterfalse(pred: Callable[[T], bool], own data: Iterator[T]) -> Iterator[T]:
    for val in data:
        if not pred(val):
            yield val

def zip_longest(own a: Iterator[T], own b: Iterator[T], fill: T) -> Iterator[list[T]]:
    left: Iterator[T] = a
    right: Iterator[T] = b
    while True:
        left_value: T | None = next(left)
        right_value: T | None = next(right)
        if left_value is None and right_value is None:
            return
        pair: list[T] = []
        if left_value is not None:
            pair.append(left_value)
        else:
            pair.append(fill)
        if right_value is not None:
            pair.append(right_value)
        else:
            pair.append(fill)
        yield pair

def count_from(start: int, step: int, n: int) -> Iterator[int]:
    i: int = 0
    current: int = start.clone()
    while i < n:
        yield current
        current = current + step
        i = i + 1


def cycle(own data: Iterator[T], n: int) -> Iterator[T]:
    saved: list[T] = []
    emitted: int = 0
    if n <= 0:
        return
    for value in data:
        saved.append(value)
        yield value
        emitted = emitted + 1
        if emitted >= n:
            return
    while emitted < n and len(saved) > 0:
        for repeated in saved:
            yield repeated
            emitted = emitted + 1
            if emitted >= n:
                return
