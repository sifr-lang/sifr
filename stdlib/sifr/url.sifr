# sifr.url - URL, query, and percent primitives
from _sifr.url import url_build as _url_build_impl
from _sifr.url import url_normalize_path as _url_normalize_path_impl
from _sifr.url import url_parse as _url_parse_impl
from _sifr.url import url_percent_decode as _url_percent_decode_impl
from _sifr.url import url_percent_decode_bytes as _url_percent_decode_bytes_impl
from _sifr.url import url_percent_encode as _url_percent_encode_impl
from _sifr.url import url_percent_encode_bytes as _url_percent_encode_bytes_impl
from _sifr.url import url_query_build as _url_query_build_impl
from _sifr.url import url_query_parse as _url_query_parse_impl


class UrlError(Error):
    message: str


class Url:
    scheme: str
    username: str
    password: str | None
    host: str
    port: int | None
    path: str
    query: str | None
    fragment: str | None
    serialized: str

    def __init__(
        self,
        scheme: str,
        username: str,
        password: str | None,
        host: str,
        port: int | None,
        path: str,
        query: str | None,
        fragment: str | None,
        serialized: str,
    ):
        self.scheme = scheme
        self.username = username
        self.password = password
        self.host = host
        self.port = port
        self.path = path
        self.query = query
        self.fragment = fragment
        self.serialized = serialized

    def to_string(self) -> str:
        return self.serialized

    def __str__(self) -> str:
        return self.serialized

    def get_scheme(self) -> str:
        return self.scheme

    def get_username(self) -> str:
        return self.username

    def get_password(self) -> str | None:
        return self.password

    def get_host(self) -> str:
        return self.host

    def get_port(self) -> int | None:
        return self.port

    def get_path(self) -> str:
        return self.path

    def get_query(self) -> str | None:
        return self.query

    def get_fragment(self) -> str | None:
        return self.fragment

    def is_absolute(self) -> bool:
        return self.scheme != "" and self.host != ""


class UrlQuery:
    pairs: list[tuple[str, str]]

    def __init__(self, pairs: list[tuple[str, str]]):
        self.pairs = pairs

    def items(self) -> list[tuple[str, str]]:
        return self.pairs

    def get(self, name: str) -> str | None:
        for pair in self.pairs:
            if pair[0] == name:
                return pair[1]
        return None


def _url_part(parts: list[str], index: int) -> str:
    value: str | None = parts[index]
    if value is not None:
        return value + ""
    return ""


def _optional_part(value: str, marker: str) -> str | None:
    if marker == "1":
        return value + ""
    return None


def _optional_port(value: str) -> int | None:
    if value == "":
        return None
    try:
        parsed: int = int(value)
        return parsed
    except ParseError:
        return None


def _url_from_parts(parts: list[str]) -> Result[Url, UrlError]:
    if len(parts) != 12:
        raise UrlError("URL bridge payload has invalid field count")
    scheme: str = _url_part(parts, 0)
    username: str = _url_part(parts, 1)
    password_value: str = _url_part(parts, 2)
    password_marker: str = _url_part(parts, 3)
    host: str = _url_part(parts, 4)
    port_value: str = _url_part(parts, 5)
    path: str = _url_part(parts, 6)
    query_value: str = _url_part(parts, 7)
    query_marker: str = _url_part(parts, 8)
    fragment_value: str = _url_part(parts, 9)
    fragment_marker: str = _url_part(parts, 10)
    serialized: str = _url_part(parts, 11)
    return Url(
        scheme,
        username,
        _optional_part(password_value, password_marker),
        host,
        _optional_port(port_value),
        path,
        _optional_part(query_value, query_marker),
        _optional_part(fragment_value, fragment_marker),
        serialized,
    )


def _pairs_from_flat(flat: list[str]) -> list[tuple[str, str]]:
    pairs: list[tuple[str, str]] = []
    i: int = 0
    while i < len(flat):
        key: str = _url_part(flat, i)
        value: str = _url_part(flat, i + 1)
        pairs.append((key, value))
        i = i + 2
    return pairs


def _flatten_pairs(pairs: list[tuple[str, str]]) -> list[str]:
    flat: list[str] = []
    for pair in pairs:
        flat.append(pair[0])
        flat.append(pair[1])
    return flat


def parse(value: str) -> Result[Url, UrlError]:
    try:
        parts: list[str] = _url_parse_impl(value)
        return _url_from_parts(parts)
    except ParseError as e:
        raise UrlError(e.message)


def build(
    scheme: str,
    host: str,
    path: str = "/",
    query: str | None = None,
    port: int | None = None,
) -> Result[Url, UrlError]:
    try:
        parts: list[str] = _url_build_impl(scheme, host, path, query, port)
        return _url_from_parts(parts)
    except ParseError as e:
        raise UrlError(e.message)


def percent_encode(value: str) -> str:
    return _url_percent_encode_impl(value)


def percent_decode(value: str) -> Result[str, UrlError]:
    try:
        decoded: str = _url_percent_decode_impl(value)
        return decoded
    except ParseError as e:
        raise UrlError(e.message)


def percent_encode_bytes(value: bytes) -> str:
    return _url_percent_encode_bytes_impl(value)


def percent_decode_bytes(value: str) -> Result[bytes, UrlError]:
    try:
        decoded: bytes = _url_percent_decode_bytes_impl(value)
        return decoded
    except ParseError as e:
        raise UrlError(e.message)


def normalize_path(path: str) -> Result[str, UrlError]:
    try:
        normalized: str = _url_normalize_path_impl(path)
        return normalized
    except ParseError as e:
        raise UrlError(e.message)


def parse_query(query: str) -> Result[UrlQuery, UrlError]:
    try:
        flat: list[str] = _url_query_parse_impl(query)
        pairs: list[tuple[str, str]] = _pairs_from_flat(flat)
        return UrlQuery(pairs)
    except ParseError as e:
        raise UrlError(e.message)


def build_query(pairs: list[tuple[str, str]]) -> Result[str, UrlError]:
    try:
        query: str = _url_query_build_impl(_flatten_pairs(pairs))
        return query
    except ParseError as e:
        raise UrlError(e.message)
