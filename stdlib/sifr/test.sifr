# sifr.test — Test assertion functions

@compiler_intrinsic(test_assert_equal)
def assert_eq[T](actual: T, expected: T) -> None:
    ...

@compiler_intrinsic(test_assert_not_equal)
def assert_ne[T](actual: T, expected: T) -> None:
    ...

@compiler_intrinsic(test_assert_true)
def assert_true(value: bool) -> None:
    ...

@compiler_intrinsic(test_assert_false)
def assert_false(value: bool) -> None:
    ...

@compiler_intrinsic(test_assert_almost_equal)
def assert_almost_eq(actual: float, expected: float, tolerance: float) -> None:
    ...

def assert_not_almost_eq(actual: float, expected: float, tolerance: float) -> None:
    assert tolerance >= 0.0
    if actual == expected:
        assert False
    diff: float = actual - expected
    if diff < 0.0:
        diff = 0.0 - diff
    # NaN comparisons are treated as not-almost-equal.
    if diff != diff:
        return
    assert diff > tolerance

@compiler_intrinsic(test_assert_greater_than)
def assert_gt[T: Comparable](a: T, b: T) -> None:
    ...

def assert_ge[T: Comparable](a: T, b: T) -> None:
    assert a >= b

@compiler_intrinsic(test_assert_less_than)
def assert_lt[T: Comparable](a: T, b: T) -> None:
    ...

def assert_le[T: Comparable](a: T, b: T) -> None:
    assert a <= b

def assert_some[T](own value: T | None) -> None:
    assert value is not None

def assert_none[T](own value: T | None) -> None:
    assert value is None

def assert_ok[T](own value: Result[T, Error]) -> None:
    try:
        out: T = value
    except Error as e:
        assert False

def assert_err[T](own value: Result[T, Error]) -> None:
    try:
        out: T = value
        assert False
    except Error as e:
        pass

# Reusable vector helpers for CPython parity tests.
def assert_vector_eq(actual: list[str], expected: list[str]) -> None:
    assert_eq(len(actual), len(expected))
    i: int = 0
    while i < len(actual):
        assert actual[i] == expected[i]
        i = i + 1

def assert_bool_vector_eq(actual: list[bool], expected: list[bool]) -> None:
    assert_eq(len(actual), len(expected))
    i: int = 0
    while i < len(actual):
        assert actual[i] == expected[i]
        i = i + 1
