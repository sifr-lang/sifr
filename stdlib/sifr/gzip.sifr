# sifr.gzip — GZip compression/decompression
from _sifr.compress import _gzip_compress_bytes_impl, _gzip_decompress_bytes_impl

def compress(data: str) -> bytes:
    return _gzip_compress_bytes_impl(data)

def decompress(data: bytes) -> Result[str, IOError]:
    return _gzip_decompress_bytes_impl(data)
