from _sifr.fs import read_text as _read_text_impl
from _sifr.fs import write_text as _write_text_impl
from _sifr.json import json_dump_tokens as _json_dump_tokens_impl
from _sifr.json import json_dump_tokens_exact as _json_dump_tokens_exact_impl
from _sifr.json import json_dump_tokens_string_ints as _json_dump_tokens_string_ints_impl
from _sifr.json import json_dump_tokens_web as _json_dump_tokens_web_impl
from _sifr.json import json_load_tokens as _json_load_tokens_impl
from _sifr.json import json_validate_integer_digit_limits as _json_validate_integer_digit_limits_impl
from sifr.io import FileHandle


class JsonValue:
    kind: str
    bool_value: bool | None
    int_value: int | None
    float_value: float | None
    str_value: str | None
    array_items: list[JsonValue]
    object_items: list[tuple[str, JsonValue]]

    def __init__(
        self,
        kind: str,
        bool_value: bool | None = None,
        int_value: int | None = None,
        float_value: float | None = None,
        str_value: str | None = None,
    ):
        self.kind = kind
        self.bool_value = bool_value
        self.int_value = int_value
        self.float_value = float_value
        self.str_value = str_value
        self.array_items = []
        self.object_items = []

    def __str__(self) -> str:
        return dumps(self)

    def is_null(self) -> bool:
        return self.kind == "null"

    def is_bool(self) -> bool:
        return self.kind == "bool"

    def is_int(self) -> bool:
        return self.kind == "int"

    def is_float(self) -> bool:
        return self.kind == "float"

    def is_str(self) -> bool:
        return self.kind == "str"

    def is_array(self) -> bool:
        return self.kind == "array"

    def is_object(self) -> bool:
        return self.kind == "object"

    def as_bool(self) -> bool | None:
        return self.bool_value

    def as_int(self) -> int | None:
        return self.int_value

    def as_float(self) -> float | None:
        return self.float_value

    def as_str(self) -> str | None:
        return self.str_value

    def as_array(self) -> list[JsonValue] | None:
        if not self.is_array():
            return None
        result: list[JsonValue] = []
        for item in self.array_items:
            result.append(item)
        return result

    def as_object(self) -> list[tuple[str, JsonValue]] | None:
        if not self.is_object():
            return None
        result: list[tuple[str, JsonValue]] = []
        for key, value in self.object_items:
            result.append((key, value))
        return result

    def at(self, index: int) -> JsonValue | None:
        if not self.is_array():
            return None
        if index < 0 or index >= len(self.array_items):
            return None
        value: JsonValue | None = self.array_items[index]
        return value

    def get(self, key: str) -> JsonValue | None:
        if not self.is_object():
            return None
        for item_key, item_value in self.object_items:
            if item_key == key:
                return item_value
        return None

    def keys(self) -> list[str]:
        result: list[str] = []
        if not self.is_object():
            return result
        for item_key, _item_value in self.object_items:
            result.append(item_key)
        return result

    def values(self) -> list[JsonValue]:
        result: list[JsonValue] = []
        if not self.is_object():
            return result
        for _item_key, item_value in self.object_items:
            result.append(item_value)
        return result

    def items(self) -> list[tuple[str, JsonValue]]:
        if not self.is_object():
            return []
        result: list[tuple[str, JsonValue]] = []
        for key, value in self.object_items:
            result.append((key, value))
        return result


class JSONEncoder:
    indent: int | None
    sort_keys: bool
    ensure_ascii: bool

    def __init__(
        self,
        indent: int | None = None,
        sort_keys: bool = False,
        ensure_ascii: bool = True,
    ) -> None:
        self.indent = indent
        self.sort_keys = sort_keys
        self.ensure_ascii = ensure_ascii

    def encode(self, value: JsonValue) -> str:
        # Current runtime encoding is deterministic and typed; option flags are
        # accepted as part of the locked wrapper surface even when no-op.
        _ = self.indent
        _ = self.sort_keys
        _ = self.ensure_ascii
        return dumps(value)

    def dump(self, value: JsonValue, path: str) -> Result[None, IOError]:
        return _write_text_impl(path, self.encode(value))

    def dump_handle(self, value: JsonValue, fh: FileHandle) -> Result[None, IOError]:
        return fh.write(self.encode(value))


class JSONDecoder:
    def __init__(self) -> None:
        pass

    def decode(self, s: str) -> Result[JsonValue, JSONDecodeError]:
        return _loads_impl(s)

    def load(self, path: str) -> Result[JsonValue, Error]:
        return load(path)

    def load_handle(self, fh: FileHandle) -> Result[JsonValue, Error]:
        return load_handle(fh)


def null() -> JsonValue:
    return JsonValue("null")


def from_bool(value: bool) -> JsonValue:
    bool_value: bool | None = value
    return JsonValue("bool", bool_value=bool_value)


def from_int(value: int) -> JsonValue:
    int_value: int | None = value
    return JsonValue("int", int_value=int_value)


def from_float(value: float) -> JsonValue:
    float_value: float | None = value
    return JsonValue("float", float_value=float_value)


def from_str(value: str) -> JsonValue:
    str_value: str | None = value + ""
    return JsonValue("str", str_value=str_value)


def _append_array_item(own mut value: JsonValue, own item: JsonValue) -> JsonValue:
    value.array_items.append(item)
    return value


def _append_object_item(
    own mut value: JsonValue, own key: str, own item_value: JsonValue
) -> JsonValue:
    value.object_items.append((key, item_value))
    return value


def from_array(items: list[JsonValue]) -> JsonValue:
    value: JsonValue = JsonValue("array")
    for item in items:
        value = _append_array_item(value, item)
    return value


def from_object(items: list[tuple[str, JsonValue]]) -> JsonValue:
    value: JsonValue = JsonValue("object")
    for key, item_value in items:
        value = _append_object_item(value, key, item_value)
    return value


def _json_token_at(tokens: list[str], index: int) -> Result[str, JSONDecodeError]:
    value: str | None = tokens[index]
    if value is None:
        raise JSONDecodeError("JSON bridge payload ended unexpectedly")
    return value + ""


def _json_token_int(tokens: list[str], index: int) -> Result[int, JSONDecodeError]:
    try:
        token: str = _json_token_at(tokens, index)
        parsed: int = int(token)
        return parsed
    except ParseError:
        raise JSONDecodeError("JSON bridge payload has invalid integer metadata")
    except JSONDecodeError as e:
        raise JSONDecodeError(e.message)


def _json_token_float(tokens: list[str], index: int) -> Result[float, JSONDecodeError]:
    try:
        token: str = _json_token_at(tokens, index)
        parsed: float = float(token)
        return parsed
    except ParseError:
        raise JSONDecodeError("JSON bridge payload has invalid float metadata")
    except JSONDecodeError as e:
        raise JSONDecodeError(e.message)


def _json_decode_bool_token(value: str) -> Result[bool, JSONDecodeError]:
    if value == "true":
        return True
    if value == "false":
        return False
    raise JSONDecodeError("JSON bridge payload has invalid bool metadata")


def _json_decode_value_at(
    tokens: list[str],
    index: int,
) -> Result[tuple[JsonValue, int], JSONDecodeError]:
    try:
        tag: str = _json_token_at(tokens, index)
        payload_index: int = index + 1
        if tag == "null":
            return (JsonValue("null"), payload_index)
        if tag == "bool":
            bool_token: str = _json_token_at(tokens, payload_index)
            bool_value: bool = _json_decode_bool_token(bool_token)
            return (JsonValue("bool", bool_value=bool_value), payload_index + 1)
        if tag == "int":
            int_value: int = _json_token_int(tokens, payload_index)
            return (JsonValue("int", int_value=int_value), payload_index + 1)
        if tag == "float":
            float_value: float = _json_token_float(tokens, payload_index)
            return (JsonValue("float", float_value=float_value), payload_index + 1)
        if tag == "str":
            str_value: str = _json_token_at(tokens, payload_index)
            return (JsonValue("str", str_value=str_value), payload_index + 1)
        if tag == "array":
            array_count: int = _json_token_int(tokens, payload_index)
            if array_count < 0:
                raise JSONDecodeError("JSON bridge payload has invalid array length")
            array_value: JsonValue = JsonValue("array")
            next_index: int = payload_index + 1
            consumed: int = 0
            while consumed < array_count:
                item_result: tuple[JsonValue, int] = _json_decode_value_at(tokens, next_index)
                array_value.array_items.append(item_result[0])
                next_index = item_result[1]
                consumed = consumed + 1
            return (array_value, next_index)
        if tag == "object":
            object_count: int = _json_token_int(tokens, payload_index)
            if object_count < 0:
                raise JSONDecodeError("JSON bridge payload has invalid object length")
            object_value: JsonValue = JsonValue("object")
            next_index: int = payload_index + 1
            consumed: int = 0
            while consumed < object_count:
                key: str = _json_token_at(tokens, next_index)
                item_result: tuple[JsonValue, int] = _json_decode_value_at(tokens, next_index + 1)
                object_value.object_items.append((key, item_result[0]))
                next_index = item_result[1]
                consumed = consumed + 1
            return (object_value, next_index)
        raise JSONDecodeError("JSON bridge payload has unknown value tag: " + tag)
    except JSONDecodeError as e:
        raise JSONDecodeError(e.message)


def _json_decode_tokens(tokens: list[str]) -> Result[JsonValue, JSONDecodeError]:
    try:
        decoded: tuple[JsonValue, int] = _json_decode_value_at(tokens, 0)
        if decoded[1] != len(tokens):
            raise JSONDecodeError("JSON bridge payload has trailing data")
        return decoded[0]
    except JSONDecodeError as e:
        raise JSONDecodeError(e.message)


def _json_append_tokens(own mut tokens: list[str], value: JsonValue) -> list[str]:
    tokens.append(value.kind + "")
    if value.kind == "bool":
        bool_value: bool | None = value.bool_value
        if bool_value is None:
            tokens.append("false")
        else:
            tokens.append(str(bool_value).lower())
    elif value.kind == "int":
        int_value: int | None = value.int_value
        if int_value is None:
            tokens.append("0")
        else:
            tokens.append(str(int_value))
    elif value.kind == "float":
        float_value: float | None = value.float_value
        if float_value is None:
            tokens.append("0.0")
        else:
            tokens.append(str(float_value))
    elif value.kind == "str":
        str_value: str | None = value.as_str()
        if str_value is None:
            tokens.append("")
        else:
            tokens.append(str_value)
    elif value.kind == "array":
        tokens.append(str(len(value.array_items)))
        for item in value.array_items:
            tokens = _json_append_tokens(tokens, item)
    elif value.kind == "object":
        tokens.append(str(len(value.object_items)))
        for key, item_value in value.object_items:
            tokens.append(key)
            tokens = _json_append_tokens(tokens, item_value)
    return tokens


def _json_bridge_tokens(value: JsonValue) -> list[str]:
    tokens: list[str] = []
    return _json_append_tokens(tokens, value)


def _loads_impl(s: str) -> Result[JsonValue, JSONDecodeError]:
    try:
        tokens: list[str] = _json_load_tokens_impl(s)
        return _json_decode_tokens(tokens)
    except JSONDecodeError as e:
        raise e


def loads(s: str) -> Result[JsonValue, JSONDecodeError]:
    return _loads_impl(s)


def validate_integer_digit_limits(s: str) -> Result[None, JsonLimitError]:
    return _json_validate_integer_digit_limits_impl(s)


def _decode_loaded_json(content: str) -> Result[JsonValue, Error]:
    try:
        value: JsonValue = _loads_impl(content)
        return value
    except JSONDecodeError as e:
        raise Error(e.message)


def load_handle(fh: FileHandle) -> Result[JsonValue, Error]:
    content_result: Result[str, IOError] = fh.read()
    try:
        content: str = content_result
        return _decode_loaded_json(content)
    except IOError as e:
        raise Error(e.message)


def load(path: str) -> Result[JsonValue, Error]:
    content_result: Result[str, IOError] = _read_text_impl(path)
    try:
        content: str = content_result
        return _decode_loaded_json(content)
    except IOError as e:
        raise Error(e.message)


def dumps(value: JsonValue | bool | int | float | str | decimal | bigdecimal) -> str:
    if isinstance(value, JsonValue):
        return _json_dump_tokens_impl(_json_bridge_tokens(value))
    elif isinstance(value, bool):
        return _json_dump_tokens_impl(_json_bridge_tokens(from_bool(value)))
    elif isinstance(value, int):
        return _json_dump_tokens_impl(_json_bridge_tokens(from_int(value)))
    elif isinstance(value, float):
        return _json_dump_tokens_impl(_json_bridge_tokens(from_float(value)))
    else:
        return _json_dump_tokens_impl(_json_bridge_tokens(from_str(str(value))))


def dumps_exact(value: JsonValue) -> str:
    return _json_dump_tokens_exact_impl(_json_bridge_tokens(value))


def dumps_web(value: JsonValue) -> Result[str, JsonIntegerRangeError]:
    return _json_dump_tokens_web_impl(_json_bridge_tokens(value))


def dumps_string_ints(value: JsonValue) -> str:
    return _json_dump_tokens_string_ints_impl(_json_bridge_tokens(value))


def dump_handle(value: JsonValue, fh: FileHandle) -> Result[None, IOError]:
    payload: str = dumps(value)
    return fh.write(payload)


def dump(value: JsonValue, path: str) -> Result[None, IOError]:
    payload: str = dumps(value)
    return _write_text_impl(path, payload)
