# sifr.math — Math functions and constants
from _sifr.math import sqrt, floor, ceil, abs_val, log, cbrt, sin, cos, tan, pow_val, min_val, max_val, round_val, pi, e, asin, acos, atan, atan2, sinh, cosh, tanh, log10, log2, exp2, degrees, radians, isnan, isinf, trunc, copysign, signbit, fmod, remainder, hypot, fma, fmax, fmin, tau, inf, nan, exp, expm1, log1p, fabs, isfinite, isnormal, issubnormal, acosh, asinh, atanh, isqrt, dist, fsum, sumprod, erf, erfc, gamma, lgamma, frexp, ldexp, modf, nextafter, ulp

def factorial(n: int) -> int:
    if n < 0:
        return 0
    result: int = 1
    i: int = 2
    while i <= n:
        result = result * i
        i = i + 1
    return result

def gcd(a: int, b: int) -> int:
    x: int = a
    y: int = b
    if x < 0:
        x = 0 - x
    if y < 0:
        y = 0 - y
    while y != 0:
        temp: int = y
        y = x % y
        x = temp
    return x

def lcm(a: int, b: int) -> int:
    if a == 0:
        return 0
    if b == 0:
        return 0
    g: int = gcd(a, b)
    x: int = a
    if x < 0:
        x = 0 - x
    y: int = b
    if y < 0:
        y = 0 - y
    return (x // g) * y

def comb(n: int, k: int) -> int:
    if k < 0:
        return 0
    if k > n:
        return 0
    if k == 0:
        return 1
    if k == n:
        return 1
    r: int = k
    if r > n - k:
        r = n - k
    result: int = 1
    i: int = 0
    while i < r:
        result = result * (n - i)
        result = result // (i + 1)
        i = i + 1
    return result

def perm(n: int, k: int) -> int:
    if k < 0:
        return 0
    if k > n:
        return 0
    result: int = 1
    i: int = 0
    while i < k:
        result = result * (n - i)
        i = i + 1
    return result

def log_base(x: float, base: float) -> float:
    return log(x) / log(base)

def isclose(a: float, b: float, rel_tol: float, abs_tol: float) -> bool:
    if rel_tol < 0.0:
        return False
    if abs_tol < 0.0:
        return False
    if a == b:
        return True
    if isnan(a) or isnan(b):
        return False
    if isinf(a) or isinf(b):
        return False
    diff: float = a - b
    if diff < 0.0:
        diff = 0.0 - diff
    a_abs: float = a
    if a_abs < 0.0:
        a_abs = 0.0 - a_abs
    b_abs: float = b
    if b_abs < 0.0:
        b_abs = 0.0 - b_abs
    rel_bound: float = rel_tol * max_val(a_abs, b_abs)
    if abs_tol > rel_bound:
        rel_bound = abs_tol
    return diff <= rel_bound

def prod(data: list[int]) -> int:
    result: int = 1
    for val in data:
        result = result * val
    return result

# Tuple-style adapters for pair-returning math intrinsics.
# Sifr currently models these as list pairs.
def frexp_mantissa(x: float) -> float:
    parts: list[float] = frexp(x)
    m: float | None = parts[0]
    if m is None:
        return nan
    return m

def frexp_exponent(x: float) -> int:
    parts: list[float] = frexp(x)
    exp_val: float | None = parts[1]
    if exp_val is None:
        return 0
    return trunc(exp_val)

def modf_fractional(x: float) -> float:
    parts: list[float] = modf(x)
    f: float | None = parts[0]
    if f is None:
        return nan
    return f

def modf_integral(x: float) -> float:
    parts: list[float] = modf(x)
    i: float | None = parts[1]
    if i is None:
        return nan
    return i

# CPython-compatible aliases
# Note: fabs is already imported from _sifr.math, so it's already available
def pow(x: float, y: float) -> float:
    return pow_val(x, y)
