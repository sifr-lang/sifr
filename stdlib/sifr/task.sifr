# sifr.task - Structured task context value model


class Context:
    name: str

    def __init__(self, name: str = "Context"):
        self.name = name

    def __str__(self) -> str:
        return self.name


class ContextKey[T]:
    name: str
    default: T

    def __init__(self, name: str, own default: T):
        self.name = name
        self.default = default


def empty_context() -> Context:
    return Context()


@compiler_intrinsic(task_current_context)
def current_context() -> Context:
    ...
