# sifr.task - Structured task context value model

from _sifr.task import task_current_context


class Context:
    name: str

    def __init__(self, name: str = "Context"):
        self.name = name

    def __str__(self) -> str:
        return self.name


class ContextKey[T]:
    name: str
    default: T

    def __init__(self, name: str, own default: T):
        self.name = name
        self.default = default


def empty_context() -> Context:
    return Context()


def current_context() -> Context:
    return task_current_context()
