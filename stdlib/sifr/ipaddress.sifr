# sifr.ipaddress — IP address manipulation (pure Sifr)


class AddressValueError(Error):
    message: str

    def __init__(self, message: str) -> None:
        self.message = message + ""

def is_valid_ipv4(addr: str) -> bool:
    parts: list[str] = addr.split(".")
    if len(parts) != 4:
        return False
    for part in parts:
        if len(part) == 0:
            return False
        if len(part) > 3:
            return False
        if len(part) > 1:
            first_digit: str | None = part[0]
            if first_digit is not None and first_digit == "0":
                return False
        val: int = _parse_int(part)
        if val < 0:
            return False
        if val > 255:
            return False
    return True

def _parse_int(s: str) -> int:
    result: int = 0
    i: int = 0
    while i < len(s):
        ch: str | None = s[i]
        if ch is not None:
            if ch == "0":
                result = result * 10
            elif ch == "1":
                result = result * 10 + 1
            elif ch == "2":
                result = result * 10 + 2
            elif ch == "3":
                result = result * 10 + 3
            elif ch == "4":
                result = result * 10 + 4
            elif ch == "5":
                result = result * 10 + 5
            elif ch == "6":
                result = result * 10 + 6
            elif ch == "7":
                result = result * 10 + 7
            elif ch == "8":
                result = result * 10 + 8
            elif ch == "9":
                result = result * 10 + 9
            else:
                return -1
        i = i + 1
    return result

def _ip_to_int_raw(addr: str) -> int:
    parts: list[str] = addr.split(".")
    result: int = 0
    for part in parts:
        val: int = _parse_int(part)
        result = result * 256 + val
    return result

def _in_ipv4_range(value: int, start: int, end: int) -> bool:
    if value < start:
        return False
    if value > end:
        return False
    return True

def _is_private_ipv4_value(value: int) -> bool:
    private_hit: bool = False

    if _in_ipv4_range(value, 0, 16777215):  # 0.0.0.0/8
        private_hit = True
    elif _in_ipv4_range(value, 167772160, 184549375):  # 10.0.0.0/8
        private_hit = True
    elif _in_ipv4_range(value, 2130706432, 2147483647):  # 127.0.0.0/8
        private_hit = True
    elif _in_ipv4_range(value, 2851995648, 2852061183):  # 169.254.0.0/16
        private_hit = True
    elif _in_ipv4_range(value, 2886729728, 2887778303):  # 172.16.0.0/12
        private_hit = True
    elif _in_ipv4_range(value, 3221225472, 3221225727):  # 192.0.0.0/24
        private_hit = True
    elif _in_ipv4_range(value, 3221225642, 3221225643):  # 192.0.0.170/31
        private_hit = True
    elif _in_ipv4_range(value, 3221225984, 3221226239):  # 192.0.2.0/24
        private_hit = True
    elif _in_ipv4_range(value, 3232235520, 3232301055):  # 192.168.0.0/16
        private_hit = True
    elif _in_ipv4_range(value, 3323068416, 3323199487):  # 198.18.0.0/15
        private_hit = True
    elif _in_ipv4_range(value, 3325256704, 3325256959):  # 198.51.100.0/24
        private_hit = True
    elif _in_ipv4_range(value, 3405803776, 3405804031):  # 203.0.113.0/24
        private_hit = True
    elif _in_ipv4_range(value, 4026531840, 4294967295):  # 240.0.0.0/4
        private_hit = True
    elif value == 4294967295:  # 255.255.255.255/32
        private_hit = True

    if private_hit:
        if value == 3221225481:  # 192.0.0.9/32
            return False
        if value == 3221225482:  # 192.0.0.10/32
            return False
    return private_hit

def ip_to_int(addr: str) -> Result[int, ValueError]:
    if not is_valid_ipv4(addr):
        raise ValueError("invalid IPv4 address")
    return _ip_to_int_raw(addr)

def is_private(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    val: int = _ip_to_int_raw(addr)
    return _is_private_ipv4_value(val)

def is_loopback(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    parts: list[str] = addr.split(".")
    if len(parts) == 4:
        first: str | None = parts[0]
        if first is not None:
            if first == "127":
                return True
    return False

def int_to_ip(val: int) -> str:
    if val < 0 or val > 4294967295:
        return "0.0.0.0"
    a: int = val // 16777216
    rem: int = val % 16777216
    b: int = rem // 65536
    rem = rem % 65536
    c: int = rem // 256
    d: int = rem % 256
    return str(a) + "." + str(b) + "." + str(c) + "." + str(d)

def is_multicast(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    parts: list[str] = addr.split(".")
    if len(parts) == 4:
        first: str | None = parts[0]
        if first is not None:
            val: int = _parse_int(first)
            if val >= 224:
                if val <= 239:
                    return True
    return False

def is_global(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    val: int = _ip_to_int_raw(addr)
    if _in_ipv4_range(val, 1681915904, 1686110207):  # 100.64.0.0/10
        return False
    return not _is_private_ipv4_value(val)


def is_link_local(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    val: int = _ip_to_int_raw(addr)
    return _in_ipv4_range(val, 2851995648, 2852061183)  # 169.254.0.0/16


def is_reserved(addr: str) -> bool:
    if not is_valid_ipv4(addr):
        return False
    val: int = _ip_to_int_raw(addr)
    return _in_ipv4_range(val, 4026531840, 4294967295)  # 240.0.0.0/4


class IPv4Address:
    _text: str
    _value: int

    def __init__(self, addr: str) -> None:
        normalized_text: str = addr + ""
        normalized_value: int = -1
        if is_valid_ipv4(addr):
            parsed: int = _ip_to_int_raw(addr)
            normalized_value = parsed
            normalized_text = int_to_ip(parsed)
        self._value = normalized_value
        self._text = normalized_text

    def to_str(self) -> str:
        return self._text + ""

    def packed_int(self) -> int:
        return self._value

    def version(self) -> int:
        return 4

    def is_private(self) -> bool:
        return is_private(self._text)

    def is_loopback(self) -> bool:
        return is_loopback(self._text)

    def is_multicast(self) -> bool:
        return is_multicast(self._text)

    def is_global(self) -> bool:
        return is_global(self._text)

    def is_link_local(self) -> bool:
        return is_link_local(self._text)

    def is_reserved(self) -> bool:
        return is_reserved(self._text)


def ip_address(addr: str) -> Result[IPv4Address, AddressValueError]:
    if not is_valid_ipv4(addr):
        raise AddressValueError("invalid IPv4 address")
    return IPv4Address(addr)


def ipv4_address(addr: str) -> Result[IPv4Address, AddressValueError]:
    return ip_address(addr)
