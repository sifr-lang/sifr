# sifr.datetime — Date and time classes
from _sifr.datetime import datetime_now_struct, datetime_format, datetime_from_timestamp
from _sifr.time import time_now

def _is_leap_year(year: int) -> bool:
    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)

def _days_in_year(year: int) -> int:
    if _is_leap_year(year):
        return 366
    return 365

def _days_in_month(year: int, month: int) -> int:
    month_days: list[int] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    idx: int = month - 1
    d: int | None = month_days[idx]
    if month == 2 and _is_leap_year(year):
        return 29
    if d is not None:
        return d
    return 0


def _substring(value: str, start: int, end: int) -> str:
    result: str = ""
    i: int = start
    while i < end:
        ch: str | None = value[i]
        if ch is not None:
            result = result + ch
        i = i + 1
    return result


def _six_digits(value: int) -> str:
    rendered: str = str(value)
    while len(rendered) < 6:
        rendered = "0" + rendered
    return rendered


def _parse_datetime_iso(value: str) -> Result[tuple[int, int, int, int, int, int], ValueError]:
    if len(value) < 19:
        raise ValueError("invalid datetime string")
    if value[4] != "-" or value[7] != "-" or value[10] != "T" or value[13] != ":" or value[16] != ":":
        raise ValueError("invalid datetime string")
    try:
        year: int = int(_substring(value, 0, 4))
        month: int = int(_substring(value, 5, 7))
        day: int = int(_substring(value, 8, 10))
        hour: int = int(_substring(value, 11, 13))
        minute: int = int(_substring(value, 14, 16))
        second: int = int(_substring(value, 17, 19))
        return (year, month, day, hour, minute, second)
    except ParseError:
        raise ValueError("invalid datetime string")


def _timezone_offset_from_text(text: str) -> Result[int, ValueError]:
    if text == "UTC":
        return 0
    if len(text) != 9:
        raise ValueError("invalid timezone string")
    if _substring(text, 0, 3) != "UTC":
        raise ValueError("invalid timezone string")
    sign_value: str = _substring(text, 3, 4)
    if sign_value != "+" and sign_value != "-":
        raise ValueError("invalid timezone string")
    if text[6] != ":":
        raise ValueError("invalid timezone string")
    try:
        hours: int = int(_substring(text, 4, 6))
        minutes: int = int(_substring(text, 7, 9))
        offset: int = hours * 3600 + minutes * 60
        if sign_value == "-":
            offset = -offset
        return offset
    except ParseError:
        raise ValueError("invalid timezone string")


class timedelta:
    _days: int
    _seconds: int
    _microseconds: int

    def __init__(self, days: int, seconds: int, microseconds: int = 0):
        self._days = days
        self._seconds = seconds
        self._microseconds = microseconds

    def total_seconds(self) -> int:
        return self._days * 86400 + self._seconds

    def days(self) -> int:
        return self._days

    def seconds(self) -> int:
        return self._seconds

    def microseconds(self) -> int:
        return self._microseconds

    def total_microseconds(self) -> int:
        return (self._days * 86400 + self._seconds) * 1000000 + self._microseconds

    def total_seconds_float(self) -> float:
        return float(self.total_microseconds()) / 1000000.0

    def __add__(self, other: timedelta) -> timedelta:
        total: int = self.total_microseconds() + other.total_microseconds()
        d: int = total // 86400000000
        remaining: int = total % 86400000000
        s: int = remaining // 1000000
        us: int = remaining % 1000000
        return timedelta(d, s, us)

    def __sub__(self, other: timedelta) -> timedelta:
        total: int = self.total_microseconds() - other.total_microseconds()
        d: int = total // 86400000000
        remaining: int = total % 86400000000
        s: int = remaining // 1000000
        us: int = remaining % 1000000
        return timedelta(d, s, us)

    def __eq__(self, other: timedelta) -> bool:
        return self.total_microseconds() == other.total_microseconds()


class timezone:
    _offset: int

    def __init__(self, offset: int) -> None:
        self._offset = offset

    def offset(self) -> int:
        return self._offset

    def iso_suffix(self) -> str:
        sign: str = "+"
        if self._offset < 0:
            sign = "-"
        abs_offset: int = self._offset
        if abs_offset < 0:
            abs_offset = -abs_offset
        h: int = abs_offset // 3600
        m: int = (abs_offset % 3600) // 60
        hs: str = str(h)
        if len(hs) < 2:
            hs = "0" + hs
        ms: str = str(m)
        if len(ms) < 2:
            ms = "0" + ms
        return sign + hs + ":" + ms

    def __str__(self) -> str:
        if self._offset == 0:
            return "UTC"
        return "UTC" + self.iso_suffix()

    def __eq__(self, other: timezone) -> bool:
        return self._offset == other._offset


def UTC() -> timezone:
    return timezone(0)


def utc() -> timezone:
    return UTC()


class datetime:
    # A full datetime class with optional fixed-offset timezone.
    year: int
    month: int
    day: int
    hour: int
    minute: int
    second: int
    microsecond: int
    _tz_offset: int | None

    def __init__(
        self,
        year: int,
        month: int,
        day: int,
        hour: int,
        minute: int,
        second: int,
        microsecond: int = 0,
        tz_offset: int | None = None,
    ) -> None:
        self.year = year
        self.month = month
        self.day = day
        self.hour = hour
        self.minute = minute
        self.second = second
        self.microsecond = microsecond
        self._tz_offset = tz_offset

    def isoformat(self) -> str:
        # Returns ISO 8601 format: YYYY-MM-DDTHH:MM:SS(+/-HH:MM for aware datetimes)
        y: str = str(self.year)
        mo: str = str(self.month)
        if len(mo) < 2:
            mo = "0" + mo
        d: str = str(self.day)
        if len(d) < 2:
            d = "0" + d
        h: str = str(self.hour)
        if len(h) < 2:
            h = "0" + h
        mi: str = str(self.minute)
        if len(mi) < 2:
            mi = "0" + mi
        s: str = str(self.second)
        if len(s) < 2:
            s = "0" + s
        base: str = y + "-" + mo + "-" + d + "T" + h + ":" + mi + ":" + s
        if self.microsecond != 0:
            base = base + "." + _six_digits(self.microsecond)
        tz_offset_opt: int | None = self._tz_offset
        if tz_offset_opt is not None:
            offset: int = tz_offset_opt
            sign: str = "+"
            abs_offset: int = offset
            if abs_offset < 0:
                sign = "-"
                abs_offset = -abs_offset
            h_off: int = abs_offset // 3600
            m_off: int = (abs_offset % 3600) // 60
            hs_off: str = str(h_off)
            if len(hs_off) < 2:
                hs_off = "0" + hs_off
            ms_off: str = str(m_off)
            if len(ms_off) < 2:
                ms_off = "0" + ms_off
            return base + sign + hs_off + ":" + ms_off
        return base

    def timestamp(self) -> int:
        # Unix timestamp using Gregorian calendar arithmetic.
        # For aware datetimes, normalize using the fixed offset.
        # Handles both pre- and post-epoch dates deterministically.
        days: int = 0
        if self.year >= 1970:
            y: int = 1970
            while y < self.year:
                days = days + _days_in_year(y)
                y = y + 1
        else:
            y: int = 1969
            while y >= self.year:
                days = days - _days_in_year(y)
                y = y - 1

        m: int = 1
        while m < self.month:
            days = days + _days_in_month(self.year, m)
            m = m + 1

        days = days + self.day - 1
        naive_timestamp: int = days * 86400 + self.hour * 3600 + self.minute * 60 + self.second
        tz_offset_opt: int | None = self._tz_offset
        if tz_offset_opt is not None:
            offset: int = tz_offset_opt
            return naive_timestamp - offset
        return naive_timestamp

    def timestamp_microseconds(self) -> int:
        return self.timestamp() * 1000000 + self.microsecond

    def astimezone(self, tz: timezone | None = None) -> Result[datetime, ValueError]:
        target: timezone = timezone(0)
        if tz is not None:
            try:
                tz_text: str = str(tz)
                target_offset: int = _timezone_offset_from_text(tz_text)
                target = timezone(target_offset)
            except ValueError as e:
                raise ValueError(e.message)
        return _from_timestamp_microseconds_with_tz(self.timestamp_microseconds(), target)

    def __eq__(self, other: datetime) -> bool:
        same_tz: bool = self._tz_offset == other._tz_offset
        return self.year == other.year and self.month == other.month and self.day == other.day and self.hour == other.hour and self.minute == other.minute and self.second == other.second and self.microsecond == other.microsecond and same_tz

    def __str__(self) -> str:
        return self.isoformat()


class date:
    year: int
    month: int
    day: int

    def isoformat(self) -> str:
        y: str = str(self.year)
        mo: str = str(self.month)
        if len(mo) < 2:
            mo = "0" + mo
        d: str = str(self.day)
        if len(d) < 2:
            d = "0" + d
        return y + "-" + mo + "-" + d

    def __eq__(self, other: date) -> bool:
        return self.year == other.year and self.month == other.month and self.day == other.day

    def __str__(self) -> str:
        return self.isoformat()


class time:
    hour: int
    minute: int
    second: int
    microsecond: int = 0
    _tz_offset: int | None = None

    def isoformat(self) -> str:
        h: str = str(self.hour)
        if len(h) < 2:
            h = "0" + h
        mi: str = str(self.minute)
        if len(mi) < 2:
            mi = "0" + mi
        s: str = str(self.second)
        if len(s) < 2:
            s = "0" + s
        rendered: str = h + ":" + mi + ":" + s
        if self.microsecond != 0:
            rendered = rendered + "." + _six_digits(self.microsecond)
        tz_offset_opt: int | None = self._tz_offset
        if tz_offset_opt is not None:
            return rendered + timezone(tz_offset_opt).iso_suffix()
        return rendered

    def is_aware(self) -> bool:
        return self._tz_offset is not None

    def utc_offset_seconds(self) -> int | None:
        return self._tz_offset

    def __eq__(self, other: time) -> bool:
        return self.hour == other.hour and self.minute == other.minute and self.second == other.second and self.microsecond == other.microsecond and self._tz_offset == other._tz_offset

    def __str__(self) -> str:
        return self.isoformat()


def _from_timestamp_with_tz(ts: float, tz: timezone | None) -> Result[datetime, ValueError]:
    try:
        whole_seconds: int = int(ts)
        fractional: float = ts - float(whole_seconds)
        microsecond: int = int(fractional * 1000000.0)
        if microsecond < 0:
            microsecond = -microsecond
        adjusted_seconds: int = whole_seconds
        tz_offset_value: int = 0
        tz_has_offset: bool = False
        if tz is not None:
            tz_text: str = str(tz)
            tz_offset: int = _timezone_offset_from_text(tz_text)
            adjusted_seconds = whole_seconds + tz_offset
            tz_offset_value = tz_offset
            tz_has_offset = True

        rendered: str = datetime_from_timestamp(float(adjusted_seconds))
        parts: tuple[int, int, int, int, int, int] = _parse_datetime_iso(rendered)
        year_part: int | None = parts[0]
        month_part: int | None = parts[1]
        day_part: int | None = parts[2]
        hour_part: int | None = parts[3]
        minute_part: int | None = parts[4]
        second_part: int | None = parts[5]
        year: int = 0
        month: int = 1
        day: int = 1
        hour: int = 0
        minute: int = 0
        second: int = 0
        if year_part is not None:
            year = year_part
        if month_part is not None:
            month = month_part
        if day_part is not None:
            day = day_part
        if hour_part is not None:
            hour = hour_part
        if minute_part is not None:
            minute = minute_part
        if second_part is not None:
            second = second_part
        if tz_has_offset:
            return datetime(year, month, day, hour, minute, second, microsecond, tz_offset_value)
        return datetime(year, month, day, hour, minute, second, microsecond, None)
    except ValueError as e:
        raise ValueError(e.message)


def _from_timestamp_microseconds_with_tz(value: int, tz: timezone | None) -> Result[datetime, ValueError]:
    whole_seconds: int = value // 1000000
    microsecond: int = value % 1000000
    try:
        result: datetime = _from_timestamp_with_tz(float(whole_seconds), tz)
        return datetime(result.year, result.month, result.day, result.hour, result.minute, result.second, microsecond, result._tz_offset)
    except ValueError as e:
        raise ValueError(e.message)


def now(tz: timezone | None = None) -> datetime:
    current_epoch: float = time_now()
    try:
        current: datetime = _from_timestamp_with_tz(current_epoch, tz)
        return current
    except ValueError:
        parts: list[int] = datetime_now_struct()
        yr: int = 0
        mo: int = 1
        dy: int = 1
        hr: int = 0
        mn: int = 0
        sc: int = 0
        for i, v in enumerate(parts):
            if i == 0:
                yr = v
            if i == 1:
                mo = v
            if i == 2:
                dy = v
            if i == 3:
                hr = v
            if i == 4:
                mn = v
            if i == 5:
                sc = v
        if tz is not None:
            try:
                parsed_offset: int = _timezone_offset_from_text(str(tz))
                return datetime(yr, mo, dy, hr, mn, sc, 0, parsed_offset)
            except ValueError:
                return datetime(yr, mo, dy, hr, mn, sc, 0, None)
        return datetime(yr, mo, dy, hr, mn, sc, 0, None)


def today() -> date:
    current: datetime = now()
    return date(current.year, current.month, current.day)


def format_datetime(dt: str, fmt: str) -> str:
    return datetime_format(dt, fmt)


def from_timestamp(ts: float, tz: timezone | None = None) -> Result[datetime, ValueError]:
    return _from_timestamp_with_tz(ts, tz)
