# sifr.signal - Structured signal identifiers and shutdown surfaces
from _sifr.signal import SignalError, signal_ctrl_c, signal_shutdown, signal_terminate


class Signal:
    name: str
    number: int

    def __init__(self, name: str, number: int):
        self.name = name
        self.number = number

    def __str__(self) -> str:
        return self.name


def sigint() -> Signal:
    return Signal("SIGINT", 2)


def sigterm() -> Signal:
    return Signal("SIGTERM", 15)


def strsignal(signal: Signal) -> str:
    return str(signal)


SIGINT: Signal = Signal("SIGINT", 2)
SIGTERM: Signal = Signal("SIGTERM", 15)


def _signal_from_number(number: int) -> Signal:
    if number == 2:
        return SIGINT
    if number == 15:
        return SIGTERM
    return Signal("UNKNOWN", number)


async def ctrl_c() -> Result[Signal, SignalError]:
    try:
        number: int = await signal_ctrl_c()
        return _signal_from_number(number)
    except SignalError as e:
        raise e


async def terminate() -> Result[Signal, SignalError]:
    try:
        number: int = await signal_terminate()
        return _signal_from_number(number)
    except SignalError as e:
        raise e


class ShutdownStream:
    async def next(self) -> Result[Signal, SignalError]:
        try:
            number: int = await signal_shutdown()
            return _signal_from_number(number)
        except SignalError as e:
            raise e


def shutdown_stream() -> ShutdownStream:
    return ShutdownStream()
