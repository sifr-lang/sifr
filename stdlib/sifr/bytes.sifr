# sifr.bytes — Binary data operations
# decode_utf8 returns Result[str, ParseError]
# bytes_to_hex returns Result[str, ParseError]
# bytes_from_hex returns Result[bytes, ParseError]
from _sifr.bytes import encode_utf8 as _encode_utf8_impl
from _sifr.bytes import bytes_to_hex as _bytes_to_hex_impl


def encode_utf8(s: str) -> bytes:
    return _encode_utf8_impl(s)


def decode_utf8(data: bytes) -> Result[str, ParseError]:
    return data.decode()


def bytes_to_hex(data: bytes) -> Result[str, ParseError]:
    return _bytes_to_hex_impl(data)


def bytes_from_hex(s: str) -> Result[bytes, ParseError]:
    return bytes.from_hex(s)


def bytes_from_ints(values: list[int]) -> Result[bytes, ValueError]:
    return bytes.from_ints(values)


def bytes_with_size(size: int) -> Result[bytes, ValueError]:
    return bytes(size)


def encode_utf8_result(s: str) -> Result[bytes, ParseError]:
    return s.encode()


def count_byte(data: bytes, value: int) -> int:
    count: int = 0
    for b in data:
        if int(b) == value:
            count = count + 1
    return count


def find_byte(data: bytes, value: int) -> int | None:
    idx: int = 0
    for b in data:
        if int(b) == value:
            return idx
        idx = idx + 1
    return None


def starts_with(data: bytes, prefix: bytes) -> bool:
    if len(prefix) > len(data):
        return False
    i: int = 0
    while i < len(prefix):
        a: uint8 | None = data[i]
        b: uint8 | None = prefix[i]
        if a is None:
            return False
        if b is None:
            return False
        if a != b:
            return False
        i = i + 1
    return True


def ends_with(data: bytes, suffix: bytes) -> bool:
    if len(suffix) > len(data):
        return False
    offset: int = len(data) - len(suffix)
    i: int = 0
    while i < len(suffix):
        a: uint8 | None = data[offset + i]
        b: uint8 | None = suffix[i]
        if a is None:
            return False
        if b is None:
            return False
        if a != b:
            return False
        i = i + 1
    return True
