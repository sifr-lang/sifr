# sifr.platform — Platform information
from _sifr.platform import platform_system as _system_impl, platform_arch as _machine_impl, platform_node as _node_impl, platform_release as _release_impl, platform_version as _version_impl, platform_processor as _processor_impl

def system() -> str:
    return _system_impl()

def machine() -> str:
    return _machine_impl()

def node() -> str:
    return _node_impl()

def release() -> str:
    return _release_impl()

def version() -> str:
    return _version_impl()

def processor() -> str:
    return _processor_impl()
