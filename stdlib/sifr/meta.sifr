# sifr.meta — package-neutral deterministic specialization contracts


class Structural:
    pass


class StaticProgram:
    pass


class MethodSlots:
    pass


class Context:
    pass


class NoContext:
    pass


class ConstIssueTemplate:
    package: str
    reason_code: str
    argument_names: list[str]


class SourceOrigin:
    pass


class CallableIdentity:
    pass


class StaticValue:
    pass


class CallArgumentDeclaration:
    name: str | None
    origin: SourceOrigin


class ClassDecoratorDeclaration:
    name: str
    origin: SourceOrigin
    argument_origins: list[SourceOrigin]
    arguments: list[CallArgumentDeclaration]


class ClassParameterDeclaration:
    name: str
    origin: SourceOrigin
    annotation_origin: SourceOrigin | None


class ClassDeclarationItem:
    order: int
    kind: str
    name: str
    identity: str
    origin: SourceOrigin
    annotation_origin: SourceOrigin | None
    value_origin: SourceOrigin | None
    return_origin: SourceOrigin | None
    declared_type: str | None
    default_kind: str
    default_value: StaticValue | None
    signature: str | None
    value_argument_origins: list[SourceOrigin]
    value_arguments: list[CallArgumentDeclaration]
    decorators: list[ClassDecoratorDeclaration]
    parameters: list[ClassParameterDeclaration]


class ClassDeclaration:
    identity: str
    name: str
    origin: SourceOrigin
    decorators: list[ClassDecoratorDeclaration]
    items: list[ClassDeclarationItem]


class DescriptorUse[D]:
    target_kind: str
    target_identity: str
    target_callable: CallableIdentity | None
    value: D
    origin: SourceOrigin


class DeclarationInput[D]:
    declaration: ClassDeclaration
    descriptors: list[DescriptorUse[D]]
    provider_module: str
    provider_function: str
    data_parent: str | None


class PlannedField:
    identity: str
    declared_type: str
    default_kind: str = "required"
    default_value: StaticValue | None = None
    default_factory: CallableIdentity | None = None
    validation_policy: str | None = None


class PlannedMetadata[D]:
    target_kind: str
    target_identity: str
    key: str
    value: D


class PlannedHandler[D]:
    target: CallableIdentity
    descriptor: D
    origin: SourceOrigin


class PlannedIssueLabel:
    origin: SourceOrigin
    message: str


class PlannedIssue[D]:
    package: str
    reason_code: str
    severity: str
    arguments: D
    primary_origin: SourceOrigin
    labels: list[PlannedIssueLabel]
    notes: list[str]


class DeclarationPlan[D]:
    fields: list[PlannedField]
    metadata: list[PlannedMetadata[D]]
    specialization_module: str | None
    specialization_function: str | None
    issues: list[PlannedIssue[D]]
    handlers: list[PlannedHandler[D]] = []
    attached_api_module: str | None = None
    attached_api_symbol: str | None = None


class ShapeMetadata[D]:
    key: str
    value: D


class ShapeMethod[D]:
    target: CallableIdentity | None
    descriptor: D | None
    origin: SourceOrigin | None
    declaration_order: int | None


class ShapeRoot[D]:
    metadata: list[ShapeMetadata[D]]
    methods: list[ShapeMethod[D]]


class ShapeInput[D]:
    canonical_identity: str
    root: ShapeRoot[D]


class ConstIssueLabel:
    origin: SourceOrigin
    message: str


class ConstPackageIssue[A]:
    package: str
    reason_code: str
    severity: str
    arguments: A
    primary_origin: SourceOrigin
    labels: list[ConstIssueLabel]
    notes: list[str]


class ConstSpecializationOutcome[T, A]:
    status: str
    value: T | None
    issues: list[ConstPackageIssue[A]]


class JsonIntegerBoundaryDescriptor:
    path: str
    profile: str | None
    representation: str
    integer_kind: str
    static_minimum: int | None
    static_maximum: int | None
