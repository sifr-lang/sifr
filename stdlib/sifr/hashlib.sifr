# sifr.hashlib — Bytes-native hashing functions and hash object model
from _sifr.crypto import sha256_bytes as _sha256_bytes_impl
from _sifr.crypto import md5_bytes as _md5_bytes_impl
from _sifr.crypto import sha1_bytes as _sha1_bytes_impl
from _sifr.crypto import sha512_bytes as _sha512_bytes_impl
from _sifr.crypto import sha224_bytes as _sha224_bytes_impl
from _sifr.crypto import sha384_bytes as _sha384_bytes_impl
from _sifr.crypto import blake2b_bytes as _blake2b_bytes_impl
from _sifr.crypto import blake2s_bytes as _blake2s_bytes_impl
from _sifr.fs import NativeFileHandle as _NativeFileHandle
from _sifr.fs import open_file as _open_file_impl
from _sifr.fs import file_read_bytes as _file_read_bytes_impl
from _sifr.fs import file_close as _file_close_impl


class HashlibError(Error):
    message: str


class HashObject:
    _algorithm: str
    _data: bytes
    name: str
    digest_size: int
    block_size: int

    def __init__(self, algorithm: str, data: bytes, name: str, digest_size: int, block_size: int) -> None:
        self._algorithm = algorithm
        self._data = data
        self.name = name
        self.digest_size = digest_size
        self.block_size = block_size

    def update(mut self, data: bytes) -> None:
        self._data = self._data + data

    def hexdigest(self) -> str:
        return _hash_hex(self._algorithm, self._data)

    def digest(self) -> bytes:
        return _hash_bytes(self._algorithm, self._data)

def _build_hash(algorithm: str, data: bytes) -> HashObject:
    alg: str = algorithm.lower()
    if alg == "md5":
        return HashObject(alg, data, "md5", 16, 64)
    elif alg == "sha1":
        return HashObject(alg, data, "sha1", 20, 64)
    elif alg == "sha224":
        return HashObject(alg, data, "sha224", 28, 64)
    elif alg == "sha256":
        return HashObject(alg, data, "sha256", 32, 64)
    elif alg == "sha384":
        return HashObject(alg, data, "sha384", 48, 128)
    elif alg == "sha512":
        return HashObject(alg, data, "sha512", 64, 128)
    elif alg == "blake2b":
        return HashObject(alg, data, "blake2b", 64, 128)
    elif alg == "blake2s":
        return HashObject(alg, data, "blake2s", 32, 64)
    # Unsupported algorithms are represented as zero-sized placeholders.
    return HashObject(alg, data, "unknown", 0, 0)


def copy_hash(h: HashObject) -> HashObject:
    return _build_hash(h._algorithm, h._data)


def _is_supported_algorithm(name: str) -> bool:
    n: str = name.lower()
    return (
        n == "md5" or
        n == "sha1" or
        n == "sha224" or
        n == "sha256" or
        n == "sha384" or
        n == "sha512" or
        n == "blake2b" or
        n == "blake2s"
    )


def _hash_bytes(algorithm: str, data: bytes) -> bytes:
    if algorithm == "md5":
        return _md5_bytes_impl(data)
    elif algorithm == "sha1":
        return _sha1_bytes_impl(data)
    elif algorithm == "sha224":
        return _sha224_bytes_impl(data)
    elif algorithm == "sha256":
        return _sha256_bytes_impl(data)
    elif algorithm == "sha384":
        return _sha384_bytes_impl(data)
    elif algorithm == "sha512":
        return _sha512_bytes_impl(data)
    elif algorithm == "blake2b":
        return _blake2b_bytes_impl(data)
    elif algorithm == "blake2s":
        return _blake2s_bytes_impl(data)
    return b""


def _hash_hex(algorithm: str, data: bytes) -> str:
    return _hash_bytes(algorithm, data).hex()


# CPython-like constructor helper with a bytes-only data boundary.
def new(name: str, data: bytes = b"") -> Result[HashObject, ValueError]:
    if not _is_supported_algorithm(name):
        raise ValueError("unsupported hash algorithm: " + name)
    return _build_hash(name, data)


def algorithms_guaranteed() -> list[str]:
    return ["md5", "sha1", "sha224", "sha256", "sha384", "sha512", "blake2b", "blake2s"]


def algorithms_available() -> list[str]:
    # Current runtime exposes the same guaranteed set.
    return algorithms_guaranteed()


def file_digest(path: str, name: str) -> Result[str, HashlibError]:
    try:
        handle: _NativeFileHandle = _open_file_impl(path, "rb")
    except IOError as e:
        raise HashlibError(e.message)
    try:
        data: bytes = _file_read_bytes_impl(handle)
    except IOError as e:
        _file_close_impl(handle)
        raise HashlibError(e.message)
    _file_close_impl(handle)
    try:
        h: HashObject = new(name, data)
        return h.hexdigest()
    except ValueError as e:
        raise HashlibError(e.message)


# SHA3/SHAKE constructor placeholders for dependency-audit gating.
def sha3_256_obj(data: bytes = b"") -> Result[HashObject, ValueError]:
    raise ValueError("sha3_256 is not yet supported")


def sha3_512_obj(data: bytes = b"") -> Result[HashObject, ValueError]:
    raise ValueError("sha3_512 is not yet supported")


def shake_128_obj(data: bytes = b"") -> Result[HashObject, ValueError]:
    raise ValueError("shake_128 is not yet supported")


def shake_256_obj(data: bytes = b"") -> Result[HashObject, ValueError]:
    raise ValueError("shake_256 is not yet supported")


def md5(data: bytes = b"") -> HashObject:
    return _build_hash("md5", data)


def sha1(data: bytes = b"") -> HashObject:
    return _build_hash("sha1", data)


def sha224(data: bytes = b"") -> HashObject:
    return _build_hash("sha224", data)


def sha256(data: bytes = b"") -> HashObject:
    return _build_hash("sha256", data)


def sha384(data: bytes = b"") -> HashObject:
    return _build_hash("sha384", data)


def sha512(data: bytes = b"") -> HashObject:
    return _build_hash("sha512", data)


def blake2b(data: bytes = b"") -> HashObject:
    return _build_hash("blake2b", data)


def blake2s(data: bytes = b"") -> HashObject:
    return _build_hash("blake2s", data)
