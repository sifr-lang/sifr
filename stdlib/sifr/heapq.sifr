# sifr.heapq — Heap queue algorithm (pure Sifr, generic)
# Implements a min-heap.
#
# In-place API (borrow-by-default with `mut`):
#   heapify(mut data)   -- convert list to a min-heap in-place
#   heappush(mut heap, item) -- push item onto heap in-place
#   heappop(mut heap) -> item | None -- pop smallest item, heapify in-place
#   heapreplace(mut heap, item) -> item | None -- replace smallest item in-place
#   heappushpop(mut heap, item) -> item | None -- push then pop in-place
T = TypeVar("T")

# ── Internal helpers ──────────────────────────────────────────────────────────

def _sift_down[T: Comparable](mut data: list[T], mut pos: int, n: int) -> None:
    done: bool = False
    while not done:
        smallest: int = pos.clone()
        left: int = 2 * pos + 1
        right: int = 2 * pos + 2
        if left < n:
            s_val: T | None = data[smallest]
            l_val: T | None = data[left]
            if s_val is not None:
                if l_val is not None:
                    if l_val < s_val:
                        smallest = left
        if right < n:
            s_val2: T | None = data[smallest]
            r_val: T | None = data[right]
            if s_val2 is not None:
                if r_val is not None:
                    if r_val < s_val2:
                        smallest = right
        if smallest == pos:
            done = True
        else:
            tmp_pos: T | None = data[pos]
            tmp_sm: T | None = data[smallest]
            if tmp_pos is not None:
                if tmp_sm is not None:
                    data[pos] = tmp_sm
                    data[smallest] = tmp_pos
            pos = smallest

def _sift_up[T: Comparable](mut heap: list[T], mut pos: int) -> None:
    done: bool = False
    while not done:
        if pos <= 0:
            done = True
        else:
            parent: int = (pos - 1) // 2
            p_val: T | None = heap[parent]
            c_val: T | None = heap[pos]
            if p_val is not None:
                if c_val is not None:
                    if c_val < p_val:
                        heap[parent] = c_val
                        heap[pos] = p_val
                        pos = parent
                    else:
                        done = True
                else:
                    done = True
            else:
                done = True

def _sift_down_max[T: Comparable](mut data: list[T], mut pos: int, n: int) -> None:
    done: bool = False
    while not done:
        largest: int = pos.clone()
        left: int = 2 * pos + 1
        right: int = 2 * pos + 2
        if left < n:
            current_val: T | None = data[largest]
            left_val: T | None = data[left]
            if current_val is not None:
                if left_val is not None:
                    if left_val > current_val:
                        largest = left
        if right < n:
            current_val2: T | None = data[largest]
            right_val: T | None = data[right]
            if current_val2 is not None:
                if right_val is not None:
                    if right_val > current_val2:
                        largest = right
        if largest == pos:
            done = True
        else:
            tmp_pos: T | None = data[pos]
            tmp_largest: T | None = data[largest]
            if tmp_pos is not None:
                if tmp_largest is not None:
                    data[pos] = tmp_largest
                    data[largest] = tmp_pos
            pos = largest

def _sift_up_max[T: Comparable](mut heap: list[T], mut pos: int) -> None:
    done: bool = False
    while not done:
        if pos <= 0:
            done = True
        else:
            parent: int = (pos - 1) // 2
            parent_val: T | None = heap[parent]
            child_val: T | None = heap[pos]
            if parent_val is not None:
                if child_val is not None:
                    if child_val > parent_val:
                        heap[parent] = child_val
                        heap[pos] = parent_val
                        pos = parent
                    else:
                        done = True
                else:
                    done = True
            else:
                done = True

# ── In-place API (mut parameters) ────────────────────────────────────────────

def heapify[T: Comparable](mut data: list[T]) -> None:
    """Convert list to a min-heap in-place. O(n) time."""
    n: int = len(data)
    i: int = n // 2 - 1
    while i >= 0:
        _sift_down(data, i, n)
        i = i - 1

def heappush[T: Comparable](mut heap: list[T], item: T) -> None:
    """Push item onto the heap in-place. O(log n) time."""
    heap.append(item)
    pos: int = len(heap) - 1
    _sift_up(heap, pos)

def heappop[T: Comparable](mut heap: list[T]) -> T | None:
    """Pop and return the smallest item. Heap is modified in-place. O(log n) time.
    Returns None if the heap is empty."""
    n: int = len(heap)
    if n == 0:
        return None
    top: T | None = heap[0]
    last: T | None = heap[n - 1]
    heap.pop()
    n2: int = len(heap)
    if n2 > 0:
        if last is not None:
            heap[0] = last
        _sift_down(heap, 0, n2)
    return top

def _heapify_max[T: Comparable](mut data: list[T]) -> None:
    """Convert list to a max-heap in-place. O(n) time."""
    n: int = len(data)
    i: int = n // 2 - 1
    while i >= 0:
        _sift_down_max(data, i, n)
        i = i - 1

def _heappop_max[T: Comparable](mut heap: list[T]) -> T | None:
    """Pop and return the largest item. Heap is modified in-place. O(log n) time.
    Returns None if the heap is empty."""
    n: int = len(heap)
    if n == 0:
        return None
    top: T | None = heap[0]
    last: T | None = heap[n - 1]
    heap.pop()
    n2: int = len(heap)
    if n2 > 0:
        if last is not None:
            heap[0] = last
        _sift_down_max(heap, 0, n2)
    return top

def _heappush_max[T: Comparable](mut heap: list[T], item: T) -> None:
    heap.append(item)
    pos: int = len(heap) - 1
    _sift_up_max(heap, pos)

def _heapreplace_max[T: Comparable](mut heap: list[T], own item: T) -> T | None:
    """Pop and return the largest item, then push item onto the heap.
    Returns None if the heap is empty. O(log n) time."""
    if len(heap) == 0:
        return None
    top: T | None = heap[0]
    heap[0] = item
    heap_len: int = len(heap)
    _sift_down_max(heap, 0, heap_len)
    return top

def _heappushpop_max[T: Comparable](mut heap: list[T], item: T) -> T | None:
    _heappush_max(heap, item)
    return _heappop_max(heap)

def heapreplace[T: Comparable](mut heap: list[T], own item: T) -> T | None:
    if len(heap) == 0:
        return None
    top: T | None = heap[0]
    heap[0] = item
    heap_len: int = len(heap)
    _sift_down(heap, 0, heap_len)
    return top

def heappushpop[T: Comparable](mut heap: list[T], item: T) -> T | None:
    # Push item then pop smallest. Semantics match CPython's mutating helper.
    heappush(heap, item)
    return heappop(heap)

def merge[T: Comparable](*iterables: list[T]) -> list[T]:
    result: list[T] = []
    positions: list[int] = []
    for _values in iterables:
        positions.append(0)
    done: bool = False
    while not done:
        best_index: int = -1
        i: int = 0
        while i < len(iterables):
            values: list[T] | None = iterables[i]
            if values is not None:
                pos: int | None = positions[i]
                if pos is not None:
                    if pos < len(values):
                        if best_index < 0:
                            best_index = i.clone()
                        else:
                            best_values: list[T] | None = iterables[best_index]
                            if best_values is not None:
                                best_pos: int | None = positions[best_index]
                                if best_pos is not None:
                                    if best_pos < len(best_values):
                                        current: T | None = values[pos]
                                        chosen: T | None = best_values[best_pos]
                                        if current is not None and chosen is not None:
                                            if current < chosen:
                                                best_index = i.clone()
            i = i + 1
        if best_index < 0:
            done = True
        else:
            selected_values: list[T] | None = iterables[best_index]
            if selected_values is not None:
                selected_pos: int | None = positions[best_index]
                if selected_pos is not None:
                    if selected_pos < len(selected_values):
                        selected_value: T | None = selected_values[selected_pos]
                        if selected_value is not None:
                            result.append(selected_value)
                        positions[best_index] = selected_pos + 1
    return result

def nsmallest[T: Comparable](n: int, data: list[T]) -> list[T]:
    heap: list[T] = data.copy()
    heapify(heap)
    result: list[T] = []
    count: int = 0
    while count < n:
        if len(heap) == 0:
            return result
        val: T | None = heappop(heap)
        if val is not None:
            result.append(val)
        count = count + 1
    return result

def nlargest[T: Comparable](n: int, data: list[T]) -> list[T]:
    # Uses a selection approach: find n largest by repeated scanning.
    if n <= 0:
        return []
    if n >= len(data):
        result: list[T] = []
        for val in data:
            result.append(val)
        return result
    # Collect all into a heap, then pop all and take last n
    heap: list[T] = data.copy()
    heapify(heap)
    all_sorted: list[T] = []
    while len(heap) > 0:
        val2: T | None = heappop(heap)
        if val2 is not None:
            all_sorted.append(val2)
    # Take last n elements (largest) in descending order
    result2: list[T] = []
    i: int = len(all_sorted) - 1
    count: int = 0
    while count < n:
        if i < 0:
            return result2
        v: T | None = all_sorted[i]
        if v is not None:
            result2.append(v)
        i = i - 1
        count = count + 1
    return result2
