# sifr.sys — System-specific parameters and functions
from _sifr.sys import get_args, sys_exit, sys_version, sys_platform, sys_maxsize

# CPython-compatible aliases

def argv() -> list[str]:
    return get_args()

def exit(code: int) -> None:
    sys_exit(code)

def version() -> str:
    return sys_version()

def platform() -> str:
    return sys_platform()

def maxsize() -> int:
    return sys_maxsize()
