# sifr.sys — System-specific parameters and functions
from _sifr.sys import get_args as _argv_impl, sys_exit as _exit_impl, sys_version as _version_impl, sys_platform as _platform_impl, sys_maxsize as _maxsize_impl

def argv() -> list[str]:
    return _argv_impl()

def exit(code: int) -> None:
    _exit_impl(code)

def version() -> str:
    return _version_impl()

def platform() -> str:
    return _platform_impl()

def maxsize() -> int:
    return _maxsize_impl()
