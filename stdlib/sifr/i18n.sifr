# sifr.i18n — explicit locale identifiers and ICU-backed formatting
from _sifr.i18n import (
    _i18n_collate_impl,
    _i18n_format_datetime_impl,
    _i18n_format_number_impl,
    _i18n_host_locale_impl,
    _i18n_locale_canonicalize_impl,
    _i18n_locale_maximize_impl,
    _i18n_locale_minimize_impl,
    _i18n_mo_load_file_impl,
    _i18n_mo_lookup_context_impl,
    _i18n_mo_lookup_context_plural_impl,
    _i18n_mo_lookup_impl,
    _i18n_mo_lookup_plural_impl,
    _i18n_mo_validate_impl,
    _i18n_plural_category_impl,
)

DATETIME_SHORT: str = "short"
DATETIME_MEDIUM: str = "medium"
DATETIME_LONG: str = "long"

PLURAL_CARDINAL: str = "cardinal"
PLURAL_ORDINAL: str = "ordinal"

COLLATION_DEFAULT: str = "default"
COLLATION_PRIMARY: str = "primary"
COLLATION_SECONDARY: str = "secondary"
COLLATION_TERTIARY: str = "tertiary"


class LocaleIdError(Error):
    message: str


class FormatError(Error):
    message: str


class PluralRulesError(Error):
    message: str


class CatalogError(Error):
    message: str


class TranslationError(Error):
    message: str


def i18n_locale_canonicalize(locale: str) -> Result[str, LocaleIdError]:
    try:
        value: str = _i18n_locale_canonicalize_impl(locale)
        return value
    except ParseError as e:
        raise LocaleIdError(e.message)


def i18n_locale_maximize(locale: str) -> Result[str, LocaleIdError]:
    try:
        value: str = _i18n_locale_maximize_impl(locale)
        return value
    except ParseError as e:
        raise LocaleIdError(e.message)


def i18n_locale_minimize(locale: str) -> Result[str, LocaleIdError]:
    try:
        value: str = _i18n_locale_minimize_impl(locale)
        return value
    except ParseError as e:
        raise LocaleIdError(e.message)


def i18n_host_locale() -> str | None:
    return _i18n_host_locale_impl()


def i18n_format_number(locale: str, value: str) -> Result[str, FormatError]:
    try:
        formatted: str = _i18n_format_number_impl(locale, value)
        return formatted
    except ParseError as e:
        raise FormatError(e.message)


def i18n_format_datetime(
    locale: str,
    style: str,
    year: int,
    month: int,
    day: int,
    hour: int,
    minute: int,
    second: int,
) -> Result[str, FormatError]:
    try:
        formatted: str = _i18n_format_datetime_impl(
            locale,
            style,
            year,
            month,
            day,
            hour,
            minute,
            second,
        )
        return formatted
    except ParseError as e:
        raise FormatError(e.message)


def i18n_plural_category(locale: str, rule_type: str, value: str) -> Result[str, PluralRulesError]:
    try:
        category: str = _i18n_plural_category_impl(locale, rule_type, value)
        return category
    except ParseError as e:
        raise PluralRulesError(e.message)


def i18n_collate(locale: str, strength: str, left: str, right: str) -> Result[int, FormatError]:
    try:
        value: int = _i18n_collate_impl(locale, strength, left, right)
        return value
    except ParseError as e:
        raise FormatError(e.message)


def i18n_mo_validate(catalog: bytes) -> Result[str, CatalogError]:
    try:
        value: str = _i18n_mo_validate_impl(catalog)
        return value
    except ParseError as e:
        raise CatalogError(e.message)


def i18n_mo_load_file(path: str) -> Result[bytes, CatalogError]:
    try:
        catalog: bytes = _i18n_mo_load_file_impl(path)
        return catalog
    except ParseError as e:
        raise CatalogError(e.message)


def i18n_mo_lookup(catalog: bytes, message_id: str) -> Result[str | None, CatalogError]:
    try:
        value: str | None = _i18n_mo_lookup_impl(catalog, message_id)
        return value
    except ParseError as e:
        raise CatalogError(e.message)


def i18n_mo_lookup_context(
    catalog: bytes, context: str, message_id: str
) -> Result[str | None, CatalogError]:
    try:
        value: str | None = _i18n_mo_lookup_context_impl(catalog, context, message_id)
        return value
    except ParseError as e:
        raise CatalogError(e.message)


def i18n_mo_lookup_plural(
    catalog: bytes, singular: str, plural: str, count: int
) -> Result[str | None, CatalogError]:
    try:
        value: str | None = _i18n_mo_lookup_plural_impl(catalog, singular, plural, count)
        return value
    except ParseError as e:
        raise CatalogError(e.message)


def i18n_mo_lookup_context_plural(
    catalog: bytes, context: str, singular: str, plural: str, count: int
) -> Result[str | None, CatalogError]:
    try:
        value: str | None = _i18n_mo_lookup_context_plural_impl(catalog, context, singular, plural, count)
        return value
    except ParseError as e:
        raise CatalogError(e.message)


class LocaleId:
    value: str

    def __init__(self, value: str) -> None:
        self.value = value + ""

    def to_string(self) -> str:
        return self.value + ""

    def canonical(self) -> Result[LocaleId, LocaleIdError]:
        try:
            canonical: str = i18n_locale_canonicalize(self.value)
            return LocaleId(canonical)
        except LocaleIdError as e:
            raise LocaleIdError(e.message)

    def maximize(self) -> Result[LocaleId, LocaleIdError]:
        try:
            expanded: str = i18n_locale_maximize(self.value)
            return LocaleId(expanded)
        except LocaleIdError as e:
            raise LocaleIdError(e.message)

    def minimize(self) -> Result[LocaleId, LocaleIdError]:
        try:
            minimized: str = i18n_locale_minimize(self.value)
            return LocaleId(minimized)
        except LocaleIdError as e:
            raise LocaleIdError(e.message)


class NumberFormatter:
    locale: LocaleId

    def __init__(self, locale: LocaleId) -> None:
        self.locale = locale

    def format(self, value: str) -> Result[str, FormatError]:
        return i18n_format_number(self.locale.to_string(), value)


class DateTimeFormatter:
    locale: LocaleId
    style: str

    def __init__(self, locale: LocaleId, style: str = "medium") -> None:
        self.locale = locale
        self.style = style + ""

    def format_parts(self, year: int, month: int, day: int, hour: int, minute: int, second: int) -> Result[str, FormatError]:
        return i18n_format_datetime(
            self.locale.to_string(),
            self.style,
            year,
            month,
            day,
            hour,
            minute,
            second,
        )


class PluralRules:
    locale: LocaleId
    rule_type: str

    def __init__(self, locale: LocaleId, rule_type: str = "cardinal") -> None:
        self.locale = locale
        self.rule_type = rule_type + ""

    def category(self, value: str) -> Result[str, PluralRulesError]:
        return i18n_plural_category(self.locale.to_string(), self.rule_type, value)


class Collator:
    locale: LocaleId
    strength: str

    def __init__(self, locale: LocaleId, strength: str = "default") -> None:
        self.locale = locale
        self.strength = strength + ""

    def compare(self, left: str, right: str) -> Result[int, FormatError]:
        return i18n_collate(self.locale.to_string(), self.strength, left, right)


class Message:
    message_id: str
    context: str
    has_context: bool
    plural_id: str
    has_plural: bool
    count: int

    def __init__(
        self,
        message_id: str,
        context: str = "",
        has_context: bool = False,
        plural_id: str = "",
        has_plural: bool = False,
        count: int = 1,
    ) -> None:
        self.message_id = message_id + ""
        self.context = context + ""
        self.has_context = has_context
        self.plural_id = plural_id + ""
        self.has_plural = has_plural
        self.count = count


class Bundle:
    _catalog: bytes

    def __init__(self, catalog: bytes) -> None:
        self._catalog = catalog

    def lookup(self, message_id: str) -> Result[str | None, CatalogError]:
        return i18n_mo_lookup(self._catalog, message_id)

    def lookup_context(self, context: str, message_id: str) -> Result[str | None, CatalogError]:
        return i18n_mo_lookup_context(self._catalog, context, message_id)

    def lookup_plural(self, singular: str, plural: str, count: int) -> Result[str | None, CatalogError]:
        return i18n_mo_lookup_plural(self._catalog, singular, plural, count)

    def lookup_context_plural(
        self, context: str, singular: str, plural: str, count: int
    ) -> Result[str | None, CatalogError]:
        return i18n_mo_lookup_context_plural(self._catalog, context, singular, plural, count)


class Translator:
    _primary: Bundle
    _fallbacks: list[Bundle]

    def __init__(self, bundle: Bundle) -> None:
        self._primary = bundle
        self._fallbacks = []

    def with_fallback(self, bundle: Bundle) -> Translator:
        next_translator: Translator = Translator(self._primary)
        for existing in self._fallbacks:
            next_translator._fallbacks.append(existing)
        next_translator._fallbacks.append(bundle)
        return next_translator

    def translate(self, message_id: str) -> Result[str, TranslationError]:
        try:
            primary_found: str | None = self._primary.lookup(message_id)
            if primary_found is not None:
                return primary_found
        except CatalogError as e:
            raise TranslationError(e.message)
        for bundle in self._fallbacks:
            try:
                found: str | None = bundle.lookup(message_id)
                if found is not None:
                    return found
            except CatalogError as e:
                raise TranslationError(e.message)
        return message_id + ""

    def translate_context(self, context: str, message_id: str) -> Result[str, TranslationError]:
        try:
            primary_found: str | None = self._primary.lookup_context(context, message_id)
            if primary_found is not None:
                return primary_found
        except CatalogError as e:
            raise TranslationError(e.message)
        for bundle in self._fallbacks:
            try:
                found: str | None = bundle.lookup_context(context, message_id)
                if found is not None:
                    return found
            except CatalogError as e:
                raise TranslationError(e.message)
        return message_id + ""

    def translate_plural(self, singular: str, plural: str, count: int) -> Result[str, TranslationError]:
        try:
            primary_found: str | None = self._primary.lookup_plural(singular, plural, count)
            if primary_found is not None:
                return primary_found
        except CatalogError as e:
            raise TranslationError(e.message)
        for bundle in self._fallbacks:
            try:
                found: str | None = bundle.lookup_plural(singular, plural, count)
                if found is not None:
                    return found
            except CatalogError as e:
                raise TranslationError(e.message)
        if count == 1:
            return singular + ""
        return plural + ""

    def translate_context_plural(
        self, context: str, singular: str, plural: str, count: int
    ) -> Result[str, TranslationError]:
        try:
            primary_found: str | None = self._primary.lookup_context_plural(context, singular, plural, count)
            if primary_found is not None:
                return primary_found
        except CatalogError as e:
            raise TranslationError(e.message)
        for bundle in self._fallbacks:
            try:
                found: str | None = bundle.lookup_context_plural(context, singular, plural, count)
                if found is not None:
                    return found
            except CatalogError as e:
                raise TranslationError(e.message)
        if count == 1:
            return singular + ""
        return plural + ""

    def translate_message(self, message: Message) -> Result[str, TranslationError]:
        if message.has_context and message.has_plural:
            return self.translate_context_plural(
                message.context,
                message.message_id,
                message.plural_id,
                message.count,
            )
        if message.has_context:
            return self.translate_context(message.context, message.message_id)
        if message.has_plural:
            return self.translate_plural(message.message_id, message.plural_id, message.count)
        return self.translate(message.message_id)

def parse_locale(value: str) -> Result[LocaleId, LocaleIdError]:
    try:
        canonical: str = i18n_locale_canonicalize(value)
        return LocaleId(canonical)
    except LocaleIdError as e:
        raise LocaleIdError(e.message)


def canonicalize_locale(value: str) -> Result[str, LocaleIdError]:
    return i18n_locale_canonicalize(value)


def maximize_locale(value: str) -> Result[str, LocaleIdError]:
    return i18n_locale_maximize(value)


def minimize_locale(value: str) -> Result[str, LocaleIdError]:
    return i18n_locale_minimize(value)


def host_locale() -> LocaleId | None:
    raw: str | None = i18n_host_locale()
    if raw is not None:
        return LocaleId(raw)
    return None


def number_formatter(locale: LocaleId) -> NumberFormatter:
    return NumberFormatter(locale)


def datetime_formatter(locale: LocaleId, style: str = "medium") -> DateTimeFormatter:
    return DateTimeFormatter(locale, style)


def plural_rules(locale: LocaleId, rule_type: str = "cardinal") -> PluralRules:
    return PluralRules(locale, rule_type)


def collator(locale: LocaleId, strength: str = "default") -> Collator:
    return Collator(locale, strength)


def message(message_id: str) -> Message:
    return Message(message_id)


def context_message(context: str, message_id: str) -> Message:
    return Message(message_id, context, True)


def plural_message(singular: str, plural: str, count: int) -> Message:
    return Message(singular, "", False, plural, True, count)


def context_plural_message(context: str, singular: str, plural: str, count: int) -> Message:
    return Message(singular, context, True, plural, True, count)


def bundle_from_mo_bytes(catalog: bytes) -> Result[Bundle, CatalogError]:
    try:
        _validated: str = i18n_mo_validate(catalog)
        return Bundle(catalog)
    except CatalogError as e:
        raise CatalogError(e.message)


def load_mo_file(path: str) -> Result[Bundle, CatalogError]:
    try:
        catalog: bytes = i18n_mo_load_file(path)
        return Bundle(catalog)
    except CatalogError as e:
        raise CatalogError(e.message)


def translator(bundle: Bundle) -> Translator:
    return Translator(bundle)
