# sifr.io — File and stream I/O surfaces
# Provides open(), open_binary(), file handle classes, and in-memory stream wrappers.
from _sifr.fs import NativeFileHandle, open_file, file_read, file_write, file_readline, file_readlines, file_close, file_read_bytes, file_write_bytes
from _sifr.fs import read_text as _read_text_impl
from _sifr.fs import write_text as _write_text_impl
from _sifr.fs import exists as _exists_impl
from _sifr.fs import read_lines as _read_lines_impl
from _sifr.fs import append_text as _append_text_impl
from sifr.encoding import (
    Encoding,
    DecodeError,
    DecodeErrorHandler,
    EncodeError,
    EncodeErrorHandler,
    decode,
    encode,
    utf8,
    strict_decode_handler,
    strict_encode_handler,
)


def _closed_stream_error() -> str:
    return "I/O operation on closed stream"


def _invalid_whence_error(whence: int) -> str:
    return "invalid whence: " + str(whence)


def _negative_seek_error(offset: int) -> str:
    return "negative seek position: " + str(offset)


def _unsupported_seek_tell_error() -> str:
    return "seek/tell is unsupported for this stream"


def read_text(path: str) -> Result[str, IOError]:
    return _read_text_impl(path)


def write_text(path: str, content: str) -> Result[None, IOError]:
    return _write_text_impl(path, content)


def exists(path: str) -> bool:
    return _exists_impl(path)


def read_lines(path: str) -> Result[list[str], IOError]:
    return _read_lines_impl(path)


def append_text(path: str, content: str) -> Result[None, IOError]:
    return _append_text_impl(path, content)


def _mode_is_readable(mode: str) -> bool:
    return ("r" in mode) or ("+" in mode)


def _mode_is_writable(mode: str) -> bool:
    return ("w" in mode) or ("a" in mode) or ("+" in mode)


class IOBase:
    _closed: bool

    def __init__(self) -> None:
        self._closed = False

    def close(self) -> None:
        self._closed = True

    def closed(self) -> bool:
        return self._closed

    def flush(self) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        return None

    def seek(self, offset: int, whence: int = 0) -> Result[int, IOError]:
        _ = offset
        _ = whence
        raise IOError(_unsupported_seek_tell_error())

    def tell(self) -> Result[int, IOError]:
        raise IOError(_unsupported_seek_tell_error())

    def readable(self) -> bool:
        return False

    def writable(self) -> bool:
        return False

    def seekable(self) -> bool:
        return False


class TextIOBase(IOBase):
    pass


class BinaryIOBase(IOBase):
    pass


class FileHandle:
    _handle: NativeFileHandle
    _mode: str
    _closed: bool

    def __init__(self, handle: NativeFileHandle, mode: str) -> None:
        self._handle = handle
        self._mode = mode
        self._closed = False

    def close(self) -> None:
        if self._closed:
            return
        file_close(self._handle)
        self._closed = True

    def closed(self) -> bool:
        return self._closed

    def flush(self) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        return None

    def read(self) -> Result[str, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        if not self.readable():
            raise IOError("stream is not readable")
        return file_read(self._handle)

    def write(self, data: str) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        if not self.writable():
            raise IOError("stream is not writable")
        return file_write(self._handle, data)

    def readline(self) -> Result[str | None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        if not self.readable():
            raise IOError("stream is not readable")
        return file_readline(self._handle)

    def readlines(self) -> Result[list[str], IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        if not self.readable():
            raise IOError("stream is not readable")
        return file_readlines(self._handle)

    def read_bytes(self) -> Result[bytes, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        if not self.readable():
            raise IOError("stream is not readable")
        return file_read_bytes(self._handle)

    def write_bytes(self, data: bytes) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        if not self.writable():
            raise IOError("stream is not writable")
        return file_write_bytes(self._handle, data)

    def seek(self, offset: int, whence: int = 0) -> Result[int, IOError]:
        _ = offset
        _ = whence
        raise IOError(_unsupported_seek_tell_error())

    def tell(self) -> Result[int, IOError]:
        raise IOError(_unsupported_seek_tell_error())

    def readable(self) -> bool:
        return _mode_is_readable(self._mode)

    def writable(self) -> bool:
        return _mode_is_writable(self._mode)

    def seekable(self) -> bool:
        return False

    def __enter__(self) -> FileHandle:
        return self

    def __exit__(self) -> None:
        self.close()


class BinaryFileHandle:
    _handle: NativeFileHandle
    _mode: str
    _closed: bool

    def __init__(self, handle: NativeFileHandle, mode: str) -> None:
        self._handle = handle
        self._mode = mode
        self._closed = False

    def close(self) -> None:
        if self._closed:
            return
        file_close(self._handle)
        self._closed = True

    def closed(self) -> bool:
        return self._closed

    def flush(self) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        return None

    def read_bytes(self, size: int | None = None) -> Result[bytes, IOError]:
        _ = size
        if self._closed:
            raise IOError(_closed_stream_error())
        if not self.readable():
            raise IOError("stream is not readable")
        return file_read_bytes(self._handle)

    def write_bytes(self, data: bytes) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        if not self.writable():
            raise IOError("stream is not writable")
        return file_write_bytes(self._handle, data)

    def seek(self, offset: int, whence: int = 0) -> Result[int, IOError]:
        _ = offset
        _ = whence
        raise IOError(_unsupported_seek_tell_error())

    def tell(self) -> Result[int, IOError]:
        raise IOError(_unsupported_seek_tell_error())

    def readable(self) -> bool:
        return _mode_is_readable(self._mode)

    def writable(self) -> bool:
        return _mode_is_writable(self._mode)

    def seekable(self) -> bool:
        return False

    def __enter__(self) -> BinaryFileHandle:
        return self

    def __exit__(self) -> None:
        self.close()


def _text_binary_mode(mode: str) -> Result[str, IOError]:
    if "b" in mode:
        raise IOError("open_text requires a text mode without 'b'")
    if mode == "r" or mode == "rt":
        return "rb"
    if mode == "w" or mode == "wt":
        return "wb"
    if mode == "a" or mode == "at":
        return "ab"
    raise IOError("invalid text mode: " + mode)


def _text_encoding_or_default(enc: Encoding | None) -> Encoding:
    if enc is not None:
        return Encoding(enc.label + "")
    return Encoding("utf-8")


def _decode_errors_or_default(errors: DecodeErrorHandler | None) -> DecodeErrorHandler:
    if errors is not None:
        return DecodeErrorHandler(errors.name + "")
    return strict_decode_handler()


def _encode_errors_from_decode_errors(errors: DecodeErrorHandler) -> EncodeErrorHandler:
    return EncodeErrorHandler(errors.name + "")


class TextFileHandle:
    _binary: BinaryFileHandle
    _encoding: Encoding
    _decode_errors: DecodeErrorHandler
    _encode_errors: EncodeErrorHandler

    def __init__(self, binary: BinaryFileHandle, enc: Encoding, decode_errors: DecodeErrorHandler, encode_errors: EncodeErrorHandler) -> None:
        self._binary = binary
        self._encoding = enc
        self._decode_errors = decode_errors
        self._encode_errors = encode_errors

    def close(self) -> None:
        self._binary.close()

    def closed(self) -> bool:
        return self._binary.closed()

    def flush(self) -> Result[None, IOError]:
        return self._binary.flush()

    def read(self) -> Result[str, IOError]:
        try:
            data: bytes = self._binary.read_bytes()
            text: str = decode(data, self._encoding, self._decode_errors)
            return text
        except IOError as e:
            raise IOError(e.message)
        except DecodeError as e:
            raise IOError("text decode failed: " + e.message)

    def write(self, text: str) -> Result[None, IOError]:
        try:
            data: bytes = encode(text, self._encoding, self._encode_errors)
            result: None = self._binary.write_bytes(data)
            return result
        except EncodeError as e:
            raise IOError("text encode failed: " + e.message)
        except IOError as e:
            raise IOError(e.message)

    def readline(self) -> Result[str | None, IOError]:
        raise IOError("TextFileHandle.readline is deferred; use read().split(\"\\n\")")

    def readlines(self) -> Result[list[str], IOError]:
        raise IOError("TextFileHandle.readlines is deferred; use read().split(\"\\n\")")

    def readable(self) -> bool:
        return self._binary.readable()

    def writable(self) -> bool:
        return self._binary.writable()

    def seekable(self) -> bool:
        return self._binary.seekable()

    def __enter__(self) -> TextFileHandle:
        return self

    def __exit__(self) -> None:
        self.close()


class TextReader:
    _closed: bool

    def __init__(self) -> None:
        self._closed = False

    def read(self) -> Result[str, IOError]:
        raise IOError("TextReader direct construction is unsupported; use open_text")

    def readline(self) -> Result[str | None, IOError]:
        raise IOError("TextReader.readline is deferred; use read().split(\"\\n\")")

    def readlines(self) -> Result[list[str], IOError]:
        raise IOError("TextReader.readlines is deferred; use read().split(\"\\n\")")

    def close(self) -> None:
        self._closed = True


class TextWriter:
    _closed: bool

    def __init__(self) -> None:
        self._closed = False

    def write(self, text: str) -> Result[None, IOError]:
        _ = text
        raise IOError("TextWriter direct construction is unsupported; use open_text")

    def close(self) -> None:
        self._closed = True


class StringIO:
    _buffer: str
    _cursor: int
    _closed: bool

    def __init__(self, initial: str = "") -> None:
        self._buffer = initial + ""
        self._cursor = 0
        self._closed = False

    def close(self) -> None:
        self._closed = True

    def closed(self) -> bool:
        return self._closed

    def flush(self) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        return None

    def read(self, size: int | None = None) -> Result[str, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        start: int = self._cursor
        end: int = len(self._buffer)
        if size is not None:
            maybe_size: int = size
            if maybe_size >= 0:
                requested: int = start + maybe_size
                if requested < end:
                    end = requested
        piece: str = self._buffer[start:end]
        self._cursor = end
        return piece

    def write(self, data: str) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        left: str = self._buffer[:self._cursor]
        tail_start: int = self._cursor + len(data)
        right: str = ""
        if tail_start < len(self._buffer):
            right = self._buffer[tail_start:]
        self._buffer = left + data + right
        self._cursor = self._cursor + len(data)
        return None

    def getvalue(self) -> str:
        return self._buffer

    def seek(self, offset: int, whence: int = 0) -> Result[int, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        origin: int = 0
        if whence == 0:
            origin = 0
        elif whence == 1:
            origin = self._cursor
        elif whence == 2:
            origin = len(self._buffer)
        else:
            raise IOError(_invalid_whence_error(whence))

        next_pos: int = origin + offset
        if next_pos < 0:
            raise IOError(_negative_seek_error(next_pos))
        end: int = len(self._buffer)
        if next_pos > end:
            next_pos = end
        self._cursor = next_pos
        return self._cursor

    def tell(self) -> Result[int, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        return self._cursor

    def readable(self) -> bool:
        return not self._closed

    def writable(self) -> bool:
        return not self._closed

    def seekable(self) -> bool:
        return not self._closed


class BytesIO:
    _buffer: bytes
    _cursor: int
    _closed: bool

    def __init__(self, initial: bytes = b"") -> None:
        self._buffer = initial
        self._cursor = 0
        self._closed = False

    def close(self) -> None:
        self._closed = True

    def closed(self) -> bool:
        return self._closed

    def flush(self) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        return None

    def read_bytes(self, size: int | None = None) -> Result[bytes, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        start: int = self._cursor
        end: int = len(self._buffer)
        if size is not None:
            maybe_size: int = size
            if maybe_size >= 0:
                requested: int = start + maybe_size
                if requested < end:
                    end = requested
        chunk: bytes = self._buffer[start:end]
        self._cursor = end
        return chunk

    def write_bytes(self, data: bytes) -> Result[None, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        left: bytes = self._buffer[:self._cursor]
        tail_start: int = self._cursor + len(data)
        right: bytes = b""
        if tail_start < len(self._buffer):
            right = self._buffer[tail_start:]
        self._buffer = left + data + right
        self._cursor = self._cursor + len(data)
        return None

    def getvalue(self) -> Result[bytes, IOError]:
        return self._buffer

    def seek(self, offset: int, whence: int = 0) -> Result[int, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        origin: int = 0
        if whence == 0:
            origin = 0
        elif whence == 1:
            origin = self._cursor
        elif whence == 2:
            origin = len(self._buffer)
        else:
            raise IOError(_invalid_whence_error(whence))

        next_pos: int = origin + offset
        if next_pos < 0:
            raise IOError(_negative_seek_error(next_pos))
        end: int = len(self._buffer)
        if next_pos > end:
            next_pos = end
        self._cursor = next_pos
        return self._cursor

    def tell(self) -> Result[int, IOError]:
        if self._closed:
            raise IOError(_closed_stream_error())
        return self._cursor

    def readable(self) -> bool:
        return not self._closed

    def writable(self) -> bool:
        return not self._closed

    def seekable(self) -> bool:
        return not self._closed


def open(path: str, mode: str = "r") -> Result[FileHandle, IOError]:
    try:
        handle: NativeFileHandle = open_file(path, mode)
        return FileHandle(handle, mode)
    except IOError as e:
        raise IOError(e.message)


def open_binary(path: str, mode: str = "rb") -> Result[BinaryFileHandle, IOError]:
    if "b" not in mode:
        raise IOError("open_binary requires binary mode")
    try:
        handle: NativeFileHandle = open_file(path, mode)
        return BinaryFileHandle(handle, mode)
    except IOError as e:
        raise IOError(e.message)


def open_text(path: str, mode: str = "r", encoding: Encoding | None = None, errors: DecodeErrorHandler | None = None) -> Result[TextFileHandle, IOError]:
    try:
        binary_mode: str = _text_binary_mode(mode)
        text_encoding: Encoding = _text_encoding_or_default(encoding)
        decode_errors: DecodeErrorHandler = _decode_errors_or_default(errors)
        encode_errors: EncodeErrorHandler = _encode_errors_from_decode_errors(decode_errors)
        binary: BinaryFileHandle = open_binary(path, binary_mode)
        return TextFileHandle(binary, text_encoding, decode_errors, encode_errors)
    except IOError as e:
        raise IOError(e.message)
