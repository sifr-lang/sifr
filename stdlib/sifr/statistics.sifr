# sifr.statistics — Statistical functions (pure Sifr)
from sifr.math import sqrt, log, exp

class StatisticsError(Error):
    message: str

def _sum(data: list[float]) -> float:
    total: float = 0.0
    for val in data:
        total = total + val
    return total

def _float_int(value: int) -> Result[float, StatisticsError]:
    try:
        converted: float = float(value)
        return converted
    except FloatOverflowError as error:
        raise StatisticsError(error.message)
    except FloatPrecisionLossError as error:
        raise StatisticsError(error.message)

def _divide_by_int(numerator: float, denominator: int) -> Result[float, StatisticsError]:
    try:
        divisor: float = _float_int(denominator)
        return numerator / divisor
    except StatisticsError as error:
        raise StatisticsError(error.message)

def mean(data: list[float]) -> Result[float, StatisticsError]:
    count: int = len(data)
    if count == 0:
        raise StatisticsError("mean requires at least one data point")
    total: float = _sum(data)
    return _divide_by_int(total, count)

def median(data: list[float]) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n == 0:
        raise StatisticsError("median requires at least one data point")
    sorted_data: list[float] = sorted(data)
    mid: int = n // 2
    if n % 2 == 0:
        a: float | None = sorted_data[mid - 1]
        b: float | None = sorted_data[mid]
        if a is not None:
            if b is not None:
                return (a + b) / 2.0
        raise StatisticsError("median: index error")
    else:
        val: float | None = sorted_data[mid]
        if val is not None:
            return val
        raise StatisticsError("median: index error")

def variance(data: list[float]) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n < 2:
        raise StatisticsError("variance requires at least two data points")
    try:
        avg: float = _divide_by_int(_sum(data), n)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    total: float = 0.0
    for val in data:
        diff: float = val - avg
        total = total + diff * diff
    return _divide_by_int(total, n - 1)

def pvariance(data: list[float]) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n == 0:
        raise StatisticsError("pvariance requires at least one data point")
    try:
        avg: float = _divide_by_int(_sum(data), n)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    total: float = 0.0
    for val in data:
        diff: float = val - avg
        total = total + diff * diff
    return _divide_by_int(total, n)

def stdev(data: list[float]) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n < 2:
        raise StatisticsError("stdev requires at least two data points")
    try:
        avg: float = _divide_by_int(_sum(data), n)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    total: float = 0.0
    for val in data:
        diff: float = val - avg
        total = total + diff * diff
    try:
        v: float = _divide_by_int(total, n - 1)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    return sqrt(v)

def pstdev(data: list[float]) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n == 0:
        raise StatisticsError("pstdev requires at least one data point")
    try:
        avg: float = _divide_by_int(_sum(data), n)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    total: float = 0.0
    for val in data:
        diff: float = val - avg
        total = total + diff * diff
    try:
        v: float = _divide_by_int(total, n)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    return sqrt(v)

def harmonic_mean(data: list[float]) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n == 0:
        raise StatisticsError("harmonic_mean requires at least one data point")
    total: float = 0.0
    for val in data:
        if val <= 0.0:
            raise StatisticsError("harmonic_mean requires positive values")
        total = total + 1.0 / val
    try:
        numerator: float = _float_int(n)
        return numerator / total
    except StatisticsError as error:
        raise StatisticsError(error.message)

def geometric_mean(data: list[float]) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n == 0:
        raise StatisticsError("geometric_mean requires at least one data point")
    log_sum: float = 0.0
    for val in data:
        if val <= 0.0:
            raise StatisticsError("geometric_mean requires positive values")
        log_sum = log_sum + log(val)
    try:
        mean_log: float = _divide_by_int(log_sum, n)
        return exp(mean_log)
    except StatisticsError as error:
        raise StatisticsError(error.message)

def median_low(data: list[float]) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n == 0:
        raise StatisticsError("median_low requires at least one data point")
    sorted_data: list[float] = sorted(data)
    mid: int = n // 2
    if n % 2 == 0:
        val: float | None = sorted_data[mid - 1]
        if val is not None:
            return val
        raise StatisticsError("median_low: index error")
    else:
        val2: float | None = sorted_data[mid]
        if val2 is not None:
            return val2
        raise StatisticsError("median_low: index error")

def median_high(data: list[float]) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n == 0:
        raise StatisticsError("median_high requires at least one data point")
    sorted_data: list[float] = sorted(data)
    mid: int = n // 2
    val: float | None = sorted_data[mid]
    if val is not None:
        return val
    raise StatisticsError("median_high: index error")


def median_grouped(data: list[float], interval: float = 1.0) -> Result[float, StatisticsError]:
    n: int = len(data)
    if n == 0:
        raise StatisticsError("median_grouped requires at least one data point")
    if interval <= 0.0:
        raise StatisticsError("median_grouped: interval must be > 0")

    sorted_data: list[float] = sorted(data)
    mid_index: int = n // 2
    midpoint_opt: float | None = sorted_data[mid_index]
    if midpoint_opt is None:
        raise StatisticsError("median_grouped: index error")
    midpoint: float = midpoint_opt

    cf: int = 0
    f: int = 0
    for value in sorted_data:
        if value < midpoint:
            cf = cf + 1
        elif value == midpoint:
            f = f + 1

    if f == 0:
        raise StatisticsError("median_grouped: grouped frequency is zero")

    lower: float = midpoint - interval / 2.0
    try:
        n_float: float = _float_int(n)
        cf_float: float = _float_int(cf)
        f_float: float = _float_int(f)
        return lower + interval * ((n_float / 2.0 - cf_float) / f_float)
    except StatisticsError as error:
        raise StatisticsError(error.message)

def mode(data: list[int]) -> Result[int, StatisticsError]:
    if len(data) == 0:
        raise StatisticsError("mode requires at least one data point")
    counts: dict[int, int] = {}
    for val in data:
        existing: int | None = counts[val]
        if existing is not None:
            counts[val] = existing + 1
        else:
            counts[val] = 1
    best: int = 0
    best_set: bool = False
    best_count: int = 0
    for val2 in data:
        count2: int | None = counts[val2]
        count2_val: int = 0
        if count2 is not None:
            count2_val = count2
        if count2_val > best_count:
            best_count = count2_val
            best = val2
            best_set = True
    if best_set:
        return best
    raise StatisticsError("mode: no mode found")

def multimode(data: list[int]) -> Result[list[int], StatisticsError]:
    if len(data) == 0:
        raise StatisticsError("multimode requires at least one data point")
    counts: dict[int, int] = {}
    for val in data:
        existing: int | None = counts[val]
        if existing is not None:
            counts[val] = existing + 1
        else:
            counts[val] = 1
    max_count: int = 0
    for val2 in data:
        count2: int | None = counts[val2]
        count2_val: int = 0
        if count2 is not None:
            count2_val = count2
        if count2_val > max_count:
            max_count = count2_val
    result: list[int] = []
    seen: dict[int, bool] = {}
    for val3 in data:
        already_opt: bool | None = seen[val3]
        already: bool = False
        if already_opt is not None:
            already = already_opt
        if not already:
            count3: int | None = counts[val3]
            count3_val: int = 0
            if count3 is not None:
                count3_val = count3
            if count3_val == max_count:
                result.append(val3)
            seen[val3] = True
    return result

def quantiles(data: list[float], n: int) -> Result[list[float], StatisticsError]:
    if len(data) < 2:
        raise StatisticsError("quantiles requires at least two data points")
    if n < 1:
        raise StatisticsError("quantiles: n must be at least 1")
    sorted_data: list[float] = sorted(data)
    m: int = len(sorted_data)
    result: list[float] = []
    i: int = 1
    while i < n:
        try:
            i_float: float = _float_int(i)
            m_float: float = _float_int(m)
            n_float: float = _float_int(n)
        except StatisticsError as error:
            raise StatisticsError(error.message)
        idx_f: float = i_float * m_float / n_float
        idx: int = 0
        try:
            converted_idx: int = int(idx_f)
            idx = converted_idx
        except ValueError as error:
            raise StatisticsError(error.message)
        try:
            idx_float: float = _float_int(idx)
        except StatisticsError as error:
            raise StatisticsError(error.message)
        frac: float = idx_f - idx_float
        if idx >= m:
            idx = m - 1
        if idx < 0:
            idx = 0
        lo: float | None = sorted_data[idx]
        lo_val: float = 0.0
        if lo is not None:
            lo_val = lo
        if frac > 0.0:
            hi_idx: int = idx + 1
            if hi_idx < m:
                hi: float | None = sorted_data[hi_idx]
                if hi is not None:
                    lo_val = lo_val + frac * (hi - lo_val)
        result.append(lo_val)
        i = i + 1
    return result

def covariance(x: list[float], y: list[float]) -> Result[float, StatisticsError]:
    n: int = len(x)
    if n < 2:
        raise StatisticsError("covariance requires at least two data points")
    if len(y) != n:
        raise StatisticsError("covariance: x and y must have the same length")
    try:
        mx: float = _divide_by_int(_sum(x), n)
        my: float = _divide_by_int(_sum(y), n)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    total: float = 0.0
    i: int = 0
    while i < n:
        xi: float | None = x[i]
        yi: float | None = y[i]
        if xi is not None:
            if yi is not None:
                total = total + (xi - mx) * (yi - my)
        i = i + 1
    return _divide_by_int(total, n - 1)

def correlation(x: list[float], y: list[float]) -> Result[float, StatisticsError]:
    n: int = len(x)
    if n < 2:
        raise StatisticsError("correlation requires at least two data points")
    if len(y) != n:
        raise StatisticsError("correlation: x and y must have the same length")
    try:
        mx: float = _divide_by_int(_sum(x), n)
        my: float = _divide_by_int(_sum(y), n)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    cov_num: float = 0.0
    sx_num: float = 0.0
    sy_num: float = 0.0
    i: int = 0
    while i < n:
        xi: float | None = x[i]
        yi: float | None = y[i]
        if xi is not None:
            if yi is not None:
                cov_num = cov_num + (xi - mx) * (yi - my)
                sx_num = sx_num + (xi - mx) * (xi - mx)
                sy_num = sy_num + (yi - my) * (yi - my)
        i = i + 1
    try:
        sx_variance: float = _divide_by_int(sx_num, n - 1)
        sy_variance: float = _divide_by_int(sy_num, n - 1)
        sx: float = sqrt(sx_variance)
        sy: float = sqrt(sy_variance)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    if sx == 0.0:
        raise StatisticsError("correlation: x has zero variance")
    if sy == 0.0:
        raise StatisticsError("correlation: y has zero variance")
    try:
        covariance_value: float = _divide_by_int(cov_num, n - 1)
        return covariance_value / (sx * sy)
    except StatisticsError as error:
        raise StatisticsError(error.message)

def linear_regression(x: list[float], y: list[float]) -> Result[list[float], StatisticsError]:
    # Returns [slope, intercept]
    n: int = len(x)
    if n < 2:
        raise StatisticsError("linear_regression requires at least two data points")
    if len(y) != n:
        raise StatisticsError("linear_regression: x and y must have the same length")
    try:
        mx: float = _divide_by_int(_sum(x), n)
        my: float = _divide_by_int(_sum(y), n)
    except StatisticsError as error:
        raise StatisticsError(error.message)
    num: float = 0.0
    den: float = 0.0
    i: int = 0
    while i < n:
        xi: float | None = x[i]
        yi: float | None = y[i]
        if xi is not None:
            if yi is not None:
                num = num + (xi - mx) * (yi - my)
                den = den + (xi - mx) * (xi - mx)
        i = i + 1
    if den == 0.0:
        raise StatisticsError("linear_regression: x has zero variance")
    slope: float = num / den
    intercept: float = my - slope * mx
    result: list[float] = []
    result.append(slope)
    result.append(intercept)
    return result
