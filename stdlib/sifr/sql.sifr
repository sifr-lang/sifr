# sifr.sql — compiler-owned SQL surface types

class SqlSchema[P]:
    def sql(self, own template: Template) -> Template:
        return template


class SqlError(Error):
    pass


class EncodeError(SqlError):
    pass


class DecodeError(SqlError):
    pass


class SqlEnum:
    pass


class Numeric:
    pass


class CalendarInterval:
    pass


class OffsetTime:
    pass


class Instant:
    pass


class IPAddress:
    pass


class IPNetwork:
    pass


class MacAddress:
    pass


class SqlArray[T]:
    pass


class Range[T]:
    pass


class MultiRange[T]:
    pass


class QueryTemplate[P]:
    pass


class BoundQuery[P]:
    pass
