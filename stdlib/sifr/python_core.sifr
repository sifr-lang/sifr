# sifr.python_core - shared embedded CPython public wrapper types

from typing import Callable

from _sifr.python import (
    ExitCause,
    ExitCauseKind,
    ExitDecision,
    Object,
    PythonError,
    ResourceIdentity,
    py_close_callback,
    py_local_callback,
    py_local_callback_echo,
    py_threadsafe_callback,
    py_threadsafe_callback_echo,
)


class ResourceDiagnostics:
    initialized: bool
    live_objects: int
    leaked_objects: int

    def __init__(self, initialized: bool, live_objects: int, leaked_objects: int):
        self.initialized = initialized
        self.live_objects = live_objects
        self.leaked_objects = leaked_objects


class LocalCallback(NonSend):
    _identity: ResourceIdentity
    callable: Object
    kind: str


class ThreadsafeCallback:
    _identity: ResourceIdentity
    callable: Object
    kind: str


def _local_callback_from_raw(own raw: tuple[ResourceIdentity, Object, str]) -> LocalCallback:
    return LocalCallback(raw[0], raw[1], raw[2])


def _threadsafe_callback_from_raw(own raw: tuple[ResourceIdentity, Object, str]) -> ThreadsafeCallback:
    return ThreadsafeCallback(raw[0], raw[1], raw[2])


@blocking_io
def local_callback(handler: Callable[[Object], Result[Object, PythonError]]) -> Result[LocalCallback, PythonError]:
    try:
        raw: tuple[ResourceIdentity, Object, str] = py_local_callback(handler)
        return _local_callback_from_raw(raw)
    except PythonError as e:
        raise e


@blocking_io
def threadsafe_callback(handler: Callable[[Object], Result[Object, PythonError]]) -> Result[ThreadsafeCallback, PythonError]:
    try:
        raw: tuple[ResourceIdentity, Object, str] = py_threadsafe_callback(handler)
        return _threadsafe_callback_from_raw(raw)
    except PythonError as e:
        raise e


@blocking_io
def local_callback_echo() -> Result[LocalCallback, PythonError]:
    try:
        raw: tuple[ResourceIdentity, Object, str] = py_local_callback_echo()
        return _local_callback_from_raw(raw)
    except PythonError as e:
        raise e


@blocking_io
def threadsafe_callback_echo() -> Result[ThreadsafeCallback, PythonError]:
    try:
        raw: tuple[ResourceIdentity, Object, str] = py_threadsafe_callback_echo()
        return _threadsafe_callback_from_raw(raw)
    except PythonError as e:
        raise e


@blocking_io
def close_local_callback(own callback: LocalCallback) -> Result[None, PythonError]:
    return py_close_callback(callback._identity)


@blocking_io
def close_threadsafe_callback(own callback: ThreadsafeCallback) -> Result[None, PythonError]:
    return py_close_callback(callback._identity)
