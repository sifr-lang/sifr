# sifr.difflib — Sequence comparison (pure Sifr)

def get_close_matches(
    word: str, possibilities: list[str], n: int, cutoff: float
) -> Result[list[str], FloatOverflowError | FloatPrecisionLossError]:
    result: list[str] = []
    scores: list[float] = []
    for candidate in possibilities:
        try:
            score: float = _similarity(word, candidate)
        except FloatOverflowError as error:
            raise FloatOverflowError(error.message)
        except FloatPrecisionLossError as error:
            raise FloatPrecisionLossError(error.message)
        if score >= cutoff:
            result.append(candidate)
            scores.append(score)
    # Simple selection of top n (no sort needed for small lists)
    if len(result) <= n:
        return result
    top: list[str] = []
    used: list[int] = []
    count: int = 0
    while count < n:
        best_idx: int = -1
        best_score: float = -1.0
        i: int = 0
        while i < len(scores):
            skip: bool = False
            for u in used:
                if u == i:
                    skip = True
            if not skip:
                s: float | None = scores[i]
                if s is not None:
                    if s > best_score:
                        best_score = s
                        best_idx = i.clone()
            i = i + 1
        if best_idx >= 0:
            used.append(best_idx)
            val: str | None = result[best_idx]
            if val is not None:
                top.append(val)
        count = count + 1
    return top

def _similarity(a: str, b: str) -> Result[float, FloatOverflowError | FloatPrecisionLossError]:
    total: int = len(a) + len(b)
    if total == 0:
        return 1.0
    matches: int = 0
    blocks: list[tuple[int, int, int]] = _matching_blocks(a, b)
    for block in blocks:
        _, _, block_size = block
        matches = matches + block_size
    try:
        numerator: float = float(2 * matches)
        denominator: float = float(total)
        return numerator / denominator
    except FloatOverflowError as error:
        raise FloatOverflowError(error.message)
    except FloatPrecisionLossError as error:
        raise FloatPrecisionLossError(error.message)

def _longest_common_substring_range(
    a: str, b: str, a_start: int, a_end: int, b_start: int, b_end: int
) -> tuple[int, int, int]:
    best_i: int = 0
    best_j: int = 0
    best_len: int = 0
    i: int = a_start.clone()
    while i < a_end:
        j: int = b_start.clone()
        while j < b_end:
            k: int = 0
            while i + k < a_end and j + k < b_end:
                ai: str | None = a[i + k]
                bj: str | None = b[j + k]
                if ai is None or bj is None:
                    k = k + 1
                    continue
                if ai != bj:
                    break
                k = k + 1
            if k > best_len:
                best_len = k
                best_i = i.clone()
                best_j = j.clone()
            j = j + 1
        i = i + 1
    return (best_i, best_j, best_len)

def _sort_blocks(blocks: list[tuple[int, int, int]]) -> list[tuple[int, int, int]]:
    sorted_blocks: list[tuple[int, int, int]] = []
    for block in blocks:
        bl_a, bl_b, _ = block.clone()
        found_insert_at: bool = False
        insert_at: int = 0
        i: int = 0
        for existing in sorted_blocks:
            if not found_insert_at:
                ex_a, ex_b, _ = existing
                comes_before: bool = False
                if bl_a < ex_a:
                    comes_before = True
                elif bl_a == ex_a:
                    if bl_b < ex_b:
                        comes_before = True
                if comes_before:
                    insert_at = i.clone()
                    found_insert_at = True
            i = i + 1
        if found_insert_at:
            sorted_blocks.insert(insert_at, block.clone())
        else:
            sorted_blocks.append(block.clone())
    return sorted_blocks

def _matching_blocks(a: str, b: str) -> list[tuple[int, int, int]]:
    pending_a_start: list[int] = [0]
    pending_a_end: list[int] = [len(a)]
    pending_b_start: list[int] = [0]
    pending_b_end: list[int] = [len(b)]
    unsorted_blocks: list[tuple[int, int, int]] = []
    while len(pending_a_start) > 0:
        a_start_value: int | None = pending_a_start.pop()
        a_end_value: int | None = pending_a_end.pop()
        b_start_value: int | None = pending_b_start.pop()
        b_end_value: int | None = pending_b_end.pop()
        if a_start_value is not None:
            if a_end_value is not None:
                if b_start_value is not None:
                    if b_end_value is not None:
                        ai, bj, size = _longest_common_substring_range(
                            a,
                            b,
                            a_start_value,
                            a_end_value,
                            b_start_value,
                            b_end_value,
                        )
                        if size == 0:
                            continue
                        unsorted_blocks.append((ai, bj, size))
                        left_a_end: int = ai.clone()
                        left_b_end: int = bj.clone()
                        if a_start_value < left_a_end and b_start_value < left_b_end:
                            pending_a_start.append(a_start_value)
                            pending_a_end.append(left_a_end)
                            pending_b_start.append(b_start_value)
                            pending_b_end.append(left_b_end)
                        right_a_start: int = ai + size
                        right_b_start: int = bj + size
                        if right_a_start < a_end_value and right_b_start < b_end_value:
                            pending_a_start.append(right_a_start)
                            pending_a_end.append(a_end_value)
                            pending_b_start.append(right_b_start)
                            pending_b_end.append(b_end_value)

    sorted_blocks: list[tuple[int, int, int]] = _sort_blocks(unsorted_blocks)
    merged_blocks: list[tuple[int, int, int]] = []
    have_previous: bool = False
    prev_a: int = 0
    prev_b: int = 0
    prev_size: int = 0
    for block in sorted_blocks:
        bl_a, bl_b, bl_size = block.clone()
        if not have_previous:
            prev_a = bl_a.clone()
            prev_b = bl_b.clone()
            prev_size = bl_size.clone()
            have_previous = True
            continue
        if prev_a + prev_size == bl_a and prev_b + prev_size == bl_b:
            prev_size = prev_size + bl_size
        else:
            merged_blocks.append((prev_a.clone(), prev_b.clone(), prev_size.clone()))
            prev_a = bl_a.clone()
            prev_b = bl_b.clone()
            prev_size = bl_size.clone()
    if have_previous:
        merged_blocks.append((prev_a.clone(), prev_b.clone(), prev_size.clone()))
    merged_blocks.append((len(a), len(b), 0))
    return merged_blocks

class SequenceMatcher:
    _a: str
    _b: str

    def __init__(self, a: str = "", b: str = "") -> None:
        self._a = a + ""
        self._b = b + ""

    def set_seq1(mut self, a: str) -> None:
        self._a = a + ""

    def set_seq2(mut self, b: str) -> None:
        self._b = b + ""

    def set_seqs(mut self, a: str, b: str) -> None:
        self._a = a + ""
        self._b = b + ""

    def ratio(self) -> Result[float, FloatOverflowError | FloatPrecisionLossError]:
        return _similarity(self._a, self._b)

    def get_matching_blocks(self) -> list[tuple[int, int, int]]:
        return _matching_blocks(self._a, self._b)

def unified_diff(a: list[str], b: list[str]) -> list[str]:
    result: list[str] = []
    result.append("--- a")
    result.append("+++ b")
    # Simple line-by-line diff
    max_len: int = len(a)
    if len(b) > max_len:
        max_len = len(b)
    i: int = 0
    while i < max_len:
        if i < len(a):
            if i < len(b):
                line_a: str | None = a[i]
                line_b: str | None = b[i]
                if line_a is not None:
                    if line_b is not None:
                        if line_a == line_b:
                            result.append(" " + line_a)
                        else:
                            result.append("-" + line_a)
                            result.append("+" + line_b)
            else:
                line_a2: str | None = a[i]
                if line_a2 is not None:
                    result.append("-" + line_a2)
        else:
            if i < len(b):
                line_b2: str | None = b[i]
                if line_b2 is not None:
                    result.append("+" + line_b2)
        i = i + 1
    return result
