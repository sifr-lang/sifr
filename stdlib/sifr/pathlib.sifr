# sifr.pathlib — Path manipulation (pure Sifr + intrinsics)
# I/O operations return Result[T, IOError] for safe error handling.
from _sifr.fs import exists as _exists_impl
from _sifr.fs import read_text as _read_text_impl
from _sifr.fs import write_text as _write_text_impl
from _sifr.fs import is_file, is_dir, mkdir, touch, resolve_path, iterdir, remove_file, rmdir, glob_pattern, rglob_pattern

def exists(path: str) -> bool:
    return _exists_impl(path)

def read_text(path: str) -> Result[str, IOError]:
    return _read_text_impl(path)

def write_text(path: str, content: str) -> Result[None, IOError]:
    return _write_text_impl(path, content)

def join_path(base: str, child: str) -> str:
    if len(base) == 0:
        return child + ""
    last: str | None = base[len(base) - 1]
    if last is not None:
        if last == "/":
            return base + child
    return base + "/" + child

def basename(path: str) -> str:
    i: int = len(path) - 1
    while i >= 0:
        ch: str | None = path[i]
        if ch is not None:
            if ch == "/":
                return path[i + 1:]
        i = i - 1
    return path + ""

def dirname(path: str) -> str:
    i: int = len(path) - 1
    while i >= 0:
        ch: str | None = path[i]
        if ch is not None:
            if ch == "/":
                return path[:i]
        i = i - 1
    return ""

def extension(path: str) -> str:
    i: int = len(path) - 1
    while i >= 0:
        ch: str | None = path[i]
        if ch is not None:
            if ch == ".":
                return path[i:]
            if ch == "/":
                return ""
        i = i - 1
    return ""

def stem(path: str) -> str:
    base: str = basename(path)
    i: int = len(base) - 1
    while i > 0:
        ch: str | None = base[i]
        if ch is not None:
            if ch == ".":
                return base[:i]
        i = i - 1
    return base + ""

def is_absolute(path: str) -> bool:
    if len(path) == 0:
        return False

    if len(path) >= 3:
        colon: str | None = path[1]
        sep: str | None = path[2]
        if colon is not None:
            if sep is not None:
                if colon == ":" and (sep == "/" or sep == "\\"):
                    return True

    first: str | None = path[0]
    if first is not None:
        if first == "/" or first == "\\":
            return True
    return False


def _iter_list_str(own entries: list[str]) -> Iterator[str]:
    i: int = 0
    while i < len(entries):
        yield entries[i]
        i = i + 1


def _iterdir_list(path: str) -> Result[list[str], IOError]:
    return iterdir(path)


def _glob_list(path: str, pattern: str) -> Result[list[str], IOError]:
    return glob_pattern(path, pattern)


def _rglob_list(path: str, pattern: str) -> Result[list[str], IOError]:
    return rglob_pattern(path, pattern)


def _iterdir_to_iter(path: str) -> Result[Iterator[str], IOError]:
    try:
        entries: list[str] = _iterdir_list(path)
        return _iter_list_str(entries)
    except IOError as e:
        raise e


def _glob_to_iter(path: str, pattern: str) -> Result[Iterator[str], IOError]:
    try:
        entries: list[str] = _glob_list(path, pattern)
        return _iter_list_str(entries)
    except IOError as e:
        raise e


def _rglob_to_iter(path: str, pattern: str) -> Result[Iterator[str], IOError]:
    try:
        entries: list[str] = _rglob_list(path, pattern)
        return _iter_list_str(entries)
    except IOError as e:
        raise e

class Path:
    _path: str

    def __init__(self, path: str):
        self._path = path

    def name(self) -> str:
        return basename(self._path)

    def parent(self) -> Path:
        return Path(dirname(self._path))

    def suffix(self) -> str:
        return extension(self._path)

    def stem(self) -> str:
        return stem(self._path)

    def exists(self) -> bool:
        return exists(self._path)

    def is_file(self) -> bool:
        return is_file(self._path)

    def is_dir(self) -> bool:
        return is_dir(self._path)

    def is_absolute(self) -> bool:
        return is_absolute(self._path)

    def read_text(self) -> Result[str, IOError]:
        return read_text(self._path)

    def write_text(self, content: str) -> Result[None, IOError]:
        return write_text(self._path, content)

    def mkdir(self) -> Result[None, IOError]:
        return mkdir(self._path)

    def joinpath(self, child: str) -> Path:
        return Path(join_path(self._path, child))

    def to_str(self) -> str:
        return self._path + ""

    def touch(self) -> Result[None, IOError]:
        return touch(self._path)

    def unlink(self) -> Result[None, IOError]:
        return remove_file(self._path)

    def rmdir(self) -> Result[None, IOError]:
        return rmdir(self._path)

    def resolve(self) -> Result[str, IOError]:
        return resolve_path(self._path)

    def iterdir(self) -> Result[Iterator[str], IOError]:
        return _iterdir_to_iter(self._path)

    def with_name(self, name: str) -> Path:
        parent: str = dirname(self._path)
        if parent == "":
            return Path(name + "")
        return Path(parent + "/" + name)

    def with_suffix(self, suffix: str) -> Path:
        s: str = stem(self._path)
        parent: str = dirname(self._path)
        if parent == "":
            return Path(s + suffix)
        return Path(parent + "/" + s + suffix)

    def glob(self, pattern: str) -> Result[Iterator[str], IOError]:
        return _glob_to_iter(self._path, pattern)

    def rglob(self, pattern: str) -> Result[Iterator[str], IOError]:
        return _rglob_to_iter(self._path, pattern)
