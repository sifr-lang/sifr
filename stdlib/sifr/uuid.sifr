# sifr.uuid — UUID generation and manipulation
from _sifr.uuid import uuid4, uuid3_text, uuid5_text

def _to_lower_hex_char(ch: str) -> str:
    if ch == "A":
        return "a"
    if ch == "B":
        return "b"
    if ch == "C":
        return "c"
    if ch == "D":
        return "d"
    if ch == "E":
        return "e"
    if ch == "F":
        return "f"
    return ch + ""

def _is_hex_char(ch: str) -> bool:
    if ch == "0":
        return True
    if ch == "1":
        return True
    if ch == "2":
        return True
    if ch == "3":
        return True
    if ch == "4":
        return True
    if ch == "5":
        return True
    if ch == "6":
        return True
    if ch == "7":
        return True
    if ch == "8":
        return True
    if ch == "9":
        return True
    if ch == "a":
        return True
    if ch == "b":
        return True
    if ch == "c":
        return True
    if ch == "d":
        return True
    if ch == "e":
        return True
    if ch == "f":
        return True
    if ch == "A":
        return True
    if ch == "B":
        return True
    if ch == "C":
        return True
    if ch == "D":
        return True
    if ch == "E":
        return True
    if ch == "F":
        return True
    return False

def _hex_digit_value(ch: str) -> int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    if ch == "9":
        return 9
    if ch == "a" or ch == "A":
        return 10
    if ch == "b" or ch == "B":
        return 11
    if ch == "c" or ch == "C":
        return 12
    if ch == "d" or ch == "D":
        return 13
    if ch == "e" or ch == "E":
        return 14
    if ch == "f" or ch == "F":
        return 15
    return -1

def _substring(value: str, start: int, end: int) -> str:
    result: str = ""
    i: int = start.clone()
    while i < end:
        ch: str | None = value[i]
        if ch is not None:
            result = result + ch
        i = i + 1
    return result

def _starts_with(value: str, prefix: str) -> bool:
    if len(value) < len(prefix):
        return False
    i: int = 0
    while i < len(prefix):
        left: str | None = value[i]
        right: str | None = prefix[i]
        if left != right:
            return False
        i = i + 1
    return True

def _canonical_uuid_text(input_text: str) -> Result[str, ValueError]:
    normalized_input: str = input_text + ""
    if _starts_with(normalized_input, "urn:uuid:"):
        normalized_input = _substring(normalized_input, 9, len(normalized_input))
    if len(normalized_input) >= 2:
        first: str | None = normalized_input[0]
        last: str | None = normalized_input[len(normalized_input) - 1]
        if first == "{" and last == "}":
            normalized_input = _substring(normalized_input, 1, len(normalized_input) - 1)

    input_len: int = len(normalized_input)
    hex_only: str = ""
    i: int = 0
    while i < input_len:
        ch_opt: str | None = normalized_input[i]
        if ch_opt is not None:
            ch: str = ch_opt
            if ch == "-":
                pass
            else:
                if not _is_hex_char(ch):
                    raise ValueError("invalid UUID hex string")
                hex_only = hex_only + _to_lower_hex_char(ch)
        i = i + 1

    if len(hex_only) != 32:
        raise ValueError("UUID hex string must be 32 hex characters")

    if input_len == 36:
        h1: str | None = normalized_input[8]
        h2: str | None = normalized_input[13]
        h3: str | None = normalized_input[18]
        h4: str | None = normalized_input[23]
        if h1 != "-" or h2 != "-" or h3 != "-" or h4 != "-":
            raise ValueError("invalid UUID hex string")
    elif input_len != 32:
        raise ValueError("invalid UUID hex string")

    canonical: str = ""
    j: int = 0
    while j < len(hex_only):
        if j == 8 or j == 12 or j == 16 or j == 20:
            canonical = canonical + "-"
        part: str | None = hex_only[j]
        if part is not None:
            canonical = canonical + part
        j = j + 1
    return canonical

class UUID:
    _hex: str

    def __init__(self, hex_str: str):
        self._hex = hex_str + ""

    def hex(self) -> str:
        result: str = ""
        i: int = 0
        while i < len(self._hex):
            ch: str | None = self._hex[i]
            if ch is not None:
                if ch != "-":
                    result = result + ch
            i = i + 1
        return result

    def urn(self) -> str:
        return "urn:uuid:" + self._hex

    def to_str(self) -> str:
        return self._hex + ""

    def version(self) -> int:
        marker: str | None = self._hex[14]
        if marker is None:
            return -1
        return _hex_digit_value(marker)

def uuid4_obj() -> UUID:
    return UUID(uuid4())

def uuid_from_hex(hex_str: str) -> Result[UUID, ValueError]:
    try:
        canonical: str = _canonical_uuid_text(hex_str)
        return UUID(canonical)
    except ValueError as e:
        raise ValueError(e.message)


def uuid3(namespace: UUID, name: str) -> UUID:
    return UUID(uuid3_text(namespace.to_str(), name))


def uuid5(namespace: UUID, name: str) -> UUID:
    return UUID(uuid5_text(namespace.to_str(), name))


def NAMESPACE_DNS() -> UUID:
    return UUID("6ba7b810-9dad-11d1-80b4-00c04fd430c8")


def NAMESPACE_URL() -> UUID:
    return UUID("6ba7b811-9dad-11d1-80b4-00c04fd430c8")


def NAMESPACE_OID() -> UUID:
    return UUID("6ba7b812-9dad-11d1-80b4-00c04fd430c8")


def NAMESPACE_X500() -> UUID:
    return UUID("6ba7b814-9dad-11d1-80b4-00c04fd430c8")
