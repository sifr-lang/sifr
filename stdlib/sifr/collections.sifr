# sifr.collections — Extended collection types
class frozenset[T: Hashable]:
    # Immutable set value. Construction copies the input so no mutable alias can change it.
    _values: set[T]

    def __init__(self, values: set[T]) -> None:
        self._values = values.copy()

    def __iter__(self) -> Iterable[T]:
        return iter(self._values)

    def __contains__(self, value: T) -> bool:
        return value in self._values

    def contains(self, value: T) -> bool:
        return value in self._values

    def __len__(self) -> int:
        return len(self._values)

    def length(self) -> int:
        return len(self._values)

    def copy(self) -> frozenset[T]:
        return frozenset(self._values)

    def union(self, other: frozenset[T]) -> frozenset[T]:
        return frozenset(self._values.union(other._values))

    def intersection(self, other: frozenset[T]) -> frozenset[T]:
        return frozenset(self._values.intersection(other._values))

    def difference(self, other: frozenset[T]) -> frozenset[T]:
        return frozenset(self._values.difference(other._values))

    def isdisjoint(self, other: frozenset[T]) -> bool:
        return self._values.isdisjoint(other._values)

    def issubset(self, other: frozenset[T]) -> bool:
        return self._values.issubset(other._values)

    def issuperset(self, other: frozenset[T]) -> bool:
        return self._values.issuperset(other._values)

    def __eq__(self, other: frozenset[T]) -> bool:
        return self._values.issubset(other._values) and other._values.issubset(self._values)


class Counter[T: Hashable]:
    # A multiset (bag) mapping elements to their counts.
    counts: dict[T, int]

    def __init__(
        self, source: dict[T, int] | None = None, iterable: list[T] | None = None
    ) -> None:
        counts: dict[T, int] = {}
        if source is not None:
            for key in source.keys():
                value: int | None = source[key]
                if value is not None:
                    counts[key] = value
        if iterable is not None:
            for item in iterable:
                value2: int | None = counts[item]
                if value2 is not None:
                    counts[item] = value2 + 1
                else:
                    counts[item] = 1
        self.counts = counts

    def __iter__(self) -> Iterable[T]:
        return iter(self.counts.keys())

    def __getitem__(self, key: T) -> int:
        val: int | None = self.counts[key]
        if val is not None:
            return val
        return 0

    def get(self, key: T, default: int = 0) -> int:
        val: int | None = self.counts[key]
        if val is not None:
            return val
        return default

    def increment(self, key: T) -> None:
        val: int | None = self.counts[key]
        if val is not None:
            self.counts[key] = val + 1
        else:
            self.counts[key] = 1

    def total(self) -> int:
        total: int = 0
        for count in self.counts.values():
            total = total + count
        return total

    def most_common(self, n: int | None = None) -> list[tuple[T, int]]:
        result: list[tuple[T, int]] = []
        for key in self.counts.keys():
            count: int | None = self.counts[key]
            if count is not None:
                entry: tuple[T, int] = (key, count)
                result.append(entry)
        sz: int = len(result)
        i: int = 0
        while i < sz:
            j: int = i + 1
            while j < sz:
                left: tuple[T, int] | None = result[i]
                right: tuple[T, int] | None = result[j]
                if left is not None:
                    if right is not None:
                        if right[1] > left[1]:
                            result[i] = right
                            result[j] = left
                j = j + 1
            i = i + 1
        if n is None:
            return result
        if n <= 0:
            return []
        top: list[tuple[T, int]] = []
        index: int = 0
        while index < n:
            if index >= len(result):
                return top
            value: tuple[T, int] | None = result[index]
            if value is not None:
                top.append(value)
            index = index + 1
        return top

    def keys(self) -> list[T]:
        result: list[T] = self.counts.keys()
        sz: int = len(result)
        i: int = 0
        while i < sz:
            j: int = i + 1
            while j < sz:
                left: T | None = result[i]
                right: T | None = result[j]
                if left is not None:
                    if right is not None:
                        if right < left:
                            result[i] = right
                            result[j] = left
                j = j + 1
            i = i + 1
        return result

    def items(self) -> list[tuple[T, int]]:
        result: list[tuple[T, int]] = []
        for key in self.counts.keys():
            value: int | None = self.counts[key]
            if value is not None:
                entry: tuple[T, int] = (key, value)
                result.append(entry)
        return result

    def values(self) -> list[int]:
        return self.counts.values()

    def copy(self) -> Counter[T]:
        return Counter(source=self.counts)

    def clear(self) -> None:
        self.counts = {}

    def update(self, other: Counter[T]) -> None:
        for key in other.counts.keys():
            other_val: int | None = other.counts[key]
            if other_val is not None:
                existing: int | None = self.counts[key]
                if existing is not None:
                    self.counts[key] = existing + other_val
                else:
                    self.counts[key] = other_val

    def subtract(self, other: Counter[T]) -> None:
        for key in other.counts.keys():
            other_val: int | None = other.counts[key]
            if other_val is not None:
                existing: int | None = self.counts[key]
                if existing is not None:
                    self.counts[key] = existing - other_val
                else:
                    self.counts[key] = 0 - other_val

    def elements(self) -> list[T]:
        result: list[T] = []
        all_keys: list[T] = self.counts.keys()
        ki: int = 0
        while ki < len(all_keys):
            key_opt: T | None = all_keys[ki]
            if key_opt is not None:
                cnt: int | None = self.counts[key_opt]
                if cnt is not None:
                    i: int = 0
                    while i < cnt:
                        key_copy: T | None = all_keys[ki]
                        if key_copy is not None:
                            result.append(key_copy)
                        i = i + 1
            ki = ki + 1
        return result

    def __add__(self, other: Counter[T]) -> Counter[T]:
        new_counts: dict[T, int] = {}
        for key in self.counts.keys():
            a_val: int | None = self.counts[key]
            if a_val is not None:
                b_val: int | None = other.counts[key]
                b_count: int = 0
                if b_val is not None:
                    b_count = b_val
                total: int = a_val + b_count
                if total > 0:
                    new_counts[key] = total
        for key2 in other.counts.keys():
            already: int | None = new_counts[key2]
            if already is None:
                b_val2: int | None = other.counts[key2]
                if b_val2 is not None:
                    if b_val2 > 0:
                        new_counts[key2] = b_val2
        return Counter(source=new_counts)

    def __sub__(self, other: Counter[T]) -> Counter[T]:
        new_counts: dict[T, int] = {}
        for key in self.counts.keys():
            a_val: int | None = self.counts[key]
            if a_val is not None:
                b_val: int | None = other.counts[key]
                b_count: int = 0
                if b_val is not None:
                    b_count = b_val
                diff: int = a_val - b_count
                if diff > 0:
                    new_counts[key] = diff
        return Counter(source=new_counts)


def from_list[T: Hashable](items: list[T]) -> Counter[T]:
    counts: dict[T, int] = {}
    for item in items:
        val: int | None = counts[item]
        if val is not None:
            counts[item] = val + 1
        else:
            counts[item] = 1
    return Counter(source=counts)




class deque[T]:
    # A double-ended queue backed by VecDeque for O(1) front/back operations.
    _data: list[T]
    maxlen: int | None

    def __init__(self, items: list[T] | None = None, maxlen: int | None = None) -> None:
        data: list[T] = []
        if items is not None:
            start: int = 0
            if maxlen is not None:
                if len(items) > maxlen:
                    start = len(items) - maxlen
            i: int = start
            while i < len(items):
                item: T | None = items[i]
                if item is not None:
                    data.append(item)
                i += 1
        self.maxlen = maxlen
        self._data = data

    def append(self, val: T) -> None:
        self._data.append(val)
        maxlen_opt: int | None = self.maxlen
        if maxlen_opt is not None:
            maxlen: int = maxlen_opt
            if len(self._data) > maxlen:
                self._data.popleft()

    def appendleft(self, val: T) -> None:
        self._data.appendleft(val)
        maxlen_opt: int | None = self.maxlen
        if maxlen_opt is not None:
            maxlen: int = maxlen_opt
            if len(self._data) > maxlen:
                self._data.pop()

    def pop(self) -> T | None:
        if len(self._data) == 0:
            return None
        return self._data.pop()

    def popleft(self) -> T | None:
        if len(self._data) == 0:
            return None
        return self._data.popleft()

    def len(self) -> int:
        return len(self._data)

    def to_list(self) -> list[T]:
        result: list[T] = []
        for v in self._data:
            result.append(v)
        return result

    def clear(self) -> None:
        self._data.clear()

    def extend(self, items: list[T]) -> None:
        for v in items:
            self._data.append(v)
        maxlen_opt: int | None = self.maxlen
        if maxlen_opt is not None:
            maxlen: int = maxlen_opt
            while len(self._data) > maxlen:
                self._data.popleft()

    def extendleft(self, items: list[T]) -> None:
        for v in items:
            self._data.appendleft(v)
        maxlen_opt: int | None = self.maxlen
        if maxlen_opt is not None:
            maxlen: int = maxlen_opt
            while len(self._data) > maxlen:
                self._data.pop()

    def copy(self) -> deque[T]:
        return deque(self.to_list(), maxlen=self.maxlen)

    def reverse(self) -> None:
        items: list[T] = self.to_list()
        items.reverse()
        self._data.clear()
        for item in items:
            self._data.append(item)

    def rotate(self, n: int = 1) -> None:
        length: int = len(self._data)
        if length == 0:
            return
        steps: int = n % length
        if steps < 0:
            steps = steps + length
        count: int = 0
        while count < steps:
            value: T | None = self._data.pop()
            if value is not None:
                self._data.appendleft(value)
            count = count + 1

    def count(self, value: T) -> int:
        total: int = 0
        for item in self._data:
            if item == value:
                total = total + 1
        return total

    def index(self, value: T, start: int = 0, stop: int | None = None) -> int | None:
        size: int = len(self._data)
        begin: int = start
        if begin < 0:
            begin = size + begin
            if begin < 0:
                begin = 0
        end: int = size
        if stop is not None:
            end = stop
            if end < 0:
                end = size + end
            if end < 0:
                end = 0
            if end > size:
                end = size
        i: int = begin
        while i < end:
            current: T | None = self._data[i]
            if current is not None:
                if current == value:
                    return i
            i = i + 1
        return None

    def remove(self, value: T) -> None:
        idx: int | None = self.index(value, 0, None)
        if idx is not None:
            rebuilt: list[T] = []
            i: int = 0
            while i < len(self._data):
                current: T | None = self._data[i]
                if current is not None:
                    if i != idx:
                        rebuilt.append(current)
                i = i + 1
            self._data.clear()
            for item in rebuilt:
                self._data.append(item)
