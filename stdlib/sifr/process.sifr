class Stdio:
    mode: str

    def __init__(self, mode: str):
        self.mode = mode


PIPE: Stdio = Stdio("pipe")
INHERIT: Stdio = Stdio("inherit")
NULL: Stdio = Stdio("null")


class Status:
    code: int
    success: bool
    signal: int | None
    timed_out: bool
    cancelled: bool
    kind: str

    def __init__(self, code: int, kind: str):
        self.code = code
        self.success = code == 0
        self.signal = None
        self.timed_out = False
        self.cancelled = False
        self.kind = kind

    def exited(self) -> bool:
        return self.signal is None and not self.timed_out and not self.cancelled


class Output:
    stdout: bytes
    stderr: bytes
    status: Status

    def __init__(self, stdout: bytes, stderr: bytes, status: Status):
        self.stdout = stdout
        self.stderr = stderr
        self.status = status


class PipeReader:
    _handle: int
    _closed: bool

    def __init__(self, handle: int):
        self._handle = handle
        self._closed = False

    @blocking_io
    def read(self, max_bytes: int) -> Result[bytes, ProcessError]:
        if self._closed:
            raise ProcessError("process pipe reader is already closed")
        try:
            chunk: bytes = process_pipe_read(self._handle, max_bytes)
            if len(chunk) == 0:
                self._closed = True
            return chunk
        except ProcessError as e:
            raise e

    @blocking_io
    def read_all(self) -> Result[bytes, ProcessError]:
        if self._closed:
            raise ProcessError("process pipe reader is already closed")
        self._closed = True
        return process_pipe_read_all(self._handle)

    @blocking_io
    def close(self) -> Result[None, ProcessError]:
        if self._closed:
            raise ProcessError("process pipe reader is already closed")
        self._closed = True
        return process_pipe_reader_close(self._handle)


class PipeWriter:
    _handle: int
    _closed: bool

    def __init__(self, handle: int):
        self._handle = handle
        self._closed = False

    @blocking_io
    def write_all(self, data: bytes) -> Result[None, ProcessError]:
        if self._closed:
            raise ProcessError("process pipe writer is already closed")
        return process_pipe_write_all(self._handle, data)

    @blocking_io
    def close(self) -> Result[None, ProcessError]:
        if self._closed:
            raise ProcessError("process pipe writer is already closed")
        self._closed = True
        return process_pipe_close(self._handle)


class Child:
    _handle: int
    _waited: bool

    def __init__(self, handle: int):
        self._handle = handle
        self._waited = False

    @blocking_io
    def kill(self) -> Result[None, ProcessError]:
        return process_kill(self._handle)

    @blocking_io
    def terminate(self) -> Result[None, ProcessError]:
        return process_terminate(self._handle)

    @blocking_io
    def wait(self) -> Result[Status, ProcessError]:
        if self._waited:
            raise ProcessError("process child has already been waited")
        self._waited = True
        try:
            parts: list[int] = process_wait(self._handle)
            return _status_from_parts(parts)
        except ProcessError as e:
            raise e

    @blocking_io
    def stdout(self) -> Result[PipeReader, ProcessError]:
        try:
            handle: int = process_child_stdout(self._handle)
            return PipeReader(handle)
        except ProcessError as e:
            raise e

    @blocking_io
    def stderr(self) -> Result[PipeReader, ProcessError]:
        try:
            handle: int = process_child_stderr(self._handle)
            return PipeReader(handle)
        except ProcessError as e:
            raise e

    @blocking_io
    def stdin(self) -> Result[PipeWriter, ProcessError]:
        try:
            handle: int = process_child_stdin(self._handle)
            return PipeWriter(handle)
        except ProcessError as e:
            raise e


class AsyncChild:
    _handle: int

    def __init__(self, handle: int):
        self._handle = handle

    def kill(self) -> Awaitable[Result[None, ProcessError]]:
        return process_async_kill(self._handle)

    def terminate(self) -> Awaitable[Result[None, ProcessError]]:
        return process_async_terminate(self._handle)

    def wait(self) -> Awaitable[Result[Status, ProcessError]]:
        return process_async_wait(self._handle)

    def stdout(self) -> Result[AsyncPipeReader, ProcessError]:
        try:
            handle: int = process_async_child_stdout(self._handle)
            return AsyncPipeReader(handle)
        except ProcessError as e:
            raise e

    def stderr(self) -> Result[AsyncPipeReader, ProcessError]:
        try:
            handle: int = process_async_child_stderr(self._handle)
            return AsyncPipeReader(handle)
        except ProcessError as e:
            raise e

    def stdin(self) -> Result[AsyncPipeWriter, ProcessError]:
        try:
            handle: int = process_async_child_stdin(self._handle)
            return AsyncPipeWriter(handle)
        except ProcessError as e:
            raise e


class ProcessHandle:
    _handle: int

    def __init__(self, handle: int):
        self._handle = handle

    def kill(self) -> Awaitable[Result[None, ProcessError]]:
        return process_async_kill(self._handle)

    def terminate(self) -> Awaitable[Result[None, ProcessError]]:
        return process_async_terminate(self._handle)

    def wait(self) -> Awaitable[Result[Status, ProcessError]]:
        return process_handle_wait(self._handle)

    def stdout(self) -> Result[AsyncPipeReader, ProcessError]:
        try:
            handle: int = process_async_child_stdout(self._handle)
            return AsyncPipeReader(handle)
        except ProcessError as e:
            raise e

    def stderr(self) -> Result[AsyncPipeReader, ProcessError]:
        try:
            handle: int = process_async_child_stderr(self._handle)
            return AsyncPipeReader(handle)
        except ProcessError as e:
            raise e

    def stdin(self) -> Result[AsyncPipeWriter, ProcessError]:
        try:
            handle: int = process_async_child_stdin(self._handle)
            return AsyncPipeWriter(handle)
        except ProcessError as e:
            raise e


class AsyncPipeReader:
    _handle: int

    def __init__(self, handle: int):
        self._handle = handle

    def read_all(self) -> Awaitable[Result[bytes, ProcessError]]:
        return process_async_pipe_read_all(self._handle)

    def read(self, max_bytes: int) -> Awaitable[Result[bytes, ProcessError]]:
        return process_async_pipe_read(self._handle, max_bytes)

    def close(self) -> Result[None, ProcessError]:
        return process_async_pipe_reader_close(self._handle)


class AsyncPipeWriter:
    _handle: int

    def __init__(self, handle: int):
        self._handle = handle

    def write_all(self, data: bytes) -> Awaitable[Result[None, ProcessError]]:
        return process_async_pipe_write_all(self._handle, data)

    def close(self) -> Result[None, ProcessError]:
        return process_async_pipe_close(self._handle)


class TextOutput:
    stdout: str
    stderr: str
    status: Status
    encoding: str

    def __init__(self, stdout: str, stderr: str, status: Status, encoding: str):
        self.stdout = stdout
        self.stderr = stderr
        self.status = status
        self.encoding = encoding


class Command:
    program: str
    arguments: list[str]
    env_vars: list[str]
    working_dir: str
    has_working_dir: bool
    stdin_data: bytes
    has_stdin_data: bool
    stdin_mode: str
    stdout_mode: str
    stderr_mode: str

    def __init__(self, program: str):
        self.program = program
        self.arguments = []
        self.env_vars = []
        self.working_dir = ""
        self.has_working_dir = False
        self.stdin_data = b""
        self.has_stdin_data = False
        self.stdin_mode = "inherit"
        self.stdout_mode = "inherit"
        self.stderr_mode = "inherit"

    def arg(self, value: str) -> None:
        self.arguments.append(value)

    def args(self, values: list[str]) -> None:
        for value in values:
            self.arguments.append(value)

    def set_env(self, key: str, value: str) -> None:
        self.env_vars.append(key + "=" + value)

    def cwd(self, path: str) -> None:
        self.working_dir = path + ""
        self.has_working_dir = True

    def stdin_bytes(self, data: bytes) -> None:
        self.stdin_data = self.stdin_data + data
        self.has_stdin_data = True

    def stdin(self, mode: Stdio) -> None:
        self.stdin_mode = mode.mode + ""

    def stdout(self, mode: Stdio) -> None:
        self.stdout_mode = mode.mode + ""

    def stderr(self, mode: Stdio) -> None:
        self.stderr_mode = mode.mode + ""


def _status(code: int) -> Status:
    if code == 0:
        return Status(code, "success")
    return Status(code, "nonzero")


def _status_from_exit(exit_status: tuple[int, int | None]) -> Status:
    return _status_from_fields(exit_status[0], exit_status[1], False)


def _status_from_parts(parts: list[int], timed_out: bool = False) -> Status:
    if len(parts) < 3:
        return _status_from_fields(-1, None, timed_out)
    signal: int | None = None
    if parts[2] != 0:
        signal = parts[1]
    return _status_from_fields(parts[0], signal, timed_out)


def _status_from_fields(code: int, signal: int | None, timed_out: bool) -> Status:
    if timed_out:
        timeout_status: Status = Status(code, "timeout")
        timeout_status.success = False
        timeout_status.timed_out = True
        return timeout_status
    if signal is not None:
        status: Status = Status(code, "signal")
        status.success = False
        observed_signal: int | None = signal
        status.signal = observed_signal
        return status
    return _status(code)


def _status_from_output_handle(handle: str) -> Result[Status, ProcessError]:
    try:
        parts: list[int] = process_output_status(handle)
        return _status_from_parts(parts, process_output_timed_out(handle))
    except ProcessError as e:
        raise e


@blocking_io
def spawn(command: Command) -> Result[Child, ProcessError]:
    if command.has_stdin_data:
        raise ProcessError("process spawn does not consume Command.stdin_bytes; use stdin(Stdio(\"pipe\")) and Child.stdin()")
    try:
        handle: int = process_spawn(
            command.program,
            command.arguments,
            command.env_vars,
            command.working_dir,
            command.has_working_dir,
            command.stdin_mode,
            command.stdout_mode,
            command.stderr_mode,
        )
        return Child(handle)
    except ProcessError as e:
        raise e


@blocking_io
def kill(child: Child) -> Result[None, ProcessError]:
    return process_kill(child._handle)


@blocking_io
def terminate(child: Child) -> Result[None, ProcessError]:
    return process_terminate(child._handle)


@blocking_io
def wait(child: Child) -> Result[Status, ProcessError]:
    try:
        parts: list[int] = process_wait(child._handle)
        return _status_from_parts(parts)
    except ProcessError as e:
        raise e


@blocking_io
def run(command: Command) -> Result[Status, ProcessError]:
    try:
        parts: list[int] = process_run(
            command.program,
            command.arguments,
            command.env_vars,
            command.working_dir,
            command.has_working_dir,
        )
        return _status_from_parts(parts)
    except ProcessError as e:
        raise e


@blocking_io
def run_timeout(command: Command, seconds: float) -> Result[Status, ProcessError]:
    try:
        handle: str = process_output_timeout(
            command.program,
            command.arguments,
            command.env_vars,
            command.working_dir,
            command.has_working_dir,
            command.stdin_data,
            command.has_stdin_data,
            seconds,
        )
        status: Status = _status_from_output_handle(handle)
        process_output_close(handle)
        return status
    except ProcessError as e:
        raise e


@blocking_io
def output(command: Command) -> Result[Output, ProcessError]:
    try:
        handle: str = process_output(
            command.program,
            command.arguments,
            command.env_vars,
            command.working_dir,
            command.has_working_dir,
            command.stdin_data,
            command.has_stdin_data,
        )
        stdout: bytes = process_output_stdout(handle)
        stderr: bytes = process_output_stderr(handle)
        status: Status = _status_from_output_handle(handle)
        process_output_close(handle)
        return Output(stdout, stderr, status)
    except ProcessError as e:
        raise e


@blocking_io
def output_timeout(command: Command, seconds: float) -> Result[Output, ProcessError]:
    try:
        handle: str = process_output_timeout(
            command.program,
            command.arguments,
            command.env_vars,
            command.working_dir,
            command.has_working_dir,
            command.stdin_data,
            command.has_stdin_data,
            seconds,
        )
        stdout: bytes = process_output_stdout(handle)
        stderr: bytes = process_output_stderr(handle)
        status: Status = _status_from_output_handle(handle)
        process_output_close(handle)
        return Output(stdout, stderr, status)
    except ProcessError as e:
        raise e


@blocking_io
def output_text(command: Command, encoding: str = "utf-8") -> Result[TextOutput, ProcessError]:
    try:
        handle: str = process_output_text(
            command.program,
            command.arguments,
            command.env_vars,
            command.working_dir,
            command.has_working_dir,
            command.stdin_data,
            command.has_stdin_data,
            encoding,
        )
        stdout: str = process_output_stdout_text(handle)
        stderr: str = process_output_stderr_text(handle)
        status: Status = _status_from_output_handle(handle)
        process_output_close(handle)
        return TextOutput(stdout, stderr, status, encoding)
    except ProcessError as e:
        raise e


def async_run(own command: Command) -> Awaitable[Result[Status, ProcessError]]:
    return process_async_run(
        command.program,
        command.arguments,
        command.env_vars,
        command.working_dir,
        command.has_working_dir,
        command.stdin_mode,
    )


def async_run_timeout(own command: Command, seconds: float) -> Awaitable[Result[Status, ProcessError]]:
    return process_async_run_timeout(
        command.program,
        command.arguments,
        command.env_vars,
        command.working_dir,
        command.has_working_dir,
        command.stdin_mode,
        seconds,
    )


def async_spawn(own command: Command) -> Awaitable[Result[AsyncChild, ProcessError]]:
    return process_async_spawn(
        command.program,
        command.arguments,
        command.env_vars,
        command.working_dir,
        command.has_working_dir,
        command.stdin_mode,
        command.stdout_mode,
        command.stderr_mode,
        command.has_stdin_data,
    )


def async_wait(own child: AsyncChild) -> Awaitable[Result[Status, ProcessError]]:
    return process_async_wait(child._handle)


def async_kill(child: AsyncChild) -> Awaitable[Result[None, ProcessError]]:
    return process_async_kill(child._handle)


def async_terminate(child: AsyncChild) -> Awaitable[Result[None, ProcessError]]:
    return process_async_terminate(child._handle)


def async_output(own command: Command) -> Awaitable[Result[Output, ProcessError]]:
    return process_async_output(
        command.program,
        command.arguments,
        command.env_vars,
        command.working_dir,
        command.has_working_dir,
        command.stdin_mode,
        command.stdin_data,
        command.has_stdin_data,
    )


def async_output_timeout(own command: Command, seconds: float) -> Awaitable[Result[Output, ProcessError]]:
    return process_async_output_timeout(
        command.program,
        command.arguments,
        command.env_vars,
        command.working_dir,
        command.has_working_dir,
        command.stdin_mode,
        command.stdin_data,
        command.has_stdin_data,
        seconds,
    )


def async_run_shell(script: str) -> Awaitable[Result[Status, ProcessError]]:
    return process_async_shell_run(script)


def async_output_shell(script: str, stdin: bytes | None = None) -> Awaitable[Result[Output, ProcessError]]:
    if stdin is None:
        return process_async_shell_output(script, b"", False)
    return process_async_shell_output(script, stdin, True)


def async_output_shell_timeout(
    script: str,
    seconds: float,
    stdin: bytes | None = None,
) -> Awaitable[Result[Output, ProcessError]]:
    if stdin is None:
        return process_async_shell_output_timeout(script, b"", False, seconds)
    return process_async_shell_output_timeout(script, stdin, True, seconds)


@blocking_io
@shell_exec
def run_shell(script: str) -> Result[Status, ProcessError]:
    try:
        parts: list[int] = process_shell_run(script)
        return _status_from_parts(parts)
    except ProcessError as e:
        raise e


@blocking_io
@shell_exec
def output_shell(script: str, stdin: bytes | None = None) -> Result[Output, ProcessError]:
    try:
        if stdin is None:
            handle: str = process_shell_output(script, b"", False)
            stdout: bytes = process_output_stdout(handle)
            stderr: bytes = process_output_stderr(handle)
            status: Status = _status_from_output_handle(handle)
            process_output_close(handle)
            return Output(stdout, stderr, status)
        handle: str = process_shell_output(script, stdin, True)
        stdout: bytes = process_output_stdout(handle)
        stderr: bytes = process_output_stderr(handle)
        status: Status = _status_from_output_handle(handle)
        process_output_close(handle)
        return Output(stdout, stderr, status)
    except ProcessError as e:
        raise e


@blocking_io
@shell_exec
def output_shell_timeout(
    script: str,
    seconds: float,
    stdin: bytes | None = None,
) -> Result[Output, ProcessError]:
    try:
        if stdin is None:
            handle: str = process_shell_output_timeout(
                script,
                b"",
                False,
                seconds,
            )
            stdout: bytes = process_output_stdout(handle)
            stderr: bytes = process_output_stderr(handle)
            status: Status = _status_from_output_handle(handle)
            process_output_close(handle)
            return Output(stdout, stderr, status)
        handle: str = process_shell_output_timeout(
            script,
            stdin,
            True,
            seconds,
        )
        stdout: bytes = process_output_stdout(handle)
        stderr: bytes = process_output_stderr(handle)
        status: Status = _status_from_output_handle(handle)
        process_output_close(handle)
        return Output(stdout, stderr, status)
    except ProcessError as e:
        raise e


@blocking_io
@shell_exec
def output_shell_text(
    script: str,
    stdin: bytes | None = None,
    encoding: str = "utf-8",
) -> Result[TextOutput, ProcessError]:
    try:
        if stdin is None:
            handle: str = process_shell_output_text(script, b"", False, encoding)
            stdout: str = process_output_stdout_text(handle)
            stderr: str = process_output_stderr_text(handle)
            status: Status = _status_from_output_handle(handle)
            process_output_close(handle)
            return TextOutput(stdout, stderr, status, encoding)
        handle: str = process_shell_output_text(script, stdin, True, encoding)
        stdout: str = process_output_stdout_text(handle)
        stderr: str = process_output_stderr_text(handle)
        status: Status = _status_from_output_handle(handle)
        process_output_close(handle)
        return TextOutput(stdout, stderr, status, encoding)
    except ProcessError as e:
        raise e
