# sifr.net — Async TCP networking substrate
from _sifr.net import (
    NetError,
    net_connect_tcp,
    net_listener_accept,
    net_listener_close,
    net_listener_local_addr,
    net_listen_tcp,
    net_lookup_host,
    net_tcp_read_half_close,
    net_tcp_read_half_read_chunk,
    net_tcp_stream_close,
    net_tcp_stream_local_addr,
    net_tcp_stream_peer_addr,
    net_tcp_stream_read_chunk,
    net_tcp_stream_shutdown_write,
    net_tcp_stream_split,
    net_tcp_stream_write,
    net_tcp_stream_write_all,
    net_tcp_write_half_close,
    net_tcp_write_half_shutdown_write,
    net_tcp_write_half_write,
    net_tcp_write_half_write_all,
)


class SocketAddr:
    value: str

    def __init__(self, value: str):
        self.value = value


class TcpStream:
    _handle: int
    _closed: bool

    def __init__(self, handle: int):
        self._handle = handle
        self._closed = False

    async def read_chunk(self, max_bytes: int) -> Result[bytes | None, NetError]:
        try:
            return await net_tcp_stream_read_chunk(self._handle, max_bytes)
        except NetError as e:
            raise e

    async def write(self, data: bytes) -> Result[int, NetError]:
        try:
            return await net_tcp_stream_write(self._handle, data)
        except NetError as e:
            raise e

    async def write_all(self, data: bytes) -> Result[None, NetError]:
        try:
            return await net_tcp_stream_write_all(self._handle, data)
        except NetError as e:
            raise e

    async def shutdown_write(self) -> Result[None, NetError]:
        try:
            return await net_tcp_stream_shutdown_write(self._handle)
        except NetError as e:
            raise e

    async def close(own self) -> Result[None, NetError]:
        self._closed = True
        try:
            return await net_tcp_stream_close(self._handle)
        except NetError as e:
            raise e

    def split(own self) -> Result[tuple[TcpReadHalf, TcpWriteHalf], NetError]:
        self._closed = True
        try:
            handles: list[int] = net_tcp_stream_split(self._handle)
            if len(handles) != 2:
                raise NetError("TCP stream split returned invalid handles")
            read: int | None = handles[0]
            write: int | None = handles[1]
            if read is None:
                raise NetError("TCP stream split returned invalid read handle")
            if write is None:
                raise NetError("TCP stream split returned invalid write handle")
            return (TcpReadHalf(read), TcpWriteHalf(write))
        except NetError as e:
            raise e

    def local_addr(self) -> Result[SocketAddr, NetError]:
        try:
            value: str = net_tcp_stream_local_addr(self._handle)
            return SocketAddr(value)
        except NetError as e:
            raise e

    def remote_addr(self) -> Result[SocketAddr, NetError]:
        try:
            value: str = net_tcp_stream_peer_addr(self._handle)
            return SocketAddr(value)
        except NetError as e:
            raise e


class TcpReadHalf:
    _handle: int
    _closed: bool

    def __init__(self, handle: int):
        self._handle = handle
        self._closed = False

    async def read_chunk(self, max_bytes: int) -> Result[bytes | None, NetError]:
        try:
            return await net_tcp_read_half_read_chunk(self._handle, max_bytes)
        except NetError as e:
            raise e

    def close(self) -> Result[None, NetError]:
        if self._closed:
            raise NetError("TCP read half is already closed")
        self._closed = True
        return net_tcp_read_half_close(self._handle)


class TcpWriteHalf:
    _handle: int
    _closed: bool

    def __init__(self, handle: int):
        self._handle = handle
        self._closed = False

    async def write(self, data: bytes) -> Result[int, NetError]:
        try:
            return await net_tcp_write_half_write(self._handle, data)
        except NetError as e:
            raise e

    async def write_all(self, data: bytes) -> Result[None, NetError]:
        try:
            return await net_tcp_write_half_write_all(self._handle, data)
        except NetError as e:
            raise e

    async def shutdown_write(self) -> Result[None, NetError]:
        try:
            return await net_tcp_write_half_shutdown_write(self._handle)
        except NetError as e:
            raise e

    def close(self) -> Result[None, NetError]:
        if self._closed:
            raise NetError("TCP write half is already closed")
        self._closed = True
        return net_tcp_write_half_close(self._handle)


class TcpListener:
    _handle: int
    _closed: bool

    def __init__(self, handle: int):
        self._handle = handle
        self._closed = False

    async def accept(self) -> Result[tuple[TcpStream, SocketAddr], NetError]:
        try:
            return await _accept_tcp_listener(self._handle)
        except NetError as e:
            raise e

    def local_addr(self) -> Result[SocketAddr, NetError]:
        try:
            value: str = net_listener_local_addr(self._handle)
            return SocketAddr(value)
        except NetError as e:
            raise e

    def close(self) -> Result[None, NetError]:
        if self._closed:
            raise NetError("TCP listener is already closed")
        self._closed = True
        return net_listener_close(self._handle)


async def connect_tcp(
    address: str,
    timeout: float | None = None,
    local_addr: str | None = None,
) -> Result[TcpStream, NetError]:
    if timeout is None:
        if local_addr is None:
            return await _connect_tcp(address, 0.0, False, "", False)
        return await _connect_tcp(address, 0.0, False, local_addr, True)
    if local_addr is None:
        return await _connect_tcp(address, timeout, True, "", False)
    return await _connect_tcp(address, timeout, True, local_addr, True)


async def listen_tcp(
    address: str,
    backlog: int | None = None,
    reuse_addr: bool = False,
) -> Result[TcpListener, NetError]:
    if backlog is None:
        return await _listen_tcp(address, 0, False, reuse_addr)
    return await _listen_tcp(address, backlog, True, reuse_addr)


async def resolve_host(
    address: str,
    timeout: float | None = None,
) -> Result[list[SocketAddr], NetError]:
    if timeout is None:
        return await _resolve_host(address, 0.0, False)
    return await _resolve_host(address, timeout, True)


async def _connect_tcp(
    address: str,
    timeout_seconds: float,
    has_timeout: bool,
    local_addr: str,
    has_local_addr: bool,
) -> Result[TcpStream, NetError]:
    return await _wrap_connect_tcp(address, timeout_seconds, has_timeout, local_addr, has_local_addr)


async def _listen_tcp(
    address: str,
    backlog: int,
    has_backlog: bool,
    reuse_addr: bool,
) -> Result[TcpListener, NetError]:
    return await _wrap_listen_tcp(address, backlog, has_backlog, reuse_addr)


async def _accept_tcp_listener(handle: int) -> Result[tuple[TcpStream, SocketAddr], NetError]:
    return await _wrap_accept_tcp(handle)


async def _resolve_host(
    address: str,
    timeout_seconds: float,
    has_timeout: bool,
) -> Result[list[SocketAddr], NetError]:
    return await _wrap_resolve_host(address, timeout_seconds, has_timeout)


async def _wrap_connect_tcp(
    address: str,
    timeout_seconds: float,
    has_timeout: bool,
    local_addr: str,
    has_local_addr: bool,
) -> Result[TcpStream, NetError]:
    try:
        handle: int = await net_connect_tcp(
            address,
            timeout_seconds,
            has_timeout,
            local_addr,
            has_local_addr,
        )
        return TcpStream(handle)
    except NetError as e:
        raise e


async def _wrap_listen_tcp(
    address: str,
    backlog: int,
    has_backlog: bool,
    reuse_addr: bool,
) -> Result[TcpListener, NetError]:
    try:
        handle: int = await net_listen_tcp(address, backlog, has_backlog, reuse_addr)
        return TcpListener(handle)
    except NetError as e:
        raise e


async def _wrap_accept_tcp(handle: int) -> Result[tuple[TcpStream, SocketAddr], NetError]:
    try:
        stream_handle: int = await net_listener_accept(handle)
        address: str = net_tcp_stream_peer_addr(stream_handle)
        return (TcpStream(stream_handle), SocketAddr(address))
    except NetError as e:
        raise e


async def _wrap_resolve_host(
    address: str,
    timeout_seconds: float,
    has_timeout: bool,
) -> Result[list[SocketAddr], NetError]:
    try:
        values: list[str] = await net_lookup_host(address, timeout_seconds, has_timeout)
        addrs: list[SocketAddr] = []
        for value in values:
            addrs.append(SocketAddr(value))
        return addrs
    except NetError as e:
        raise e
