def case_fold(text: str) -> str:
    return _unicode_case_fold_impl(text)


def graphemes(text: str) -> list[str]:
    return _unicode_graphemes_impl(text)


def grapheme_indices(text: str) -> list[tuple[int, str]]:
    flat: list[str] = _unicode_grapheme_indices_flat_impl(text)
    pairs: list[tuple[int, str]] = []
    i: int = 0
    while i < len(flat):
        pairs.append((_trusted_int(_flat_part(flat, i)), _flat_part(flat, i + 1)))
        i = i + 2
    return pairs


def words(text: str) -> list[str]:
    return _unicode_words_impl(text)


def word_boundaries(text: str) -> list[tuple[int, int, str]]:
    flat: list[str] = _unicode_word_boundaries_flat_impl(text)
    boundaries: list[tuple[int, int, str]] = []
    i: int = 0
    while i < len(flat):
        boundaries.append((_trusted_int(_flat_part(flat, i)), _trusted_int(_flat_part(flat, i + 1)), _flat_part(flat, i + 2)))
        i = i + 3
    return boundaries
