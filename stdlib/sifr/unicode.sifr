# sifr.unicode — Unicode normalization, data, and case mapping
from _sifr.unicode import (
    _unicode_bidirectional_impl,
    _unicode_case_fold_impl,
    _unicode_category_impl,
    _unicode_combining_impl,
    _unicode_data_version_impl,
    _unicode_decimal_impl,
    _unicode_decomposition_impl,
    _unicode_digit_impl,
    _unicode_east_asian_width_impl,
    _unicode_grapheme_indices_flat_impl,
    _unicode_graphemes_impl,
    _unicode_is_normalized_impl,
    _unicode_lookup_impl,
    _unicode_mirrored_impl,
    _unicode_name_impl,
    _unicode_normalize_impl,
    _unicode_numeric_value_impl,
    _unicode_word_boundaries_flat_impl,
    _unicode_words_impl,
)

NFC: str = "NFC"
NFD: str = "NFD"
NFKC: str = "NFKC"
NFKD: str = "NFKD"


class UnicodeDataError(Error):
    message: str


def _trusted_int(value: str) -> int:
    try:
        parsed: int = int(value)
        return parsed
    except ParseError:
        return 0


def _flat_part(flat: list[str], index: int) -> str:
    value: str | None = flat[index]
    if value is not None:
        return value + ""
    return ""


def data_version() -> str:
    return _unicode_data_version_impl()


def normalize(form: str, text: str) -> Result[str, UnicodeDataError]:
    try:
        normalized: str = _unicode_normalize_impl(form, text)
        return normalized
    except ParseError as e:
        raise UnicodeDataError(e.message)


def is_normalized(form: str, text: str) -> Result[bool, UnicodeDataError]:
    try:
        normalized: bool = _unicode_is_normalized_impl(form, text)
        return normalized
    except ParseError as e:
        raise UnicodeDataError(e.message)


def name(ch: str) -> Result[str, UnicodeDataError]:
    try:
        value: str = _unicode_name_impl(ch)
        return value
    except ParseError as e:
        raise UnicodeDataError(e.message)


def lookup(character_name: str) -> Result[str, UnicodeDataError]:
    try:
        value: str = _unicode_lookup_impl(character_name)
        return value
    except ParseError as e:
        raise UnicodeDataError(e.message)


