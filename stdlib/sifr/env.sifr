# sifr.env — Environment variable access
# This module provides a small CPython-style environment surface.
from _sifr.sys import env_get as _getenv_opt_impl, env_set as _setenv_impl, env_unset as _unsetenv_impl, env_keys as _keys_impl, env_values as _values_impl, env_items as _items_impl

def getenv_opt(key: str) -> str | None:
    return _getenv_opt_impl(key)

def getenv(key: str, default_value: str) -> str:
    val: str | None = _getenv_opt_impl(key)
    if val is None:
        return default_value + ""
    return val

def setenv(key: str, value: str) -> None:
    _setenv_impl(key, value)

def unsetenv(key: str) -> None:
    _unsetenv_impl(key)

def keys() -> list[str]:
    return _keys_impl()

def values() -> list[str]:
    return _values_impl()

def items() -> list[str]:
    return _items_impl()
