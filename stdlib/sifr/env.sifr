# sifr.env — Environment variable access
# This module provides a small CPython-style environment surface.
from _sifr.sys import env_get, env_set, env_unset, env_keys, env_values, env_items

def getenv_opt(key: str) -> str | None:
    return env_get(key)

def getenv(key: str, default_value: str) -> str:
    val: str | None = env_get(key)
    if val is None:
        return default_value + ""
    return val

def setenv(key: str, value: str) -> None:
    env_set(key, value)

def unsetenv(key: str) -> None:
    env_unset(key)

def keys() -> list[str]:
    return env_keys()

def values() -> list[str]:
    return env_values()

def items() -> list[str]:
    return env_items()
