from _sifr.toml import toml_parse_tokens
from sifr.io import FileHandle, read_text


class TomlValue:
    kind: str
    bool_value: bool | None
    int_value: int | None
    float_value: float | None
    str_value: str | None
    datetime_value: str | None
    array_items: list[TomlValue]
    table_items: list[tuple[str, TomlValue]]

    def __init__(
        self,
        kind: str,
        bool_value: bool | None = None,
        int_value: int | None = None,
        float_value: float | None = None,
        str_value: str | None = None,
        datetime_value: str | None = None,
    ):
        self.kind = kind
        self.bool_value = bool_value
        self.int_value = int_value
        self.float_value = float_value
        self.str_value = str_value
        self.datetime_value = datetime_value
        self.array_items = []
        self.table_items = []

    def is_bool(self) -> bool:
        return self.kind == "bool"

    def is_int(self) -> bool:
        return self.kind == "int"

    def is_float(self) -> bool:
        return self.kind == "float"

    def is_str(self) -> bool:
        return self.kind == "str"

    def is_datetime(self) -> bool:
        return self.kind == "datetime"

    def is_array(self) -> bool:
        return self.kind == "array"

    def is_table(self) -> bool:
        return self.kind == "table"

    def as_bool(self) -> bool | None:
        return self.bool_value

    def as_int(self) -> int | None:
        return self.int_value

    def as_float(self) -> float | None:
        return self.float_value

    def as_str(self) -> str | None:
        return self.str_value

    def as_datetime(self) -> str | None:
        return self.datetime_value

    def as_array(self) -> list[TomlValue] | None:
        if not self.is_array():
            return None
        result: list[TomlValue] = []
        for item in self.array_items:
            result.append(item)
        return result

    def as_table(self) -> list[tuple[str, TomlValue]] | None:
        if not self.is_table():
            return None
        result: list[tuple[str, TomlValue]] = []
        for key, value in self.table_items:
            result.append((key, value))
        return result

    def at(self, index: int) -> TomlValue | None:
        if not self.is_array():
            return None
        if index < 0 or index >= len(self.array_items):
            return None
        value: TomlValue | None = self.array_items[index]
        return value

    def get(self, key: str) -> TomlValue | None:
        if not self.is_table():
            return None
        for item_key, item_value in self.table_items:
            if item_key == key:
                return item_value
        return None

    def keys(self) -> list[str]:
        result: list[str] = []
        if not self.is_table():
            return result
        for item_key, _item_value in self.table_items:
            result.append(item_key)
        return result

    def values(self) -> list[TomlValue]:
        result: list[TomlValue] = []
        if not self.is_table():
            return result
        for _item_key, item_value in self.table_items:
            result.append(item_value)
        return result

    def items(self) -> list[tuple[str, TomlValue]]:
        if not self.is_table():
            return []
        result: list[tuple[str, TomlValue]] = []
        for key, value in self.table_items:
            result.append((key, value))
        return result


def _token_at(tokens: list[str], index: int) -> Result[str, TOMLDecodeError]:
    value: str | None = tokens[index]
    if value is None:
        raise TOMLDecodeError("TOML bridge payload ended unexpectedly")
    return value + ""


def _token_int(tokens: list[str], index: int) -> Result[int, TOMLDecodeError]:
    try:
        token: str = _token_at(tokens, index)
        parsed: int = int(token)
        return parsed
    except ParseError:
        raise TOMLDecodeError("TOML bridge payload has invalid integer metadata")
    except TOMLDecodeError as e:
        raise TOMLDecodeError(e.message)


def _token_float(tokens: list[str], index: int) -> Result[float, TOMLDecodeError]:
    try:
        token: str = _token_at(tokens, index)
        parsed: float = float(token)
        return parsed
    except ParseError:
        raise TOMLDecodeError("TOML bridge payload has invalid float metadata")
    except TOMLDecodeError as e:
        raise TOMLDecodeError(e.message)


def _decode_bool_token(value: str) -> Result[bool, TOMLDecodeError]:
    if value == "true":
        return True
    if value == "false":
        return False
    raise TOMLDecodeError("TOML bridge payload has invalid bool metadata")


def _decode_toml_value_at(
    tokens: list[str],
    index: int,
) -> Result[tuple[TomlValue, int], TOMLDecodeError]:
    try:
        tag: str = _token_at(tokens, index)
        payload_index: int = index + 1
        if tag == "bool":
            bool_token: str = _token_at(tokens, payload_index)
            bool_value: bool = _decode_bool_token(bool_token)
            return (TomlValue("bool", bool_value=bool_value), payload_index + 1)
        if tag == "int":
            int_value: int = _token_int(tokens, payload_index)
            return (TomlValue("int", int_value=int_value), payload_index + 1)
        if tag == "float":
            float_value: float = _token_float(tokens, payload_index)
            return (TomlValue("float", float_value=float_value), payload_index + 1)
        if tag == "str":
            str_value: str = _token_at(tokens, payload_index)
            return (TomlValue("str", str_value=str_value), payload_index + 1)
        if tag == "datetime":
            datetime_value: str = _token_at(tokens, payload_index)
            return (TomlValue("datetime", datetime_value=datetime_value), payload_index + 1)
        if tag == "array":
            array_count: int = _token_int(tokens, payload_index)
            if array_count < 0:
                raise TOMLDecodeError("TOML bridge payload has invalid array length")
            array_value: TomlValue = TomlValue("array")
            next_index: int = payload_index + 1
            consumed: int = 0
            while consumed < array_count:
                item_result: tuple[TomlValue, int] = _decode_toml_value_at(tokens, next_index)
                array_value.array_items.append(item_result[0])
                next_index = item_result[1]
                consumed = consumed + 1
            return (array_value, next_index)
        if tag == "table":
            table_count: int = _token_int(tokens, payload_index)
            if table_count < 0:
                raise TOMLDecodeError("TOML bridge payload has invalid table length")
            table_value: TomlValue = TomlValue("table")
            next_index: int = payload_index + 1
            consumed: int = 0
            while consumed < table_count:
                key: str = _token_at(tokens, next_index)
                item_result: tuple[TomlValue, int] = _decode_toml_value_at(tokens, next_index + 1)
                table_value.table_items.append((key, item_result[0]))
                next_index = item_result[1]
                consumed = consumed + 1
            return (table_value, next_index)
        raise TOMLDecodeError("TOML bridge payload has unknown value tag: " + tag)
    except TOMLDecodeError as e:
        raise TOMLDecodeError(e.message)


def _decode_toml_tokens(tokens: list[str]) -> Result[TomlValue, TOMLDecodeError]:
    try:
        decoded: tuple[TomlValue, int] = _decode_toml_value_at(tokens, 0)
        if decoded[1] != len(tokens):
            raise TOMLDecodeError("TOML bridge payload has trailing data")
        return decoded[0]
    except TOMLDecodeError as e:
        raise TOMLDecodeError(e.message)


def loads(text: str) -> Result[TomlValue, TOMLDecodeError]:
    try:
        tokens: list[str] = toml_parse_tokens(text)
        return _decode_toml_tokens(tokens)
    except ParseError as e:
        raise TOMLDecodeError(e.message)


def _decode_loaded_toml(content: str) -> Result[TomlValue, Error]:
    try:
        value: TomlValue = loads(content)
        return value
    except TOMLDecodeError as e:
        raise Error(e.message)


def load_handle(fh: FileHandle) -> Result[TomlValue, Error]:
    content_result: Result[str, IOError] = fh.read()
    try:
        content: str = content_result
        return _decode_loaded_toml(content)
    except IOError as e:
        raise Error(e.message)


def load(path: str) -> Result[TomlValue, Error]:
    content_result: Result[str, IOError] = read_text(path)
    try:
        content: str = content_result
        return _decode_loaded_toml(content)
    except IOError as e:
        raise Error(e.message)
