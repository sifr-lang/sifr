@blocking_io
def copy_record_fields(obj: Object, fields: list[str]) -> Result[list[tuple[str, Object]], PythonError]:
    try:
        raw: list[Object] = py_copy_record_fields(obj, fields)
        values: list[tuple[str, Object]] = []
        index: int = 0
        while index < len(fields) and index < len(raw):
            values.append((fields[index], raw[index]))
            index += 1
        return values
    except PythonError as e:
        raise e


