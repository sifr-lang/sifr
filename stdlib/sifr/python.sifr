@blocking_io
def zero_copy_dlpack_tensor(obj: Object) -> Result[DlpackTensor, PythonError]:
    try:
        raw: tuple[ResourceIdentity, int, int, int, str, int, int, int, int, bool, bool] = py_dlpack_tensor(
            obj,
