class BufferView(NonSend):
    _identity: ResourceIdentity
    length: int
    item_size: int
    readonly: bool
    dimensions: int
    shape: list[int]
    strides: list[int]
    suboffsets: list[int]
    c_contiguous: bool
    f_contiguous: bool
    format: str


class ArrowCapsule(NonSend):
    _identity: ResourceIdentity
    kind: str
    capsule_names: list[str]
    producer_module: str
    producer_type: str
    copy_possible: bool


class DlpackTensor(NonSend):
    _identity: ResourceIdentity
    dtype_code: int
    dtype_bits: int
    dtype_lanes: int
    dtype: str
    device_type: int
    device_id: int
    dimensions: int
    shape: list[int]
    strides: list[int]
    byte_offset: int
    has_deleter: bool
    stream_sync_required: bool


def _buffer_from_raw(own raw: tuple[ResourceIdentity, int, int, bool, int, bool, bool, str]) -> Result[BufferView, PythonError]:
    try:
        shape: list[int] = py_buffer_shape(raw[0])
        strides: list[int] = py_buffer_strides(raw[0])
        suboffsets: list[int] = py_buffer_suboffsets(raw[0])
        return BufferView(raw[0], raw[1], raw[2], raw[3], raw[4], shape, strides, suboffsets, raw[5], raw[6], raw[7])
    except PythonError as e:
        raise e

def _arrow_from_raw(own raw: tuple[ResourceIdentity, str, str, str, bool]) -> Result[ArrowCapsule, PythonError]:
    try:
        capsule_names: list[str] = py_arrow_capsule_names(raw[0])
        return ArrowCapsule(raw[0], raw[1], capsule_names, raw[2], raw[3], raw[4])
    except PythonError as e:
        raise e


def _dlpack_from_raw(own raw: tuple[ResourceIdentity, int, int, int, str, int, int, int, int, bool, bool]) -> Result[DlpackTensor, PythonError]:
    try:
        shape: list[int] = py_dlpack_shape(raw[0])
        strides: list[int] = py_dlpack_strides(raw[0])
        return DlpackTensor(raw[0], raw[1], raw[2], raw[3], raw[4], raw[5], raw[6], raw[7], shape, strides, raw[8], raw[9], raw[10])
    except PythonError as e:
        raise e


def _keys_from_keyed_objects(values: list[tuple[str, Object]]) -> list[str]:
    keys: list[str] = []
    for value in values:
        keys.append(value[0])
    return keys


def _objects_from_keyed_objects(values: list[tuple[str, Object]]) -> list[Object]:
    objects: list[Object] = []
    for value in values:
        objects.append(value[1])
    return objects


@blocking_io
def import_module(name: str) -> Result[Object, PythonError]:
    try:
        raw: Object = py_import_module(name)
        return raw
    except PythonError as e:
        raise e


@blocking_io
def get_attr(obj: Object, name: str) -> Result[Object, PythonError]:
    try:
        raw: Object = py_get_attr(obj, name)
        return raw
    except PythonError as e:
        raise e


@blocking_io
def get_item(obj: Object, key: str) -> Result[Object, PythonError]:
    try:
        raw: Object = py_get_item_str(obj, key)
        return raw
    except PythonError as e:
        raise e


@blocking_io
def call(
    callable_obj: Object,
    own args: list[Object],
    own kwargs: list[tuple[str, Object]],
) -> Result[Object, PythonError]:
    try:
        kwargs_keys: list[str] = _keys_from_keyed_objects(kwargs)
        kwargs_values: list[Object] = _objects_from_keyed_objects(kwargs)
        raw: Object = py_call(
            callable_obj,
            args,
            kwargs_keys,
            kwargs_values,
        )
        return raw
    except PythonError as e:
        raise e


@blocking_io
def call_attr(
    obj: Object,
    name: str,
    own args: list[Object],
    own kwargs: list[tuple[str, Object]],
) -> Result[Object, PythonError]:
    try:
        kwargs_keys: list[str] = _keys_from_keyed_objects(kwargs)
        kwargs_values: list[Object] = _objects_from_keyed_objects(kwargs)
        raw: Object = py_call_attr(
            obj,
            name,
            args,
            kwargs_keys,
            kwargs_values,
        )
        return raw
    except PythonError as e:
        raise e


@blocking_io
def close(own obj: Object) -> Result[None, PythonError]:
    return py_close(obj)


@blocking_io
def zero_copy_as_u8(obj: Object) -> Result[BufferView, PythonError]:
    try:
        raw: tuple[ResourceIdentity, int, int, bool, int, bool, bool, str] = py_buffer_u8(
            obj,
            False,
        )
        return _buffer_from_raw(raw)
    except PythonError as e:
        raise e


@blocking_io
def zero_copy_as_writable_u8(obj: Object) -> Result[BufferView, PythonError]:
    try:
        raw: tuple[ResourceIdentity, int, int, bool, int, bool, bool, str] = py_buffer_u8(
            obj,
            True,
        )
        return _buffer_from_raw(raw)
    except PythonError as e:
        raise e


@blocking_io
def copy_buffer_bytes(view: BufferView) -> Result[bytes, PythonError]:
    return py_copy_buffer_u8(view._identity)


@blocking_io
def release_buffer(own view: BufferView) -> Result[None, PythonError]:
    return py_release_buffer(view._identity)


