# sifr.re — Regular expressions
from _sifr.regex import re_match as _re_match_impl
from _sifr.regex import re_find as _re_find_impl
from _sifr.regex import re_replace as _re_replace_impl
from _sifr.regex import re_findall as _re_findall_impl
from _sifr.regex import re_split as _re_split_impl
from _sifr.regex import re_find_start as _re_find_start_impl
from _sifr.regex import re_find_end as _re_find_end_impl
from _sifr.regex import re_match_flags as _re_match_flags_impl
from _sifr.regex import re_find_flags as _re_find_flags_impl
from _sifr.regex import re_replace_flags as _re_replace_flags_impl
from _sifr.regex import re_findall_flags as _re_findall_flags_impl
from _sifr.regex import re_split_flags as _re_split_flags_impl

# Flag constants (CPython-compatible values)
IGNORECASE: int = 2
MULTILINE: int = 8
DOTALL: int = 16
VERBOSE: int = 64

def re_match(pattern: str, text: str) -> Result[bool, RegexError]:
    return _re_match_impl(pattern, text)

def re_find(pattern: str, text: str) -> Result[str | None, RegexError]:
    return _re_find_impl(pattern, text)

def re_replace(pattern: str, replacement: str, text: str) -> Result[str, RegexError]:
    return _re_replace_impl(pattern, replacement, text)

def re_findall(pattern: str, text: str) -> Result[list[str], RegexError]:
    return _re_findall_impl(pattern, text)

def re_split(pattern: str, text: str) -> Result[list[str], RegexError]:
    return _re_split_impl(pattern, text)

def re_find_start(pattern: str, text: str) -> Result[int, RegexError]:
    return _re_find_start_impl(pattern, text)

def re_find_end(pattern: str, text: str) -> Result[int, RegexError]:
    return _re_find_end_impl(pattern, text)

def re_match_flags(pattern: str, text: str, flags: int) -> Result[bool, RegexError]:
    return _re_match_flags_impl(pattern, text, flags)

def re_find_flags(pattern: str, text: str, flags: int) -> Result[str | None, RegexError]:
    return _re_find_flags_impl(pattern, text, flags)

def re_replace_flags(pattern: str, replacement: str, text: str, flags: int) -> Result[str, RegexError]:
    return _re_replace_flags_impl(pattern, replacement, text, flags)

def re_findall_flags(pattern: str, text: str, flags: int) -> Result[list[str], RegexError]:
    return _re_findall_flags_impl(pattern, text, flags)

def re_split_flags(pattern: str, text: str, flags: int) -> Result[list[str], RegexError]:
    return _re_split_flags_impl(pattern, text, flags)

class Match:
    _matched: str
    _start: int
    _end: int

    def __init__(self, matched: str, start: int, end: int):
        self._matched = matched
        self._start = start
        self._end = end

    def group(self) -> str:
        return self._matched + ""

    def start(self) -> int:
        return self._start

    def end(self) -> int:
        return self._end

    def span(self) -> list[int]:
        result: list[int] = [self._start, self._end]
        return result

    def to_str(self) -> str:
        return self._matched + ""

# CPython-compatible aliases
# Note: match is skipped (Python keyword)
def search(pattern: str, text: str) -> Result[str | None, RegexError]:
    return re_find(pattern, text)

def search_flags(pattern: str, text: str, flags: int) -> Result[str | None, RegexError]:
    return re_find_flags(pattern, text, flags)

def search_match(pattern: str, text: str) -> Result[Match | None, RegexError]:
    try:
        found: str | None = re_find(pattern, text)
        if found is not None:
            s: int = re_find_start(pattern, text)
            e: int = re_find_end(pattern, text)
            return Match(found, s, e)
        return None
    except RegexError as e:
        raise RegexError(e.message)

def sub(pattern: str, replacement: str, text: str) -> Result[str, RegexError]:
    return re_replace(pattern, replacement, text)

def sub_flags(pattern: str, replacement: str, text: str, flags: int) -> Result[str, RegexError]:
    return re_replace_flags(pattern, replacement, text, flags)

def findall(pattern: str, text: str) -> Result[list[str], RegexError]:
    return re_findall(pattern, text)

def findall_flags(pattern: str, text: str, flags: int) -> Result[list[str], RegexError]:
    return re_findall_flags(pattern, text, flags)

def split(pattern: str, text: str) -> Result[list[str], RegexError]:
    return re_split(pattern, text)

def split_flags(pattern: str, text: str, flags: int) -> Result[list[str], RegexError]:
    return re_split_flags(pattern, text, flags)


def _iter_matches(own matches: list[Match]) -> Iterator[Match]:
    i: int = 0
    while i < len(matches):
        yield matches[i]
        i = i + 1


def _find_index_from(text: str, needle: str, start: int) -> int:
    if start < 0:
        return -1
    if len(needle) == 0:
        if start <= len(text):
            return start
        return -1
    max_start: int = len(text) - len(needle)
    i: int = start
    while i <= max_start:
        if text[i:i + len(needle)] == needle:
            return i
        i = i + 1
    return -1


def _findall_for_finditer(pattern: str, text: str, flags: int) -> Result[list[str], RegexError]:
    if flags != 0:
        return re_findall_flags(pattern, text, flags)
    return re_findall(pattern, text)


def _finditer_materialize(pattern: str, text: str, flags: int) -> Result[list[Match], RegexError]:
    try:
        found_items: list[str] = _findall_for_finditer(pattern, text, flags)
        matches: list[Match] = []
        cursor: int = 0
        for found in found_items:
            start: int = _find_index_from(text, found, cursor)
            if start < 0:
                start = cursor
            found_len: int = len(found)
            end: int = start + found_len
            matches.append(Match(found, start, end))
            if found_len == 0:
                cursor = end + 1
            else:
                cursor = end
        return matches
    except RegexError as e:
        raise RegexError(e.message)


def finditer(pattern: str, text: str) -> Result[Iterator[Match], RegexError]:
    try:
        matches: list[Match] = _finditer_materialize(pattern, text, 0)
        return _iter_matches(matches)
    except RegexError as e:
        raise RegexError(e.message)


class Pattern:
    # A compiled regular expression pattern.
    _pattern: str
    _flags: int

    def __init__(self, pattern: str, flags: int) -> None:
        self._pattern = pattern
        self._flags = flags

    def search(self, text: str) -> Result[str | None, RegexError]:
        if self._flags != 0:
            return re_find_flags(self._pattern, text, self._flags)
        return re_find(self._pattern, text)

    def is_match(self, text: str) -> Result[bool, RegexError]:
        # CPython: Pattern.match — renamed is_match due to Rust keyword conflict
        if self._flags != 0:
            return re_match_flags(self._pattern, text, self._flags)
        return re_match(self._pattern, text)

    def sub(self, replacement: str, text: str) -> Result[str, RegexError]:
        if self._flags != 0:
            return re_replace_flags(self._pattern, replacement, text, self._flags)
        return re_replace(self._pattern, replacement, text)

    def findall(self, text: str) -> Result[list[str], RegexError]:
        if self._flags != 0:
            return re_findall_flags(self._pattern, text, self._flags)
        return re_findall(self._pattern, text)

    def finditer(self, text: str) -> Result[Iterator[Match], RegexError]:
        try:
            matches: list[Match] = _finditer_materialize(self._pattern, text, self._flags)
            return _iter_matches(matches)
        except RegexError as e:
            raise RegexError(e.message)

    def split(self, text: str) -> Result[list[str], RegexError]:
        if self._flags != 0:
            return re_split_flags(self._pattern, text, self._flags)
        return re_split(self._pattern, text)

    def pattern(self) -> str:
        return self._pattern + ""


def compile(pattern: str) -> Pattern:
    return Pattern(pattern, 0)

def compile_flags(pattern: str, flags: int) -> Pattern:
    return Pattern(pattern, flags)


def fullmatch(pattern: str, text: str) -> Result[bool, RegexError]:
    # Match the entire string against the pattern.
    anchored: str = "^" + pattern + "$"
    return re_match(anchored, text)

def fullmatch_flags(pattern: str, text: str, flags: int) -> Result[bool, RegexError]:
    anchored: str = "^" + pattern + "$"
    return re_match_flags(anchored, text, flags)
