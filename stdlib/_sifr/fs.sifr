# Private _sifr.fs native declaration module.

@rust(sifr_stdlib.fs.read_text)
def read_text(path: str) -> Result[str, IOError]:
    ...


@rust(sifr_stdlib.fs.write_text)
def write_text(path: str, content: str) -> Result[None, IOError]:
    ...


