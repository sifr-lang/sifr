# Private _sifr.process native declaration module.


class ProcessError(Error):
    message: str


@rust(sifr_stdlib.process.process_run)
def process_run(
    program: str,
    args: list[str],
    env: list[str],
    cwd: str,
    has_cwd: bool,
) -> Result[list[int], ProcessError]:
    ...


@rust(sifr_stdlib.process.process_output)
def process_output(
    program: str,
    args: list[str],
    env: list[str],
    cwd: str,
    has_cwd: bool,
    stdin: bytes,
    has_stdin: bool,
) -> Result[str, ProcessError]:
    ...


