# Private _sifr.crypto native declaration module.
# Random and base encoding helpers still use compiler intrinsics during the
# incremental stateless-leaf migration.

@rust(sifr_stdlib.hash.sha256, panic=trusted_no_panic)
def sha256(s: str) -> str:
    return ""

@rust(sifr_stdlib.hash.sha256_bytes, panic=trusted_no_panic)
def sha256_bytes(data: bytes) -> bytes:
    return b""

@rust(sifr_stdlib.hash.md5, panic=trusted_no_panic)
def md5(s: str) -> str:
    return ""

@rust(sifr_stdlib.hash.md5_bytes, panic=trusted_no_panic)
def md5_bytes(data: bytes) -> bytes:
    return b""

