# Private _sifr.crypto native declaration module.
# Random helpers still use compiler intrinsics during the incremental
# stateless-leaf migration.

@rust(sifr_stdlib.base64.base64_encode)
def base64_encode(s: str) -> str:
    ...

@rust(sifr_stdlib.base64.base64_encode_bytes)
def base64_encode_bytes(data: bytes) -> bytes:
    ...

@rust(sifr_stdlib.base64.base64_decode)
def base64_decode(s: str) -> Result[str, ParseError]:
    ...

@rust(sifr_stdlib.base64.base64_decode_bytes)
def base64_decode_bytes(data: bytes) -> Result[bytes, ParseError]:
    ...

@rust(sifr_stdlib.base64.base64_encode_opts)
def base64_encode_opts(s: str, altchars: str, wrapcol: int) -> Result[str, ParseError]:
    ...

@rust(sifr_stdlib.base64.base64_decode_opts)
def base64_decode_opts(s: str, altchars: str, validate: bool, ignorechars: str) -> Result[str, ParseError]:
    ...

@rust(sifr_stdlib.base64.urlsafe_b64encode)
