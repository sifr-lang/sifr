# Private _sifr.net native declaration module.


class NetError(Error):
    message: str


@rust(sifr_stdlib.net.net_connect_tcp)
async def net_connect_tcp(
    address: str,
    timeout_seconds: float,
    has_timeout: bool,
    local_addr: str,
    has_local_addr: bool,
) -> Result[int, NetError]:
    ...


@rust(sifr_stdlib.net.net_listen_tcp)
async def net_listen_tcp(
    address: str,
    backlog: int,
    has_backlog: bool,
    reuse_addr: bool,
) -> Result[int, NetError]:
    ...


@rust(sifr_stdlib.net.net_listener_accept)
async def net_listener_accept(handle: int) -> Result[int, NetError]:
    ...


@rust(sifr_stdlib.net.net_listener_close)
def net_listener_close(handle: int) -> Result[None, NetError]:
    ...


@rust(sifr_stdlib.net.net_listener_local_addr)
def net_listener_local_addr(handle: int) -> Result[str, NetError]:
    ...


