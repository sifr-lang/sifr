# Test: 3-way isinstance narrowing with field access

class A:
    x: int

class B:
    y: str

class C:
    z: float

def check(val: A | B | C) -> str:
    if isinstance(val, A):
        return f"A: {val.x}"
    elif isinstance(val, B):
        return f"B: {val.y}"
    else:
        return f"C: {val.z}"

def main():
    assert str(check(A(1))) == 'A: 1'
    assert str(check(B("hi"))) == 'B: hi'
    assert str(check(C(3.14))) == 'C: 3.14'
