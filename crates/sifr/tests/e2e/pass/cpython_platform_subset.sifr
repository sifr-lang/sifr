# Adapted CPython platform subset for sifr.platform (canonical bool-vector format)
from sifr.platform import system, machine, node, release, version, processor
from sifr.test import assert_bool_vector_eq


def collect_core_actual() -> list[bool]:
    actual: list[bool] = []
    sys_name: str = system()
    system_shape_ok: bool = len(sys_name) > 0 and (
        sys_name == "Linux" or
        sys_name == "Darwin" or
        sys_name == "Windows" or
        sys_name == "linux" or
        sys_name == "macos" or
        sys_name == "windows"
    )
    actual.append(system_shape_ok)
    actual.append(len(machine()) > 0)
    actual.append(len(processor()) > 0)
    return actual


def collect_host_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(len(node()) > 0)
    actual.append(len(release()) > 0)
    actual.append(len(version()) > 0)
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_core_actual())
    append_all(actual, collect_host_actual())
    assert_bool_vector_eq(actual, expected)
    assert str("cpython_platform_subset: pass") == "cpython_platform_subset: pass"
