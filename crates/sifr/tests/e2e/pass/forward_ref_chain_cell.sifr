# Test: Forward reference with ChainCell (recursive forward-reference pattern)

def chain_length(own head: ChainCell | None) -> int:
    count: int = 0
    current: ChainCell | None = head
    if current is not None:
        count = count + 1
    return count

class ChainCell:
    val: int
    next: ChainCell | None

def main():
    n3: ChainCell = ChainCell(3, None)
    n2: ChainCell = ChainCell(2, None)
    n1: ChainCell = ChainCell(1, None)
    # Just test that forward references work
    assert str(chain_length(n1) + chain_length(n2) + chain_length(n3)) == '3'
