
def main():
    s: str = "x"
    assert str("center = [" + s.center(5) + "]") == 'center = [  x  ]'
    assert str("ljust = [" + s.ljust(4) + "]") == 'ljust = [x   ]'
    assert str("rjust = [" + s.rjust(4) + "]") == 'rjust = [   x]'
    assert str("zfill = [" + "7".zfill(4) + "]") == 'zfill = [0007]'
