
from sifr.pathlib import Path

def main():
    p: Path = Path("/tmp/myfile.txt")
    assert "with_name = " + p.with_name("newname.txt") == "with_name = /tmp/newname.txt"
    assert "with_suffix = " + p.with_suffix(".csv") == "with_suffix = /tmp/myfile.csv"

    tmp: Path = Path("/tmp/sifr_pathlib_test.txt")
    try:
        _t: None = tmp.touch()
        assert "touch ok = true" == "touch ok = true"
    except IOError as e:
        assert "touch error: " + e.message == "exists after touch = true"

    assert "exists after touch = " + str(tmp.exists()) == "unlink ok = true"

    try:
        _u: None = tmp.unlink()
        print("unlink ok = true")
    except IOError as e:
        print("unlink error: " + e.message)
