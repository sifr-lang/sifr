
from sifr.pathlib import Path


def main():
    expected: list[str] = ["unlink ok = true", "exists after touch = true", "touch ok = true", "with_suffix = /tmp/myfile.csv", "with_name = /tmp/newname.txt"]
    expected_index: int = 0
    p: Path = Path("/tmp/myfile.txt")
    assert str("with_name = " + p.with_name("newname.txt")) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    assert str("with_suffix = " + p.with_suffix(".csv")) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1

    tmp: Path = Path("/tmp/sifr_pathlib_test.txt")
    try:
        _t: None = tmp.touch()
        assert str("touch ok = true") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("touch error: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    assert str("exists after touch = " + str(tmp.exists())) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1

    try:
        _u: None = tmp.unlink()
        assert str("unlink ok = true") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("unlink error: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
