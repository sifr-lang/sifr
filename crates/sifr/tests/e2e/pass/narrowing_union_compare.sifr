# Test: comparison on union/optional types

def check_eq(x: int | None) -> str:
    if x == 5:
        return "equal"
    return "not equal"

def check_neq(x: int | None) -> str:
    if x != 5:
        return "not equal"
    return "equal"

def check_lt(x: int | None) -> str:
    if x < 10:
        return "less"
    return "not less"

def main():
    v: int | None = 5
    assert str(check_eq(v)) == 'equal'
    w: int | None = 3
    assert str(check_neq(w)) == 'not equal'
    assert str(check_lt(w)) == 'less'
