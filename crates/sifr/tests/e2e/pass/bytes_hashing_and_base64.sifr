# Reference: stdlib_parity_rng_2_hashlib_base64_bytes_native_surface
from sifr.base64 import (
    b64decode_bytes, b64encode_bytes,
    standard_b64decode_bytes, standard_b64encode_bytes,
    urlsafe_b64decode_bytes, urlsafe_b64encode_bytes
)
from sifr.hashlib import HashObject, new
from sifr.test import assert_eq, assert_true


def main() -> None:
    try:
        payload: bytes = b"abc"

        h_bytes: HashObject = new("sha256", payload)
        assert_eq(
            h_bytes.hexdigest(),
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
        )
        assert_true(len(h_bytes.digest()) == 32)

        h_bytes.update(payload)
        assert_eq(
            h_bytes.hexdigest(),
            "bbb59da3af939f7af5f360f2ceb80a496e3bae1cd87dde426db0ae40677e1c2c"
        )

        h_direct: HashObject = new("sha256", b"abc")
        h_expected: HashObject = new("sha256", payload)
        assert_eq(h_direct.digest(), h_expected.digest())

        h_empty: HashObject = new("sha256", b"")
        assert_eq(
            h_empty.hexdigest(),
            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        )
        assert_true(len(h_empty.digest()) == 32)

        h_mixed: HashObject = new("sha256", b"")
        h_mixed.update(b"ab")
        h_mixed.update(b"c")
        assert_eq(h_mixed.hexdigest(), h_expected.hexdigest())

        base_payload: bytes = b"hello+bytes"
        enc: bytes = b64encode_bytes(base_payload)
        dec: bytes = b64decode_bytes(enc)
        assert_eq(dec, base_payload)

        std_enc: bytes = standard_b64encode_bytes(base_payload)
        std_dec: bytes = standard_b64decode_bytes(std_enc)
        assert_eq(std_dec, base_payload)

        url_enc: bytes = urlsafe_b64encode_bytes(base_payload)
        url_dec: bytes = urlsafe_b64decode_bytes(url_enc)
        assert_eq(url_dec, base_payload)

        try:
            _bad_decoded: bytes = b64decode_bytes(b"@@@@")
            assert_true(False)
        except ParseError as e:
            assert_true(len(e.message) > 0)
    except ValueError as e:
        assert str("unexpected value error: " + e.message) == "bytes_hashing_and_base64: pass"
    except ParseError as e:
        assert str("unexpected parse error: " + e.message) == "bytes_hashing_and_base64: pass"

    assert str("bytes_hashing_and_base64: pass") == "bytes_hashing_and_base64: pass"
