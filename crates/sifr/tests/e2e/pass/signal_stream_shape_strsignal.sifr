from sifr.signal import (
    SIGINT,
    SIGTERM,
    Signal,
    SignalError,
    ctrl_c,
    shutdown_stream,
    strsignal,
    terminate,
)


async def _shape_ctrl_c() -> Result[Signal, SignalError]:
    return await ctrl_c()


async def _shape_terminate() -> Result[Signal, SignalError]:
    return await terminate()


async def _shape_shutdown() -> Result[Signal, SignalError]:
    return await shutdown_stream().next()


def main():
    interrupt: Signal = SIGINT
    interrupt_label: str = strsignal(interrupt)
    assert interrupt_label == "SIGINT"

    termination: Signal = SIGTERM
    termination_label: str = strsignal(termination)
    assert termination_label == "SIGTERM"

    # Shape pin only: these helpers are intentionally not awaited because
    # deterministic external signal delivery belongs to the shutdown-stream harness.
