# Bytes constructors.
def main() -> None:
    size_ok: bool = False
    try:
        zeroes: bytes = bytes(4)
        zero: uint8 = 0
        assert len(zeroes) == 4
        assert zeroes[0] == zero
        assert zeroes[3] == zero
        size_ok = True
    except ValueError as e:
        _ = str(e.message)
    assert size_ok

    from_ints_ok: bool = False
    try:
        ints: list[int] = [72, 105, 33]
        payload: bytes = bytes.from_ints(ints)
        h: uint8 = 72
        i: uint8 = 105
        bang: uint8 = 33
        assert payload[0] == h
        assert payload[1] == i
        assert payload[2] == bang
        from_ints_ok = True
    except ValueError as e:
        _ = str(e.message)
    assert from_ints_ok

    from_hex_ok: bool = False
    try:
        parsed: bytes = bytes.from_hex("53 69 66 72")
        text: str = parsed.decode()
        assert text == "Sifr"
        from_hex_ok = True
    except ParseError as e:
        _ = str(e.message)
    assert from_hex_ok

    encode_ok: bool = False
    try:
        encoded: bytes = "bytes-constructor-sample".encode("utf-8")
        decoded: str = encoded.decode("utf-8")
        assert decoded == "bytes-constructor-sample"
        encode_ok = True
    except ParseError as e:
        _ = str(e.message)
    assert encode_ok
