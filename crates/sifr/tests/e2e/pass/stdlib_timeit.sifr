# Test sifr.timeit module (CPython-matching API)
from sifr.timeit import default_timer, timeit
from typing import Callable

def do_work():
    total: int = 0
    i: int = 0
    while i < 100:
        total = total + i
        i = i + 1

def main():
    # default_timer returns a monotonic float >= 0.0
    t: float = default_timer()
    print(t >= 0.0)
    # timeit runs a callable N times and returns elapsed seconds
    elapsed: float = timeit(do_work, 10)
    # elapsed should be non-negative (>= 0 includes 0.0 for very fast ops)
    print(elapsed > -1.0)

# expect-stdout: true
