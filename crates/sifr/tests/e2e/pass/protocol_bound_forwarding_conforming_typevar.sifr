# Test: forwarding a TypeVar through protocol-bounded generics with explicit conformance

def keep_comparable[T: Comparable](x: T) -> T:
    return x

def relay_comparable[U: Comparable](x: U) -> U:
    return keep_comparable(x)

def add_same[T: Addable](left: T, right: T) -> T:
    return left + right

def relay_add[U: Addable](left: U, right: U) -> U:
    return add_same(left, right)

def main():
    n: int = relay_comparable(7)
    s: str = relay_comparable("ok")
    total: int = relay_add(4, 5)
    joined: str = relay_add("sifr", " rust")
    assert str(n) == '7'
    assert str(s) == 'ok'
    assert total == 9
    assert joined == "sifr rust"
