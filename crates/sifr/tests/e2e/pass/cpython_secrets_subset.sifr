# Adapted CPython secrets subset for sifr.secrets (canonical vector format)
from sifr.secrets import choice, compare_digest, randbelow, randbits, token_hex
from sifr.test import assert_bool_vector_eq


def collect_core_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(compare_digest("abc", "abc"))
    actual.append(compare_digest("abc", "abd") == False)

    token: str = token_hex(6)
    actual.append(len(token) == 12)

    randbelow_ok: bool = False
    try:
        below: int = randbelow(7)
        randbelow_ok = below >= 0 and below < 7
    except ValueError as e:
        _ = e.message
    actual.append(randbelow_ok)

    randbits_ok: bool = False
    try:
        bits: int = randbits(10)
        randbits_ok = bits >= 0
    except ValueError as e:
        _ = e.message
    actual.append(randbits_ok)

    choice_ok: bool = False
    try:
        picked: int = choice([1, 2, 3])
        choice_ok = picked >= 1 and picked <= 3
    except ValueError as e:
        _ = e.message
    actual.append(choice_ok)

    return actual


def collect_negative_actual() -> list[bool]:
    actual: list[bool] = []

    empty_choice_rejected: bool = False
    try:
        _bad_choice: int = choice([])
        _ = _bad_choice
    except ValueError as e:
        empty_choice_rejected = e.message == "choice: items must not be empty"
    actual.append(empty_choice_rejected)

    invalid_below_rejected: bool = False
    try:
        _bad_below: int = randbelow(0)
        _ = _bad_below
    except ValueError as e:
        invalid_below_rejected = e.message == "randbelow: n must be > 0"
    actual.append(invalid_below_rejected)

    invalid_bits_rejected: bool = False
    try:
        _bad_bits: int = randbits(-1)
        _ = _bad_bits
    except ValueError as e:
        invalid_bits_rejected = e.message == "randbits: number of bits must be >= 0"
    actual.append(invalid_bits_rejected)

    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [
        True, True, True, True, True, True, True, True, True
    ]
    actual: list[bool] = []
    append_all(actual, collect_core_actual())
    append_all(actual, collect_negative_actual())

    assert_bool_vector_eq(actual, expected)
    assert str("cpython_secrets_subset: pass") == "cpython_secrets_subset: pass"
