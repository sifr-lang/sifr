from sifr.process import Child, Command, ProcessError, Status, spawn, terminate, wait


def sleeping_command() -> Command:
    command: Command = Command("sleep")
    command.arg("30")
    return command


def main():
    actual: list[bool] = []

    try:
        child: Child = spawn(sleeping_command())
        _terminated: None = terminate(child)
        status: Status = wait(child)
        actual.append(not status.success)
        actual.append(status.kind == "signal")
        actual.append(status.signal == 15)

        method_child: Child = spawn(sleeping_command())
        _method_terminated: None = method_child.terminate()
        method_status: Status = method_child.wait()
        actual.append(not method_status.success)
        actual.append(method_status.kind == "signal")

        try:
            _after_wait_terminate: None = terminate(child)
            actual.append(False)
        except ProcessError as e:
            actual.append("closed or unknown" in e.message)
    except ProcessError as e:
        actual.append(False)

    assert actual == [True, True, True, True, True, True]
