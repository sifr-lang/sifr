
def parse_number(s: str) -> Result[int, ParseError]:
    return int(s)

def main():
    try:
        val: int = parse_number("42")
        assert str(f"parsed: {val}") == 'parsed: 42'
    except ParseError as e:
        assert str(f"error: {e.message}") == 'caught: not a number'

    try:
        raise ParseError("not a number")
    except ParseError as e:
        _ = str(f"caught: {e.message}")
