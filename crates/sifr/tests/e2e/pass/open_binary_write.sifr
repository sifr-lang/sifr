
from sifr.io import read_text

def main():
    path: str = "/tmp/sifr_open_binary_write_test.txt"
    try:
        f = open(path, "wb")
        data: bytes = b"hello"
        _: None = f.write_bytes(data)
        f.close()
        content: str = read_text(path)
        if content == "hello":
            assert str("bytes verified") == 'bytes verified'
        else:
            assert str("mismatch: " + content) == 'binary write ok'
        _ = str("binary write ok")
    except IOError as e:
        _ = str("error: " + e.message)
