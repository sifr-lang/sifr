from enum import Enum

class HttpStatus(Enum):
    OK = 200
    NOT_FOUND = 404
    INTERNAL_ERROR = 500

def main():
    s: HttpStatus = HttpStatus.OK
    assert str(s) == 'OK'
    assert str(s.value()) == '200'
    assert str(s.name()) == 'OK'
    s2: HttpStatus = HttpStatus.NOT_FOUND
    assert str(s2.value()) == '404'

