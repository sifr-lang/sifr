from enum import Enum

class HttpStatus(Enum):
    OK = 200
    NOT_FOUND = 404
    INTERNAL_ERROR = 500

def main():
    s: HttpStatus = HttpStatus.OK
    print(s)
    print(s.value())
    print(s.name())
    s2: HttpStatus = HttpStatus.NOT_FOUND
    print(s2.value())

# expect-stdout: OK
# expect-stdout: 200
# expect-stdout: OK
# expect-stdout: 404
