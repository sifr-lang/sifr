# Test TopologicalSorter class
from sifr.graphlib import TopologicalSorter, CycleError

def main():
    ts: TopologicalSorter = TopologicalSorter()
    # Graph: 0 -> 1 -> 2, 0 -> 2
    ts.add(1, 0)
    ts.add(2, 1)
    ts.add(2, 0)
    try:
        order: list[int] = ts.static_order()
        print(len(order))
        # Node 0 should come first (no predecessors)
        first: int | None = order[0]
        if first is not None:
            print(first)
        # Node 2 should come last (depends on both 0 and 1)
        last: int | None = order[2]
        if last is not None:
            print(last)
    except CycleError as e:
        print(f"error: {e.message}")

# expect-stdout: 3
# expect-stdout: 0
# expect-stdout: 2
