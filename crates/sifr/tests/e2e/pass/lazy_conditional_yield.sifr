# Tests: lazy generator with conditional yield (filter pattern)
def evens(limit: int) -> Iterator[int]:
    i: int = 0
    while i < limit:
        if i % 2 == 0:
            yield i
        i = i + 1

def main():
    output: list[int] = []
    for e in evens(10):
        output.append(e)
    assert output == [0, 2, 4, 6, 8]
