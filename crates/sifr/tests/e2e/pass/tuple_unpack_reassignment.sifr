# Reference: narrowing_tuple_unpack_mutability
# Test: tuple destructuring should emit mutable bindings when targets are later reassigned.

def my_sqrt(x: int) -> int:
    l, r = 0, x
    while l <= r:
        mid = (l + r) // 2
        if mid * mid == x:
            return mid
        if mid * mid < x:
            l = mid + 1
        else:
            r = mid - 1
    return r

def main():
    assert str(my_sqrt(4)) == '2'
    assert str(my_sqrt(8)) == '2'
    assert str(my_sqrt(0)) == '0'
