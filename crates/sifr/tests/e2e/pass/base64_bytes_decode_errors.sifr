# Reference: stdlib_parity_rng_2_base64_invalid_bytes_decode_boundary
from sifr.base64 import b64decode_bytes, urlsafe_b64decode_bytes
from sifr.test import assert_true


def main() -> None:
    try:
        _decoded: bytes = b64decode_bytes(b"@@@@")
        assert_true(False)
    except ParseError as e:
        assert_true(len(e.message) > 0)

    try:
        _urlsafe_decoded: bytes = urlsafe_b64decode_bytes(b"%%%%")
        assert_true(False)
    except ParseError as e:
        assert_true(len(e.message) > 0)

    assert str("base64_bytes_decode_errors: pass") == "base64_bytes_decode_errors: pass"
