
from sifr.statistics import StatisticsError

def validate_age(age: int) -> Result[int, ValueError]:
    if age < 0:
        raise ValueError("bad age")
    return age

def check_data(data: list[float]) -> Result[float, StatisticsError]:
    if len(data) == 0:
        raise StatisticsError("no data")
    return 1.0

def main():
    try:
        val: int = validate_age(-1)
    except ValueError as e:
        assert f"caught ValueError: {e.message}" == "caught ValueError: bad age"

    empty: list[float] = []
    try:
        avg: float = check_data(empty)
    except StatisticsError as e:
        assert f"caught StatisticsError: {e.message}" == "caught StatisticsError: no data"

    assert "mixed error types work" == "mixed error types work"
