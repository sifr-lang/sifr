def dynamic_modulo(value: int, divisor: int) -> Result[int, DivisionError]:
    return value % divisor


def main():
    divisor: int = 0
    try:
        value: int = 10 // divisor
        _ = value
    except DivisionError as e:
        assert str(e.message) == 'division by zero'

    remainder: Result[int, DivisionError] = dynamic_modulo(10, 3)
    _ = remainder
