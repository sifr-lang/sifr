
from sifr.datetime import time, timezone

def main():
    t: time = time(10, 30, 45)
    assert "time isoformat = " + t.isoformat() == "time isoformat = 10:30:45"
    t2: time = time(10, 30, 45)
    assert "time eq = " + str(t == t2) == "time eq = true"
    tz: timezone = timezone(0)
    assert "timezone str = " + str(tz) == "timezone str = UTC"
