# Test sifr.fnmatch module
from sifr.fnmatch import fnmatch, fnmatch_filter

def main():
    # exact match
    assert str(fnmatch("hello.txt", "hello.txt")) == 'true'

    # wildcard *
    assert str(fnmatch("hello.txt", "*.txt")) == 'true'
    assert str(fnmatch("hello.py", "*.txt")) == 'false'

    # wildcard ?
    assert str(fnmatch("cat", "c?t")) == 'true'
    assert str(fnmatch("cart", "c?t")) == 'false'

    # filter
    names: list[str] = ["a.txt", "b.py", "c.txt", "d.rs"]
    matched: list[str] = fnmatch_filter(names, "*.txt")
    assert str(len(matched)) == '2'
    first: str | None = matched[0]
    if first is not None:
        assert str(first) == 'a.txt'
    second: str | None = matched[1]
    if second is not None:
        assert str(second) == 'c.txt'

