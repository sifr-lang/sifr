# Test sifr.fnmatch module
from sifr.fnmatch import fnmatch, fnmatch_filter

def main():
    # exact match
    assert fnmatch("hello.txt", "hello.txt") == True

    # wildcard *
    assert fnmatch("hello.txt", "*.txt") == True
    assert fnmatch("hello.py", "*.txt") == False

    # wildcard ?
    assert fnmatch("cat", "c?t") == True
    assert fnmatch("cart", "c?t") == False

    # filter
    names: list[str] = ["a.txt", "b.py", "c.txt", "d.rs"]
    matched: list[str] = fnmatch_filter(names, "*.txt")
    assert len(matched) == 2
    first: str | None = matched[0]
    if first is not None:
        assert first == a.txt
    second: str | None = matched[1]
    if second is not None:
        assert second == c.txt

