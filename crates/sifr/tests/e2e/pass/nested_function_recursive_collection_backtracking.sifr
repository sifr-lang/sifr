# Test: Recursive nested helper with captured collection state lowers through production codegen

def collect_budget_routes(weights: list[int], budget: int) -> list[list[int]]:
    routes = []

    def visit(index, current, total):
        if total == budget:
            routes.append(current.copy())
            return
        if index >= len(weights) or total > budget:
            return

        current.append(weights[index])
        visit(index, current, total + weights[index])
        current.pop()
        visit(index + 1, current, total)

    visit(0, [], 0)
    return routes

def main():
    assert str(collect_budget_routes([2, 3, 6, 7], 7)) == '[[2, 2, 3], [7]]'
