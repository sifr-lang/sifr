# Test: Recursive nested helper with captured collection state lowers through production codegen

def accumulate_items(items: list[int], limit: int) -> list[list[int]]:
    snapshots = []

    def visit(index, current, total):
        if total == limit:
            snapshots.append(current.copy())
            return
        if index < 0 or index >= len(items) or total > limit:
            return

        current.append(items[index])
        visit(index, current, total + items[index])
        current.pop()
        visit(index + 1, current, total)

    visit(0, [], 0)
    return snapshots

def main():
    assert str(accumulate_items([1, 2, 4], 4)) == '[[1, 1, 1, 1], [1, 1, 2], [2, 2], [4]]'
