async def values() -> AsyncGenerator[int, GeneratorCloseError]:
    yield 1
    yield 2


async def find(target: int) -> Result[int, GeneratorCloseError]:
    found = -1
    async for value in values():
        if value == target:
            found = value
            break
    else:
        return -1
    return found


async def main() -> Result[None, GeneratorCloseError]:
    first = await find(2)
    missing = await find(9)
    assert str(first) == "Ok(2)"
    assert str(missing) == "Ok(-1)"
    return None
