
class Circle:
    radius: float

    def __init__(self, radius: float):
        self.radius = radius

class Square:
    side: float

    def __init__(self, side: float):
        self.side = side

def describe(shape: Circle | Square):
    if isinstance(shape, Circle):
        assert f"Circle with radius {shape.radius}" == "Circle with radius 5"
    else:
        assert f"Square with side {shape.side}" == "Square with side 3"

def main():
    c: Circle = Circle(5.0)
    s: Square = Square(3.0)
    describe(c)
    describe(s)
