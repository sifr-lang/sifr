# Test parse safety error paths — all parse/decode intrinsics return Result
from sifr.json import json_loads
from sifr.tomllib import loads
from sifr.re import re_match
from sifr.base64 import base64_decode
from sifr.bytes import decode_utf8, bytes_from_hex


def main():
    expected: list[str] = ["all parse safety error paths passed", "hex ok: 72", "caught hex ParseError", "utf8 ok: hi", "caught utf8 ParseError", "base64 ok: hello", "caught base64 ParseError", "regex ok: true", "caught RegexError", "true", "caught TOMLDecodeError", "json ok: {\"ok\":true}", "caught JSONDecodeError"]
    expected_index: int = 0
    # 1. JSON: invalid input returns JSONDecodeError
    try:
        val: str = json_loads("invalid json")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except JSONDecodeError as e:
        assert str("caught JSONDecodeError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 2. JSON: valid input succeeds
    try:
        data: str = json_loads("{\"ok\":true}")
        assert str(f"json ok: {data}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except JSONDecodeError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 3. TOML: invalid input returns TOMLDecodeError
    try:
        tval: str = loads("invalid [toml")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except TOMLDecodeError as e:
        assert str("caught TOMLDecodeError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 4. TOML: valid input succeeds
    try:
        tdata: str = loads("key = \"value\"")
        assert str(len(tdata) > 0) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except TOMLDecodeError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 5. Regex: invalid pattern returns RegexError
    try:
        matched: bool = re_match("[invalid", "text")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except RegexError as e:
        assert str("caught RegexError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 6. Regex: valid pattern succeeds
    try:
        matched2: bool = re_match("[a-z]+", "hello")
        assert str(f"regex ok: {matched2}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except RegexError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 7. Base64: invalid input returns ParseError
    try:
        decoded: str = base64_decode("not valid base64!!!")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("caught base64 ParseError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 8. Base64: valid input succeeds
    try:
        decoded2: str = base64_decode("aGVsbG8=")
        assert str(f"base64 ok: {decoded2}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 9. UTF-8: invalid bytes returns ParseError
    try:
        bad_bytes: list[int] = [255, 254, 253]
        text: str = decode_utf8(bad_bytes)
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("caught utf8 ParseError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 10. UTF-8: valid bytes succeeds
    try:
        good_bytes: list[int] = [104, 105]
        text2: str = decode_utf8(good_bytes)
        assert str(f"utf8 ok: {text2}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 11. bytes_from_hex: invalid hex returns ParseError
    try:
        bad_hex: list[int] = bytes_from_hex("ZZZZ")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("caught hex ParseError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 12. bytes_from_hex: valid hex succeeds
    try:
        good_hex: list[int] = bytes_from_hex("48")
        assert str(f"hex ok: {good_hex[0]}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    assert str("all parse safety error paths passed") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1

