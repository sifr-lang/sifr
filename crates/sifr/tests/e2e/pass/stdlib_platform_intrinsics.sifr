
from sifr.platform import system, machine, processor

def main():
    sys: str = system()
    assert "system len > 0 = " + str(len(sys) > 0) == "system len > 0 = true"

    mach: str = machine()
    assert "machine len > 0 = " + str(len(mach) > 0) == "machine len > 0 = true"

    proc: str = processor()
    assert "processor len > 0 = " + str(len(proc) > 0) == "processor len > 0 = true"
