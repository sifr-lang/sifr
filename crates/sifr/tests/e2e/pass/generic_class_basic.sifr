# Test generic class with field access and method calls
class Stack[T]:
    items: list[T]

    def __init__(self, items: list[T]):
        self.items = items

    def push(mut self, item: T) -> None:
        self.items.append(item)

    def size(self) -> int:
        return len(self.items)

def main():
    s: Stack[int] = Stack([])
    s.push(1)
    s.push(2)
    s.push(3)
    assert str(s.size()) == '3'
