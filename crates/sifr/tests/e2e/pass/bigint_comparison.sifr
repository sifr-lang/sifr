# TEMPORARY TRANSITION FIXTURE: exercises the public bigint alias until alias removal.
def main():
    a: bigint = bigint(100)
    b: bigint = bigint(200)
    assert str(a == b) == 'false'
    assert str(a != b) == 'true'
    assert str(a < b) == 'true'
    assert str(a > b) == 'false'
    assert str(a <= b) == 'true'
    assert str(a >= b) == 'false'
    c: bigint = bigint(100)
    assert str(a == c) == 'true'
