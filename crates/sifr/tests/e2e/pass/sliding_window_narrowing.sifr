# Reference: phase31_sliding_window_left_pointer_narrowing
# Canonical sliding-window left-pointer narrowing should accept tuple-unpacked
# zero-based pointers, preserve direct string indexing, and keep generated code
# on the non-optional path for set.remove/add.

def maxVowels(s: str, k: int) -> int:
    l, res, total = 0, 0, 0
    vowels = "aeiou"

    for r in range(len(s)):
        if s[r] in vowels:
            total += 1
        if (r - l + 1) > k:
            if s[l] in vowels:
                total -= 1
            l += 1
        res = max(res, total)
    return res

def lengthOfLongestSubstring(s: str) -> int:
    charSet = set()
    l = 0
    res = 0

    for r in range(len(s)):
        while s[r] in charSet:
            charSet.remove(s[l])
            l += 1
        charSet.add(s[r])
        res = max(res, r - l + 1)
    return res

def main():
    assert str(maxVowels("abciiidef", 3)) == '3'
    assert str(maxVowels("aeiou", 2)) == '2'
    assert str(lengthOfLongestSubstring("abcabcbb")) == '3'
    assert str(lengthOfLongestSubstring("bbbbb")) == '1'
