
def main():
    # int(float) -> int (truncation)
    x: int = int(3.7)
    assert str(x) == '3'

    # float(int) -> float
    y: float = float(42)
    assert str(y) == '42'

    # str(x) for any type
    s: str = str(42)
    assert str("hello") == 'hello'

    # bool(x) for any type
    b: bool = bool(1)
    assert str(b) == 'true'
