
def main():
    # int(float) -> int (truncation)
    x: int = int(3.7)
    assert x == 3

    # float(int) -> float
    y: float = float(42)
    assert y == 42

    # str(x) for any type
    s: str = str(42)
    assert "hello" == hello

    # bool(x) for any type
    b: bool = bool(1)
    assert b == True
