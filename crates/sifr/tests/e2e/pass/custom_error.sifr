
class AppError(Error):
    message: str

def validate(x: int) -> Result[int, AppError]:
    if x < 0:
        raise AppError("something went wrong")
    return x


def main():
    expected: list[str] = ["ok: 42", "caught: something went wrong"]
    expected_index: int = 0
    try:
        val: int = validate(-1)
        assert str(val) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except AppError as e:
        assert str(f"caught: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        val2: int = validate(42)
        assert str(f"ok: {val2}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except AppError as e:
        assert str(f"caught: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
