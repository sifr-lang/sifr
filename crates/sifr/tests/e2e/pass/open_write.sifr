
from sifr.io import read_text

def main():
    path: str = "/tmp/sifr_open_write_test.txt"
    try:
        f = open(path, "w", encoding="utf-8")
        _: None = f.write("test content")
        f.close()
        content: str = read_text(path)
        if content == "test content":
            assert str("write ok") == 'write ok'
        else:
            assert str("write mismatch: " + content) == 'verify ok'
        _ = str("verify ok")
    except IOError as e:
        _ = str("error: " + e.message)
