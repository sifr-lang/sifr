# expect-stdout: contains a = true
# expect-stdout: get a default = 1
# expect-stdout: get z default = 9
# expect-stdout: get b opt = 2
# expect-stdout: pop a = 1
# expect-stdout: len after pop = 1

def main():
    d: dict[str, int] = {"a": 1, "b": 2}

    print("contains a = " + str(d.contains("a")))
    print("get a default = " + str(d.get("a", 0)))
    print("get z default = " + str(d.get("z", 9)))

    b_val: int | None = d.get("b")
    if b_val is not None:
        print("get b opt = " + str(b_val))

    a_val: int | None = d.pop("a")
    if a_val is not None:
        print("pop a = " + str(a_val))

    print("len after pop = " + str(len(d)))
