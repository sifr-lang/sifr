# CPython test_datetime — ported assertions for sifr.datetime (timedelta)
from sifr.test import assert_bool_vector_eq
from sifr.datetime import timedelta

def collect_basic_actual() -> list[bool]:
    actual: list[bool] = []
    td0: timedelta = timedelta(0, 0)
    actual.append(td0.total_seconds() == 0)
    actual.append(td0.days() == 0)
    actual.append(td0.seconds() == 0)

    td1: timedelta = timedelta(1, 0)
    actual.append(td1.total_seconds() == 86400)
    actual.append(td1.days() == 1)
    actual.append(td1.seconds() == 0)

    td2: timedelta = timedelta(0, 3600)
    actual.append(td2.total_seconds() == 3600)
    actual.append(td2.days() == 0)
    actual.append(td2.seconds() == 3600)

    td3: timedelta = timedelta(2, 7200)
    actual.append(td3.total_seconds() == 180000)
    actual.append(td3.days() == 2)
    actual.append(td3.seconds() == 7200)
    return actual

def collect_add_sub_actual() -> list[bool]:
    actual: list[bool] = []
    td0: timedelta = timedelta(0, 0)
    td1: timedelta = timedelta(1, 0)
    td2: timedelta = timedelta(0, 3600)
    td3: timedelta = timedelta(2, 7200)

    sum1: timedelta = td1 + td2
    sum2: timedelta = td0 + td1
    sum3: timedelta = td2 + td2
    actual.append(sum1.total_seconds() == 90000)
    actual.append(sum2.total_seconds() == 86400)
    actual.append(sum3.total_seconds() == 7200)

    diff1: timedelta = td1 - td2
    diff2: timedelta = td3 - td1
    diff3: timedelta = td1 - td0
    actual.append(diff1.total_seconds() == 82800)
    actual.append(diff2.total_seconds() == 93600)
    actual.append(diff3.total_seconds() == 86400)
    return actual

def collect_equality_actual() -> list[bool]:
    actual: list[bool] = []
    td0: timedelta = timedelta(0, 0)
    td1: timedelta = timedelta(1, 0)
    td2: timedelta = timedelta(0, 3600)
    actual.append(td0 == timedelta(0, 0))
    actual.append(td1 == timedelta(1, 0))
    td1_ne_td2: bool = not (td1 == td2)
    td0_ne_td1: bool = not (td0 == td1)
    actual.append(td1_ne_td2)
    actual.append(td0_ne_td1)

    td_1day: timedelta = timedelta(1, 0)
    td_86400s: timedelta = timedelta(0, 86400)
    actual.append(td_1day == td_86400s)
    return actual

def collect_chained_actual() -> list[bool]:
    actual: list[bool] = []
    hour: timedelta = timedelta(0, 3600)
    two_hours: timedelta = hour + hour
    three_hours: timedelta = two_hours + hour
    actual.append(three_hours.total_seconds() == 10800)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [
        True, True, True, True, True, True, True, True, True, True, True, True,
        True, True, True, True, True, True,
        True, True, True, True, True,
        True
    ]
    actual: list[bool] = []
    append_all(actual, collect_basic_actual())
    append_all(actual, collect_add_sub_actual())
    append_all(actual, collect_equality_actual())
    append_all(actual, collect_chained_actual())
    assert_bool_vector_eq(actual, expected)

    assert str("cpython_datetime: all 28 assertions passed") == 'cpython_datetime: all 28 assertions passed'
