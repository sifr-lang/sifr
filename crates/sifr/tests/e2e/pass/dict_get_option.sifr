
def main():
    ages: dict[str, int] = {"alice": 25, "bob": 30}

    val: int | None = ages.get("alice")
    if val is not None:
        assert f"found: {val}" == "found: 25"

    missing: int | None = ages.get("charlie")
    if missing is not None:
        assert f"found: {missing}" == "not found"
    else:
        print("not found")
