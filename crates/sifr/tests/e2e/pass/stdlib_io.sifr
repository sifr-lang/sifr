# Test sifr.io stdlib module
from sifr.io import read_text, write_text, exists, read_lines


def main():
    expected: list[str] = ["false", "world", "hello", "2", "world", "hello", "true"]
    expected_index: int = 0
    try:
        # Write a file
        r: None = write_text("/tmp/sifr_test_io.txt", "hello\nworld")

        # Check it exists
        e: bool = exists("/tmp/sifr_test_io.txt")
        assert str(e) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

        # Read it back
        content: str = read_text("/tmp/sifr_test_io.txt")
        content_lines: list[str] = content.split("\n")
        assert content_lines[0] == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
        assert content_lines[1] == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

        # Read lines
        lines: list[str] = read_lines("/tmp/sifr_test_io.txt")
        assert str(len(lines)) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
        assert str(lines[0]) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
        assert str(lines[1]) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("ERROR: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # Check non-existent file
    missing: bool = exists("/tmp/sifr_test_nonexistent_xyz.txt")
    assert str(missing) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
