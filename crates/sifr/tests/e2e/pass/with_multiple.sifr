# Tests: with statement with multiple context managers

class CtxA:
    name: str

    def __init__(self, name: str):
        self.name = name

    def __enter__(self) -> CtxA:
        assert str("A.__enter__") == "A.__enter__"
        return self

    def __exit__(self) -> None:
        assert str("A.__exit__") == "A.__exit__"

class CtxB:
    name: str

    def __init__(self, name: str):
        self.name = name

    def __enter__(self) -> CtxB:
        assert str("B.__enter__") == "B.__enter__"
        return self

    def __exit__(self) -> None:
        assert str("B.__exit__") == "B.__exit__"


def main():
    with CtxA("first") as a, CtxB("second") as b:
        assert str("using a and b") == "using a and b"
