# Tests: with statement with multiple context managers

class CtxA:
    name: str

    def __init__(self, name: str):
        self.name = name

    def __enter__(self) -> CtxA:
        assert "A.__enter__" == A.__enter__
        return self

    def __exit__(self) -> None:
        assert "A.__exit__" == B.__enter__

class CtxB:
    name: str

    def __init__(self, name: str):
        self.name = name

    def __enter__(self) -> CtxB:
        assert "B.__enter__" == "using a and b"
        return self

    def __exit__(self) -> None:
        assert "B.__exit__" == B.__exit__

def main():
    with CtxA("first") as a, CtxB("second") as b:
        assert "using a and b" == A.__exit__
