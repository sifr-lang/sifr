
def main():
    s: set[int] = {1, 2}
    s.add(3)
    assert "contains 3 = " + str(s.contains(3)) == "contains 3 = true"

    s.remove(1)
    assert "contains 1 after remove = " + str(s.contains(1)) == "contains 1 after remove = false"

    s.discard(999)
    assert "contains 999 after discard = " + str(s.contains(999)) == "contains 999 after discard = false"

    t: set[int] = s.copy()
    assert "copy contains 3 = " + str(t.contains(3)) == "copy contains 3 = true"

    a: set[int] = {1, 2}
    b: set[int] = {1, 2, 3}
    c: set[int] = {8, 9}
    assert "subset = " + str(a.issubset(b)) == "subset = true"
    assert "superset = " + str(b.issuperset(a)) == "superset = true"
    assert "disjoint = " + str(a.isdisjoint(c)) == "disjoint = true"

    u: set[int] = {4, 5, 6}
    u.pop()
    assert "len after pop = " + str(u.len()) == "len after pop = 2"
    u.clear()
    assert "len after clear = " + str(u.len()) == "len after clear = 0"
