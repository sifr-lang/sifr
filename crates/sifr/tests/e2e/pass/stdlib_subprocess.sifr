
from sifr.subprocess import run, check_call, check_output, CompletedProcess

def main():
    try:
        result: CompletedProcess = run("echo ok")
        assert str("echo ok = " + result.stdout.strip()) == 'echo ok = ok'
        rc: int = check_call("echo check_call_stdlib")
        assert rc == 0
        out: str = check_output("echo check_output_stdlib")
        assert out.strip() == "check_output_stdlib"
    except IOError as e:
        _ = str("error: " + e.message)
