# Test sifr.collections Counter class — mutation via increment
from sifr.collections import Counter, from_list

def main():
    # Create Counter
    c: Counter = from_list(["x", "y", "x"])

    # Check initial counts
    assert c.get("x") == 2
    assert c.get("y") == 1
    assert c.total() == 3

    # Increment existing key
    c.increment("x")
    assert c.get("x") == 3
    assert c.total() == 4

    # Increment new key
    c.increment("z")
    assert c.get("z") == 1
    assert c.total() == 5

