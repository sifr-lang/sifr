def classify(x: int) -> str:
    match x:
        case n if n < 0:
            return "negative"
        case n if n == 0:
            return "zero"
        case n if n > 0:
            return "positive"
        case _:
            return "unknown"

def main():
    assert classify(-5) == negative
    assert classify(0) == zero
    assert classify(7) == positive

