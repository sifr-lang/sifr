def classify(x: int) -> str:
    match x:
        case n if n < 0:
            return "negative"
        case n if n == 0:
            return "zero"
        case n if n > 0:
            return "positive"
        case _:
            return "unknown"

def main():
    assert str(classify(-5)) == 'negative'
    assert str(classify(0)) == 'zero'
    assert str(classify(7)) == 'positive'

