# Consolidated stdlib time coverage for stdlib_consolidation structure rules
from sifr.time import time, sleep, strftime, strptime, gmtime_struct, localtime_struct, perf_counter, monotonic, struct_time
from sifr.time import mktime, TIMEZONE, ALTZONE, DAYLIGHT, TZNAME
from sifr.test import assert_bool_vector_eq


def collect_clock_actual() -> list[bool]:
    actual: list[bool] = []
    now_ok: bool = time() > 0.0
    actual.append(now_ok)

    perf_before: float = perf_counter()
    mono_before: float = monotonic()
    sleep(0.01)
    perf_after: float = perf_counter()
    mono_after: float = monotonic()
    actual.append(perf_after >= perf_before and mono_after >= mono_before)
    return actual


def collect_format_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(strftime("%Y-%m-%d %H:%M:%S", 0.0) == "1970-01-01 00:00:00")
    gmt: struct_time = gmtime_struct(0.0)
    actual.append(gmt.tm_year == 1970 and gmt.tm_mon == 1 and gmt.tm_mday == 1 and gmt.tm_hour == 0 and gmt.tm_min == 0 and gmt.tm_sec == 0)

    local: struct_time = localtime_struct(0.0)
    actual.append(local.tm_year > 0 and local.tm_mon >= 1 and local.tm_mon <= 12 and local.tm_mday >= 1 and local.tm_mday <= 31 and local.tm_yday >= 1)
    actual.append(TIMEZONE == 0 and ALTZONE == 0 and DAYLIGHT == 0 and TZNAME[0] == "UTC" and TZNAME[1] == "UTC")
    return actual


def collect_parse_and_safety_actual() -> list[bool]:
    actual: list[bool] = []
    parsed_ok: bool = False
    try:
        parsed: str = strptime("2024-01-15 10:30:00", "%Y-%m-%d %H:%M:%S")
        parsed_ok = parsed == "2024-01-15T10:30:00"
    except ValueError as e:
        _ = str(e.message)
        parsed_ok = False
    actual.append(parsed_ok)

    invalid_parse_rejected: bool = False
    try:
        _bad: str = strptime("bad", "%Y-%m-%d %H:%M:%S")
    except ValueError as e:
        _ = str(e.message)
        invalid_parse_rejected = True
    actual.append(invalid_parse_rejected)

    sleep(-0.05)
    actual.append(True)

    out_of_range_gmt: struct_time = gmtime_struct(1.0e20)
    out_of_range_local: struct_time = localtime_struct(1.0e20)
    out_of_range_safe: bool = out_of_range_gmt.tm_year == 0 and out_of_range_local.tm_year == 0
    actual.append(out_of_range_safe)

    epoch_tm: struct_time = gmtime_struct(0.0)
    actual.append(mktime(epoch_tm) == 0.0)
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_clock_actual())
    append_all(actual, collect_format_actual())
    append_all(actual, collect_parse_and_safety_actual())
    assert_bool_vector_eq(actual, expected)
    assert str("stdlib_time_consolidated: pass") == "stdlib_time_consolidated: pass"
