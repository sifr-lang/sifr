# Reference: stdlib_parity_iter_fix_6_itertools_iterable_stdlib_readiness
from sifr.itertools import islice, accumulate, compress, dropwhile, takewhile, filterfalse, pairwise, batched, cycle
from sifr.pathlib import Path
from sifr.io import write_text
from sifr.os import getpid, run_command
from sifr.test import assert_bool_vector_eq


def lt3(x: int) -> bool:
    return x < 3


def collect_iterable_input_actual() -> list[bool]:
    actual: list[bool] = []
    nums: list[int] = [1, 2, 3, 4]

    actual.append(str(list(islice(iter(nums), 1, 4, 2))) == "[2, 4]")
    actual.append(str(list(accumulate(iter(nums)))) == "[1, 3, 6, 10]")
    actual.append(str(list(compress(iter(nums), iter([True, False, True, False])))) == "[1, 3]")
    actual.append(str(list(dropwhile(lt3, iter(nums)))) == "[3, 4]")
    actual.append(str(list(takewhile(lt3, iter(nums)))) == "[1, 2]")
    actual.append(str(list(filterfalse(lt3, iter(nums)))) == "[3, 4]")
    actual.append(str(pairwise(iter(nums))) == "[[1, 2], [2, 3], [3, 4]]")
    try:
        batched_values: list[list[int]] = batched(iter(nums), 2)
        actual.append(str(batched_values) == "[[1, 2], [3, 4]]")
    except ValueError as e:
        _ = str(e.message)
        actual.append(False)
    actual.append(str(list(cycle(iter(nums), 6))) == "[1, 2, 3, 4, 1, 2]")

    return actual


def collect_runtime_iterator_actual() -> list[bool]:
    actual: list[bool] = []
    base: str = "/tmp/sifr_stdlib_parity_iter_fix_6_" + str(getpid())

    try:
        _mk: str = run_command("mkdir -p " + base + "/sub")
        _w1: None = write_text(base + "/a.txt", "a")
        _w2: None = write_text(base + "/sub/b.txt", "b")

        root: Path = Path(base + "")
        entries_it: Iterator[str] = root.iterdir()
        actual.append(len(list(islice(entries_it, 1))) == 1)

        recursive_it: Iterator[str] = root.rglob("*.txt")
        actual.append(len(list(islice(recursive_it, 2))) == 2)
    except IOError as e:
        _ = str(e.message)
        actual = [False, False]
    finally:
        try:
            _rm: str = run_command("rm -rf " + base)
        except IOError as e:
            _rm_message: str = str(e.message)

    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True, True, True, True, True, True]
    actual: list[bool] = []

    append_all(actual, collect_iterable_input_actual())
    append_all(actual, collect_runtime_iterator_actual())

    assert_bool_vector_eq(actual, expected)
    assert str("iterable_stdlib: pass") == "iterable_stdlib: pass"
