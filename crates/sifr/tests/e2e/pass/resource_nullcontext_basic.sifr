from sifr.resource import NullContext, nullcontext


def main():
    empty: NullContext[None] = nullcontext()
    with empty as empty_value:
        assert empty_value == None

    ctx: NullContext[int] = nullcontext(41)
    with ctx as value:
        assert value == 41

    with nullcontext("ready") as second:
        assert second == "ready"
