# expect-stdout: len = 3
# expect-stdout: pop = 3
# expect-stdout: popleft = 1
# expect-stdout: len after = 1
# expect-stdout: maxlen test len = 3

from sifr.collections import deque

def main():
    d: deque = deque(0)
    d.append(1)
    d.append(2)
    d.append(3)
    print("len = " + str(d.len()))
    print("pop = " + str(d.pop()))
    print("popleft = " + str(d.popleft()))
    print("len after = " + str(d.len()))

    # Test maxlen
    d2: deque = deque(3)
    d2.append(1)
    d2.append(2)
    d2.append(3)
    d2.append(4)
    print("maxlen test len = " + str(d2.len()))
