
from sifr.collections import deque

def main():
    d: deque = deque(0)
    d.append(1)
    d.append(2)
    d.append(3)
    assert "len = " + str(d.len()) == "len = 3"
    assert "pop = " + str(d.pop()) == "pop = 3"
    assert "popleft = " + str(d.popleft()) == "popleft = 1"
    assert "len after = " + str(d.len()) == "len after = 1"

    # Test maxlen
    d2: deque = deque(3)
    d2.append(1)
    d2.append(2)
    d2.append(3)
    d2.append(4)
    assert "maxlen test len = " + str(d2.len()) == "maxlen test len = 3"
