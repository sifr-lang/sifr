# Test sifr.math stdlib module
from sifr.math import sqrt, floor, ceil, pi, e

def main():
    # sqrt
    result: float = sqrt(16.0)
    print(result)

    # floor
    f: int = floor(3.7)
    print(f)

    # ceil
    c: int = ceil(3.2)
    print(c)

    # pi constant
    print(pi > 3.14)
    print(pi < 3.15)

    # e constant
    print(e > 2.71)
    print(e < 2.72)

# expect-stdout: 4
# expect-stdout: 3
# expect-stdout: 4
# expect-stdout: true
# expect-stdout: true
# expect-stdout: true
# expect-stdout: true
