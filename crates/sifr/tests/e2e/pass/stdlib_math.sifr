# Test sifr.math stdlib module
from sifr.math import sqrt, floor, ceil, pi, e

def main():
    # sqrt
    result: float = sqrt(16.0)
    assert result == 4

    # floor
    f: int = floor(3.7)
    assert f == 3

    # ceil
    c: int = ceil(3.2)
    assert c == 4

    # pi constant
    assert pi > 3.14 == True
    assert pi < 3.15 == True

    # e constant
    assert e > 2.71 == True
    assert e < 2.72 == True

