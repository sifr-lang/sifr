# Test sifr.math stdlib module
from sifr.math import sqrt, floor, ceil, pi, e

def main():
    # sqrt
    result: float = sqrt(16.0)
    assert str(result) == '4'

    # floor
    f: int = floor(3.7)
    assert str(f) == '3'

    # ceil
    c: int = ceil(3.2)
    assert str(c) == '4'

    # pi constant
    assert str(pi > 3.14) == 'true'
    assert str(pi < 3.15) == 'true'

    # e constant
    assert str(e > 2.71) == 'true'
    assert str(e < 2.72) == 'true'

