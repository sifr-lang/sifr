
from sifr.pathlib import Path
from sifr.os import mkdir
from sifr.io import write_text

def main():
    try:
        dir_path: str = "/tmp/sifr_glob_test"
        _: None = mkdir(dir_path)
        _2: None = write_text(dir_path + "/test1.txt", "a")
        _3: None = write_text(dir_path + "/test2.txt", "b")
        p: Path = Path(dir_path)
        files_it: Iterator[str] = p.glob("*.txt")
        files: list[str] = list(files_it)
        assert str("glob found files = " + str(len(files) > 0)) == 'glob found files = true'
        all_files_it: Iterator[str] = p.rglob("*.txt")
        all_files: list[str] = list(all_files_it)
        assert str("rglob found files = " + str(len(all_files) > 0)) == 'rglob found files = true'
    except IOError as e:
        _ = str("error: " + e.message)
