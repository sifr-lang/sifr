# Extended read-only checks for sifr.env.
from sifr.env import getenv, getenv_opt, keys, values, items

def main():
    missing: str | None = getenv_opt("SIFR_ENV_EXT_MISSING")
    assert str(missing is None) == "true"
    assert getenv("SIFR_ENV_EXT_MISSING", "fallback") == "fallback"

    bad_empty: str | None = getenv_opt("")
    bad_equals: str | None = getenv_opt("BAD=KEY")
    assert str(bad_empty is None) == "true"
    assert str(bad_equals is None) == "true"

    k: list[str] = keys()
    v: list[str] = values()
    it: list[str] = items()
    assert str(len(k) == len(v)) == "true"
    assert str(len(k) == len(it)) == "true"
