# Extended parity/safety checks for sifr.env
from sifr.env import env_get, env_set, env_unset, getenv, setenv, unsetenv, keys, values, items

def main():
    # Baseline set/get
    env_set("SIFR_ENV_EXT_A", "1")
    assert str(getenv("SIFR_ENV_EXT_A", "x")) == '1'

    # Unset and fallback behavior
    env_unset("SIFR_ENV_EXT_A")
    missing: str | None = env_get("SIFR_ENV_EXT_A")
    if missing is None:
        assert str("unset ok") == 'unset ok'

    # Invalid key should be handled safely (no panic, no set)
    bad: str | None = env_get("BAD=KEY")
    if bad is None:
        assert str("invalid safe") == 'invalid safe'
    env_set("BAD=KEY", "blocked")
    bad_after: str | None = env_get("BAD=KEY")
    if bad_after is None:
        assert str("invalid set blocked") == 'invalid set blocked'

    # CPython-style wrappers
    setenv("SIFR_ENV_EXT_B", "2")
    assert str(getenv("SIFR_ENV_EXT_B", "x")) == '2'
    unsetenv("SIFR_ENV_EXT_B")
    assert str(getenv("SIFR_ENV_EXT_B", "fallback")) == 'fallback'

    k: list[str] = keys()
    v: list[str] = values()
    it: list[str] = items()
    assert str(len(k) == len(v)) == 'true'
    assert str(len(k) == len(it)) == 'true'

    # Confirm keys() contains the variable we just set
    setenv("SIFR_ENV_EXT_C", "3")
    found: bool = False
    names: list[str] = keys()
    for name in names:
        if name == "SIFR_ENV_EXT_C":
            found = True
    assert str(found) == 'true'
    unsetenv("SIFR_ENV_EXT_C")

