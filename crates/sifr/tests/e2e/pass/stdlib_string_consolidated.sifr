# Consolidated stdlib string coverage for stdlib_consolidation structure rules
from sifr.string import capwords, ascii_lowercase, digits, whitespace
from sifr.test import assert_bool_vector_eq

def collect_capwords_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(capwords("hello world test") == "Hello World Test")
    actual.append(capwords("hello   world") == "Hello World")
    actual.append(capwords("hello\tworld") == "Hello World")
    actual.append(capwords("hello\nworld") == "Hello World")
    actual.append(capwords("one\vtwo\fthree") == "One Two Three")
    actual.append(capwords("") == "")
    return actual

def collect_constants_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(ascii_lowercase == "abcdefghijklmnopqrstuvwxyz")
    actual.append(digits == "0123456789")
    actual.append(len(whitespace) == 6)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [
        True, True, True, True, True, True,
        True, True, True
    ]
    actual: list[bool] = []
    append_all(actual, collect_capwords_actual())
    append_all(actual, collect_constants_actual())
    assert_bool_vector_eq(actual, expected)
    assert str("stdlib_string_consolidated: pass") == "stdlib_string_consolidated: pass"
