# Adapted CPython glob subset for sifr.glob (canonical bool-vector format)
from sifr.glob import glob
from sifr.io import write_text
from sifr.os import run_command, getpid
from sifr.test import assert_bool_vector_eq


def collect_glob_actual() -> list[bool]:
    actual: list[bool] = []
    base: str = "/tmp/sifr_cpython_glob_subset_" + str(getpid())
    missing: str = base + "_missing"
    try:
        _mk: str = run_command("mkdir -p " + base + "/subdir")
        _w1: None = write_text(base + "/a.txt", "a")
        _w2: None = write_text(base + "/b.txt", "b")
        _w3: None = write_text(base + "/alpha.log", "log")
        _w4: None = write_text(base + "/data.csv", "csv")
        _w5: None = write_text(base + "/.secret.txt", "hidden")

        txt: list[str] = glob(base, "*.txt")
        txt_ok: bool = len(txt) == 2 and txt[0] == "a.txt" and txt[1] == "b.txt"
        actual.append(txt_ok)

        one_char_txt: list[str] = glob(base, "?.txt")
        one_char_ok: bool = len(one_char_txt) == 2 and one_char_txt[0] == "a.txt" and one_char_txt[1] == "b.txt"
        actual.append(one_char_ok)

        a_star: list[str] = glob(base, "a*")
        a_star_ok: bool = len(a_star) == 2 and a_star[0] == "a.txt" and a_star[1] == "alpha.log"
        actual.append(a_star_ok)

        dirs: list[str] = glob(base, "sub*")
        dirs_ok: bool = len(dirs) == 1 and dirs[0] == "subdir"
        actual.append(dirs_ok)

        hidden: list[str] = glob(base, ".*.txt")
        hidden_ok: bool = len(hidden) == 1 and hidden[0] == ".secret.txt"
        actual.append(hidden_ok)

        none_found: list[str] = glob(base, "*.xyz")
        actual.append(len(none_found) == 0)

        missing_dir: list[str] = glob(missing, "*.txt")
        actual.append(len(missing_dir) == 0)
    except IOError as e:
        _ = str(e.message)
        actual = [False, False, False, False, False, False, False]
    finally:
        _clean: str = run_command("rm -rf " + base)
    return actual


def main():
    expected: list[bool] = [True, True, True, True, True, True, True]
    actual: list[bool] = collect_glob_actual()

    assert_bool_vector_eq(actual, expected)
    assert str("cpython_glob_subset: pass") == "cpython_glob_subset: pass"
