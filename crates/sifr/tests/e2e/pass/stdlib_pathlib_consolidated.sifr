# Consolidated stdlib pathlib coverage for stdlib_consolidation structure rules
from sifr.pathlib import basename, dirname, extension, stem, is_absolute, join_path, Path
from sifr.os import getpid
from sifr.test import assert_bool_vector_eq


def collect_path_functions_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(basename("/home/user/file.txt") == "file.txt")
    actual.append(dirname("/home/user/file.txt") == "/home/user")
    actual.append(extension("/home/user/file.txt") == ".txt")
    actual.append(stem("/home/user/file.txt") == "file")
    absolute_checks_ok: bool = is_absolute("/tmp") and not is_absolute("tmp/file.txt")
    actual.append(absolute_checks_ok)
    actual.append(join_path("/tmp", "demo.txt") == "/tmp/demo.txt")
    return actual


def collect_path_class_actual() -> list[bool]:
    actual: list[bool] = []
    sample: Path = Path("/tmp/myfile.txt")
    actual.append(sample.name() == "myfile.txt")
    actual.append(sample.parent().to_str() == "/tmp")
    actual.append(sample.suffix() == ".txt")
    actual.append(sample.stem() == "myfile")
    actual.append(sample.is_absolute())
    actual.append(sample.to_str() == "/tmp/myfile.txt")
    actual.append(sample.joinpath("sub").to_str() == "/tmp/myfile.txt/sub")
    actual.append(sample.with_name("renamed.txt").to_str() == "/tmp/renamed.txt")
    actual.append(sample.with_suffix(".csv").to_str() == "/tmp/myfile.csv")
    return actual


def collect_filesystem_actual() -> list[bool]:
    actual: list[bool] = []
    base: str = "/tmp/sifr_stdlib_pathlib_consolidated_" + str(getpid())
    dir_path: str = base + ""
    sub_path: str = base + "/sub"
    f1_path: str = base + "/a.txt"
    f2_path: str = base + "/sub/b.txt"
    dirp: Path = Path(dir_path)
    sub: Path = Path(sub_path)
    f1: Path = Path(f1_path)
    f2: Path = Path(f2_path)

    read_write_ok: bool = False
    file_state_ok: bool = False
    glob_ok: bool = False
    rglob_ok: bool = False
    iterdir_ok: bool = False
    resolve_ok: bool = False
    cleanup_ok: bool = False
    try:
        _dm: None = dirp.mkdir()
        _sm: None = sub.mkdir()
        _w1: None = f1.write_text("alpha")
        _w2: None = f2.write_text("beta")
        c1: str = f1.read_text()
        c2: str = f2.read_text()
        read_write_ok = c1 == "alpha" and c2 == "beta"

        _touch: None = Path(base + "/touch.txt").touch()
        file_state_ok = f1.exists() and f1.is_file() and dirp.is_dir()

        g_it: Iterator[str] = dirp.glob("*.txt")
        g: list[str] = list(g_it)
        glob_ok = len(g) >= 2
        rg_it: Iterator[str] = dirp.rglob("*.txt")
        rg: list[str] = list(rg_it)
        rglob_ok = len(rg) >= 3

        entries_it: Iterator[str] = dirp.iterdir()
        entries: list[str] = list(entries_it)
        iterdir_ok = len(entries) >= 2

        resolved: str = dirp.resolve()
        resolve_ok = len(resolved) > 0

        _u1: None = f1.unlink()
        _u2: None = f2.unlink()
        _u3: None = Path(base + "/touch.txt").unlink()
        _sr: None = sub.rmdir()
        _dr: None = dirp.rmdir()
        cleanup_ok = not dirp.exists()
    except IOError as e:
        _ = str(e.message)

    actual.append(read_write_ok)
    actual.append(file_state_ok)
    actual.append(glob_ok)
    actual.append(rglob_ok)
    actual.append(iterdir_ok)
    actual.append(resolve_ok)
    actual.append(cleanup_ok)

    missing_read_rejected: bool = False
    try:
        _missing_content: str = Path("/tmp/sifr_stdlib_pathlib_consolidated_missing.txt").read_text()
    except IOError as e:
        _ = str(e.message)
        missing_read_rejected = True
    actual.append(missing_read_rejected)
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [
        True, True, True, True, True, True,
        True, True, True, True, True, True, True, True, True,
        True, True, True, True, True, True, True, True
    ]
    actual: list[bool] = []
    append_all(actual, collect_path_functions_actual())
    append_all(actual, collect_path_class_actual())
    append_all(actual, collect_filesystem_actual())
    assert_bool_vector_eq(actual, expected)
    assert str("stdlib_pathlib_consolidated: pass") == "stdlib_pathlib_consolidated: pass"
