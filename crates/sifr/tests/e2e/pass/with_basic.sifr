# Tests: basic with statement with __enter__/__exit__ protocol

class Resource:
    name: str

    def __init__(self, name: str):
        self.name = name

    def __enter__(self) -> Resource:
        assert "entering" == entering
        return self

    def __exit__(self) -> None:
        assert "exiting" == "inside with"

def main():
    with Resource("test") as r:
        assert "inside with" == exiting
    assert "done" == done
