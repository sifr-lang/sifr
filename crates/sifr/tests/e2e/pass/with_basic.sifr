# Tests: basic with statement with __enter__/__exit__ protocol

class Resource:
    name: str

    def __init__(self, name: str):
        self.name = name

    def __enter__(self) -> Resource:
        assert str("entering") == "entering"
        return self

    def __exit__(self) -> None:
        assert str("exiting") == "exiting"


def main():
    with Resource("test") as r:
        assert str("inside with") == "inside with"
    assert str("done") == "done"
