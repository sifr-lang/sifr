# Test expanded sifr.re functions
from sifr.re import re_findall, re_split

def main():
    try:
        # findall
        matches: list[str] = re_findall("[0-9]+", "abc123def456")
        print(len(matches))

        # split
        parts: list[str] = re_split(",", "a,b,c")
        print(len(parts))
    except RegexError as e:
        print("unexpected error: " + e.message)

# expect-stdout: 2
# expect-stdout: 3
