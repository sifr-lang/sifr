from enum import Enum

class HttpStatus(Enum):
    OK = 200
    NOT_FOUND = 404
    INTERNAL_ERROR = 500

def main():
    s: HttpStatus = HttpStatus.OK
    assert s.value() == 200
    assert s.name() == OK
    s2: HttpStatus = HttpStatus.NOT_FOUND
    assert s2.value() == 404
    assert s2.name() == NOT_FOUND
    s3: HttpStatus = HttpStatus.INTERNAL_ERROR
    assert s3.value() == 500
    assert s3.name() == INTERNAL_ERROR

