# Test sifr.hashlib stdlib module
from sifr.hashlib import sha256, md5

def main():
    # SHA-256 of empty string
    h: str = sha256("")
    print(h)

    # MD5 of empty string
    m: str = md5("")
    print(m)

# expect-stdout: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
# expect-stdout: d41d8cd98f00b204e9800998ecf8427e
