# Adapted CPython heapq subset for sifr.heapq (canonical vector format)
from sifr.heapq import (
    heapify, heappush, heappop,
    nsmallest, nlargest,
    heappushpop, heapreplace
)
from sifr.test import assert_bool_vector_eq

def main():
    expected: list[bool] = [
        True, True, True, True, True, True,
        True, True, True, True, True, True,
        True, True
    ]
    actual: list[bool] = []

    h: list[int] = []
    heappush(h, 5)
    heappush(h, 3)
    heappush(h, 7)
    heappush(h, 1)

    p1: int | None = heappop(h)
    p2: int | None = heappop(h)
    p3: int | None = heappop(h)
    p4: int | None = heappop(h)
    actual.append(p1 is not None and p1 == 1)
    actual.append(p2 is not None and p2 == 3)
    actual.append(p3 is not None and p3 == 5)
    actual.append(p4 is not None and p4 == 7)
    actual.append(len(h) == 0)

    h2: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]
    heapify(h2)
    sorted_vals: list[int] = []
    while len(h2) > 0:
        v: int | None = heappop(h2)
        if v is not None:
            sorted_vals.append(v)
    actual.append(str(sorted_vals) == "[1, 1, 2, 3, 4, 5, 6, 9]")

    items: list[int] = [4, 1, 5, 2, 3]
    actual.append(str(nsmallest(3, items)) == "[1, 2, 3]")
    actual.append(str(nlargest(3, items)) == "[5, 4, 3]")
    actual.append(str(nsmallest(1, items)) == "[1]")
    actual.append(str(nlargest(1, items)) == "[5]")

    empty: list[int] = []
    actual.append(heappop(empty) is None)
    actual.append(heapreplace(empty, 8) is None and str(empty) == "[]")

    hp_src: list[int] = [3, 5, 7]
    hp_ret: int | None = heappushpop(hp_src, 4)
    actual.append(hp_ret is not None and hp_ret == 3)
    actual.append(str(hp_src) == "[3, 5, 7]")

    assert_bool_vector_eq(actual, expected)
    assert str("cpython_heapq_subset: pass") == "cpython_heapq_subset: pass"
