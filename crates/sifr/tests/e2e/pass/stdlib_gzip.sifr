
from sifr.gzip import compress, decompress

def main():
    data: str = "Hello, World!"
    compressed: bytes = compress(data)
    assert str("compressed len > 0 = " + str(len(compressed) > 0)) == 'compressed len > 0 = true'

    try:
        decompressed: str = decompress(compressed)
        assert str("decompressed = " + decompressed) == 'decompressed = Hello, World!'
    except IOError as e:
        _ = str("error: " + e.message)
