
from sifr.gzip import compress, decompress

def main():
    data: str = "Hello, World!"
    compressed: list[int] = compress(data)
    assert "compressed len > 0 = " + str(len(compressed) > 0) == "compressed len > 0 = true"

    try:
        decompressed: str = decompress(compressed)
        assert "decompressed = " + decompressed == "decompressed = Hello, World!"
    except IOError as e:
        print("error: " + e.message)
