
def validate(x: int) -> Result[int, ValueError]:
    if x < 0:
        raise ValueError("out of range")
    return x

def divide(a: int, b: int) -> Result[int, DivisionError]:
    if b == 0:
        raise DivisionError("division by zero")
    return a // b

def read_file(path: str) -> Result[str, IOError]:
    if path == "missing.txt":
        raise IOError("file not found")
    return "contents"

def parse_data(s: str) -> Result[int, ParseError]:
    if s == "bad":
        raise ParseError("invalid format")
    return 42

def main():
    try:
        val: int = validate(-1)
    except ValueError as e:
        assert f"caught ValueError: {e.message}" == "caught ValueError: out of range"

    try:
        val2: int = divide(10, 0)
    except DivisionError as e:
        assert f"caught DivisionError: {e.message}" == "caught DivisionError: division by zero"

    try:
        data: str = read_file("missing.txt")
    except IOError as e:
        assert f"caught IOError: {e.message}" == "caught IOError: file not found"

    try:
        num: int = parse_data("bad")
    except ParseError as e:
        assert f"caught ParseError: {e.message}" == "caught ParseError: invalid format"

    assert "all built-in errors work" == "all built-in errors work"
