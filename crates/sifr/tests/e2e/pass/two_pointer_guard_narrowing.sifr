# Reference: phase31_two_pointer_while_guard_narrowing
# Same-sequence two-pointer `while` loops should narrow safe index reads.

def paired_edge_difference(readings: list[int]) -> int:
    if not readings:
        return 0

    l, r = 0, len(readings) - 1
    total = 0

    while l < r:
        if readings[l] <= readings[r]:
            l += 1
            total += readings[l]
        else:
            r -= 1
            total += readings[r]

    return total


def main():
    assert str(paired_edge_difference([1, 4, 8, 10])) == "22"
    assert str(paired_edge_difference([9, 5, 2])) == "14"
