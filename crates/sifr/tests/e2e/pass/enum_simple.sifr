from enum import Enum

class Color(Enum):
    RED = 1
    GREEN = 2
    BLUE = 3

def main():
    c: Color = Color.RED
    print(c)
    c2: Color = Color.GREEN
    print(c2)
    print(c == Color.RED)
    print(c == Color.GREEN)

# expect-stdout: RED
# expect-stdout: GREEN
# expect-stdout: true
# expect-stdout: false
