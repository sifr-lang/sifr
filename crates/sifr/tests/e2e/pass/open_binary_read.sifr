
from sifr.io import write_text

def main():
    path: str = "/tmp/sifr_open_binary_read_test.txt"
    try:
        _: None = write_text(path, "hello")
        f = open(path, "rb")
        data: bytes = f.read_bytes()
        f.close()
        assert str("bytes count > 0 = " + str(len(data) > 0)) == 'bytes count > 0 = true'
        assert str("binary read ok") == 'binary read ok'
    except IOError as e:
        _ = str("error: " + e.message)
