from sifr.math import fmod

def reverse_last_digit(x: int) -> Result[int, ValueError | FloatOverflowError | FloatPrecisionLossError]:
    try:
        x_float: float = float(x)
        return int(fmod(x_float, 10.0))
    except ValueError as error:
        raise ValueError(error.message)
    except FloatOverflowError as error:
        raise FloatOverflowError(error.message)
    except FloatPrecisionLossError as error:
        raise FloatPrecisionLossError(error.message)

def main():
    try:
        positive: int = reverse_last_digit(123)
        negative: int = reverse_last_digit(-123)
        assert str(positive) == "3"
        assert str(negative) == "-3"
    except Error:
        assert False
