class StreamCloseError(Error):
    pass


class ClosableCounter:
    current: int
    stop: int
    closed: bool

    def __init__(self, start: int, stop: int):
        self.current = start
        self.stop = stop
        self.closed = False

    async def anext(mut self) -> Result[Option[int], StreamCloseError]:
        if self.current >= self.stop:
            return None
        value: int = self.current
        self.current = self.current + 1
        next_value: Option[int] = value
        return next_value

    async def aclose(mut self) -> Result[None, StreamCloseError]:
        self.closed = True
        return None


async def main() -> Result[None, StreamCloseError]:
    stream: ClosableCounter = ClosableCounter(0, 5)
    total: int = 0

    async for value in stream:
        if value == 3:
            break
        total = total + value

    assert total == 3
    assert stream.closed

    mapping: dict[str, int] = {"key": 1}
    key: str = "key"
    if key not in mapping:
        return None
    refresh_total: int = 0
    refresh_stream: ClosableCounter = ClosableCounter(0, 2)
    async for _value in refresh_stream:
        refresh_total += mapping[key]
        mapping[key] = 100
    assert refresh_total == 101
    return None
