# Safety-focused checks for first-class bytes


def main():
    expected: list[str] = ["Hello", "caught unicode hex parse", "4869", "00ff", "caught decode invalid continuation", "caught decode invalid leading"]
    expected_index: int = 0
    try:
        bad_hi: str = b"\xff".decode()
        assert str("should not reach") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("caught decode invalid leading") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        bad_lo: str = b"\x80".decode()
        assert str("should not reach") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("caught decode invalid continuation") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        h1: str = b"\x00\xff".hex()
        assert str(h1) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        h2: str = b"Hi".hex()
        assert str(h2) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # Previously this path could panic due to byte-index slicing on UTF-8.
    try:
        bad_hex: bytes = bytes.from_hex("€")
        assert str(len(bad_hex)) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("caught unicode hex parse") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # Whitespace-tolerant hex parsing remains supported.
    try:
        ok_hex: bytes = bytes.from_hex("48 65 6c 6c 6f")
        ok_text: str = ok_hex.decode()
        assert str(ok_text) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
