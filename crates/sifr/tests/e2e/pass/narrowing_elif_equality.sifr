# Test: elif equality chain narrowing (no Never)
# expect-stdout: one
# expect-stdout: two
# expect-stdout: three
# expect-stdout: other

def classify(x: int) -> str:
    if x == 1:
        return "one"
    elif x == 2:
        return "two"
    elif x == 3:
        return "three"
    return "other"

def main():
    print(classify(1))
    print(classify(2))
    print(classify(3))
    print(classify(99))
