# Test: elif equality chain narrowing (no Never)

def classify(x: int) -> str:
    if x == 1:
        return "one"
    elif x == 2:
        return "two"
    elif x == 3:
        return "three"
    return "other"

def main():
    assert classify(1) == one
    assert classify(2) == two
    assert classify(3) == three
    assert classify(99) == other
