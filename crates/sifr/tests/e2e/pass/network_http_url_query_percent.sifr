from sifr.url import (
    Url,
    UrlError,
    UrlQuery,
    build_query,
    build,
    normalize_path,
    parse_query,
    parse,
    percent_decode,
    percent_decode_bytes,
    percent_encode,
    percent_encode_bytes,
)


def main() -> Result[None, Error]:
    try:
        parsed: Url = parse("https://user:pass@example.com:8443/a/../b?x=1&x=2#frag")
        assert parsed.get_scheme() == "https"
        assert parsed.get_username() == "user"
        assert parsed.get_password() == "pass"
        assert parsed.get_host() == "example.com"
        assert parsed.get_port() == 8443
        assert parsed.get_path() == "/b"
        assert parsed.get_query() == "x=1&x=2"
        assert parsed.get_fragment() == "frag"

        built: Url = build("https", "xn--bcher-kva.example", "/docs", "q=sifr", 443)
        assert built.get_host() == "xn--bcher-kva.example"
        assert built.get_path() == "/docs"
        assert built.get_query() == "q=sifr"

        ipv4: Url = parse("http://127.0.0.1:8080/health")
        assert ipv4.get_host() == "127.0.0.1"
        assert ipv4.get_port() == 8080
        ipv6: Url = build("http", "::1", "/ready", None, 8080)
        assert ipv6.get_host() == "[::1]"
        assert ipv6.get_port() == 8080
        assert ipv6.get_path() == "/ready"
        safe_build: Url = build("https", "example.com", "/", None, None)
        assert safe_build.get_fragment() is None
        escaped_ascii_host: Url = parse("https://%61.example/ok")
        assert escaped_ascii_host.get_host() == "a.example"
        encoded_slash_path: Url = parse("https://example.com/a/%2F/b")
        assert encoded_slash_path.get_path() == "/a/%2F/b"

        encoded: str = percent_encode("a b/ç")
        assert encoded == "a%20b%2F%C3%A7"
        decoded: str = percent_decode(encoded)
        assert decoded == "a b/ç"

        byte_encoded: str = percent_encode_bytes(b"\xff /")
        assert byte_encoded == "%FF%20%2F"
        byte_decoded: bytes = percent_decode_bytes(byte_encoded)
        assert byte_decoded == b"\xff /"

        normalized: str = normalize_path("/a/b/../c/./")
        assert normalized == "/a/c/"
        encoded_slash: str = normalize_path("/a/%2F/../b")
        assert encoded_slash == "/a/b"

        query: UrlQuery = parse_query("a=1&b=two+words&a=3")
        assert query.get("a") == "1"
        assert query.get("b") == "two words"
        assert query.get("missing") is None
        rebuilt: str = build_query(query.items())
        assert rebuilt == "a=1&b=two+words&a=3"
    except UrlError as e:
        raise Error(e.message)

    blocked_host: bool = False
    try:
        _blocked: Url = parse("https://é.example/")
        assert False
    except UrlError as e:
        blocked_host = "non-ASCII URL hosts are blocked" in e.message
    assert blocked_host

    escaped_blocked_host: bool = False
    try:
        _escaped_blocked: Url = parse("https://%C3%A9.example/")
        assert False
    except UrlError as e:
        escaped_blocked_host = "non-ASCII URL hosts are blocked" in e.message
    assert escaped_blocked_host

    bad_percent: bool = False
    try:
        _bad_decode: str = percent_decode("%zz")
        assert False
    except UrlError as e:
        bad_percent = "invalid percent escape" in e.message
    assert bad_percent

    bad_port: bool = False
    try:
        _bad_url: Url = build("https", "example.com", "/", None, 70000)
        assert False
    except UrlError as e:
        bad_port = "URL port must be in 0..65535" in e.message
    assert bad_port

    bad_scheme: bool = False
    try:
        _bad_scheme: Url = build("https://attacker.example/?", "example.com", "/", None, None)
        assert False
    except UrlError as e:
        bad_scheme = "invalid URL scheme" in e.message
    assert bad_scheme

    host_fragment_injection: bool = False
    try:
        _host_fragment: Url = build("https", "evil.example#frag", "/", None, None)
        assert False
    except UrlError as e:
        host_fragment_injection = "invalid URL host" in e.message
    assert host_fragment_injection

    host_userinfo_injection: bool = False
    try:
        _host_userinfo: Url = build("https", "user@example.com", "/", None, None)
        assert False
    except UrlError as e:
        host_userinfo_injection = "invalid URL host" in e.message
    assert host_userinfo_injection

    host_path_injection: bool = False
    try:
        _host_path: Url = build("https", "example.com/path", "/", None, None)
        assert False
    except UrlError as e:
        host_path_injection = "invalid URL host" in e.message
    assert host_path_injection

    bad_query_utf8: bool = False
    try:
        _bad_query: UrlQuery = parse_query("a=%FF")
        assert False
    except UrlError as e:
        bad_query_utf8 = "query component is not UTF-8" in e.message
    assert bad_query_utf8

    return None
