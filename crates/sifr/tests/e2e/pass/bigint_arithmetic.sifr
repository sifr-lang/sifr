# TEMPORARY TRANSITION FIXTURE: exercises the public bigint alias until alias removal.
def main():
    a: bigint = bigint(100)
    b: bigint = bigint(200)
    assert str(a + b) == '300'
    assert str(b - a) == '100'
    assert str(a * b) == '20000'
    assert str(b // a) == '2'
    assert str(b % bigint(3)) == '2'
