# Test: printing Option values directly in print() and f-strings
# This covers the regression where Option<T> in display contexts
# caused Rust compilation errors (Option doesn't impl Display).


def main():
    # --- print() with Option from list indexing ---
    nums: list[int] = [10, 20, 30]
    assert str(nums[1]) == '20'
    assert str(nums[99]) == 'None'

    # --- f-string with Option from list indexing ---
    assert str(f"first: {nums[0]}") == 'first: 10'
    assert str(f"missing: {nums[99]}") == 'missing: None'

    # --- f-string with Option from dict indexing ---
    ages: dict[str, int] = {"alice": 30, "bob": 25}
    assert str(f"alice age: {ages['alice']}") == 'alice age: 30'
    assert str(f"missing key: {ages['charlie']}") == 'missing key: None'

    # --- f-string with Option from string indexing ---
    s: str = "hello"
    assert str(f"char: {s[0]}") == 'char: h'
    assert str(f"oob char: {s[99]}") == 'oob char: None'
