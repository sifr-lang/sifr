# Test Path class
from sifr.pathlib import Path

def main():
    p: Path = Path("/home/user/docs/file.txt")
    assert str(p.name()) == 'file.txt'
    assert str(p.parent()) == '/home/user/docs'
    assert str(p.suffix()) == '.txt'
    assert str(p.stem()) == 'file'
    assert str(p.is_absolute()) == 'true'
    assert str(p.to_str()) == '/home/user/docs/file.txt'
    assert str(p.joinpath("sub")) == '/home/user/docs/file.txt/sub'

