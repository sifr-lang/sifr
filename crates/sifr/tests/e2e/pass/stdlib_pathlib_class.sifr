# Test Path class
from sifr.pathlib import Path

def main():
    p: Path = Path("/home/user/docs/file.txt")
    assert p.name() == file.txt
    assert p.parent() == "/home/user/docs"
    assert p.suffix() == ".txt"
    assert p.stem() == file
    assert p.is_absolute() == True
    assert p.to_str() == "/home/user/docs/file.txt"
    assert p.joinpath("sub") == "/home/user/docs/file.txt/sub"

