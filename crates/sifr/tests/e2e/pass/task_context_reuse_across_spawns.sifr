from sifr.task import Context, current_context

async def worker() -> int:
    await task.sleep(0.0)
    assert str(current_context()) == "shared"
    return 1

async def main() -> Result[None, ScopeFailure]:
    context: Context = Context("shared")
    async with task.scope() as scope:
        first = task.spawn_scoped(worker(), ctx=context)
        second = task.spawn_scoped(worker(), ctx=context)
        assert str(context) == "shared"
        assert await first == task.Ok(1)
        assert await second == task.Ok(1)
    assert str(context) == "shared"
    return None
