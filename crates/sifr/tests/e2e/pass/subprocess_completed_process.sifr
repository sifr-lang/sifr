
from sifr.subprocess import run, CompletedProcess

def main():
    try:
        result: CompletedProcess = run("echo hello")
        assert str("returncode = " + str(result.returncode)) == 'returncode = 0'
        assert str("stdout has content = " + str(len(result.stdout) > 0)) == 'stdout has content = true'
        assert str("CompletedProcess ok") == 'CompletedProcess ok'
    except IOError as e:
        _ = str("error: " + e.message)
