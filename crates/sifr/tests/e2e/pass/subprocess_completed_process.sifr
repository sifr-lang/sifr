
from sifr.subprocess import run, CompletedProcess

def main():
    try:
        result: CompletedProcess = run("echo hello")
        assert "returncode = " + str(result.returncode) == "returncode = 0"
        assert "stdout has content = " + str(len(result.stdout) > 0) == "stdout has content = true"
        assert "CompletedProcess ok" == "CompletedProcess ok"
    except IOError as e:
        print("error: " + e.message)
