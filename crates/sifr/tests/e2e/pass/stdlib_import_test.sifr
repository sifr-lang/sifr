# Test that stdlib imports resolve to .sifr files (two-phase compilation)
# This verifies the core stdlib import architecture: user code imports from sifr.*
# which resolves to embedded .sifr files compiled in the first import pass.
from sifr.test import assert_eq
from sifr.math import sqrt, pi
from sifr.string import ascii_lowercase

def main():
    # Verify sifr.test resolves (import pass compiled)
    assert_eq(1, 1)

    # Verify sifr.math resolves with functions and constants
    result: float = sqrt(4.0)
    assert_eq(int(result), 2)

    # Verify sifr.string resolves with module-level constants
    assert_eq(len(ascii_lowercase), 26)

    assert str("stdlib imports resolved successfully") == 'stdlib imports resolved successfully'

