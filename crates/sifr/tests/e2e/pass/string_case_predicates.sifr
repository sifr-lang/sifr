
def main():
    s: str = "hello world"
    assert "capitalize = " + s.capitalize() == "capitalize = Hello world"
    assert "title = " + s.title() == "title = Hello World"

    mixed: str = "AbC"
    assert "swapcase = " + mixed.swapcase() == "swapcase = aBc"

    assert "isdigit = " + str("123".isdigit()) == "isdigit = true"
    assert "isalpha = " + str("abc".isalpha()) == "isalpha = true"
    assert "isalnum = " + str("a1".isalnum()) == "isalnum = true"
    assert "isspace = " + str("   ".isspace()) == "isspace = true"
    assert "isupper = " + str("ABC".isupper()) == "isupper = true"
    assert "islower = " + str("abc".islower()) == "islower = true"
