# expect-stdout: capitalize = Hello world
# expect-stdout: title = Hello World
# expect-stdout: swapcase = aBc
# expect-stdout: isdigit = true
# expect-stdout: isalpha = true
# expect-stdout: isalnum = true
# expect-stdout: isspace = true
# expect-stdout: isupper = true
# expect-stdout: islower = true

def main():
    s: str = "hello world"
    print("capitalize = " + s.capitalize())
    print("title = " + s.title())

    mixed: str = "AbC"
    print("swapcase = " + mixed.swapcase())

    print("isdigit = " + str("123".isdigit()))
    print("isalpha = " + str("abc".isalpha()))
    print("isalnum = " + str("a1".isalnum()))
    print("isspace = " + str("   ".isspace()))
    print("isupper = " + str("ABC".isupper()))
    print("islower = " + str("abc".islower()))
