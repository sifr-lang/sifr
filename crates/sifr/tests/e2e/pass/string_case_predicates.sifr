
def main():
    s: str = "hello world"
    assert str("capitalize = " + s.capitalize()) == 'capitalize = Hello world'
    assert str("title = " + s.title()) == 'title = Hello World'

    mixed: str = "AbC"
    assert str("swapcase = " + mixed.swapcase()) == 'swapcase = aBc'

    assert str("isdigit = " + str("123".isdigit())) == 'isdigit = true'
    assert str("isalpha = " + str("abc".isalpha())) == 'isalpha = true'
    assert str("isalnum = " + str("a1".isalnum())) == 'isalnum = true'
    assert str("isspace = " + str("   ".isspace())) == 'isspace = true'
    assert str("isupper = " + str("ABC".isupper())) == 'isupper = true'
    assert str("islower = " + str("abc".islower())) == 'islower = true'
