from enum import Enum

class Color(Enum):
    RED = 1
    GREEN = 2
    BLUE = 3

def describe(c: Color) -> str:
    match c:
        case Color.RED:
            return "red"
        case Color.GREEN:
            return "green"
        case Color.BLUE:
            return "blue"

def main():
    print(describe(Color.RED))
    print(describe(Color.GREEN))
    print(describe(Color.BLUE))

# expect-stdout: red
# expect-stdout: green
# expect-stdout: blue
