from enum import Enum

class Color(Enum):
    RED = 1
    GREEN = 2
    BLUE = 3

def describe(c: Color) -> str:
    match c:
        case Color.RED:
            return "red"
        case Color.GREEN:
            return "green"
        case Color.BLUE:
            return "blue"

def main():
    assert str(describe(Color.RED)) == 'red'
    assert str(describe(Color.GREEN)) == 'green'
    assert str(describe(Color.BLUE)) == 'blue'

