
def main():
    s: str = "hello"

    # Valid index returns Some
    c: str | None = s[0]
    if c is not None:
        assert f"char: {c}" == "char: h"

    # Out-of-bounds returns None
    oob: str | None = s[100]
    if oob is not None:
        assert f"char: {oob}" == "out of bounds"
    else:
        print("out of bounds")
