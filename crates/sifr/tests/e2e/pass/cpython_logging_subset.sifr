# Adapted CPython logging subset for sifr.logging (canonical bool-vector format)
from sifr.logging import getLogger, basicConfig, Handler, FileHandler, StreamHandler, NullHandler, Formatter
from sifr.logging import Logger, DEBUG, INFO, WARNING, ERROR, CRITICAL, NOTSET
from sifr.logging import log_info, log_warn, log_error, log_debug
from sifr.io import write_text, read_text, exists
from sifr.os import run_command
from sifr.tempfile import mktemp_path
from sifr.test import assert_bool_vector_eq


def collect_app_flow_actual(base: str) -> list[bool]:
    actual: list[bool] = []
    app_log: str = base + "/app.log"
    app_flow_ok: bool = False
    try:
        _w: None = write_text(app_log, "")
        logger: Logger = getLogger("app")
        logger.set_file(app_log)
        logger.set_level(INFO)
        logger.info("hello")
        logger.warning("watch")
        logger.error("boom")
        logger.debug("hidden")
        app_content: str = read_text(app_log)
        app_flow_ok = app_content == "[INFO] app: hello\n[WARNING] app: watch\n[ERROR] app: boom\n"
    except IOError as e:
        _ = str(e.message)
    actual.append(app_flow_ok)
    return actual


def collect_basic_config_actual(base: str) -> list[bool]:
    actual: list[bool] = []
    root_log: str = base + "/root.log"
    child_log: str = base + "/child.log"
    basic_config_ok: bool = False
    try:
        _w1: None = write_text(root_log, "")
        _w2: None = write_text(child_log, "")

        root: Logger = basicConfig(WARNING)
        root.set_file(root_log)
        root.info("skip")
        root.warning("root-warn")

        child: Logger = getLogger("child")
        child.set_file(child_log)
        child.info("skip-child")
        child.error("child-error")

        root_content: str = read_text(root_log)
        child_content: str = read_text(child_log)
        basic_config_ok = root_content == "[WARNING] root: root-warn\n" and child_content == "[ERROR] child: child-error\n"
    except IOError as e:
        _ = str(e.message)
    actual.append(basic_config_ok)
    return actual


def collect_handler_actual(base: str) -> list[bool]:
    actual: list[bool] = []
    handler_log: str = base + "/handler.log"
    handler_ok: bool = False
    try:
        _w: None = write_text(handler_log, "")
        handler: FileHandler = FileHandler(handler_log + "")
        handler.set_formatter(Formatter("%(name)s|%(levelname)s|%(message)s"))
        handler.emit("INFO", "svc", "hi")
        handler_content: str = read_text(handler_log)
        handler_ok = handler_content == "svc|INFO|hi\n"
    except IOError as e:
        _ = str(e.message)
    actual.append(handler_ok)
    return actual


def collect_constants_and_helpers_actual() -> list[bool]:
    actual: list[bool] = []
    constants_ok: bool = DEBUG == 10 and INFO == 20 and WARNING == 30 and ERROR == 40 and CRITICAL == 50 and NOTSET == 0
    actual.append(constants_ok)

    helper_ok: bool = True
    log_info("subset info")
    log_warn("subset warn")
    log_error("subset error")
    log_debug("subset debug")
    actual.append(helper_ok)
    return actual


def collect_missing_path_actual(base: str) -> list[bool]:
    actual: list[bool] = []
    missing_logger_log: str = base + "/missing/logger.log"
    missing_handler_log: str = base + "/missing2/handler.log"

    missing_logger_safe: bool = False
    try:
        missing_logger: Logger = getLogger("missing")
        missing_logger.set_file(missing_logger_log)
        missing_logger.error("should fail")
        missing_logger_safe = not exists(missing_logger_log)
    except IOError as e:
        _ = str(e.message)
        missing_logger_safe = False

    missing_handler_safe: bool = False
    try:
        bad_handler: FileHandler = FileHandler(missing_handler_log + "")
        bad_handler.emit("INFO", "svc", "should fail")
        missing_handler_safe = not exists(missing_handler_log)
    except IOError as e:
        _ = str(e.message)
        missing_handler_safe = False

    actual.append(missing_logger_safe)
    actual.append(missing_handler_safe)
    return actual


def collect_handler_hierarchy_actual(base: str) -> list[bool]:
    actual: list[bool] = []

    hierarchy_log: str = base + "/hierarchy.log"
    hierarchy_ok: bool = False
    try:
        _w_h: None = write_text(hierarchy_log, "")
        logger: Logger = getLogger("hier")
        logger.set_level(DEBUG)
        logger.set_file(hierarchy_log)
        fh: FileHandler = FileHandler(hierarchy_log + "", INFO)
        logger.add_handler(fh)
        logger.info("visible")
        logger.debug("hidden")
        logger.clear_handler()
        hierarchy_content: str = read_text(hierarchy_log)
        hierarchy_ok = hierarchy_content == "INFO:hier:visible\n"
    except IOError as e:
        _ = str(e.message)
    actual.append(hierarchy_ok)

    null_log: str = base + "/null.log"
    null_ok: bool = False
    try:
        _w_n: None = write_text(null_log, "")
        null_logger: Logger = getLogger("null")
        null_logger.set_level(DEBUG)
        null_logger.set_file(null_log)
        nh: NullHandler = NullHandler()
        null_logger.set_null_handler(nh)
        null_logger.error("drop")
        null_logger.clear_handler()
        null_content: str = read_text(null_log)
        null_ok = null_content == ""
    except IOError as e:
        _ = str(e.message)
    actual.append(null_ok)

    base_handler: Handler = Handler()
    base_handler.set_level(ERROR)
    stream_handler: StreamHandler = StreamHandler(INFO)
    stream_handler.set_formatter(Formatter("%(name)s:%(message)s"))
    actual.append(base_handler.level() == ERROR and stream_handler.level() == INFO)
    return actual


def collect_cleanup_actual(base: str) -> list[bool]:
    actual: list[bool] = []
    cleanup_ok: bool = False
    try:
        _cleanup: str = run_command("rm -rf " + base)
        cleanup_ok = not exists(base)
    except IOError as e:
        _ = str(e.message)
        cleanup_ok = not exists(base)
    actual.append(cleanup_ok)
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True, True, True, True, True, True]
    actual: list[bool] = []
    base: str = mktemp_path("sifr_cpython_logging_subset_")
    try:
        _mk: str = run_command("mkdir -p " + base)
    except IOError as e:
        _ = str(e.message)

    append_all(actual, collect_app_flow_actual(base))
    append_all(actual, collect_basic_config_actual(base))
    append_all(actual, collect_handler_actual(base))
    append_all(actual, collect_constants_and_helpers_actual())
    append_all(actual, collect_missing_path_actual(base))
    append_all(actual, collect_handler_hierarchy_actual(base))
    append_all(actual, collect_cleanup_actual(base))

    assert_bool_vector_eq(actual, expected)
    assert str("cpython_logging_subset: pass") == "cpython_logging_subset: pass"
