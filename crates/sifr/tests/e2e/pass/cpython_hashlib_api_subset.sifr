# Adapted CPython hashlib API subset for sifr.hashlib
from sifr.hashlib import new, sha256, algorithms_guaranteed, algorithms_available, file_digest, HashlibError, HashObject
from sifr.io import write_text
from sifr.test import assert_vector_eq, assert_bool_vector_eq

def contains(values: list[str], needle: str) -> bool:
    for v in values:
        if v == needle:
            return True
    return False

def collect_positive_actual(tmp_path: str) -> list[str]:
    actual: list[str] = []
    guaranteed: list[str] = algorithms_guaranteed()
    available: list[str] = algorithms_available()
    actual.append(str(contains(guaranteed, "sha256")))
    actual.append(str(contains(guaranteed, "md5")))
    actual.append(str(len(guaranteed) == len(available)))

    try:
        h: HashObject = new("sha256", b"abc")
        actual.append(h.hexdigest())
    except ValueError as e:
        actual.append("ERR")

    try:
        digest: str = file_digest(tmp_path, "sha256")
        actual.append(digest)
    except HashlibError as e:
        actual.append("ERR")
    return actual

def collect_negative_actual_ok(tmp_path: str) -> list[bool]:
    actual_ok: list[bool] = []
    try:
        bad_new: HashObject = new("sha3_256", b"")
        _ = str(bad_new.name)
        actual_ok.append(True)
    except ValueError as e:
        actual_ok.append(False)

    try:
        bad_digest: str = file_digest(tmp_path, "sha3_256")
        _ = str(bad_digest)
        actual_ok.append(True)
    except HashlibError as e:
        actual_ok.append(False)
    return actual_ok

def main():
    expected: list[str] = [
        "true",
        "true",
        "true",
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
        "8e6537b695ff181bc341e32d8b8970485ac3513408e5eb1e8ba9fc5af1cd3f57",
    ]
    tmp_path: str = "tmp_hashlib_api_subset.txt"
    try:
        _ = write_text(tmp_path, "file-data")
    except IOError as e:
        _ = str("unexpected write error: " + e.message)
        assert False

    actual: list[str] = collect_positive_actual(tmp_path)
    assert_vector_eq(actual, expected)

    expected_ok: list[bool] = [False, False]
    actual_ok: list[bool] = collect_negative_actual_ok(tmp_path)
    assert_bool_vector_eq(actual_ok, expected_ok)
    assert sha256(b"abc").hexdigest() == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
