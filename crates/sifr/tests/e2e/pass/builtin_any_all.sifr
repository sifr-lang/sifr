# Tests: any() and all() built-in functions

def main():
    mixed: list[bool] = [True, False, True]
    all_true: list[bool] = [True, True, True]
    assert str(any(mixed)) == 'true'
    assert str(all(mixed)) == 'false'
    assert str(any([False, False])) == 'false'
    assert str(all(all_true)) == 'true'
