
from sifr.datetime import now, datetime

def main():
    dt: datetime = now()
    assert "year > 2020 = " + str(dt.year > 2020) == "year > 2020 = true"
    assert "month valid = " + str(dt.month >= 1 and dt.month <= 12) == "month valid = true"
    assert "now returns datetime = true" == "now returns datetime = true"
