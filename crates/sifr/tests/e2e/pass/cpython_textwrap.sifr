# CPython test_textwrap.py — ported assertions for sifr.textwrap
from sifr.test import assert_eq
from sifr.textwrap import wrap, fill, dedent, indent, shorten

def main():
    # --- wrap ---
    try:
        w1: list[str] = wrap("Hello there, how are you this fine day?", 12)
        assert_eq(len(w1), 4)
        assert str(w1) == '["Hello there,", "how are you", "this fine", "day?"]'
    except ValueError as e:
        assert str(f"error: {e.message}") == '["Hello", "there"]'

    try:
        w2: list[str] = wrap("", 6)
        assert_eq(len(w2), 0)
    except ValueError as e:
        assert str(f"error: {e.message}") == 'cpython_textwrap: all 20 assertions passed'

    try:
        w3: list[str] = wrap("Short", 80)
        assert_eq(len(w3), 1)
    except ValueError as e:
        _ = str(f"error: {e.message}")
    try:
        w4: list[str] = wrap("Hello there", 5)
        assert_eq(len(w4), 2)
        _ = str(w4)
    except ValueError as e:
        _ = str(f"error: {e.message}")
    # --- fill ---
    try:
        f1: str = fill("Hello there", 5)
        assert_eq(f1, "Hello\nthere")
        f2: str = fill("", 6)
        assert_eq(f2, "")
        f3: str = fill("Short", 80)
        assert_eq(f3, "Short")
    except ValueError as e:
        _ = str(f"error: {e.message}")
    # --- dedent ---
    assert_eq(dedent("  Hello"), "Hello")
    assert_eq(dedent("  Hello\n  World"), "Hello\nWorld")
    assert_eq(dedent(""), "")
    assert_eq(dedent("Hello"), "Hello")
    assert_eq(dedent("    line1\n    line2\n    line3"), "line1\nline2\nline3")

    # --- indent ---
    assert_eq(indent("Hello\nWorld", "  "), "  Hello\n  World")
    assert_eq(indent("", "  "), "")
    assert_eq(indent("Hello", ""), "Hello")
    assert_eq(indent("A\nB\nC", ">> "), ">> A\n>> B\n>> C")

    # --- shorten ---
    assert_eq(shorten("Hello", 10), "Hello")
    assert_eq(shorten("", 6), "")

    _ = str("cpython_textwrap: all 20 assertions passed")
