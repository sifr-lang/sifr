# Tests self-referential ListNode class with Box<T>

class ListNode:
    val: int
    next: ListNode | None

    def __init__(self, val: int, next: ListNode | None):
        self.val = val
        self.next = next

def main():
    node2: ListNode = ListNode(2, None)
    node1: ListNode = ListNode(1, node2)
    assert node1.val == 1
