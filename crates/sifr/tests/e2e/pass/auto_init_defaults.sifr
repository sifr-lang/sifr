# Test auto-generated __init__ with default field values
class Config:
    debug: bool = False
    timeout: int = 30

def main():
    c1: Config = Config()
    assert str(c1.debug) == 'false'
    assert str(c1.timeout) == '30'
    c2: Config = Config(True, 60)
    assert str(c2.debug) == 'true'
    assert str(c2.timeout) == '60'

