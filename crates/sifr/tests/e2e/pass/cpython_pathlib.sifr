# CPython test_pathlib — ported assertions for sifr.pathlib
from sifr.pathlib import basename, dirname, extension, stem, is_absolute, join_path
from sifr.test import assert_bool_vector_eq


def collect_basename_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(basename("/home/user/file.txt") == "file.txt")
    actual.append(basename("/home/user/") == "")
    actual.append(basename("file.txt") == "file.txt")
    actual.append(basename("/a/b/c") == "c")
    return actual


def collect_dirname_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(dirname("/home/user/file.txt") == "/home/user")
    actual.append(dirname("file.txt") == "")
    actual.append(dirname("/a/b/c") == "/a/b")
    actual.append(dirname("/a") == "")
    return actual


def collect_extension_and_stem_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(extension("file.txt") == ".txt")
    actual.append(extension("file.tar.gz") == ".gz")
    actual.append(extension("file") == "")
    actual.append(extension(".hidden") == ".hidden")
    actual.append(extension("path/to/file.py") == ".py")

    actual.append(stem("file.txt") == "file")
    actual.append(stem("file.tar.gz") == "file.tar")
    actual.append(stem("file") == "file")
    actual.append(stem("path/to/file.py") == "file")
    return actual


def collect_absolute_and_join_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(is_absolute("/home/user"))
    actual.append(is_absolute("/"))
    rel_path: bool = not is_absolute("relative/path")
    file_path: bool = not is_absolute("file.txt")
    empty_path: bool = not is_absolute("")
    actual.append(rel_path)
    actual.append(file_path)
    actual.append(empty_path)

    actual.append(join_path("/home", "user") == "/home/user")
    actual.append(join_path("/home/user", "file.txt") == "/home/user/file.txt")
    actual.append(join_path("a", "b") == "a/b")
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [
        True, True, True, True,
        True, True, True, True,
        True, True, True, True, True, True, True, True, True,
        True, True, True, True, True, True, True, True
    ]
    actual: list[bool] = []
    append_all(actual, collect_basename_actual())
    append_all(actual, collect_dirname_actual())
    append_all(actual, collect_extension_and_stem_actual())
    append_all(actual, collect_absolute_and_join_actual())
    assert_bool_vector_eq(actual, expected)
    assert str("cpython_pathlib: pass") == "cpython_pathlib: pass"
