from sifr.asyncio import gather


async def first() -> int:
    await task.sleep(0.0)
    return 1


async def second() -> int:
    await task.sleep(0.0)
    return 2


async def main() -> Result[None, ScopeFailure]:
    async with task.scope() as scope:
        result = await gather([scope.spawn(first()), scope.spawn(second())])
    return None
