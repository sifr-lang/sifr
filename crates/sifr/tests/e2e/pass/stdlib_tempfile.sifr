# Test sifr.tempfile module
from sifr.tempfile import mkstemp, mkdtemp
from sifr.io import exists
from sifr.os import run_command

def main():
    try:
        # mkstemp creates a temp file
        path: str = mkstemp("sifr_test_")
        assert str(exists(path)) == 'true'

        # mkdtemp creates a temp directory
        dpath: str = mkdtemp("sifr_testd_")
        assert str(exists(dpath)) == 'true'

        # Cleanup
        r1: str = run_command("rm -f " + path)
        r2: str = run_command("rm -rf " + dpath)
    except IOError as e:
        _ = str("ERROR: " + e.message)
