from sifr.io import exists
from sifr.os import getpid, remove_file
from sifr.process import Output, ProcessError, output_shell_timeout
from sifr.time import sleep


def marker_path() -> str:
    return "/tmp/sifr_process_timeout_group_cleanup_" + str(getpid()) + ".txt"


def main():
    path: str = marker_path()
    try:
        if exists(path):
            try:
                _removed_existing: None = remove_file(path)
            except IOError as e:
                _cleanup_message: str = str(e.message)

        script: str = "(sleep 0.20; printf escaped > " + path + ") & sleep 1"
        timed_out: Output = output_shell_timeout(script, 0.02)
        assert timed_out.status.timed_out
        assert timed_out.status.kind == "timeout"

        sleep(0.35)
        assert not exists(path)
    except ProcessError as e:
        assert e.message == ""
    except IOError as e:
        assert e.message == ""
    finally:
        if exists(path):
            try:
                _removed: None = remove_file(path)
            except IOError as e:
                _cleanup_message: str = str(e.message)
