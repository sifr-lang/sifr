# Reference: stdlib_parity_iter_fix_3_concrete_iterator_codegen
# stdlib_parity_iter_fix_3: concrete iterator codegen pipeline closure

def is_even(x: int) -> bool:
    return x % 2 == 0


def main():
    xs: list[int] = [4, 1, 3, 2]
    flags: list[bool] = [False, True, False]

    has_true: bool = any(iter(flags))
    evens: Iterator[int] = filter(is_even, iter(xs))
    src_it: Iterator[int] = iter(xs)
    evens_from_it_var: Iterator[int] = filter(is_even, src_it)
    ordered: list[int] = sorted(iter(xs))

    assert str(has_true) == "true"
    assert str(list(evens)) == "[4, 2]"
    assert str(list(evens_from_it_var)) == "[4, 2]"
    assert str(ordered) == "[1, 2, 3, 4]"
