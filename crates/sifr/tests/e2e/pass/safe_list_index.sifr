
def main():
    nums: list[int] = [10, 20, 30]

    # Valid index returns Some
    val: int | None = nums[1]
    if val is not None:
        assert str(f"found: {val}") == 'found: 20'

    # Out-of-bounds returns None
    oob: int | None = nums[10]
    if oob is not None:
        assert str(f"found: {oob}") == 'not found'
    else:
        _ = str("not found")
