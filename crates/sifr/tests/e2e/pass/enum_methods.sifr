from enum import Enum

class Direction(Enum):
    NORTH = 1
    SOUTH = 2
    EAST = 3
    WEST = 4

    def is_vertical(self) -> bool:
        match self:
            case Direction.NORTH | Direction.SOUTH:
                return True
            case _:
                return False

def main():
    assert Direction.NORTH.is_vertical() == True
    assert Direction.EAST.is_vertical() == False
    assert Direction.SOUTH.is_vertical() == True
    assert Direction.WEST.is_vertical() == False

