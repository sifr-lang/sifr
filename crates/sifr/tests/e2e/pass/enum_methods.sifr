from enum import Enum

class Direction(Enum):
    NORTH = 1
    SOUTH = 2
    EAST = 3
    WEST = 4

    def is_vertical(self) -> bool:
        match self:
            case Direction.NORTH | Direction.SOUTH:
                return True
            case _:
                return False

def main():
    assert str(Direction.NORTH.is_vertical()) == 'true'
    assert str(Direction.EAST.is_vertical()) == 'false'
    assert str(Direction.SOUTH.is_vertical()) == 'true'
    assert str(Direction.WEST.is_vertical()) == 'false'

