# Test: Recursive nested backtracking helper preserves deterministic subsets order.

def subsets(nums: list[int]) -> list[list[int]]:
    res = []
    subset = []

    def dfs(i):
        if i >= len(nums):
            res.append(subset.copy())
            return
        subset.append(nums[i])
        dfs(i + 1)
        subset.pop()
        dfs(i + 1)

    dfs(0)
    return res


def main():
    assert str(subsets([1, 2, 3])) == '[[1, 2, 3], [1, 2], [1, 3], [1], [2, 3], [2], [3], []]'
