
from sifr.graphlib import CycleError

def check_graph(has_cycle: bool) -> Result[int, CycleError]:
    if has_cycle:
        raise CycleError("cycle detected")
    return 0

def main():
    try:
        result: int = check_graph(True)
    except CycleError as e:
        assert f"caught CycleError: {e.message}" == "caught CycleError: cycle detected"

    assert "stdlib error types work" == "stdlib error types work"
