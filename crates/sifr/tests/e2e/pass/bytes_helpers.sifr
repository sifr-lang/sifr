# Reference: stdlib_parity_bytes_0_architecture_lock
from sifr.bytes import encode_utf8, decode_utf8, bytes_to_hex, bytes_from_hex, count_byte, find_byte, starts_with, ends_with


def main() -> None:
    payload: bytes = encode_utf8("bytes-wave0")
    assert len(payload) == 11
    assert count_byte(payload, 101) == 2
    assert find_byte(payload, 119) == 6

    prefix: bytes = encode_utf8("bytes")
    suffix: bytes = encode_utf8("wave0")
    assert starts_with(payload, prefix)
    assert ends_with(payload, suffix)

    conversion_ok: bool = False
    try:
        hex_text: str = bytes_to_hex(payload)
        rebuilt: bytes = bytes_from_hex(hex_text)
        roundtrip: str = decode_utf8(rebuilt)
        conversion_ok = roundtrip == "bytes-wave0"
    except ParseError as e:
        _ = str(e.message)
    assert conversion_ok
