# Reference: stdlib_parity_bytes_0_architecture_lock


def main() -> None:
    payload: bytes = b"bytes-rule0"
    assert len(payload) == 11
    assert payload.count(101) == 2
    assert payload.find(114) == 6

    prefix: bytes = b"bytes"
    suffix: bytes = b"rule0"
    assert payload.startswith(prefix)
    assert payload.endswith(suffix)

    conversion_ok: bool = False
    try:
        hex_text: str = payload.hex()
        rebuilt: bytes = bytes.from_hex(hex_text)
        roundtrip: str = rebuilt.decode()
        conversion_ok = roundtrip == "bytes-rule0"
    except ParseError as e:
        _ = str(e.message)
    assert conversion_ok
