def describe_union(x: int | str) -> str:
    match x:
        case int():
            return "integer"
        case str():
            return "string"

def make_int() -> int | str:
    return 42

def make_str() -> int | str:
    return "hello"

def main():
    a: int | str = make_int()
    b: int | str = make_str()
    assert describe_union(a) == integer
    assert describe_union(b) == string

