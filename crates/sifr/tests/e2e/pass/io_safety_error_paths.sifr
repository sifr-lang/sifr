# Test I/O safety: error paths return IOError instead of panicking
from sifr.io import read_text, write_text, read_lines
from sifr.os import listdir, mkdir, rmdir, remove_file, rename, getcwd


def main():
    expected: list[str] = ["all io safety tests passed", "getcwd ok", "safety works", "caught rename IOError", "caught remove_file IOError", "caught rmdir IOError", "caught listdir IOError", "caught read_lines IOError", "caught read_text IOError"]
    expected_index: int = 0
    # 1. read_text on non-existent file returns IOError
    try:
        content: str = read_text("/tmp/sifr_io_safety_nonexistent_file.txt")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("caught read_text IOError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 2. read_lines on non-existent file returns IOError
    try:
        lines: list[str] = read_lines("/tmp/sifr_io_safety_nonexistent_file.txt")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("caught read_lines IOError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 3. listdir on non-existent directory returns IOError
    try:
        entries: list[str] = listdir("/tmp/sifr_io_safety_nonexistent_dir")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("caught listdir IOError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 4. rmdir on non-existent directory returns IOError
    try:
        r: None = rmdir("/tmp/sifr_io_safety_nonexistent_dir")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("caught rmdir IOError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 5. remove_file on non-existent file returns IOError
    try:
        r2: None = remove_file("/tmp/sifr_io_safety_nonexistent_file.txt")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("caught remove_file IOError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 6. rename non-existent file returns IOError
    try:
        r3: None = rename("/tmp/sifr_io_safety_nonexistent.txt", "/tmp/sifr_io_safety_dest.txt")
        assert str("should not reach here") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("caught rename IOError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 7. Success path: write then read
    try:
        w: None = write_text("/tmp/sifr_io_safety_test.txt", "safety works")
        data: str = read_text("/tmp/sifr_io_safety_test.txt")
        assert str(data) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
        cleanup: None = remove_file("/tmp/sifr_io_safety_test.txt")
    except IOError as e:
        assert str("unexpected error: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 8. getcwd succeeds
    try:
        cwd: str = getcwd()
        assert str("getcwd ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("getcwd failed: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    assert str("all io safety tests passed") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1

