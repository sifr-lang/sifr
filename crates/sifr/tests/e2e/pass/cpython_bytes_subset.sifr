# Adapted CPython bytes subset for first-class bytes
from sifr.test import assert_vector_eq, assert_bool_vector_eq

def render_opt_int(own value: int | None) -> str:
    if value is None:
        return "None"
    return str(value)

def bytes_to_hex_or_err(payload: bytes) -> str:
    try:
        hex_out: str = payload.hex()
        return hex_out
    except ParseError as e:
        _ = str(e.message)
        return "ERR"

def bytes_from_hex_to_text_or_err(payload: str) -> str:
    try:
        parsed: bytes = bytes.from_hex(payload)
        text: str = parsed.decode()
        return text
    except ParseError as e:
        _ = str(e.message)
        return "ERR"

def collect_primary_actual() -> list[str]:
    actual: list[str] = []
    data: bytes = b"mississippi"
    actual.append(str(data.count(115)))
    actual.append(render_opt_int(data.find(112)))
    actual.append(render_opt_int(data.find(120)))
    actual.append(str(data.startswith(b"miss")))
    actual.append(str(data.endswith(b"ippi")))
    actual.append(bytes_to_hex_or_err(b"Hi"))
    actual.append(bytes_from_hex_to_text_or_err("48 69"))
    return actual

def collect_hex_error_actual_ok(inputs: list[str]) -> list[bool]:
    hex_actual_ok: list[bool] = []
    for s in inputs:
        try:
            _bad_hex: bytes = bytes.from_hex(s)
            hex_actual_ok.append(True)
        except ParseError as e:
            hex_actual_ok.append(False)
    return hex_actual_ok

def collect_decode_error_actual_ok() -> list[bool]:
    decode_actual_ok: list[bool] = []
    try:
        bad_text: str = b"\xff".decode()
        decode_actual_ok.append(True)
    except ParseError as e:
        decode_actual_ok.append(False)
    try:
        good_text: str = b"Hi".decode()
        decode_actual_ok.append(True)
    except ParseError as e:
        decode_actual_ok.append(False)
    return decode_actual_ok

def main():
    expected: list[str] = ["4", "8", "None", "true", "true", "4869", "Hi"]
    actual: list[str] = collect_primary_actual()
    assert_vector_eq(actual, expected)

    hex_inputs: list[str] = ["abc", "€"]
    hex_expected_ok: list[bool] = [False, False]
    hex_actual_ok: list[bool] = collect_hex_error_actual_ok(hex_inputs)
    assert_bool_vector_eq(hex_actual_ok, hex_expected_ok)

    decode_expected_ok: list[bool] = [False, True]
    decode_actual_ok: list[bool] = collect_decode_error_actual_ok()
    assert_bool_vector_eq(decode_actual_ok, decode_expected_ok)
    assert str("cpython_bytes_subset: pass") == "cpython_bytes_subset: pass"
