# Test sifr.collections Set operations
from sifr.collections import new_set, set_add, set_contains, set_remove, set_len, set_union, set_intersection, set_from_list

def main():
    # Create from list with dedup
    assert set_len(set_from_list([1, 2, 2, 3, 3, 3])) == 3

    # Contains - true
    assert set_contains(set_from_list([1, 2, 3]), 2) == True
    # Contains - false
    assert set_contains(set_from_list([1, 2, 3]), 5) == False

    # Add element
    assert set_len(set_add(set_from_list([1, 2]), 3)) == 3

    # Add duplicate (should not increase size)
    assert set_len(set_add(set_from_list([1, 2, 3]), 2)) == 3

    # Remove
    assert set_contains(set_remove(set_from_list([1, 2, 3]), 2), 2) == False
    assert set_len(set_remove(set_from_list([1, 2, 3]), 2)) == 2

    # Union
    assert set_len(set_union(set_from_list([1, 2, 3]), set_from_list([3, 4, 5]))) == 5

    # Intersection
    assert set_len(set_intersection(set_from_list([1, 2, 3]), set_from_list([3, 4, 5]))) == 1

