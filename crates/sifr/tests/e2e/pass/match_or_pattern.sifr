def classify(x: int) -> str:
    match x:
        case 1 | 2 | 3:
            return "small"
        case 4 | 5 | 6:
            return "medium"
        case _:
            return "large"

def main():
    assert str(classify(1)) == 'small'
    assert str(classify(3)) == 'small'
    assert str(classify(5)) == 'medium'
    assert str(classify(10)) == 'large'

