def classify(x: int) -> str:
    match x:
        case 1 | 2 | 3:
            return "small"
        case 4 | 5 | 6:
            return "medium"
        case _:
            return "large"

def main():
    assert classify(1) == small
    assert classify(3) == small
    assert classify(5) == medium
    assert classify(10) == large

