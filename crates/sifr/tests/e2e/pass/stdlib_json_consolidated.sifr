# Consolidated stdlib json coverage for structured-value parity
from sifr.json import JsonValue, loads, dumps, validate_integer_digit_limits


def main() -> None:
    try:
        parsed_obj: JsonValue = loads("{\"name\":\"sifr\"}")
        parsed_arr: JsonValue = loads("[1,2,3]")
        assert str(parsed_obj) == "{\"name\":\"sifr\"}"
        assert str(parsed_arr) == "[1,2,3]"
    except JSONDecodeError as e:
        assert False

    assert dumps("hello") == "\"hello\""
    assert dumps(False) == "false"

    try:
        parsed_roundtrip: JsonValue = loads(dumps(7))
        assert str(parsed_roundtrip) == "7"
    except JSONDecodeError as e:
        assert False

    try:
        _bad: JsonValue = loads("{")
        _ = _bad
        assert False
    except JSONDecodeError as e:
        assert len(e.message) > 0

    oversized_integer: str = "1"
    for _index in range(0, 4097):
        oversized_integer = oversized_integer + "0"

    try:
        _: None = validate_integer_digit_limits(oversized_integer)
        assert False
    except JsonLimitError as e:
        assert e.limit == 4096
        assert len(e.message) > 0

    try:
        _too_large: JsonValue = loads("{\"id\":" + oversized_integer + "}")
        _ = _too_large
        assert False
    except JSONDecodeError as e:
        assert len(e.message) > 0
