# Adapted CPython env subset for sifr.env safety model
from sifr.env import env_get, env_set, env_unset, getenv, keys, values, items

def main():
    env_unset("SIFR_ENV_PORT")
    env_set("SIFR_ENV_PORT", "v")

    v1: str | None = env_get("SIFR_ENV_PORT")
    if v1 is not None:
        assert v1 == v
    assert getenv("SIFR_ENV_PORT", "d") == v

    env_unset("SIFR_ENV_PORT")
    assert getenv("SIFR_ENV_PORT", "d") == d

    # Safety adaptation: invalid names are ignored instead of panicking.
    env_set("", "x")
    bad_empty: str | None = env_get("")
    if bad_empty is None:
        assert "empty-key-safe" == empty-key-safe

    env_set("A=B", "x")
    bad_eq: str | None = env_get("A=B")
    if bad_eq is None:
        assert "equals-key-safe" == equals-key-safe

    k: list[str] = keys()
    v: list[str] = values()
    it: list[str] = items()

    assert len(k) == len(v) == True
    assert len(k) == len(it) == True

    has_equals_pair: bool = False
    for pair in it:
        for ch in pair:
            if ch == "=":
                has_equals_pair = True
    assert has_equals_pair == True

