# Test sifr.secrets stdlib module
from sifr.secrets import choice, compare_digest, randbelow, randbits, token_hex

def main():
    # token_hex generates hex string of specified byte length
    token: str = token_hex(4)
    assert str(len(token)) == '8'
    assert str(compare_digest("abc", "abc")) == 'true'
    assert str(compare_digest("abc", "abd")) == 'false'

    # randbelow generates number in [0, n)
    try:
        val: int = randbelow(10)
        assert str(val >= 0) == 'true'
        assert str(val < 10) == 'true'
        picked: int = choice([1, 2, 3])
        assert str(picked >= 1) == 'true'
        bits: int = randbits(8)
        assert str(bits >= 0) == 'true'
    except ValueError as e:
        _ = str(f"error: {e.message}")
