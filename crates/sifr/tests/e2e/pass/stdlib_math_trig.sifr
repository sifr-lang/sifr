# Test new math stdlib functions
from sifr.math import log, sin, cos, tan, abs_val, pow_val, round_val

def main():
    assert str(log(1.0)) == '0'
    assert str(sin(0.0)) == '0'
    assert str(cos(0.0)) == '1'
    assert str(abs_val(-5.0)) == '5'
    assert str(pow_val(2.0, 3.0)) == '8'
    assert str(round_val(3.7)) == '4'

