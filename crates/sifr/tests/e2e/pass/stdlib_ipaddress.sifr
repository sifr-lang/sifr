# Test sifr.ipaddress module
from sifr.ipaddress import is_valid_ipv4, is_private, is_loopback

def main():
    # valid IPv4
    assert str(is_valid_ipv4("192.168.1.1")) == 'true'
    assert str(is_valid_ipv4("256.1.1.1")) == 'false'
    assert str(is_valid_ipv4("not.an.ip")) == 'false'

    # private addresses
    assert str(is_private("192.168.1.1")) == 'true'
    assert str(is_private("8.8.8.8")) == 'false'

    # loopback
    assert str(is_loopback("127.0.0.1")) == 'true'
    assert str(is_loopback("192.168.1.1")) == 'false'

