async def numbers() -> AsyncGenerator[int, GeneratorCloseError]:
    yield 1
    yield 2
    yield 3


async def main() -> Result[None, GeneratorCloseError]:
    values: list[int] = [x async for x in numbers() if x > 1]

    assert len(values) == 2
    assert values[0] == 2
    assert values[1] == 3
    return None
