# Reference: narrowing_constructor_compat
from sifr.collections import deque
from sifr.test import assert_bool_vector_eq

def collect_actual() -> list[bool]:
    actual: list[bool] = []

    names = set(["aa", "bb", "aa"])
    actual.append(len(names) == 2)
    actual.append("aa" in names)

    seen = set()
    seen.add("cc")
    actual.append("cc" in seen)

    q: deque[str] = deque(["x"])
    q.append("y")
    first: str | None = q.popleft()
    second: str | None = q.popleft()
    actual.append(first is not None and first == "x")
    actual.append(second is not None and second == "y")

    bounded: deque[int] = deque([1, 2, 3, 4], maxlen=3)
    actual.append(bounded.len() == 3)
    bounded_first: int | None = bounded.popleft()
    actual.append(bounded_first is not None and bounded_first == 2)

    return actual

def main():
    expected: list[bool] = [True, True, True, True, True, True, True]
    assert_bool_vector_eq(collect_actual(), expected)
