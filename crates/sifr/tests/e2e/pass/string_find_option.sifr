
def main():
    s: str = "hello, world!"

    pos: int | None = s.find("world")
    if pos is not None:
        assert str(f"found at: {pos}") == 'found at: 7'

    missing: int | None = s.find("xyz")
    if missing is not None:
        assert str(f"found at: {missing}") == 'not found'
    else:
        _ = str("not found")
