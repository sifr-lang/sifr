# expect-stdout: found at: 7
# expect-stdout: not found

def main():
    s: str = "hello, world!"

    pos: int | None = s.find("world")
    if pos is not None:
        print(f"found at: {pos}")

    missing: int | None = s.find("xyz")
    if missing is not None:
        print(f"found at: {missing}")
    else:
        print("not found")
