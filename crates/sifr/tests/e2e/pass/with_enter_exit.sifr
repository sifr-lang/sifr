# expect-stdout: Resource.__enter__ called
# expect-stdout: using resource: myfile.txt
# expect-stdout: Resource.__exit__ called
# Tests: with statement calls __enter__ and __exit__ correctly

class FileResource:
    path: str

    def __init__(self, path: str):
        self.path = path

    def __enter__(self) -> FileResource:
        print("Resource.__enter__ called")
        return self

    def __exit__(self) -> None:
        print("Resource.__exit__ called")

def main():
    with FileResource("myfile.txt") as f:
        print("using resource: " + f.path)
