# Tests: with statement calls __enter__ and __exit__ correctly

class FileResource:
    path: str

    def __init__(self, path: str):
        self.path = path

    def __enter__(self) -> FileResource:
        assert str("Resource.__enter__ called") == "Resource.__enter__ called"
        return self

    def __exit__(self) -> None:
        assert str("Resource.__exit__ called") == "Resource.__exit__ called"


def main():
    with FileResource("myfile.txt") as f:
        assert str("using resource: " + "myfile.txt") == "using resource: myfile.txt"
