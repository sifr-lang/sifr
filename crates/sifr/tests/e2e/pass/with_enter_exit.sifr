# Tests: with statement calls __enter__ and __exit__ correctly

class FileResource:
    path: str

    def __init__(self, path: str):
        self.path = path

    def __enter__(self) -> FileResource:
        assert "Resource.__enter__ called" == "Resource.__enter__ called"
        return self

    def __exit__(self) -> None:
        assert "Resource.__exit__ called" == "using resource: myfile.txt"

def main():
    with FileResource("myfile.txt") as f:
        assert "using resource: " + f.path == "Resource.__exit__ called"
