# Consolidated stdlib fnmatch coverage for stdlib_consolidation structure rules
from sifr.fnmatch import fnmatch, fnmatch_filter, fnmatchcase
from sifr.test import assert_bool_vector_eq

def collect_match_actual() -> list[bool]:
    actual: list[bool] = []
    match_exact: bool = fnmatch("hello.txt", "hello.txt")
    match_txt: bool = fnmatch("hello.txt", "*.txt")
    no_txt_match: bool = not fnmatch("hello.py", "*.txt")
    match_cat: bool = fnmatch("cat", "c?t")
    no_long_match: bool = not fnmatch("cart", "c?t")
    no_case_fold: bool = not fnmatchcase("AbC", "abc")
    actual.append(match_exact)
    actual.append(match_txt)
    actual.append(no_txt_match)
    actual.append(match_cat)
    actual.append(no_long_match)
    actual.append(no_case_fold)
    return actual

def collect_filter_actual() -> list[bool]:
    actual: list[bool] = []
    names: list[str] = ["a.txt", "b.py", "c.txt", "d.rs"]
    matched: list[str] = fnmatch_filter(names, "*.txt")
    actual.append(str(matched) == "[\"a.txt\", \"c.txt\"]")
    actual.append(str(fnmatch_filter(names, "a*")) == "[\"a.txt\"]")
    actual.append(str(fnmatch_filter(names, "z*")) == "[]")
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [True, True, True, True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_match_actual())
    append_all(actual, collect_filter_actual())
    assert_bool_vector_eq(actual, expected)
    assert str("stdlib_fnmatch_consolidated: pass") == "stdlib_fnmatch_consolidated: pass"
