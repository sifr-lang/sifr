# Adapted CPython json subset for sifr.json structured values
from sifr.json import JsonValue, loads, dumps


def main() -> None:
    try:
        obj: JsonValue = loads("{\"a\":1}")
        arr: JsonValue = loads("[1,2,3]")
        num: JsonValue = loads("42")
        bval: JsonValue = loads("true")
        nval: JsonValue = loads("null")
        sval: JsonValue = loads("\"hi\"")
        ordered: JsonValue = loads("{\"z\":1,\"a\":2,\"m\":3}")
        assert str(obj) == "{\"a\":1}"
        assert str(arr) == "[1,2,3]"
        assert str(num) == "42"
        assert str(bval) == "true"
        assert str(nval) == "null"
        assert str(sval) == "\"hi\""
        assert str(ordered) == "{\"z\":1,\"a\":2,\"m\":3}"
    except JSONDecodeError as e:
        assert False

    assert dumps("hello") == "\"hello\""
    assert dumps(42) == "42"
    assert dumps(True) == "true"

    try:
        rt: JsonValue = loads(dumps(42))
        assert str(rt) == "42"
    except JSONDecodeError as e:
        assert False

    try:
        _bad1: JsonValue = loads("{")
        _ = _bad1
        assert False
    except JSONDecodeError as e:
        assert len(e.message) > 0

    try:
        _bad2: JsonValue = loads("tru")
        _ = _bad2
        assert False
    except JSONDecodeError as e:
        assert len(e.message) > 0
