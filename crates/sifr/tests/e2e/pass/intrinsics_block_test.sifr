# Test that stdlib modules correctly wrap intrinsics
# This verifies that sifr.* modules successfully import from _sifr.* internally
# while user code only sees the sifr.* public API.
from sifr.io import exists
from sifr.hashlib import sha256
from sifr.base64 import b64encode, b64decode
from sifr.env import getenv_opt

def main():
    # sifr.io wraps _sifr.fs/_sifr.fs intrinsics
    result: bool = exists("/nonexistent_path_12345")
    assert str(result) == 'false'

    # sifr.hashlib wraps _sifr.crypto intrinsics
    hash_val: str = sha256("test")
    assert str(len(hash_val) > 0) == 'true'

    # sifr.base64 wraps _sifr.crypto intrinsics
    encoded: str = b64encode("hello")
    try:
        decoded: str = b64decode(encoded)
        assert str(decoded) == 'hello'
    except ParseError as e:
        assert str("unexpected error: " + e.message) == 'intrinsics block test passed'

    _ = str("intrinsics block test passed")
