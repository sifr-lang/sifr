
def main():
    items: list[int] = [1, 2, 3, 4, 5]

    # Negative index returns Some
    last: int | None = items[-1]
    if last is not None:
        assert f"last: {last}" == "last: 5"

    second_last: int | None = items[-2]
    if second_last is not None:
        assert f"second last: {second_last}" == "second last: 4"
