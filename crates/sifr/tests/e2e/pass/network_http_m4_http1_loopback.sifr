# sifr-e2e-allow-http-transport-harness
from sifr.http import (
    BodyError,
    BodyStream,
    HeaderMap,
    HttpError,
    RequestHead,
    body_from_bytes,
    body_from_chunks,
    headers_from_pairs,
    request_head,
)
from sifr.http_transport import (
    transport_http1_client_roundtrip_tcp,
    transport_http1_server_respond_tcp,
)
from sifr.net import SocketAddr, TcpListener, TcpStream, connect_tcp, listen_tcp


def chunked_body(chunks: list[bytes]) -> Result[BodyStream, HttpError]:
    try:
        body: BodyStream = body_from_chunks(chunks)
        return body
    except BodyError as e:
        raise HttpError(e.message)


async def server_once(own stream: TcpStream) -> Result[bool, HttpError]:
    try:
        request: tuple[str, str, str, list[tuple[str, str]], bytes] = await transport_http1_server_respond_tcp(
            stream._handle,
            201,
            [("content-type", "application/octet-stream"), ("x-sifr-reply", "http1")],
            b"pong-http1",
            1024,
            1024,
        )
        assert request[0] == "POST"
        assert request[1] == "/m4/http1"
        assert request[2] == "HTTP/1.1"
        assert request[4] == b"ping-http1"
        return True
    except HttpError as e:
        raise HttpError(e.message)


async def main() -> Result[None, Error]:
    try:
        request_headers: HeaderMap = headers_from_pairs([("x-sifr-request", "http1")])
        typed_head: RequestHead = request_head("POST", "/m4/http1", request_headers)
        typed_body: BodyStream = chunked_body([b"ping", b"-http1"])
        typed_bytes: bytes = typed_body.collect_with_limit(1024)

        listener: TcpListener = await listen_tcp("127.0.0.1:0", reuse_addr=True)
        addr: SocketAddr = listener.local_addr()
        client: TcpStream = await connect_tcp(addr.value, timeout=2.0)
        accepted: tuple[TcpStream, SocketAddr] = await listener.accept()
        _closed: None = listener.close()

        async with task.scope() as scope:
            server = scope.spawn(server_once(accepted[0]))
            response: tuple[int, str, list[tuple[str, str]], bytes] = await transport_http1_client_roundtrip_tcp(
                client._handle,
                typed_head.method.value,
                typed_head.path,
                [("x-sifr-request", "http1")],
                typed_bytes,
                1024,
                1024,
            )
            assert response[0] == 201
            assert response[1] == "HTTP/1.1"
            assert response[3] == b"pong-http1"
            _server_joined = await server.join()

        response_limit_is_independent: bool = False
        listener2: TcpListener = await listen_tcp("127.0.0.1:0", reuse_addr=True)
        addr2: SocketAddr = listener2.local_addr()
        client2: TcpStream = await connect_tcp(addr2.value, timeout=2.0)
        accepted2: tuple[TcpStream, SocketAddr] = await listener2.accept()
        _closed2: None = listener2.close()
        async with task.scope() as scope2:
            server2 = scope2.spawn(server_once(accepted2[0]))
            try:
                _small_response_limit: tuple[int, str, list[tuple[str, str]], bytes] = await transport_http1_client_roundtrip_tcp(
                    client2._handle,
                    typed_head.method.value,
                    typed_head.path,
                    [("x-sifr-request", "http1")],
                    typed_bytes,
                    1024,
                    4,
                )
            except HttpError as e:
                response_limit_is_independent = "exceeds" in e.message
            _server_joined2 = await server2.join()
        assert response_limit_is_independent

        too_large: bool = False
        try:
            _body: bytes = body_from_bytes(b"abc").collect_with_limit(2)
            assert False
        except BodyError as e:
            too_large = "exceeds" in e.message
        assert too_large
    except Error as e:
        raise e
    return None
