# Test sifr.tomllib module
from sifr.tomllib import TomlValue, loads


def main() -> None:
    try:
        toml_text: str = "name = \"test\"\nversion = 42"
        result: TomlValue = loads(toml_text)
        name_value: TomlValue | None = result.get("name")
        version_value: TomlValue | None = result.get("version")
        assert name_value is not None
        assert version_value is not None
        if name_value is not None and version_value is not None:
            assert name_value.as_str() == "test"
            assert version_value.as_int() == 42
    except TOMLDecodeError as e:
        assert False
