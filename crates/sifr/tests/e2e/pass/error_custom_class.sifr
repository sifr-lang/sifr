
class AppError(Error):
    message: str

def validate(x: int) -> Result[int, AppError]:
    if x < 0:
        raise AppError("invalid value")
    return x

def main():
    try:
        val: int = validate(-1)
        assert f"ok: {val}" == "caught: invalid value"
    except AppError as e:
        assert f"caught: {e.message}" == "ok: 42"

    try:
        val2: int = validate(42)
        assert f"ok: {val2}" == "user-defined errors work"
    except AppError as e:
        print(f"caught: {e.message}")

    print("user-defined errors work")
