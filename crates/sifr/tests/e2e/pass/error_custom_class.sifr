
class AppError(Error):
    message: str

def validate(x: int) -> Result[int, AppError]:
    if x < 0:
        raise AppError("invalid value")
    return x


def main():
    expected: list[str] = ["user-defined errors work", "ok: 42", "caught: invalid value"]
    expected_index: int = 0
    try:
        val: int = validate(-1)
        assert str(f"ok: {val}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except AppError as e:
        assert str(f"caught: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        val2: int = validate(42)
        assert str(f"ok: {val2}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except AppError as e:
        assert str(f"caught: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    assert str("user-defined errors work") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
