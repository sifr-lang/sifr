# Runtime file basics.
from sifr.io import write_text, read_text, read_lines, exists
from sifr.os import remove_file, rmdir
from sifr.tempfile import mkstemp, mkdtemp
from sifr.zipfile import ZipFile
from sifr.logging import getLogger, INFO, Logger
from sifr.time import gmtime_struct, localtime_struct
from sifr.timeit import timeit
from sifr.test import assert_bool_vector_eq


def tiny_workload() -> None:
    i: int = 0
    total: int = 0
    while i < 20:
        total = total + i
        i = i + 1


def main() -> None:
    actual: list[bool] = []

    text_io_ok: bool = False
    binary_io_ok: bool = False
    tempfile_ok: bool = False
    zip_ok: bool = False
    logging_ok: bool = False
    time_api_ok: bool = False
    cleanup_ok: bool = False

    text_path: str = "/tmp/sifr_runtime_file_basics_text.txt"
    temp_file: str = ""
    temp_dir: str = ""
    zip_path: str = ""
    log_path: str = ""

    try:
        _w_text: None = write_text(text_path, "one\ntwo")
        lines: list[str] = read_lines(text_path)
        text_io_ok = len(lines) == 2 and lines[0] == "one" and lines[1] == "two"

        wb = open(text_path, "wb")
        _wb: None = wb.write_bytes(b"runtime")
        wb.close()
        rb = open(text_path, "rb")
        payload: bytes = rb.read_bytes()
        rb.close()
        binary_io_ok = payload == b"runtime"
    except IOError as e:
        _ = str(e.message)

    try:
        temp_file_created: str = mkstemp("sifr_runtime_file_basics_")
        temp_dir_created: str = mkdtemp("sifr_runtime_file_basics_dir_")
        temp_file = temp_file_created + ""
        temp_dir = temp_dir_created + ""
        tempfile_ok = exists(temp_file) and exists(temp_dir)

        zip_path = temp_file + ".zip"
        archive: ZipFile = ZipFile(zip_path + "")
        _zc: None = archive.create()
        _zw: None = archive.write("entry.txt", "zip-data")
        names: list[str] = archive.namelist()
        payload_text: str = archive.read("entry.txt")
        zip_ok = len(names) == 1 and names[0] == "entry.txt" and payload_text == "zip-data"
    except IOError as e:
        _ = str(e.message)

    try:
        log_path = text_path + ".log"
        _w_log: None = write_text(log_path, "")
        logger: Logger = getLogger("runtime_file_basics")
        logger.set_level(INFO)
        logger.set_file(log_path)
        logger.info("lock")
        log_content: str = read_text(log_path)
        logging_ok = log_content == "[INFO] runtime_file_basics: lock\n"
    except IOError as e:
        _ = str(e.message)

    gmt_now = gmtime_struct(0.0)
    local_now = localtime_struct(0.0)
    time_api_ok = gmt_now.tm_year > 0 and local_now.tm_year > 0 and timeit(tiny_workload, 1) >= 0.0

    try:
        if exists(text_path):
            _rm_text: None = remove_file(text_path)
        if len(log_path) > 0 and exists(log_path):
            _rm_log: None = remove_file(log_path)
        if len(zip_path) > 0 and exists(zip_path):
            _rm_zip: None = remove_file(zip_path)
        if len(temp_file) > 0 and exists(temp_file):
            _rm_file: None = remove_file(temp_file)
        if len(temp_dir) > 0 and exists(temp_dir):
            _rm_dir: None = rmdir(temp_dir)
        cleanup_ok = (not exists(text_path)) and (len(log_path) == 0 or not exists(log_path)) and (len(zip_path) == 0 or not exists(zip_path)) and (len(temp_file) == 0 or not exists(temp_file)) and (len(temp_dir) == 0 or not exists(temp_dir))
    except IOError as e:
        _ = str(e.message)

    actual.append(text_io_ok)
    actual.append(binary_io_ok)
    actual.append(tempfile_ok)
    actual.append(zip_ok)
    actual.append(logging_ok)
    actual.append(time_api_ok)
    actual.append(cleanup_ok)

    expected: list[bool] = [True, True, True, True, True, True, True]
    assert_bool_vector_eq(actual, expected)
