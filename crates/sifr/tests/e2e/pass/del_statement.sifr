
def main():
    # Del from dict
    ages: dict[str, int] = {"alice": 25, "bob": 30, "charlie": 35}
    assert f"before: {len(ages)}" == "before: 3"
    del ages["bob"]
    assert f"after del: {len(ages)}" == "after del: 2"

    missing: int | None = ages["bob"]
    if missing is not None:
        assert f"bob is {missing}" == "bob not found"
    else:
        print("bob not found")
