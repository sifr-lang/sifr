# Test Callable[[T], bool] with TypeVar — generic predicate functions
# Validates that concrete functions with Copy types (int, float, bool)
# and Move types (str) all work as Callable[[T], bool] arguments.
from sifr.itertools import dropwhile, takewhile, filterfalse
from sifr.functools import reduce
from sifr.test import assert_eq

def is_small(x: int) -> bool:
    return x < 5

def is_long(s: str) -> bool:
    return len(s) > 3

def is_big_float(x: float) -> bool:
    return x > 2.5

def add_ints(a: int, b: int) -> int:
    return a + b

def concat_strs(a: str, b: str) -> str:
    return a + b

def main():
    # --- dropwhile with int (Copy type) ---
    nums: list[int] = [1, 3, 7, 2, 8]
    dw_int: list[int] = list(dropwhile(is_small, iter(nums)))
    assert_eq(len(dw_int), 3)
    first_dw: int | None = dw_int[0]
    if first_dw is not None:
        assert_eq(first_dw, 7)

    # --- dropwhile with str (Move type) ---
    words: list[str] = ["hi", "yo", "hello", "a", "world"]
    dw_str: list[str] = list(dropwhile(is_long, iter(words)))
    assert_eq(len(dw_str), 5)

    # --- takewhile with int ---
    tw_int: list[int] = list(takewhile(is_small, iter(nums)))
    assert_eq(len(tw_int), 2)

    # --- takewhile with str ---
    long_words: list[str] = ["hello", "world", "hi", "yo"]
    tw_str: list[str] = list(takewhile(is_long, iter(long_words)))
    assert_eq(len(tw_str), 2)

    # --- filterfalse with int (keeps elements where is_small is False, i.e. >= 5) ---
    ff_int: list[int] = list(filterfalse(is_small, iter(nums)))
    assert_eq(len(ff_int), 2)

    # --- filterfalse with float ---
    floats: list[float] = [1.0, 3.0, 2.0, 4.5]
    ff_float: list[float] = list(filterfalse(is_big_float, iter(floats)))
    assert_eq(len(ff_float), 2)

    # --- reduce with int (Copy type) ---
    total: int = reduce(add_ints, nums, 0)
    assert_eq(total, 21)

    # --- reduce with str (Move type) ---
    parts: list[str] = ["hello", " ", "world"]
    combined: str = reduce(concat_strs, parts, "")
    assert_eq(combined, "hello world")

    assert str("generic_callable_typevar: all tests passed") == 'generic_callable_typevar: all tests passed'
