
def main():
    items: list[int] = [1, 2, 3]
    val: int | None = items.pop()
    if val is not None:
        assert str(f"popped: {val}") == 'popped: 3'

    # Pop until empty
    _ = items.pop()
    _ = items.pop()
    empty: int | None = items.pop()
    if empty is not None:
        assert str(f"got: {empty}") == 'list empty'
    else:
        _ = str("list empty")
