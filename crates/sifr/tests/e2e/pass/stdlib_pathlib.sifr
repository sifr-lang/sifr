# Test sifr.pathlib module
from sifr.pathlib import join_path, basename, dirname, extension

def main():
    assert join_path("/home", "user") == "/home/user"
    assert basename("/home/user/file.txt") == file.txt
    assert dirname("/home/user/file.txt") == "/home/user"
    assert extension("/home/user/file.txt") == ".txt"

