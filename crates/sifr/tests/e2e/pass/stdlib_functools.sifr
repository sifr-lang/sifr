# Test sifr.functools stdlib module
from sifr.functools import reduce

def add(a: int, b: int) -> int:
    return a + b

def mul(a: int, b: int) -> int:
    return a * b

def main():
    data: list[int] = [1, 2, 3, 4, 5]

    # reduce with add
    total: int = reduce(add, data, 0)
    assert total == 15

    # reduce with multiply
    product: int = reduce(mul, data, 1)
    assert product == 120

