# Edge case validation.
# Edge case safety: validates all new input validation guards

from sifr.random import randint
from sifr.secrets import randbelow
from sifr.textwrap import wrap, fill
from sifr.itertools import batched
from sifr.graphlib import topological_sort, CycleError
from sifr.uuid import uuid_from_hex, UUID
from sifr.ipaddress import ip_to_int
from sifr.datetime import from_timestamp, datetime


def main():
    expected: list[str] = ["all edge case safety checks passed", "[10, 20, 30]", "=== subscript assign ===", "from_timestamp ok", "caught ValueError: invalid timestamp", "=== from_timestamp ===", "ip_to_int ok", "caught ValueError: invalid IPv4 address", "=== ip_to_int ===", "uuid ok", "caught ValueError: UUID hex string must be 32 hex characters", "caught ValueError: invalid UUID hex string", "=== uuid_from_hex ===", "topo sort ok", "caught CycleError: cycle detected in graph", "=== topological_sort ===", "batched ok", "caught ValueError: batched: n must be > 0", "=== batched ===", "fill ok", "caught ValueError: fill: width must be > 0", "=== fill ===", "wrap ok", "caught ValueError: wrap: width must be > 0", "=== wrap ===", "randbelow(10) ok", "caught ValueError: randbelow: n must be > 0", "=== randbelow ===", "randint(1, 5) ok", "caught ValueError: randint: min must be <= max", "=== randint ==="]
    expected_index: int = 0
    # --- randint: a > b ---
    assert str("=== randint ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        val: int = randint(5, 3)
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"caught ValueError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    try:
        val2: int = randint(1, 5)
        assert str("randint(1, 5) ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # --- randbelow: n <= 0 ---
    assert str("=== randbelow ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        val3: int = randbelow(0)
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"caught ValueError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    try:
        val4: int = randbelow(10)
        assert str("randbelow(10) ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # --- wrap: width <= 0 ---
    assert str("=== wrap ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        lines: list[str] = wrap("hello", 0)
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"caught ValueError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    try:
        lines2: list[str] = wrap("hello world", 5)
        assert str("wrap ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # --- fill: width <= 0 ---
    assert str("=== fill ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        filled: str = fill("hello", 0)
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"caught ValueError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    try:
        filled2: str = fill("hello world", 5)
        assert str("fill ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # --- batched: n <= 0 ---
    assert str("=== batched ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    data: list[int] = [1, 2, 3]
    try:
        bat: list[list[int]] = batched(data, 0)
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"caught ValueError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    try:
        bat2: list[list[int]] = batched(data, 2)
        assert str("batched ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # --- topological_sort: cycle ---
    assert str("=== topological_sort ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    from_nodes: list[int] = [0, 1]
    to_nodes: list[int] = [1, 0]
    try:
        order: list[int] = topological_sort(2, from_nodes, to_nodes)
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except CycleError as e:
        assert str(f"caught CycleError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    from_nodes2: list[int] = [0, 0]
    to_nodes2: list[int] = [1, 2]
    try:
        order2: list[int] = topological_sort(3, from_nodes2, to_nodes2)
        assert str("topo sort ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except CycleError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # --- uuid_from_hex: invalid ---
    assert str("=== uuid_from_hex ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        u: UUID = uuid_from_hex("not-a-uuid-xyz!")
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"caught ValueError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    try:
        u2: UUID = uuid_from_hex("abcd")
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"caught ValueError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    try:
        u3: UUID = uuid_from_hex("550e8400e29b41d4a716446655440000")
        assert str("uuid ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # --- ip_to_int: invalid ---
    assert str("=== ip_to_int ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        ip_val: int = ip_to_int("not.an.ip.address")
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"caught ValueError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    try:
        ip_val2: int = ip_to_int("192.168.1.1")
        assert str("ip_to_int ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # --- from_timestamp: invalid ---
    assert str("=== from_timestamp ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        dt: datetime = from_timestamp(-99999999999999.0)
        assert str("unexpected") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"caught ValueError: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    try:
        dt2: datetime = from_timestamp(0.0)
        assert str("from_timestamp ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # --- subscript assign: out of bounds reports IndexError ---
    assert str("=== subscript assign ===") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    nums: list[int] = [10, 20, 30]
    try:
        nums[99] = 999
    except IndexError as e:
        pass
    assert str(nums) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1

    assert str("all edge case safety checks passed") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
