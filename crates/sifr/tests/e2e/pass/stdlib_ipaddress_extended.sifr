# Test new sifr.ipaddress functions

from sifr.ipaddress import int_to_ip, is_multicast, is_global

def main():
    assert "int_to_ip = " + int_to_ip(3232235777) == "int_to_ip = 192.168.1.1"
    assert "is_multicast = " + str(is_multicast("224.0.0.1")) == "is_multicast = true"
    assert "is_global = " + str(is_global("8.8.8.8")) == "is_global = true"
