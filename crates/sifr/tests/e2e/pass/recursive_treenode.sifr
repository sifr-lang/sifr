# Tests self-referential TreeNode class with Box<T>

class TreeNode:
    val: int
    left: TreeNode | None
    right: TreeNode | None

    def __init__(self, val: int, left: TreeNode | None, right: TreeNode | None):
        self.val = val
        self.left = left
        self.right = right

def main():
    left: TreeNode = TreeNode(2, None, None)
    right: TreeNode = TreeNode(3, None, None)
    root: TreeNode = TreeNode(1, left, right)
    assert str(root.val) == '1'
