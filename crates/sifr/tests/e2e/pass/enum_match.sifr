from enum import Enum

class Direction(Enum):
    NORTH = 1
    SOUTH = 2
    EAST = 3
    WEST = 4

def describe(d: Direction) -> str:
    match d:
        case Direction.NORTH:
            return "north"
        case Direction.SOUTH:
            return "south"
        case Direction.EAST:
            return "east"
        case Direction.WEST:
            return "west"
        case _:
            return "unknown"

def main():
    assert describe(Direction.NORTH) == north
    assert describe(Direction.EAST) == east
    assert describe(Direction.WEST) == west

