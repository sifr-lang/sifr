from sifr.operator import add, sub, mul, floordiv, mod_val, neg, lt, eq, and_, or_, not_, contains, getitem, itemgetter, truth

def main():
    assert str("add = " + str(add(3, 4))) == 'add = 7'
    assert str("sub = " + str(sub(7, 4))) == 'sub = 3'
    assert str("mul = " + str(mul(2, 5))) == 'mul = 10'
    try:
        quotient: int = floordiv(5, 2)
        remainder: int = mod_val(5, 2)
        assert str("floordiv = " + str(quotient)) == 'floordiv = 2'
        assert str("mod_val = " + str(remainder)) == 'mod_val = 1'
    except DivisionError:
        assert False
    assert str("neg = " + str(neg(5))) == 'neg = -5'
    assert str("lt = " + str(lt(3, 5))) == 'lt = true'
    assert str("eq = " + str(eq(3, 5))) == 'eq = false'
    assert str("and_ = " + str(and_(True, False))) == 'and_ = false'
    assert str("or_ = " + str(or_(True, False))) == 'or_ = true'
    assert str("not_ = " + str(not_(False))) == 'not_ = true'

    items: list[int] = [10, 20, 30, 40]
    assert str("getitem = " + str(getitem(items, 2))) == 'getitem = 30'
    assert str("itemgetter = " + str(itemgetter(items, 2))) == 'itemgetter = 30'
    assert str("contains = " + str(contains(items, 20))) == 'contains = true'
    assert str("truth = " + str(truth(items))) == 'truth = true'
