
from sifr.operator import add, sub, mul, floordiv, mod_val, neg, lt, eq, itemgetter

def main():
    assert "add = " + str(add(3, 4)) == "add = 7"
    assert "sub = " + str(sub(7, 4)) == "sub = 3"
    assert "mul = " + str(mul(2, 5)) == "mul = 10"
    assert "floordiv = " + str(floordiv(5, 2)) == "floordiv = 2"
    assert "mod_val = " + str(mod_val(5, 2)) == "mod_val = 1"
    assert "neg = " + str(neg(5)) == "neg = -5"
    assert "lt = " + str(lt(3, 5)) == "lt = true"
    assert "eq = " + str(eq(3, 5)) == "eq = false"

    items: list[int] = [10, 20, 30, 40]
    assert "itemgetter = " + str(itemgetter(items, 2)) == "itemgetter = 30"
