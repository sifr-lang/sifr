# Immutable structural records have named construction and canonical layouts.

type User = {active: bool, email: str, id: int}
type UserSummary = {email: str, id: int}
type Boxed[T] = {value: T}
type ReorderedUser = {id: int, email: str, active: bool}
type Flags = {active: bool, admin: bool}
type Count = {value: int}
type WideCount = {left: int, middle: int, right: int}
type NarrowCount = {left: int, right: int}
type Transform = {apply: Callable[[int], int]}
type TaggedNumber = {value: int | bool}


def read_id(user: UserSummary) -> int:
    return user.id


def unwrap[T](box: Boxed[T]) -> T:
    return box.value


def wrap[T](own value: T) -> Boxed[T]:
    return Boxed[T](value=value)


def is_active(flags: Flags) -> bool:
    return flags.active


def count_value(count: Count) -> int:
    return count.value


def increment(value: int) -> int:
    return value + 1


def main():
    user: User = User(id=7, email="dev@sifr.dev", active=True)
    assert user.id == 7
    assert user.email == "dev@sifr.dev"
    assert read_id(user) == 7

    branch_user: User = User(id=7, email="branch@sifr.dev", active=True)
    reordered: ReorderedUser = ReorderedUser(active=True, id=8, email="other@sifr.dev")
    selected = branch_user if True else reordered
    assert selected.id == 7

    box: Boxed[int] = Boxed[int](value=9)
    assert unwrap(box) == 9
    wrapped: Boxed[int] = wrap(10)
    assert unwrap(wrapped) == 10

    flags: Flags = Flags(active=True, admin=False)
    assert is_active(flags)
    assert is_active(flags)

    count: Count = Count(value=1)
    assert count_value(count) == 1
    assert count_value(count) == 1

    projected: UserSummary = user.project[UserSummary]()
    assert projected.id == 7
    match projected:
        case {"id": projected_id}:
            assert projected_id == 7

    wide_count: WideCount = WideCount(left=11, middle=12, right=13)
    narrow_count: NarrowCount = wide_count.project[NarrowCount]()
    assert narrow_count.left == 11
    assert narrow_count.right == 13
    # Exact integers have Sifr copy semantics but use a non-Copy Rust carrier.
    assert wide_count.middle == 12

    transform: Transform = Transform(apply=increment)
    assert transform.apply(4) == 5

    tagged: TaggedNumber = TaggedNumber(value=17)
    assert tagged.value == 17
