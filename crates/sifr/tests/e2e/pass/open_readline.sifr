
from sifr.io import read_lines, write_text

def main():
    path: str = "/tmp/sifr_open_readline_test.txt"
    try:
        _: None = write_text(path, "first line\nsecond line\n")
        lines: list[str] = read_lines(path)
        line1: str | None = lines[0]
        line2: str | None = lines[1]
        if line1 is not None:
            assert str("line1 = " + line1) == 'line1 = first line'
        if line2 is not None:
            assert str("line2 = " + line2) == 'line2 = second line'
        assert str("line-count = " + str(len(lines))) == 'line-count = 2'
    except IOError as e:
        _ = str("error: " + e.message)
