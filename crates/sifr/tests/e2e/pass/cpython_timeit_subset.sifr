# Adapted CPython timeit subset for sifr.timeit (canonical bool-vector format)
from sifr.timeit import default_timer, timeit, repeat
from sifr.time import sleep
from sifr.test import assert_bool_vector_eq


def workload():
    total: int = 0
    i: int = 0
    while i < 200:
        total = total + i
        i = i + 1


def all_non_negative(values: list[float]) -> bool:
    i: int = 0
    while i < len(values):
        current: float | None = values[i]
        if current is None:
            return False
        if current < 0.0:
            return False
        i = i + 1
    return True


def collect_timer_actual() -> list[bool]:
    actual: list[bool] = []
    t1: float = default_timer()
    sleep(0.01)
    t2: float = default_timer()
    actual.append(t2 >= t1)
    return actual


def collect_repeat_actual() -> list[bool]:
    actual: list[bool] = []
    elapsed: float = timeit(workload, 5)
    actual.append(elapsed >= 0.0)

    repeated: list[float] = repeat(workload, 3, 4)
    actual.append(len(repeated) == 3)
    actual.append(all_non_negative(repeated))
    return actual


def collect_edge_actual() -> list[bool]:
    actual: list[bool] = []
    repeat_zero_count: list[float] = repeat(workload, 0, 4)
    actual.append(len(repeat_zero_count) == 0)

    repeat_negative_count: list[float] = repeat(workload, -2, 4)
    actual.append(len(repeat_negative_count) == 0)

    actual.append(timeit(workload, 0) >= 0.0)

    repeat_zero_number: list[float] = repeat(workload, 2, 0)
    actual.append(len(repeat_zero_number) == 2 and all_non_negative(repeat_zero_number))
    return actual


def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)


def main():
    expected: list[bool] = [True, True, True, True, True, True, True, True]
    actual: list[bool] = []
    append_all(actual, collect_timer_actual())
    append_all(actual, collect_repeat_actual())
    append_all(actual, collect_edge_actual())

    assert_bool_vector_eq(actual, expected)
    assert str("cpython_timeit_subset: pass") == "cpython_timeit_subset: pass"
