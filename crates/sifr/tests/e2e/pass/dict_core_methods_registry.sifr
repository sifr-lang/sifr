
def main():
    d: dict[str, int] = {"a": 1, "b": 2}

    keys: list[str] = d.keys()
    assert "keys len = " + str(len(keys)) == "keys len = 2"
    assert "keys has a = " + str(keys.contains("a")) == "keys has a = true"

    values: list[int] = d.values()
    assert "values len = " + str(len(values)) == "values len = 2"

    items: list[tuple[str, int]] = d.items()
    assert "items len = " + str(len(items)) == "items len = 2"

    d2: dict[str, int] = d.copy()
    d2.update({"c": 3})
    assert "copy len after update = " + str(len(d2)) == "copy len after update = 3"

    d2.clear()
    assert "clear len = " + str(len(d2)) == "clear len = 0"
