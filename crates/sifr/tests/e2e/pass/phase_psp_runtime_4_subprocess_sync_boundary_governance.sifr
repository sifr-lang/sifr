from sifr.subprocess import run, run_raw, run_with_input, check_call, check_output, CompletedProcess
from sifr.subprocess import PIPE, STDOUT, DEVNULL
from sifr.test import assert_bool_vector_eq


def main() -> None:
    actual: list[bool] = []

    run_ok: bool = False
    try:
        cp: CompletedProcess = run("echo runtime_wave4")
        run_ok = cp.returncode == 0 and cp.stdout.strip() == "runtime_wave4"
    except IOError as e:
        _ = e.message
    actual.append(run_ok)

    raw_ok: bool = False
    try:
        raw: str = run_raw("echo runtime_wave4_raw")
        raw_ok = raw.strip() == "runtime_wave4_raw"
    except IOError as e:
        _ = e.message
    actual.append(raw_ok)

    input_ok: bool = False
    try:
        echoed: str = run_with_input("cat", "runtime_wave4_stdin")
        input_ok = echoed == "runtime_wave4_stdin"
    except IOError as e:
        _ = e.message
    actual.append(input_ok)

    check_call_ok: bool = False
    try:
        rc: int = check_call("echo runtime_wave4_check_call")
        check_call_ok = rc == 0
    except IOError as e:
        _ = e.message
    actual.append(check_call_ok)

    check_output_ok: bool = False
    try:
        out: str = check_output("echo runtime_wave4_check_output")
        check_output_ok = out.strip() == "runtime_wave4_check_output"
    except IOError as e:
        _ = e.message
    actual.append(check_output_ok)

    constants_ok: bool = PIPE == -1 and STDOUT == -2 and DEVNULL == -3
    actual.append(constants_ok)

    check_call_failure_ok: bool = False
    try:
        _bad_rc: int = check_call("definitely_missing_runtime_wave4_cmd_12345")
        _ = _bad_rc
    except IOError as e:
        _ = e.message
        check_call_failure_ok = True
    actual.append(check_call_failure_ok)

    check_output_failure_ok: bool = False
    try:
        _bad_out: str = check_output("definitely_missing_runtime_wave4_cmd_12345")
        _ = _bad_out
    except IOError as e:
        _ = e.message
        check_output_failure_ok = True
    actual.append(check_output_failure_ok)

    stderr_shape_ok: bool = False
    try:
        stderr_cp: CompletedProcess = run("sh -c 'echo runtime_wave4_err 1>&2'")
        stderr_shape_ok = stderr_cp.returncode == 0 and stderr_cp.stderr.strip() == "runtime_wave4_err"
    except IOError as e:
        _ = e.message
    actual.append(stderr_shape_ok)

    expected: list[bool] = [True, True, True, True, True, True, True, True, True]
    assert_bool_vector_eq(actual, expected)
