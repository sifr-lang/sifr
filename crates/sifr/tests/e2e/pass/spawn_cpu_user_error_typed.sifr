class LocalFailure(Error):
    message: str


@cpu_heavy
def reject_value() -> Result[int, LocalFailure]:
    raise LocalFailure("cpu rejected value")


async def main() -> Result[None, ScopeFailure]:
    handle = task.spawn_cpu(reject_value)
    result = await handle
    assert str(result).find("cpu rejected value") is not None
    return None
