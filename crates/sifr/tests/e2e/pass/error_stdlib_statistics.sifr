
from sifr.statistics import StatisticsError

def compute_stats(data: list[float]) -> Result[float, StatisticsError]:
    if len(data) == 0:
        raise StatisticsError("empty dataset")
    total: float = 0.0
    for val in data:
        total = total + val
    return total / float(len(data))

def main():
    empty: list[float] = []
    try:
        avg: float = compute_stats(empty)
    except StatisticsError as e:
        assert f"caught StatisticsError: {e.message}" == "caught StatisticsError: empty dataset"

    assert "stdlib error types work" == "stdlib error types work"
