# Test generic functions with different protocol bounds
from sifr.bisect import bisect_left
from sifr.collections import Counter, from_list

def min_val[T: Comparable](a: T, b: T) -> T:
    if a < b:
        return a
    return b

def main():
    assert str(min_val(10, 3)) == '3'
    assert str(min_val("apple", "banana")) == 'apple'

    items: list[int] = [1, 3, 5, 7, 9]
    idx: int = bisect_left(items, 5)
    assert str(idx) == '2'

    words: list[str] = ["cat", "cat", "dog"]
    c: Counter[str] = from_list(words)
    assert str(c.get("cat")) == '2'

