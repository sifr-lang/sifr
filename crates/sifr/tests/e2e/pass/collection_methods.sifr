# Reference: stdlib_parity_a2_core_object_model_surface
def main():
    nums: list[int] = [1, 2, 3, 2]
    assert nums.index(2, start=1, stop=4) == 1
    assert nums.pop(0) == 1
    assert nums == [2, 3, 2]

    letters: list[str] = ["seed"]
    letters.extend("ab")
    assert letters == ["seed", "a", "b"]

    defaults_first: dict[str, int] = {"base": 1}
    assert defaults_first.setdefault("new", 2) == 2
    assert defaults_first == {"base": 1, "new": 2}

    data: dict[str, int] = {"x": 1}
    data.update(a=2)
    data.update([("b", 3)], c=4)
    assert data["a"] == 2
    assert data["b"] == 3
    assert data["c"] == 4
    assert data.setdefault("d", 8) == 8
    assert data["d"] == 8
    assert data.setdefault("a", 99) == 2
    assert data.pop("missing", default=9) == 9

    seen: set[int] = {1}
    seen.update([2, 3], range(4, 6))
    assert seen.contains(5)
    trimmed: set[int] = seen.intersection([1, 2, 7], [2, 3])
    assert trimmed.len() == 1
    assert trimmed.contains(2)
    seen.intersection_update([2, 3, 7], [2, 3, 9])
    assert seen == {2, 3}
    seen.difference_update([2], [8])
    assert seen == {3}
    seen.symmetric_difference_update([3, 9])
    assert seen == {9}

    first_intersection: set[int] = {1, 2, 3}
    first_intersection.intersection_update([2, 3, 4])
    assert first_intersection == {2, 3}
    first_difference: set[int] = {1, 2, 3}
    first_difference.difference_update([2], [8])
    assert first_difference == {1, 3}
    first_symmetric: set[int] = {1, 2}
    first_symmetric.symmetric_difference_update([2, 3])
    assert first_symmetric == {1, 3}

    pair: tuple[int, int, int] = (4, 5, 4)
    assert pair.count(4) == 2
    assert pair.index(4, start=1) == 2

    parts: list[str] = "alpha,beta,gamma".split(sep=",", maxsplit=1)
    assert parts == ["alpha", "beta,gamma"]
    assert "aaaa".replace("a", "b", count=2) == "bbaa"
