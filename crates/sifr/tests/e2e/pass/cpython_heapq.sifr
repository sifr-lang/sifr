# CPython test_heapq.py — ported assertions for sifr.heapq
# Updated to use the in-place mut-parameter API (borrow-by-default behavior)
from sifr.test import assert_eq
from sifr.heapq import heapify, heappush, heappop, nsmallest, nlargest, heappushpop, heapreplace, merge

def assert_push_pop_cases():
    h1: list[int] = []
    heappush(h1, 5)
    assert_eq(len(h1), 1)

    heappush(h1, 3)
    heappush(h1, 7)
    heappush(h1, 1)
    assert_eq(len(h1), 4)

    v1: int | None = heappop(h1)
    if v1 is not None:
        assert_eq(v1, 1)

    v2: int | None = heappop(h1)
    if v2 is not None:
        assert_eq(v2, 3)

    v3: int | None = heappop(h1)
    if v3 is not None:
        assert_eq(v3, 5)

    v4: int | None = heappop(h1)
    if v4 is not None:
        assert_eq(v4, 7)
    assert_eq(len(h1), 0)

def assert_heapify_cases():
    h2: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]
    heapify(h2)

    # Pop all to verify sorted order
    sorted_vals: list[int] = []
    while len(h2) > 0:
        val: int | None = heappop(h2)
        if val is not None:
            sorted_vals.append(val)
    assert_eq(len(sorted_vals), 8)
    assert str(sorted_vals) == '[1, 1, 2, 3, 4, 5, 6, 9]'

    # Empty heapify
    h3: list[int] = []
    heapify(h3)
    assert_eq(len(h3), 0)

def assert_rank_cases():
    data: list[int] = [4, 1, 5, 2, 3]
    sm: list[int] = nsmallest(3, data)
    assert_eq(len(sm), 3)
    assert str(sm) == '[1, 2, 3]'

    lg: list[int] = nlargest(3, data)
    assert_eq(len(lg), 3)
    assert str(lg) == '[5, 4, 3]'

    sm1: list[int] = nsmallest(1, data)
    assert_eq(len(sm1), 1)
    assert str(sm1) == '[1]'

    lg1: list[int] = nlargest(1, data)
    assert_eq(len(lg1), 1)
    assert str(lg1) == '[5]'

def assert_pushpop_replace_cases():
    h5: list[int] = [3, 5, 7]
    r1: int | None = heappushpop(h5, 1)
    if r1 is not None:
        assert_eq(r1, 1)

    h6: list[int] = [3, 5, 7]
    r2: int | None = heappushpop(h6, 4)
    if r2 is not None:
        assert_eq(r2, 3)

    # --- heapreplace mutates the heap in place ---
    h7: list[int] = [1, 5, 7]
    r3: int | None = heapreplace(h7, 10)
    if r3 is not None:
        assert_eq(r3, 1)

def assert_merge_cases():
    left: list[int] = [1, 4, 7]
    right: list[int] = [2, 5, 8]
    tail: list[int] = [3, 6, 9]
    merged: list[int] = merge(left, right, tail)
    assert_eq(str(merged), '[1, 2, 3, 4, 5, 6, 7, 8, 9]')

def main():
    assert_push_pop_cases()
    assert_heapify_cases()
    assert_rank_cases()
    assert_pushpop_replace_cases()
    assert_merge_cases()

    assert str("cpython_heapq: all assertions passed") == 'cpython_heapq: all assertions passed'
