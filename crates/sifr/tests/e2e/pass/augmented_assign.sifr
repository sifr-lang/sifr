# expect-stdout: 15
# expect-stdout: 10.5
# expect-stdout: HelloWorld
# expect-stdout: 3
def main():
    x: int = 10
    x += 5
    print(x)

    y: float = 3.5
    y *= 3.0
    print(y)

    s: str = "Hello"
    s += "World"
    print(s)

    items: list[int] = [1, 2]
    items += [3]
    print(len(items))
