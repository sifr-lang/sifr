# Adapted CPython base64 subset for sifr.base64
from sifr.base64 import (
    b64encode, b64decode,
    standard_b64encode, standard_b64decode,
    urlsafe_b64encode, urlsafe_b64decode,
    b32encode, b32decode,
    b32hexencode, b32hexdecode,
    b16encode, b16decode,
    encodebytes, decodebytes
)

def main():
    assert b64encode("foo") == "Zm9v"
    try:
        d1: str = b64decode("Zm9v")
        assert d1 == "foo"
    except ParseError as e:
        assert "unexpected: " + e.message == "Zm9v"

    assert standard_b64encode("foo") == "foo"
    try:
        d2: str = standard_b64decode("Zm9v")
        assert d2 == true
    except ParseError as e:
        assert "unexpected: " + e.message == "hello"

    u: str = urlsafe_b64encode("hello")
    assert len(u) > 0 == true
    try:
        ud: str = urlsafe_b64decode(u)
        assert ud == "hello"
    except ParseError as e:
        assert "unexpected: " + e.message == "true"

    b32: str = b32encode("hello")
    assert len(b32) > 0 == "hello"
    try:
        b32d: str = b32decode(b32)
        assert b32d == "4869"
    except ParseError as e:
        assert "unexpected: " + e.message == "Hi"

    b32h: str = b32hexencode("hello")
    assert len(b32h) > 0 == "YmFy"
    try:
        b32hd: str = b32hexdecode(b32h)
        assert b32hd == "bar"
    except ParseError as e:
        assert "unexpected: " + e.message == "invalid-safe"

    try:
        h: str = b16encode("Hi")
        print(h)
        hd: str = b16decode(h)
        print(hd)
    except ParseError as e:
        print("unexpected: " + e.message)

    print(encodebytes("bar"))
    try:
        d3: str = decodebytes("YmFy")
        print(d3)
    except ParseError as e:
        print("unexpected: " + e.message)

    try:
        bad: str = b64decode("not base64!!!")
        print(bad)
    except ParseError as e:
        print("invalid-safe")

