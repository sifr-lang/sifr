# Adapted CPython base64 subset for sifr.base64
from sifr.base64 import (
    b64encode, b64decode,
    standard_b64encode, standard_b64decode,
    urlsafe_b64encode, urlsafe_b64decode,
    b32encode, b32decode,
    b32hexencode, b32hexdecode,
    b16encode, b16decode,
    encodebytes, decodebytes
)
from sifr.test import assert_vector_eq, assert_bool_vector_eq

def main():
    expected: list[str] = ["Zm9v", "foo", "Zm9v", "foo", "true", "hello", "true", "hello", "true", "hello", "4869", "Hi", "YmFy", "bar"]
    actual: list[str] = []

    actual.append(b64encode("foo"))
    d1_ok: bool = True
    d1: str = ""
    try:
        out: str = b64decode("Zm9v")
        d1 = out
    except ParseError as e:
        d1_ok = False
    if d1_ok:
        actual.append(d1)
    else:
        actual.append("ERR")

    actual.append(standard_b64encode("foo"))
    d2_ok: bool = True
    d2: str = ""
    try:
        out2: str = standard_b64decode("Zm9v")
        d2 = out2
    except ParseError as e:
        d2_ok = False
    if d2_ok:
        actual.append(d2)
    else:
        actual.append("ERR")

    u: str = urlsafe_b64encode("hello")
    actual.append(str(len(u) > 0))
    ud_ok: bool = True
    ud: str = ""
    try:
        out3: str = urlsafe_b64decode(u)
        ud = out3
    except ParseError as e:
        ud_ok = False
    if ud_ok:
        actual.append(ud)
    else:
        actual.append("ERR")

    b32: str = b32encode("hello")
    actual.append(str(len(b32) > 0))
    b32d_ok: bool = True
    b32d: str = ""
    try:
        out4: str = b32decode(b32)
        b32d = out4
    except ParseError as e:
        b32d_ok = False
    if b32d_ok:
        actual.append(b32d)
    else:
        actual.append("ERR")

    b32h: str = b32hexencode("hello")
    actual.append(str(len(b32h) > 0))
    b32hd_ok: bool = True
    b32hd: str = ""
    try:
        out5: str = b32hexdecode(b32h)
        b32hd = out5
    except ParseError as e:
        b32hd_ok = False
    if b32hd_ok:
        actual.append(b32hd)
    else:
        actual.append("ERR")

    b16_ok: bool = True
    b16: str = ""
    b16d: str = ""
    try:
        h: str = b16encode("Hi")
        b16 = h + ""
        hd: str = b16decode(h)
        b16d = hd
    except ParseError as e:
        b16_ok = False
    if b16_ok:
        actual.append(b16)
        actual.append(b16d)
    else:
        actual.append("ERR")
        actual.append("ERR")

    actual.append(encodebytes("bar"))
    d3_ok: bool = True
    d3: str = ""
    try:
        out6: str = decodebytes("YmFy")
        d3 = out6
    except ParseError as e:
        d3_ok = False
    if d3_ok:
        actual.append(d3)
    else:
        actual.append("ERR")

    assert_vector_eq(actual, expected)

    # Error-path fixture vectors.
    decode_inputs: list[str] = ["not base64!!!", "YmFy"]
    expected_ok: list[bool] = [False, True]
    actual_ok: list[bool] = []
    for payload in decode_inputs:
        try:
            out7: str = b64decode(payload)
            actual_ok.append(True)
        except ParseError as e:
            actual_ok.append(False)
    assert_bool_vector_eq(actual_ok, expected_ok)
    assert str("cpython_base64_subset: pass") == "cpython_base64_subset: pass"
