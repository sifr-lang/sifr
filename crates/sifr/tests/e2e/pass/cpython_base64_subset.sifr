# Adapted CPython base64 subset for sifr.base64
from sifr.base64 import (
    b64encode, b64decode,
    standard_b64encode, standard_b64decode,
    urlsafe_b64encode, urlsafe_b64decode,
    b32encode, b32decode,
    b32hexencode, b32hexdecode,
    b16encode, b16decode,
    encodebytes, decodebytes
)


def main():
    expected: list[str] = ["invalid-safe", "bar", "YmFy", "Hi", "4869", "hello", "true", "hello", "true", "hello", "true", "foo", "Zm9v", "foo", "Zm9v"]
    expected_index: int = 0
    assert str(b64encode("foo")) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        d1: str = b64decode("Zm9v")
        assert str(d1) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    assert str(standard_b64encode("foo")) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        d2: str = standard_b64decode("Zm9v")
        assert str(d2) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    u: str = urlsafe_b64encode("hello")
    assert str(len(u) > 0) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        ud: str = urlsafe_b64decode(u)
        assert str(ud) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    b32: str = b32encode("hello")
    assert str(len(b32) > 0) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        b32d: str = b32decode(b32)
        assert str(b32d) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    b32h: str = b32hexencode("hello")
    assert str(len(b32h) > 0) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        b32hd: str = b32hexdecode(b32h)
        assert str(b32hd) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        h: str = b16encode("Hi")
        assert str(h) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
        hd: str = b16decode(h)
        assert str(hd) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    assert str(encodebytes("bar")) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    try:
        d3: str = decodebytes("YmFy")
        assert str(d3) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("unexpected: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        bad: str = b64decode("not base64!!!")
        assert str(bad) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ParseError as e:
        assert str("invalid-safe") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

