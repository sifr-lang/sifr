# Adapted CPython base64 subset for sifr.base64
from sifr.base64 import (
    b64encode, b64decode,
    urlsafe_b64encode, urlsafe_b64decode,
    b32encode, b32decode,
    b32hexencode, b32hexdecode,
    b16encode, b16decode
)
from sifr.test import assert_vector_eq, assert_bool_vector_eq

def encode_b64_or_err(payload: str) -> str:
    return b64encode(payload)

def encode_urlsafe_b64_or_err(payload: str) -> str:
    return urlsafe_b64encode(payload)

def encode_b32_or_err(payload: str) -> str:
    return b32encode(payload)

def encode_b32hex_or_err(payload: str) -> str:
    return b32hexencode(payload)

def decode_b64_or_err(payload: str) -> str:
    try:
        decoded: str = b64decode(payload)
        return decoded
    except ParseError as e:
        return "ERR"

def decode_urlsafe_b64_or_err(payload: str) -> str:
    try:
        decoded: str = urlsafe_b64decode(payload)
        return decoded
    except ParseError as e:
        return "ERR"

def decode_b32_or_err(payload: str) -> str:
    try:
        decoded: str = b32decode(payload)
        return decoded
    except ParseError as e:
        return "ERR"

def decode_b32hex_or_err(payload: str) -> str:
    try:
        decoded: str = b32hexdecode(payload)
        return decoded
    except ParseError as e:
        return "ERR"

def b16_encode_or_err(payload: str) -> str:
    encoded: str = "ERR"
    try:
        out: str = b16encode(payload)
        encoded = out
    except ParseError as e:
        _ = str(e.message)
    return encoded

def b16_decode_or_err(payload: str) -> str:
    decoded: str = "ERR"
    try:
        out: str = b16decode(payload)
        decoded = out
    except ParseError as e:
        _ = str(e.message)
    return decoded

def collect_positive_actual() -> list[str]:
    actual: list[str] = []
    actual.append(encode_b64_or_err("foo"))
    actual.append(decode_b64_or_err("Zm9v"))
    urlsafe_encoded: str = encode_urlsafe_b64_or_err("hello")
    actual.append(str(len(urlsafe_encoded) > 0))
    actual.append(decode_urlsafe_b64_or_err(urlsafe_encoded))

    b32_encoded: str = encode_b32_or_err("hello")
    actual.append(str(len(b32_encoded) > 0))
    actual.append(decode_b32_or_err(b32_encoded))

    b32hex_encoded: str = encode_b32hex_or_err("hello")
    actual.append(str(len(b32hex_encoded) > 0))
    actual.append(decode_b32hex_or_err(b32hex_encoded))

    b16_encoded: str = b16_encode_or_err("Hi")
    b16_encoded_for_decode: str = b16_encoded + ""
    actual.append(b16_encoded)
    actual.append(b16_decode_or_err(b16_encoded_for_decode))

    return actual

def collect_decode_actual_ok(inputs: list[str]) -> list[bool]:
    actual_ok: list[bool] = []
    for payload in inputs:
        try:
            decoded: str = b64decode(payload)
            _ = str(decoded)
            actual_ok.append(True)
        except ParseError as e:
            actual_ok.append(False)
    return actual_ok

def main():
    expected: list[str] = [
        "Zm9v", "foo",
        "true", "hello",
        "true", "hello",
        "true", "hello",
        "4869", "Hi",
    ]
    actual: list[str] = collect_positive_actual()
    assert_vector_eq(actual, expected)

    decode_inputs: list[str] = ["not base64!!!", "YmFy"]
    expected_ok: list[bool] = [False, True]
    actual_ok: list[bool] = collect_decode_actual_ok(decode_inputs)
    assert_bool_vector_eq(actual_ok, expected_ok)
    assert str("cpython_base64_subset: pass") == "cpython_base64_subset: pass"
