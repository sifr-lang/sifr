async def numbers() -> AsyncGenerator[int, GeneratorCloseError]:
    yield 1
    yield 2
    yield 3


async def main() -> Result[None, GeneratorCloseError]:
    values: set[int] = {x async for x in numbers() if x > 1}

    assert len(values) == 2
    assert 2 in values
    assert 3 in values
    return None
