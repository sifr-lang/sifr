
from sifr.configparser import ConfigParser

def main():
    config: ConfigParser = ConfigParser()
    config.read_string("[database]\nhost = localhost\nport = 5432\n")

    host: str = config.get("database", "host")
    port: str = config.get("database", "port")
    assert "host = " + host == "host = localhost"
    assert "port = " + port == "port = 5432"
    assert "has_host = " + str(config.has_option("database", "host")) == "has_host = true"
    assert "has_missing = " + str(config.has_option("database", "missing")) == "has_missing = false"
