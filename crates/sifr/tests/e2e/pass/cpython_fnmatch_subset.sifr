# Adapted CPython fnmatch subset for sifr.fnmatch (canonical vector format)
from sifr.fnmatch import fnmatch, filter
from sifr.test import assert_bool_vector_eq

def collect_fnmatch_actual() -> list[bool]:
    actual: list[bool] = []
    match_exact: bool = fnmatch("abc", "abc")
    match_prefix: bool = fnmatch("abc", "a*")
    match_suffix: bool = fnmatch("abc", "*c")
    match_qmark: bool = fnmatch("abc", "???")
    no_ab_match: bool = not fnmatch("abc", "ab")
    empty_qmark_match: bool = not fnmatch("", "?")
    actual.append(match_exact)
    actual.append(match_prefix)
    actual.append(match_suffix)
    actual.append(match_qmark)
    actual.append(no_ab_match)
    actual.append(empty_qmark_match)
    return actual

def collect_case_sensitive_actual() -> list[bool]:
    actual: list[bool] = []
    case_exact: bool = fnmatch("AbC", "AbC")
    no_case_fold_match: bool = not fnmatch("AbC", "abc")
    uppercase_pattern_miss: bool = not fnmatch("ABC", "a*")
    actual.append(case_exact)
    actual.append(no_case_fold_match)
    actual.append(uppercase_pattern_miss)
    return actual

def collect_filter_actual() -> list[bool]:
    actual: list[bool] = []
    names: list[str] = ["Python", "Ruby", "Perl", "Tcl"]
    actual.append(str(filter(names, "P*")) == "[\"Python\", \"Perl\"]")
    actual.append(str(filter(names, "R*")) == "[\"Ruby\"]")
    actual.append(str(filter(names, "X*")) == "[]")

    files: list[str] = ["a.py", "b.txt", "c.py", "d.rs"]
    actual.append(str(filter(files, "*.py")) == "[\"a.py\", \"c.py\"]")
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [
        True, True, True, True, True, True,
        True, True, True, True, True, True,
        True
    ]
    actual: list[bool] = []
    append_all(actual, collect_fnmatch_actual())
    append_all(actual, collect_case_sensitive_actual())
    append_all(actual, collect_filter_actual())

    assert_bool_vector_eq(actual, expected)
    assert str("cpython_fnmatch_subset: pass") == "cpython_fnmatch_subset: pass"
