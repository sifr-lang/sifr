from sifr.sync import Channel, ChannelReceiver, ChannelSender, ClosedError


async def main() -> Result[None, ClosedError]:
    # Surface validation only: direct endpoint construction, async send/receive
    # signatures, and Result types. Shared queue factories are deferred capabilities.
    sender: ChannelSender[int] = ChannelSender(Channel([], -1))
    sent: Result[None, ClosedError] = await sender.send(42)
    receiver: ChannelReceiver[int] = ChannelReceiver(Channel([42], -1))
    received: Result[int, ClosedError] = await receiver.receive()
    assert str(sent) == "Ok(())"
    assert str(received) == "Ok(42)"
    return None
