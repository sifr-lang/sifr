# Adapted CPython hashlib object-model subset for sifr.hashlib
from sifr.hashlib import sha256, md5, sha256_obj, md5_obj, copy_hash

def main():
    h = sha256_obj("")
    h.update("a")
    h.update("bc")
    assert str(h.hexdigest() == sha256("abc")) == 'true'
    assert str(h.digest() == h.hexdigest()) == 'true'
    assert str(h.name == "sha256") == 'true'
    assert str(h.digest_size == 32) == 'true'
    assert str(h.block_size == 64) == 'true'

    c = copy_hash(h)
    c.update("x")
    assert str(h.hexdigest() == sha256("abc")) == 'true'
    assert str(c.hexdigest() == sha256("abcx")) == 'true'

    m = md5_obj("hello")
    assert str(m.hexdigest() == md5("hello")) == 'true'
    assert str(m.digest_size == 16) == 'true'
    assert str(m.block_size == 64) == 'true'

