# Adapted CPython hashlib object-model subset for sifr.hashlib
from sifr.hashlib import sha256, md5, sha256_obj, md5_obj, copy_hash

def main():
    h = sha256_obj("")
    h.update("a")
    h.update("bc")
    assert h.hexdigest() == sha256("abc") == True
    assert h.digest() == h.hexdigest() == True
    assert h.name == "sha256" == True
    assert h.digest_size == 32 == True
    assert h.block_size == 64 == True

    c = copy_hash(h)
    c.update("x")
    assert h.hexdigest() == sha256("abc") == True
    assert c.hexdigest() == sha256("abcx") == True

    m = md5_obj("hello")
    assert m.hexdigest() == md5("hello") == True
    assert m.digest_size == 16 == True
    assert m.block_size == 64 == True

