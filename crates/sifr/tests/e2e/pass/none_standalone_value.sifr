
def maybe_value(x: int) -> int | None:
    if x > 0:
        return x
    return None

def main():
    result: int | None = maybe_value(0)
    if result is None:
        assert "none" == none
    result2: int | None = maybe_value(5)
    assert result2 is not None == True
    assert result2 is None == False
