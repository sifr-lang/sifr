# Test error subclass handling: IOError subclasses, extra fields, parent catch-all
from sifr.io import read_text, write_text
from sifr.json import JsonValue, loads
from sifr.re import search

def has_match(pattern: str, text: str) -> Result[bool, RegexError]:
    try:
        found: str | None = search(pattern, text)
        return found is not None
    except RegexError as error:
        raise RegexError(error.message)


def main():
    expected: list[str] = ["all tests passed", "9: custom error message", "8: display ok", "7: caught FileNotFoundError in mixed", "6: regex detail ok", "5: json line=1 col=2", "4: message ok", "3: kind=FileNotFound", "2: caught IOError parent", "1: caught FileNotFoundError"]
    expected_index: int = 0
    # 1. FileNotFoundError caught by specific handler
    try:
        content: str = read_text("/tmp/sifr_subclass_nonexistent.txt")
    except FileNotFoundError as e:
        assert str("1: caught FileNotFoundError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("1: should not reach IOError") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 2. IOError parent catches all subclasses
    try:
        content2: str = read_text("/tmp/sifr_subclass_nonexistent2.txt")
    except IOError as e:
        assert str("2: caught IOError parent") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 3. IOError kind field is populated
    try:
        content3: str = read_text("/tmp/sifr_subclass_nonexistent3.txt")
    except IOError as e:
        assert str(f"3: kind={e.kind}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 4. e.message contains Rust error text
    try:
        content4: str = read_text("/tmp/sifr_subclass_nonexistent4.txt")
    except FileNotFoundError as e:
        assert str("4: message ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("4: fallback") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 5. JSONDecodeError has line and column fields
    try:
        result: JsonValue = loads("{invalid json")
    except JSONDecodeError as e:
        assert str(f"5: json line={e.line} col={e.column}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 6. RegexError has detail field
    try:
        m: bool = has_match("[invalid", "test")
    except RegexError as e:
        assert str("6: regex detail ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 7. Mixed error families: IOError + JSONDecodeError in same try
    try:
        data: str = read_text("/tmp/sifr_subclass_nonexistent5.txt")
    except FileNotFoundError as e:
        assert str("7: caught FileNotFoundError in mixed") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except IOError as e:
        assert str("7: caught IOError in mixed") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except JSONDecodeError as e:
        assert str("7: caught JSONDecodeError in mixed") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 8. print(e) works via Display (same as e.message)
    try:
        content8: str = read_text("/tmp/sifr_subclass_nonexistent8.txt")
    except IOError as e:
        assert str("8: display ok") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # 9. User-defined error with message
    try:
        raise ValueError("custom error message")
    except ValueError as e:
        assert str(f"9: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    assert str("all tests passed") == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
