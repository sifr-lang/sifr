# Test sifr.collections Counter class — native dict[str, int] implementation
from sifr.collections import Counter, from_list

def main():
    # Create Counter from a list of strings
    c: Counter = from_list(["apple", "banana", "apple", "cherry", "banana", "apple"])

    # Get count for a specific key
    assert c.get("apple") == 3
    assert c.get("banana") == 2
    assert c.get("cherry") == 1
    assert c.get("missing") == 0

    # Total count
    assert c.total() == 6

    # Most common (top 2) -- returns list of keys sorted by count descending
    top2: list[str] = c.most_common(2)
    assert top2 == ["apple", "banana"]

    # Keys and values
    keys: list[str] = c.keys()
    assert len(keys) == 3
    vals: list[int] = c.values()
    assert len(vals) == 3

    # Increment
    c.increment("cherry")
    c.increment("cherry")
    assert c.get("cherry") == 3

