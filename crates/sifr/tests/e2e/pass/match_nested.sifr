class Point:
    x: int
    y: int

def classify(p: Point) -> str:
    match p:
        case Point(x=0, y=0):
            return "origin"
        case Point(x=px, y=py) if px > 0 and py > 0:
            return "first quadrant"
        case Point(x=px, y=py) if px < 0 and py > 0:
            return "second quadrant"
        case _:
            return "other"

def main():
    assert str(classify(Point(0, 0))) == 'origin'
    assert str(classify(Point(3, 4))) == 'first quadrant'
    assert str(classify(Point(-2, 5))) == 'second quadrant'
    assert str(classify(Point(-1, -1))) == 'other'

