# Adapted CPython calendar subset for sifr.calendar
from sifr.calendar import (
    MONDAY, SUNDAY,
    day_name, day_abbr,
    month_name, month_abbr,
    isleap, leapdays, monthrange,
    Calendar, TextCalendar, HTMLCalendar,
)
from sifr.test import assert_bool_vector_eq

def collect_constants_actual() -> list[bool]:
    actual: list[bool] = []
    jan: str | None = month_name[1]
    dec_abbr: str | None = month_abbr[12]
    monday_abbr: str | None = day_abbr[MONDAY]
    sunday_name: str | None = day_name[SUNDAY]

    actual.append(jan == "January")
    actual.append(dec_abbr == "Dec")
    actual.append(monday_abbr == "Mon")
    actual.append(sunday_name == "Sunday")
    return actual

def collect_helper_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(isleap(2024))
    not_leap_1900: bool = not isleap(1900)
    actual.append(not_leap_1900)
    actual.append(leapdays(2000, 2025) == 7)
    feb_2024: list[int] = monthrange(2024, 2)
    actual.append(str(feb_2024) == "[3, 29]")
    return actual

def collect_class_actual() -> list[bool]:
    actual: list[bool] = []

    cal: Calendar = Calendar(MONDAY)
    actual.append(str(cal.iterweekdays()) == "[0, 1, 2, 3, 4, 5, 6]")
    cal.setfirstweekday(SUNDAY)
    actual.append(str(cal.iterweekdays()) == "[6, 0, 1, 2, 3, 4, 5]")

    text_cal_ok: bool = False
    try:
        text_cal: TextCalendar = TextCalendar(MONDAY)
        month_label: str = text_cal.formatmonthname(2024, 2, 0)
        text_cal_ok = month_label == "February 2024"
    except ValueError as e:
        _ = e.message
    actual.append(text_cal_ok)

    html_cal_ok: bool = False
    try:
        html_cal: HTMLCalendar = HTMLCalendar(MONDAY)
        html_label: str = html_cal.formatmonthname(2024, 2)
        html_cal_ok = html_label == "<tr><th colspan=\"7\" class=\"month\">February 2024</th></tr>"
    except ValueError as e:
        _ = e.message
    actual.append(html_cal_ok)

    invalid_month_ok: bool = False
    try:
        _bad: str = TextCalendar().formatmonthname(2024, 13, 0)
    except ValueError as e:
        invalid_month_ok = e.message == "calendar: month must be in 1..12"
    actual.append(invalid_month_ok)

    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [
        True, True, True, True,
        True, True, True, True,
        True, True, True, True, True,
    ]
    actual: list[bool] = []
    append_all(actual, collect_constants_actual())
    append_all(actual, collect_helper_actual())
    append_all(actual, collect_class_actual())
    assert_bool_vector_eq(actual, expected)
    assert str("cpython_calendar_subset: pass") == "cpython_calendar_subset: pass"
