def describe(x: int) -> str:
    match x:
        case 1:
            return "one"
        case 2:
            return "two"
        case 3:
            return "three"
        case _:
            return "other"

def main():
    assert str(describe(1)) == 'one'
    assert str(describe(2)) == 'two'
    assert str(describe(3)) == 'three'
    assert str(describe(99)) == 'other'

