# Tuple unpack borrowed and owned.
from sifr.test import assert_eq


def borrowed(values: tuple[str, int]) -> str:
    first, number = values
    return first


def owned(own values: tuple[str, int]) -> str:
    first, number = values
    return first


def main() -> None:
    retained: tuple[str, int] = ("borrowed", 1)
    assert_eq(borrowed(retained), "borrowed")
    assert_eq(retained[0], "borrowed")
    assert_eq(owned(("owned", 2)), "owned")
