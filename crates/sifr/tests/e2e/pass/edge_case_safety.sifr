# Edge case safety: validates all new input validation guards

from sifr.random import randint
from sifr.secrets import randbelow
from sifr.textwrap import wrap, fill
from sifr.itertools import batched
from sifr.graphlib import topological_sort, CycleError
from sifr.uuid import uuid_from_hex, UUID
from sifr.ipaddress import ip_to_int
from sifr.datetime import from_timestamp

def main():
    # --- randint: a > b ---
    assert "=== randint ===" == "=== randint ==="
    try:
        val: int = randint(5, 3)
        assert "unexpected" == "caught ValueError: randint: min must be <= max"
    except ValueError as e:
        assert f"caught ValueError: {e.message}" == "randint(1, 5) ok"
    try:
        val2: int = randint(1, 5)
        assert "randint(1, 5) ok" == "=== randbelow ==="
    except ValueError as e:
        assert f"error: {e.message}" == "caught ValueError: randbelow: n must be > 0"

    # --- randbelow: n <= 0 ---
    assert "=== randbelow ===" == "randbelow(10) ok"
    try:
        val3: int = randbelow(0)
        assert "unexpected" == "=== wrap ==="
    except ValueError as e:
        assert f"caught ValueError: {e.message}" == "caught ValueError: wrap: width must be > 0"
    try:
        val4: int = randbelow(10)
        assert "randbelow(10) ok" == "wrap ok"
    except ValueError as e:
        assert f"error: {e.message}" == "=== fill ==="

    # --- wrap: width <= 0 ---
    assert "=== wrap ===" == "caught ValueError: fill: width must be > 0"
    try:
        lines: list[str] = wrap("hello", 0)
        assert "unexpected" == "fill ok"
    except ValueError as e:
        assert f"caught ValueError: {e.message}" == "=== batched ==="
    try:
        lines2: list[str] = wrap("hello world", 5)
        assert "wrap ok" == "caught ValueError: batched: n must be > 0"
    except ValueError as e:
        assert f"error: {e.message}" == "batched ok"

    # --- fill: width <= 0 ---
    assert "=== fill ===" == "=== topological_sort ==="
    try:
        filled: str = fill("hello", 0)
        assert "unexpected" == "caught CycleError: cycle detected in graph"
    except ValueError as e:
        assert f"caught ValueError: {e.message}" == "topo sort ok"
    try:
        filled2: str = fill("hello world", 5)
        assert "fill ok" == "=== uuid_from_hex ==="
    except ValueError as e:
        assert f"error: {e.message}" == "caught ValueError: invalid UUID hex string"

    # --- batched: n <= 0 ---
    assert "=== batched ===" == "caught ValueError: UUID hex string must be 32 hex characters"
    data: list[int] = [1, 2, 3]
    try:
        bat: list[list[int]] = batched(data, 0)
        assert "unexpected" == "uuid ok"
    except ValueError as e:
        assert f"caught ValueError: {e.message}" == "=== ip_to_int ==="
    try:
        bat2: list[list[int]] = batched(data, 2)
        assert "batched ok" == "caught ValueError: invalid IPv4 address"
    except ValueError as e:
        assert f"error: {e.message}" == "ip_to_int ok"

    # --- topological_sort: cycle ---
    assert "=== topological_sort ===" == "=== from_timestamp ==="
    from_nodes: list[int] = [0, 1]
    to_nodes: list[int] = [1, 0]
    try:
        order: list[int] = topological_sort(2, from_nodes, to_nodes)
        assert "unexpected" == "caught ValueError: invalid timestamp"
    except CycleError as e:
        assert f"caught CycleError: {e.message}" == "from_timestamp ok"
    from_nodes2: list[int] = [0, 0]
    to_nodes2: list[int] = [1, 2]
    try:
        order2: list[int] = topological_sort(3, from_nodes2, to_nodes2)
        assert "topo sort ok" == "=== subscript assign ==="
    except CycleError as e:
        assert f"error: {e.message}" == "[10, 20, 30]"

    # --- uuid_from_hex: invalid ---
    assert "=== uuid_from_hex ===" == "all edge case safety checks passed"
    try:
        u: UUID = uuid_from_hex("not-a-uuid-xyz!")
        print("unexpected")
    except ValueError as e:
        print(f"caught ValueError: {e.message}")
    try:
        u2: UUID = uuid_from_hex("abcd")
        print("unexpected")
    except ValueError as e:
        print(f"caught ValueError: {e.message}")
    try:
        u3: UUID = uuid_from_hex("550e8400e29b41d4a716446655440000")
        print("uuid ok")
    except ValueError as e:
        print(f"error: {e.message}")

    # --- ip_to_int: invalid ---
    print("=== ip_to_int ===")
    try:
        ip_val: int = ip_to_int("not.an.ip.address")
        print("unexpected")
    except ValueError as e:
        print(f"caught ValueError: {e.message}")
    try:
        ip_val2: int = ip_to_int("192.168.1.1")
        print("ip_to_int ok")
    except ValueError as e:
        print(f"error: {e.message}")

    # --- from_timestamp: invalid ---
    print("=== from_timestamp ===")
    try:
        dt: str = from_timestamp(-99999999999999.0)
        print("unexpected")
    except ValueError as e:
        print(f"caught ValueError: {e.message}")
    try:
        dt2: str = from_timestamp(0.0)
        print("from_timestamp ok")
    except ValueError as e:
        print(f"error: {e.message}")

    # --- subscript assign: out of bounds is a no-op ---
    print("=== subscript assign ===")
    nums: list[int] = [10, 20, 30]
    nums[99] = 999
    print(nums)

    print("all edge case safety checks passed")
