
def main():
    xs: list[int] = [2]
    xs.append(3)
    assert "len after append = " + str(len(xs)) == "len after append = 2"

    ys: list[int] = [4, 5]
    xs.extend(ys)
    assert "len after extend = " + str(len(xs)) == "len after extend = 4"
    assert "contains 5 = " + str(xs.contains(5)) == "contains 5 = true"

    xs.insert(1, 9)
    assert "count 9 = " + str(xs.count(9)) == "count 9 = 1"
    assert "len after insert = " + str(len(xs)) == "len after insert = 5"
