
def main():
    xs: list[int] = [2]
    xs.append(3)
    assert str("len after append = " + str(len(xs))) == 'len after append = 2'

    ys: list[int] = [4, 5]
    xs.extend(ys)
    assert str("len after extend = " + str(len(xs))) == 'len after extend = 4'
    assert str("contains 5 = " + str(xs.contains(5))) == 'contains 5 = true'

    xs.insert(1, 9)
    assert str("count 9 = " + str(xs.count(9))) == 'count 9 = 1'
    assert str("len after insert = " + str(len(xs))) == 'len after insert = 5'
