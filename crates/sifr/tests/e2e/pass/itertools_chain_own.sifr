# Test itertools chain -- borrow semantics
from sifr.itertools import chain

def main():
    # chain (borrow both, returns new list)
    a: list[int] = [1, 2, 3]
    b: list[int] = [4, 5, 6]
    result: list[int] = chain(a, b)
    assert str(result) == '[1, 2, 3, 4, 5, 6]'
    # a and b are still usable after chain (borrow semantics)
    assert str(len(a)) == '3'
    assert str(len(b)) == '3'

