# Test sifr.textwrap module
from sifr.textwrap import wrap, fill, indent


def main():
    expected: list[str] = [">> world", ">> hello", "foo bar", "hello world", "3"]
    expected_index: int = 0
    # wrap splits text into lines of given width
    try:
        lines: list[str] = wrap("the quick brown fox jumps", 10)
        assert str(len(lines)) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # fill joins wrapped lines
    try:
        filled: str = fill("hello world foo bar", 12)
        filled_lines: list[str] = filled.split("\n")
        assert filled_lines[0] == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
        assert filled_lines[1] == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except ValueError as e:
        assert str(f"error: {e.message}") == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    # indent adds prefix to non-empty lines
    text: str = "hello\nworld"
    result: str = indent(text, ">> ")
    result_lines: list[str] = result.split("\n")
    assert result_lines[0] == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
    assert result_lines[1] == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
