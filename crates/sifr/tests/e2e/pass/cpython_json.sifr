# CPython test_json — structured-value assertions for sifr.json
from sifr.json import JsonValue, loads, dumps


def main() -> None:
    try:
        parsed_obj: JsonValue = loads("{\"a\":1}")
        parsed_arr: JsonValue = loads("[1,2,3]")
        parsed_int: JsonValue = loads("42")
        parsed_true: JsonValue = loads("true")
        parsed_false: JsonValue = loads("false")
        parsed_null: JsonValue = loads("null")
        parsed_empty_arr: JsonValue = loads("[]")
        parsed_empty_obj: JsonValue = loads("{}")
        parsed_float: JsonValue = loads("3.14")
        parsed_hello: JsonValue = loads("\"hello\"")
        parsed_empty_str: JsonValue = loads("\"\"")
        assert str(parsed_obj) == "{\"a\":1}"
        assert str(parsed_arr) == "[1,2,3]"
        assert str(parsed_int) == "42"
        assert str(parsed_true) == "true"
        assert str(parsed_false) == "false"
        assert str(parsed_null) == "null"
        assert str(parsed_empty_arr) == "[]"
        assert str(parsed_empty_obj) == "{}"
        assert str(parsed_float) == "3.14"
        assert str(parsed_hello) == "\"hello\""
        assert str(parsed_empty_str) == "\"\""
    except JSONDecodeError as e:
        assert False

    assert dumps("hello") == "\"hello\""
    assert dumps("") == "\"\""
    assert dumps(42) == "42"
    assert dumps(0) == "0"
    assert dumps(True) == "true"
    assert dumps(False) == "false"
    assert dumps(3.14) == "3.14"

    try:
        roundtrip_int: JsonValue = loads(dumps(42))
        roundtrip_true: JsonValue = loads(dumps(True))
        roundtrip_false: JsonValue = loads(dumps(False))
        roundtrip_float: JsonValue = loads(dumps(3.14))
        assert str(roundtrip_int) == "42"
        assert str(roundtrip_true) == "true"
        assert str(roundtrip_false) == "false"
        assert str(roundtrip_float) == "3.14"
    except JSONDecodeError as e:
        assert False
