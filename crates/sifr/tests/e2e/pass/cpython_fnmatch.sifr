# CPython test_fnmatch.py — ported assertions for sifr.fnmatch
# Note: filter is used instead of the CPython alias 'filter' because
# 'filter' conflicts with the built-in filter(func, iterable) function
from sifr.test import assert_bool_vector_eq
from sifr.fnmatch import fnmatch, filter

def collect_fnmatch_core_actual() -> list[bool]:
    actual: list[bool] = []
    match_exact: bool = fnmatch("abc", "abc")
    match_qmark: bool = fnmatch("abc", "???")
    match_star: bool = fnmatch("abc", "*")
    match_prefix: bool = fnmatch("abc", "a*")
    match_suffix: bool = fnmatch("abc", "*c")
    match_mixed: bool = fnmatch("abc", "a*c")
    no_short_match: bool = not fnmatch("abc", "ab")
    no_double_qmark: bool = not fnmatch("a", "??")
    no_other_char: bool = not fnmatch("a", "b")
    match_empty: bool = fnmatch("", "")
    match_empty_star: bool = fnmatch("", "*")
    no_empty_qmark: bool = not fnmatch("", "?")

    actual.append(match_exact)
    actual.append(match_qmark)
    actual.append(match_star)
    actual.append(match_prefix)
    actual.append(match_suffix)
    actual.append(match_mixed)
    actual.append(no_short_match)
    actual.append(no_double_qmark)
    actual.append(no_other_char)
    actual.append(match_empty)
    actual.append(match_empty_star)
    actual.append(no_empty_qmark)
    return actual

def collect_case_sensitive_actual() -> list[bool]:
    actual: list[bool] = []
    case_exact: bool = fnmatch("abc", "abc")
    no_case_fold_ab: bool = not fnmatch("AbC", "abc")
    no_case_fold_ba: bool = not fnmatch("abc", "AbC")
    case_exact_mixed: bool = fnmatch("AbC", "AbC")
    case_star_lower: bool = fnmatch("abc", "a*")
    no_case_star_upper: bool = not fnmatch("ABC", "a*")

    actual.append(case_exact)
    actual.append(no_case_fold_ab)
    actual.append(no_case_fold_ba)
    actual.append(case_exact_mixed)
    actual.append(case_star_lower)
    actual.append(no_case_star_upper)
    return actual

def collect_filter_primary_actual() -> list[bool]:
    actual: list[bool] = []
    names: list[str] = ["Python", "Ruby", "Perl", "Tcl"]
    r1: list[str] = filter(names, "P*")
    actual.append(len(r1) == 2)
    actual.append(str(r1) == "[\"Python\", \"Perl\"]")

    r2: list[str] = filter(names, "R*")
    actual.append(len(r2) == 1)

    r3: list[str] = filter(names, "X*")
    actual.append(len(r3) == 0)

    files: list[str] = ["test.py", "test.rb", "test.js", "main.py"]
    r4: list[str] = filter(files, "*.py")
    actual.append(len(r4) == 2)
    actual.append(str(r4) == "[\"test.py\", \"main.py\"]")
    return actual

def collect_more_patterns_actual() -> list[bool]:
    actual: list[bool] = []
    match_foo_prefix: bool = fnmatch("foo.bar", "foo.*")
    match_foo_suffix: bool = fnmatch("foo.bar", "*.bar")
    no_foo_baz: bool = not fnmatch("foo.bar", "*.baz")
    match_test_qmark: bool = fnmatch("test123", "test???")
    match_test_star: bool = fnmatch("test123", "test*")
    no_test_short: bool = not fnmatch("test123", "test?")
    match_dotted: bool = fnmatch("a.b.c", "a.*.*")
    match_prefix_qmark: bool = fnmatch("hello", "?ello")
    match_suffix_qmark: bool = fnmatch("hello", "hell?")
    no_missing_char: bool = not fnmatch("hello", "hell")

    actual.append(match_foo_prefix)
    actual.append(match_foo_suffix)
    actual.append(no_foo_baz)
    actual.append(match_test_qmark)
    actual.append(match_test_star)
    actual.append(no_test_short)
    actual.append(match_dotted)
    actual.append(match_prefix_qmark)
    actual.append(match_suffix_qmark)
    actual.append(no_missing_char)
    return actual

def collect_filter_secondary_actual() -> list[bool]:
    actual: list[bool] = []
    all_files: list[str] = ["a.txt", "b.txt", "c.py", "d.py", "e.rs"]
    txt: list[str] = filter(all_files, "*.txt")
    actual.append(len(txt) == 2)
    py: list[str] = filter(all_files, "*.py")
    actual.append(len(py) == 2)
    rs: list[str] = filter(all_files, "*.rs")
    actual.append(len(rs) == 1)
    all_match: list[str] = filter(all_files, "*")
    actual.append(len(all_match) == 5)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [
        True, True, True, True, True, True, True, True, True, True, True, True,
        True, True, True, True, True, True,
        True, True, True, True, True, True,
        True, True, True, True, True, True, True, True, True, True,
        True, True, True, True
    ]
    actual: list[bool] = []
    append_all(actual, collect_fnmatch_core_actual())
    append_all(actual, collect_case_sensitive_actual())
    append_all(actual, collect_filter_primary_actual())
    append_all(actual, collect_more_patterns_actual())
    append_all(actual, collect_filter_secondary_actual())
    assert_bool_vector_eq(actual, expected)

    assert str("cpython_fnmatch: all 40 assertions passed") == 'cpython_fnmatch: all 40 assertions passed'
