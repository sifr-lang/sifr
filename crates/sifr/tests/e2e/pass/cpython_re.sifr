# CPython test_re.py assertions adapted to the canonical sifr.re surface.
from sifr.test import assert_bool_vector_eq
from sifr.re import search, sub, findall, split, compile, Pattern

def pattern_matches(pattern_text: str, text: str) -> Result[bool, RegexError]:
    try:
        pattern: Pattern = compile(pattern_text)
        return pattern.is_match(text)
    except RegexError as error:
        raise RegexError(error.message)

def collect_match_actual() -> list[bool]:
    actual: list[bool] = []
    try:
        literal_match: bool = pattern_matches("a", "a")
        prefix_match: bool = pattern_matches("a", "abc")
        different_literal_match: bool = pattern_matches("b", "a")
        sequence_match: bool = pattern_matches("ab", "abc")
        repeated_match: bool = pattern_matches("a*", "aaa")
        empty_repeat_match: bool = pattern_matches("a*", "")
        repeated_prefix_match: bool = pattern_matches("x*", "xxxa")
        wildcard_match: bool = pattern_matches(".", "a")
        exact_anchor_match: bool = pattern_matches("^abc$", "abc")
        extended_anchor_match: bool = pattern_matches("^abc$", "abcd")
        digit_match: bool = pattern_matches("[0-9]+", "123")
        alphabetic_digit_match: bool = pattern_matches("[0-9]+", "abc")
        letter_match: bool = pattern_matches("[a-z]+", "hello")
        first_alternative_match: bool = pattern_matches("(a|b)", "a")
        second_alternative_match: bool = pattern_matches("(a|b)", "b")
        missing_alternative_match: bool = pattern_matches("(a|b)", "c")
        actual.append(literal_match)
        actual.append(prefix_match)
        actual.append(not different_literal_match)
        actual.append(sequence_match)
        actual.append(repeated_match)
        actual.append(empty_repeat_match)
        actual.append(repeated_prefix_match)
        actual.append(wildcard_match)
        actual.append(exact_anchor_match)
        actual.append(not extended_anchor_match)
        actual.append(digit_match)
        actual.append(not alphabetic_digit_match)
        actual.append(letter_match)
        actual.append(first_alternative_match)
        actual.append(second_alternative_match)
        actual.append(not missing_alternative_match)
    except RegexError as e:
        count: int = 0
        while count < 16:
            actual.append(False)
            count = count + 1
    return actual

def collect_search_actual() -> list[bool]:
    actual: list[bool] = []
    try:
        found: str | None = search("x+", "axx")
        actual.append(str(found) == "xx")

        not_found: str | None = search("x", "aaa")
        actual.append(not_found is None)

        word: str | None = search("\\w+", "hello world")
        actual.append(str(word) == "hello")

        digit: str | None = search("\\d+", "abc123def")
        actual.append(str(digit) == "123")
    except RegexError as e:
        actual.append(False)
        actual.append(False)
        actual.append(False)
        actual.append(False)
    return actual

def collect_findall_actual() -> list[bool]:
    actual: list[bool] = []
    try:
        r1: list[str] = findall(":+", "abc")
        actual.append(len(r1) == 0)

        r2: list[str] = findall(":+", "a:b::c:::d")
        actual.append(len(r2) == 3)
        actual.append(str(r2) == "[\":\", \"::\", \":::\"]")

        r3: list[str] = findall("a", "abacada")
        actual.append(len(r3) == 4)

        r4: list[str] = findall("\\d+", "08.2 -2 23x99y")
        actual.append(len(r4) == 5)
        actual.append(str(r4) == "[\"08\", \"2\", \"2\", \"23\", \"99\"]")

        r5: list[str] = findall("[A-Z]", "Hello World")
        actual.append(len(r5) == 2)

        r6: list[str] = findall("\\w+", "one two three")
        actual.append(len(r6) == 3)

        r7: list[str] = findall("[aeiou]", "beautiful")
        actual.append(len(r7) == 5)
    except RegexError as e:
        count: int = 0
        while count < 9:
            actual.append(False)
            count = count + 1
    return actual

def collect_sub_actual() -> list[bool]:
    actual: list[bool] = []
    try:
        s1: str = sub("y", "a", "xyz")
        actual.append(s1 == "xaz")
        s2: str = sub("a", "b", "aaaaa")
        actual.append(s2 == "bbbbb")
        s3: str = sub("\\d", "X", "a1b2c3")
        actual.append(s3 == "aXbXcX")
        s4: str = sub("\\s+", " ", "hello   world")
        actual.append(s4 == "hello world")
        s5: str = sub("x", "", "xaxbxcx")
        actual.append(s5 == "abc")

        masked_vowels: str = sub("[aeiou]", "*", "hello")
        actual.append(masked_vowels == "h*ll*")
        prefixed_text: str = sub("^", ">>", "hello")
        actual.append(prefixed_text == ">>hello")
        masked_digits: str = sub("[0-9]", "#", "a1b2c3d4")
        actual.append(masked_digits == "a#b#c#d#")
    except RegexError as e:
        count: int = 0
        while count < 8:
            actual.append(False)
            count = count + 1
    return actual

def collect_split_actual() -> list[bool]:
    actual: list[bool] = []
    try:
        sp1: list[str] = split(":", ":a:b::c")
        actual.append(len(sp1) == 5)
        actual.append(str(sp1) == "[\"\", \"a\", \"b\", \"\", \"c\"]")

        sp2: list[str] = split(":+", ":a:b::c")
        actual.append(len(sp2) == 4)
        actual.append(str(sp2) == "[\"\", \"a\", \"b\", \"c\"]")

        sp3: list[str] = split("\\s+", "hello world  foo")
        actual.append(len(sp3) == 3)
        actual.append(str(sp3) == "[\"hello\", \"world\", \"foo\"]")

        sp4: list[str] = split(",", "a,b,c,d")
        actual.append(len(sp4) == 4)

        sp5: list[str] = split("[,;]", "a,b;c,d")
        actual.append(len(sp5) == 4)
    except RegexError as e:
        count: int = 0
        while count < 8:
            actual.append(False)
            count = count + 1
    return actual

def collect_edge_actual() -> list[bool]:
    actual: list[bool] = []
    try:
        empty_find: list[str] = findall("x", "")
        actual.append(len(empty_find) == 0)

        no_match_sub: str = sub("x", "y", "abc")
        actual.append(no_match_sub == "abc")
    except RegexError as e:
        actual.append(False)
        actual.append(False)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [
        True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True,
        True, True, True, True,
        True, True, True, True, True, True, True, True, True,
        True, True, True, True, True, True, True, True,
        True, True, True, True, True, True, True, True,
        True, True
    ]
    actual: list[bool] = []
    append_all(actual, collect_match_actual())
    append_all(actual, collect_search_actual())
    append_all(actual, collect_findall_actual())
    append_all(actual, collect_sub_actual())
    append_all(actual, collect_split_actual())
    append_all(actual, collect_edge_actual())
    assert_bool_vector_eq(actual, expected)
    assert str("cpython_re: all 47 assertions passed") == "cpython_re: all 47 assertions passed"
