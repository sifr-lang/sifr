def describe_method(method: str) -> str:
    match method:
        case "GET":
            return "read"
        case "POST":
            return "create"
        case "PUT":
            return "update"
        case _:
            return "other"

def describe_code(code: int) -> str:
    match code:
        case 200:
            return "ok"
        case 404:
            return "not found"
        case 500:
            return "error"
        case _:
            return "unknown"

def main():
    assert describe_method("GET") == read
    assert describe_method("POST") == create
    assert describe_method("DELETE") == other
    assert describe_code(200) == ok
    assert describe_code(404) == not found
    assert describe_code(999) == unknown

