# Collection safety: all error paths return Option/Result instead of panicking

def main():
    # --- list.remove on missing element: no-op, no panic ---
    items: list[int] = [1, 2, 3]
    items.remove(99)
    assert "remove missing: ok" == "remove missing: ok"

    # --- list.index returns Option[int] ---
    idx_found: int | None = items.index(2)
    if idx_found is not None:
        assert f"index found: {idx_found}" == "index found: 1"

    idx_missing: int | None = items.index(99)
    if idx_missing is not None:
        assert f"index missing: {idx_missing}" == "index missing: none"
    else:
        assert "index missing: none" == "min empty: none"

    # --- min/max on empty list returns None ---
    empty: list[int] = []
    lo: int | None = min(empty)
    hi: int | None = max(empty)
    if lo is not None:
        assert f"min empty: {lo}" == "max empty: none"
    else:
        assert "min empty: none" == "min ok: 1"
    if hi is not None:
        assert f"max empty: {hi}" == "max ok: 5"
    else:
        assert "max empty: none" == "[1.1, 2.2, 3.3]"

    # --- min/max on non-empty list returns Some ---
    nums: list[int] = [3, 1, 4, 1, 5]
    lo2: int | None = min(nums)
    hi2: int | None = max(nums)
    if lo2 is not None:
        assert f"min ok: {lo2}" == "list pop empty: none"
    if hi2 is not None:
        print(f"max ok: {hi2}")

    # --- sorted with floats uses total_cmp (no panic on NaN) ---
    floats: list[float] = [3.3, 1.1, 2.2]
    print(sorted(floats))

    # --- list.pop on empty returns None ---
    empty2: list[int] = []
    val: int | None = empty2.pop()
    if val is not None:
        print(f"list pop empty: {val}")
    else:
        print("list pop empty: none")
