
from sifr.io import write_text

def main():
    path: str = "/tmp/sifr_open_read_test.txt"
    try:
        _: None = write_text(path, "hello world")
        f = open(path, "r", encoding="utf-8")
        content: str = f.read()
        f.close()
        assert str("content = " + content) == 'content = hello world'
        assert str("read ok") == 'read ok'
    except IOError as e:
        _ = str("error: " + e.message)
