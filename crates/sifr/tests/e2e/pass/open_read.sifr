# expect-stdout: content = hello world
# expect-stdout: read ok

from sifr.io import write_text

def main():
    path: str = "/tmp/sifr_open_read_test.txt"
    try:
        _: None = write_text(path, "hello world")
        f = open(path, "r")
        content: str = f.read()
        f.close()
        print("content = " + content)
        print("read ok")
    except IOError as e:
        print("error: " + e.message)
