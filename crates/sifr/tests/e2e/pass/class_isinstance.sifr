
class Point:
    x: float
    y: float

    def __init__(self, x: float, y: float):
        self.x = x
        self.y = y

def check(own val: int | Point):
    if isinstance(val, Point):
        assert str("is a point") == 'is a point'
    else:
        assert str("not a point") == 'not a point'

def main():
    p: Point = Point(1.0, 2.0)
    check(p)
    check(42)
