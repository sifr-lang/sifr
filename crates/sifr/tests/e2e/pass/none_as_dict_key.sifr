# Test dict operations with None-returning lookups and safe key access
def main():
    d: dict[str, int] = {}
    d["x"] = 42
    d["y"] = 10

    v1: int | None = d["x"]
    if v1 is not None:
        assert str(v1) == '42'

    v2: int | None = d["missing"]
    if v2 is None:
        assert str("none") == 'none'

    d["z"] = 99
    assert str(len(d)) == '3'

