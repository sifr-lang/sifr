
from sifr.re import compile, fullmatch, Pattern


def main():
    expected: list[str] = ["pattern = \\d+", "fullmatch = true", "findall len = 2", "search result len > 0 = true", "match = true"]
    expected_index: int = 0
    p: Pattern = compile("\\d+")
    try:
        m: bool = p.is_match("123abc")
        assert str("match = " + str(m)) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except RegexError as e:
        assert str("match error: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        s: str | None = p.search("hello 42 world")
        if s is not None:
            assert str("search result len > 0 = " + str(len(s) > 0)) == expected[len(expected) - expected_index - 1]
            expected_index = expected_index + 1
        else:
            assert str("search result len > 0 = false") == expected[len(expected) - expected_index - 1]
            expected_index = expected_index + 1
    except RegexError as e:
        assert str("search error: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        all_nums: list[str] = p.findall("hello 42 world 99")
        assert str("findall len = " + str(len(all_nums))) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except RegexError as e:
        assert str("findall error: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    try:
        fm: bool = fullmatch("\\d+", "12345")
        assert str("fullmatch = " + str(fm)) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1
    except RegexError as e:
        assert str("fullmatch error: " + e.message) == expected[len(expected) - expected_index - 1]
        expected_index = expected_index + 1

    assert str("pattern = " + p.pattern()) == expected[len(expected) - expected_index - 1]
    expected_index = expected_index + 1
