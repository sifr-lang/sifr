# Adapted CPython strictness subset for sifr.base64 options
from sifr.base64 import b64encode_opts, b64decode_opts
from sifr.test import assert_vector_eq, assert_bool_vector_eq

def line_at_or_missing(lines: list[str], index: int) -> str:
    current: int = 0
    for line in lines:
        if current == index:
            return line
        current = current + 1
    return "MISSING"

def encode_opts_or_err(payload: str, altchars: str, wrapcol: int) -> str:
    try:
        encoded: str = b64encode_opts(payload, altchars, wrapcol)
        safe: str = encoded + ""
        return safe
    except ParseError as e:
        _ = str(e.message)
        return "ERR"

def decode_opts_or_err(payload: str, altchars: str, validate: bool, ignorechars: str) -> str:
    try:
        decoded: str = b64decode_opts(payload, altchars, validate, ignorechars)
        safe: str = decoded + ""
        return safe
    except ParseError as e:
        _ = str(e.message)
        return "ERR"

def collect_positive_actual() -> list[str]:
    actual: list[str] = []

    wrapped: str = encode_opts_or_err("www.python.org", "", 8)
    wrapped_lines: list[str] = wrapped.split("\n")
    actual.append(line_at_or_missing(wrapped_lines, 0))
    actual.append(line_at_or_missing(wrapped_lines, 1))
    actual.append(line_at_or_missing(wrapped_lines, 2))

    alt_encoded_1: str = encode_opts_or_err("~~~", "*$", 0)
    alt_encoded_1_for_decode: str = alt_encoded_1 + ""
    actual.append(alt_encoded_1)
    actual.append(decode_opts_or_err(alt_encoded_1_for_decode, "*$", False, ""))

    alt_encoded_2: str = encode_opts_or_err("???", "*$", 0)
    alt_encoded_2_for_decode: str = alt_encoded_2 + ""
    actual.append(alt_encoded_2)
    actual.append(decode_opts_or_err(alt_encoded_2_for_decode, "*$", False, ""))

    actual.append(decode_opts_or_err("YWJj!", "", False, ""))
    actual.append(decode_opts_or_err("YW\nJj", "", True, "\n"))
    return actual

def collect_negative_actual_ok() -> list[bool]:
    actual_ok: list[bool] = []
    try:
        strict_fail: str = b64decode_opts("YWJj!", "", True, "")
        _ = str(strict_fail)
        actual_ok.append(True)
    except ParseError as e:
        actual_ok.append(False)

    try:
        bad_alt: str = b64encode_opts("x", "+", 0)
        _ = str(bad_alt)
        actual_ok.append(True)
    except ParseError as e:
        actual_ok.append(False)

    try:
        bad_wrap: str = b64encode_opts("x", "", -1)
        _ = str(bad_wrap)
        actual_ok.append(True)
    except ParseError as e:
        actual_ok.append(False)
    return actual_ok

def main():
    positive_expected: list[str] = [
        "d3d3LnB5",
        "dGhvbi5v",
        "cmc=",
        "fn5*",
        "~~~",
        "Pz8$",
        "???",
        "abc",
        "abc",
    ]
    positive_actual: list[str] = collect_positive_actual()
    assert_vector_eq(positive_actual, positive_expected)

    negative_expected_ok: list[bool] = [False, False, False]
    negative_actual_ok: list[bool] = collect_negative_actual_ok()
    assert_bool_vector_eq(negative_actual_ok, negative_expected_ok)
    assert str("cpython_base64_strictness_subset: pass") == "cpython_base64_strictness_subset: pass"
