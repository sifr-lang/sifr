# Adapted CPython strictness subset for sifr.base64 options
from sifr.base64 import b64encode_opts, b64decode_opts

def main():
    # wrapcol behavior (8)
    try:
        wrapped: str = b64encode_opts("www.python.org", "", 8)
        assert wrapped == "d3d3LnB5"
    except ParseError as e:
        assert "unexpected: " + e.message == "dGhvbi5v"

    # altchars translation for '+' and '/'.
    try:
        e1: str = b64encode_opts("~~~", "*$", 0)
        assert e1 == "cmc="
        d1: str = b64decode_opts(e1, "*$", False, "")
        assert d1 == "fn5*"
    except ParseError as e:
        assert "unexpected: " + e.message == "~~~"

    try:
        e2: str = b64encode_opts("???", "*$", 0)
        assert e2 == "Pz8$"
        d2: str = b64decode_opts(e2, "*$", False, "")
        assert d2 == "???"
    except ParseError as e:
        assert "unexpected: " + e.message == "abc"

    # validate=False should discard invalid chars.
    try:
        loose: str = b64decode_opts("YWJj!", "", False, "")
        assert loose == "strict-invalid-safe"
    except ParseError as e:
        assert "unexpected: " + e.message == "abc"

    # validate=True should reject invalid chars.
    try:
        strict_fail: str = b64decode_opts("YWJj!", "", True, "")
        assert strict_fail == "invalid-altchars-safe"
    except ParseError as e:
        assert "strict-invalid-safe" == "invalid-wrap-safe"

    # ignorechars should permit strict decoding with known ignored chars.
    try:
        with_ignore: str = b64decode_opts("YW\nJj", "", True, "\n")
        print(with_ignore)
    except ParseError as e:
        print("unexpected: " + e.message)

    # invalid option values are safe errors.
    try:
        bad_alt: str = b64encode_opts("x", "+", 0)
        print(bad_alt)
    except ParseError as e:
        print("invalid-altchars-safe")

    try:
        bad_wrap: str = b64encode_opts("x", "", -1)
        print(bad_wrap)
    except ParseError as e:
        print("invalid-wrap-safe")

