def lookup_pair(nums: list[int], target: int) -> list[int]:
    seen = {}
    for i, value in enumerate(nums):
        complement = target - value
        if complement in seen:
            return [seen[complement], i]
        seen[value] = i
    return []


def distinct_scoped_maps(flag: bool) -> int:
    # Same spelling in disjoint lexical scopes must keep distinct map types.
    if flag:
        data = {}
        data["key"] = 1
        return len(data)
    data = {}
    data[2] = 3
    return len(data)


def compatible_scoped_maps(flag: bool) -> int:
    if flag:
        data = {}
        data[1] = 2.5
        return len(data)
    data = {}
    data[3] = 4
    return len(data)


def loop_scoped_maps(items: list[int]) -> int:
    total = 0
    for item in items:
        data = {}
        data[item] = item
        total += len(data)
    data = {}
    data["a"] = 1
    return total + len(data)


def main():
    assert lookup_pair([2, 7, 11, 15], 9) == [0, 1]
    assert lookup_pair([3, 2, 4], 6) == [1, 2]
    assert lookup_pair([3, 3], 6) == [0, 1]
    assert distinct_scoped_maps(True) == 1
    assert distinct_scoped_maps(False) == 1
    assert compatible_scoped_maps(True) == 1
    assert compatible_scoped_maps(False) == 1
    assert loop_scoped_maps([1, 2]) == 3
