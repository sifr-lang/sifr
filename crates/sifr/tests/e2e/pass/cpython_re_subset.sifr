# Adapted CPython re subset for sifr.re (canonical vector format)
from sifr.re import search, sub, findall, split, search_flags, fullmatch, compile, IGNORECASE, Pattern
from sifr.test import assert_bool_vector_eq

def has_match(pattern: str, text: str) -> Result[bool, RegexError]:
    try:
        found: str | None = search(pattern, text)
        return found is not None
    except RegexError as error:
        raise RegexError(error.message)

def collect_match_actual() -> list[bool]:
    actual: list[bool] = []
    prefix_match: bool = False
    exact_match_fail: bool = False
    try:
        m_prefix: bool = has_match("a+", "aaab")
        m_exact: bool = has_match("^abc$", "abcd")
        prefix_match = m_prefix
        exact_match_fail = not m_exact
    except RegexError as e:
        _ = str(e.message)
    actual.append(prefix_match)
    actual.append(exact_match_fail)
    return actual

def collect_find_actual() -> list[bool]:
    actual: list[bool] = []
    found_digits_ok: bool = False
    missing_digits_ok: bool = False
    try:
        found_digits: str | None = search("\\d+", "abc123def")
        found_digits_ok = str(found_digits) == "123"
        missing_digits: str | None = search("\\d+", "abcdef")
        missing_digits_ok = missing_digits is None
    except RegexError as e:
        _ = str(e.message)
    actual.append(found_digits_ok)
    actual.append(missing_digits_ok)
    return actual

def collect_replace_findall_split_actual() -> list[bool]:
    actual: list[bool] = []
    replace_ok: bool = False
    findall_ok: bool = False
    split_ok: bool = False
    try:
        replaced: str = sub("\\d+", "N", "a1b22c333")
        replace_ok = replaced == "aNbNcN"
        all_hits: list[str] = findall("\\d+", "x1y22z333")
        findall_ok = str(all_hits) == "[\"1\", \"22\", \"333\"]"
        split_parts: list[str] = split(":+", "a:b::c")
        split_ok = str(split_parts) == "[\"a\", \"b\", \"c\"]"
    except RegexError as e:
        _ = str(e.message)
    actual.append(replace_ok)
    actual.append(findall_ok)
    actual.append(split_ok)
    return actual

def collect_flags_actual() -> list[bool]:
    actual: list[bool] = []
    case_insensitive_ok: bool = False
    case_sensitive_ok: bool = False
    try:
        case_insensitive: str | None = search_flags("hello", "HELLO world", IGNORECASE)
        case_insensitive_ok = case_insensitive is not None
        case_sensitive: str | None = search_flags("hello", "HELLO world", 0)
        case_sensitive_ok = case_sensitive is None
    except RegexError as e:
        _ = str(e.message)
    actual.append(case_insensitive_ok)
    actual.append(case_sensitive_ok)
    return actual

def collect_fullmatch_actual() -> list[bool]:
    actual: list[bool] = []
    fullmatch_ok: bool = False
    fullmatch_fail: bool = False
    try:
        fm_ok: bool = fullmatch("\\d+", "12345")
        fm_bad: bool = fullmatch("\\d+", "123a")
        fullmatch_ok = fm_ok
        fullmatch_fail = not fm_bad
    except RegexError as e:
        _ = str(e.message)
    actual.append(fullmatch_ok)
    actual.append(fullmatch_fail)
    return actual

def collect_pattern_actual() -> list[bool]:
    actual: list[bool] = []
    pattern_match_ok: bool = False
    try:
        pat: Pattern = compile("h.llo")
        actual.append(pat.pattern() == "h.llo")
        pm: bool = pat.is_match("hello")
        pattern_match_ok = pm
    except RegexError as e:
        actual.append(False)
        _ = str(e.message)
    actual.append(pattern_match_ok)
    return actual

def collect_invalid_pattern_actual() -> list[bool]:
    actual: list[bool] = []
    invalid_pattern_rejected: bool = False
    try:
        _m: bool = has_match("(", "abc")
        _ = _m
    except RegexError as e:
        invalid_pattern_rejected = len(e.message) > 0
    actual.append(invalid_pattern_rejected)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [
        True, True, True, True, True, True, True,
        True, True, True, True, True, True, True
    ]
    actual: list[bool] = []
    append_all(actual, collect_match_actual())
    append_all(actual, collect_find_actual())
    append_all(actual, collect_replace_findall_split_actual())
    append_all(actual, collect_flags_actual())
    append_all(actual, collect_fullmatch_actual())
    append_all(actual, collect_pattern_actual())
    append_all(actual, collect_invalid_pattern_actual())

    assert_bool_vector_eq(actual, expected)
    assert str("cpython_re_subset: pass") == "cpython_re_subset: pass"
