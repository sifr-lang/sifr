# Test new random functions: shuffle, sample, randrange, gauss, choice, choices, getrandbits
from sifr.random import choice, choices, getrandbits, shuffle, sample, randrange, gauss
from sifr.test import assert_eq, assert_true

def main():
    # shuffle mutates in place and preserves length
    items: list[int] = [1, 2, 3, 4, 5]
    assert_eq(len(items), 5)
    shuffle(items)
    assert_eq(len(items), 5)

    # sample
    try:
        s: list[int] = sample(items, 3)
        assert_eq(len(s), 3)
    except ValueError as e:
        assert str("unexpected: " + e.message) == 'stdlib_random_new: all tests passed'

    # randrange
    try:
        r0: int = randrange(10)
        assert_true(r0 >= 0)
        assert_true(r0 < 10)
        r: int = randrange(0, 10, 1)
        assert_true(r >= 0)
        assert_true(r < 10)
    except ValueError as e:
        _ = str("unexpected: " + e.message)

    try:
        picked: int = choice(items)
        assert_true(picked >= 1)
        assert_true(picked <= 5)
        many: list[int] = choices(items, k=4)
        assert_eq(len(many), 4)
        bits: int = getrandbits(12)
        assert_true(bits >= 0)
    except ValueError as e:
        _ = str("unexpected: " + e.message)

    # gauss returns a float
    g: float = gauss(0.0, 1.0)
    # just check it's a number (no assertion on value since it's random)
    _ = g

    _ = str("stdlib_random_new: all tests passed")
