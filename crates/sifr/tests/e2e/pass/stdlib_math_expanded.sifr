# Test expanded sifr.math functions
from sifr.math import asin, acos, atan, sinh, cosh, tanh, log10, log2, degrees, radians, isnan, isinf, trunc, hypot, tau, inf, nan

def main():
    # Trig inverses
    assert str(trunc(degrees(asin(1.0)))) == '90'
    assert str(trunc(degrees(acos(0.0)))) == '90'
    
    # Hyperbolic
    assert str(trunc(sinh(0.0))) == '0'
    
    # Log variants
    assert str(trunc(log10(100.0))) == '2'
    
    # Constants
    assert str(isnan(nan)) == 'true'
    assert str(isinf(inf)) == 'true'
    
    # Utility
    assert str(trunc(3.7)) == '3'
    assert str(trunc(hypot(3.0, 4.0))) == '5'

