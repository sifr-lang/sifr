# Test expanded sifr.math functions
from sifr.math import asin, acos, atan, sinh, cosh, tanh, log10, log2, degrees, radians, isnan, isinf, trunc, hypot, tau, inf, nan

def main():
    # Trig inverses
    assert trunc(degrees(asin(1.0))) == 90
    assert trunc(degrees(acos(0.0))) == 90
    
    # Hyperbolic
    assert trunc(sinh(0.0)) == 0
    
    # Log variants
    assert trunc(log10(100.0)) == 2
    
    # Constants
    assert isnan(nan) == True
    assert isinf(inf) == True
    
    # Utility
    assert trunc(3.7) == 3
    assert trunc(hypot(3.0, 4.0)) == 5

