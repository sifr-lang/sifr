# Test Match class
from sifr.re import Match

def main():
    m: Match = Match("hello", 2, 7)
    assert str(m.group()) == 'hello'
    assert str(m.start()) == '2'
    assert str(m.end()) == '7'
    sp: list[int] = m.span()
    assert str(sp[0]) == '2'
    assert str(sp[1]) == '7'
    assert str(m.to_str()) == 'hello'

