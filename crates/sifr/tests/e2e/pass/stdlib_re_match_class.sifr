# Test Match class
from sifr.re import Match

def main():
    m: Match = Match("hello", 2, 7)
    print(m.group())
    print(m.start())
    print(m.end())
    sp: list[int] = m.span()
    print(sp[0])
    print(sp[1])
    print(m.to_str())

# expect-stdout: hello
# expect-stdout: 2
# expect-stdout: 7
# expect-stdout: 2
# expect-stdout: 7
# expect-stdout: hello
