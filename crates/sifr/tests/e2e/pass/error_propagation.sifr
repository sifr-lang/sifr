
def validate(x: int) -> Result[str, ValueError]:
    if x > 0:
        return "positive"
    raise ValueError("value must be positive")

def main():
    try:
        r1: str = validate(5)
        assert str(f"ok: {r1}") == 'ok: positive'
    except ValueError as e:
        assert str(f"caught: {e.message}") == 'caught: value must be positive'

    try:
        r2: str = validate(-1)
        _ = str(f"ok: {r2}")
    except ValueError as e:
        _ = str(f"caught: {e.message}")
