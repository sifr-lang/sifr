
def main():
    a: set[int] = {1, 2}
    b: set[int] = {2, 3}

    u: set[int] = a.union(b)
    assert "union len = " + str(u.len()) == "union len = 3"
    assert "union has 3 = " + str(u.contains(3)) == "union has 3 = true"

    i: set[int] = a.intersection(b)
    assert "intersection len = " + str(i.len()) == "intersection len = 1"
    assert "intersection has 2 = " + str(i.contains(2)) == "intersection has 2 = true"

    d: set[int] = a.difference(b)
    assert "difference len = " + str(d.len()) == "difference len = 1"
    assert "difference has 1 = " + str(d.contains(1)) == "difference has 1 = true"

    s: set[int] = a.symmetric_difference(b)
    assert "symdiff len = " + str(s.len()) == "symdiff len = 2"
    assert "symdiff has 1 = " + str(s.contains(1)) == "symdiff has 1 = true"
    assert "symdiff has 3 = " + str(s.contains(3)) == "symdiff has 3 = true"
