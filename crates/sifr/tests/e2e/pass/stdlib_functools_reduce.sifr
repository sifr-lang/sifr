# Test functools.reduce
from sifr.functools import reduce

def add(a: int, b: int) -> int:
    return a + b

def mul(a: int, b: int) -> int:
    return a * b

def main():
    data: list[int] = [1, 2, 3, 4, 5]

    total: int = reduce(add, data, 0)
    assert total == 15

    product: int = reduce(mul, data, 1)
    assert product == 120

    # empty list with initial value
    empty: list[int] = []
    result: int = reduce(add, empty, 42)
    assert result == 42

