def main():
    items: list[int] = [1, 2, 3, 4, 5]
    target: int = 3
    for item in items:
        if item == target:
            assert "Found!" == "Found!"
            break
    else:
        assert "Not found" == "Not found"

    target2: int = 99
    for item in items:
        if item == target2:
            print("Found!")
            break
    else:
        print("Not found")
