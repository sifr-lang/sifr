def main():
    items: list[int] = [1, 2, 3, 4, 5]
    target: int = 3
    for item in items:
        if item == target:
            assert str("Found!") == 'Found!'
            break
    else:
        assert str("Not found") == 'Not found'

    target2: int = 99
    for item in items:
        if item == target2:
            _ = str("Found!")
            break
    else:
        _ = str("Not found")
