# Tests that bool() works on collections (list, dict)

def main():
    nums: list[int] = [1, 2, 3]
    empty: list[int] = []
    assert str(bool(nums)) == 'true'
    assert str(bool(empty)) == 'false'
    d: dict[str, int] = {"a": 1}
    empty_d: dict[str, int] = {}
    assert str(bool(d)) == 'true'
    assert str(bool(empty_d)) == 'false'
