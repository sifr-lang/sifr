# Tests that bool() works on collections (list, dict)

def main():
    nums: list[int] = [1, 2, 3]
    empty: list[int] = []
    assert bool(nums) == True
    assert bool(empty) == False
    d: dict[str, int] = {"a": 1}
    empty_d: dict[str, int] = {}
    assert bool(d) == True
    assert bool(empty_d) == False
