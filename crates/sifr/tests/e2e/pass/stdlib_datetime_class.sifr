
from sifr.datetime import datetime, date

def main():
    dt: datetime = datetime(2024, 1, 15, 10, 30, 0)
    assert "isoformat = " + dt.isoformat() == "isoformat = 2024-01-15T10:30:00"
    assert "year = " + str(dt.year) == "year = 2024"
    assert "month = " + str(dt.month) == "month = 1"
    assert "day = " + str(dt.day) == "day = 15"
    ts: int = dt.timestamp()
    assert "timestamp > 0 = " + str(ts > 0) == "timestamp > 0 = true"

    d: date = date(2024, 1, 15)
    assert "date isoformat = " + d.isoformat() == "date isoformat = 2024-01-15"
