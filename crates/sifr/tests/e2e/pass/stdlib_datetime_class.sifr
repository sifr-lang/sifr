# expect-stdout: isoformat = 2024-01-15T10:30:00
# expect-stdout: year = 2024
# expect-stdout: month = 1
# expect-stdout: day = 15
# expect-stdout: timestamp > 0 = true
# expect-stdout: date isoformat = 2024-01-15

from sifr.datetime import datetime, date

def main():
    dt: datetime = datetime(2024, 1, 15, 10, 30, 0)
    print("isoformat = " + dt.isoformat())
    print("year = " + str(dt.year))
    print("month = " + str(dt.month))
    print("day = " + str(dt.day))
    ts: int = dt.timestamp()
    print("timestamp > 0 = " + str(ts > 0))

    d: date = date(2024, 1, 15)
    print("date isoformat = " + d.isoformat())
