class Resource:
    def __enter__(self) -> int:
        return 5

    def __exit__(self) -> None:
        pass


class A:
    x: int


class B:
    y: str


def from_match(value: A | B):
    match value:
        case A(x=x):
            return x
        case B(y=y):
            return y


def from_try(flag: bool):
    try:
        if flag:
            raise ValueError("bad")
        return 3
    except ValueError:
        return 4
    return "unreachable"


def from_with():
    with Resource() as value:
        return value
    return "unreachable"


def main() -> None:
    first: int | str = from_match(A(1))
    second: int | str = from_match(B("two"))
    assert from_try(False) == 3
    assert from_try(True) == 4
    assert from_with() == 5
