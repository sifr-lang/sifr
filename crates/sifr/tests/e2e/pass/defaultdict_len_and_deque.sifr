from sifr.collections import defaultdict, deque

def optional_text_length(value: str | None) -> int:
    return len(value)

def optional_list_length(value: list[int] | None) -> int:
    return len(value)

def main():
    assert optional_text_length(None) == 0
    assert optional_text_length("") == 0
    assert optional_text_length("é🙂") == 2
    assert optional_list_length(None) == 0
    empty_values: list[int] = []
    assert optional_list_length(empty_values) == 0
    assert optional_list_length([3, 4]) == 2
    groups = defaultdict(list)
    groups["hit"].append("hot")
    groups["hit"].append("hut")
    assert "hot" in groups["hit"]
    assert "cold" not in groups["miss"]

    seen = defaultdict(set)
    seen[1].add("a")
    seen[1].add("b")
    assert "a" in seen[1]
    assert len(seen[2]) == 0

    counts = defaultdict(int)
    counts["steps"] += 1
    counts["steps"] += 2
    assert counts["steps"] == 3
    assert counts["other"] == 0

    q: deque[int] = deque([1, 2, 3])
    assert len(q) == 3
    first: int | None = q.popleft()
    assert first is not None and first == 1
