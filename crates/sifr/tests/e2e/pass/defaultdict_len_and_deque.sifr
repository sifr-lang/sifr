from sifr.collections import defaultdict, deque

def main():
    groups = defaultdict(list)
    groups["hit"].append("hot")
    groups["hit"].append("hut")
    assert "hot" in groups["hit"]
    assert "cold" not in groups["miss"]

    seen = defaultdict(set)
    seen[1].add("a")
    seen[1].add("b")
    assert "a" in seen[1]
    assert len(seen[2]) == 0

    counts = defaultdict(int)
    counts["steps"] += 1
    counts["steps"] += 2
    assert counts["steps"] == 3
    assert counts["other"] == 0

    q: deque[int] = deque([1, 2, 3])
    assert len(q) == 3
    first: int | None = q.popleft()
    assert first is not None and first == 1
