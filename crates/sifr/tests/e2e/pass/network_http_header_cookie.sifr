from sifr.http import (
    HeaderError,
    HeaderMap,
    HeaderName,
    HeaderValue,
    build_cookie_header,
    header_name,
    header_value,
    headers_from_pairs,
    parse_cookie_header,
)


def main() -> Result[None, Error]:
    try:
        name: HeaderName = header_name("content-type")
        assert name.get_value() == "content-type"
        canonical_name: HeaderName = header_name("Content-Type")
        assert canonical_name.get_value() == "content-type"
        value: HeaderValue = header_value("  text/plain\t")
        assert value.get_value() == "text/plain"

        headers: HeaderMap = headers_from_pairs(
            [
                ("accept", " text/plain "),
                ("accept", " application/json "),
                ("x-sifr", "header-cookie"),
            ]
        )
        assert headers.len() == 3
        items = headers.items()
        assert items[0][0].get_value() == "accept"
        assert items[0][1].get_value() == "text/plain"
        assert items[1][0].get_value() == "accept"
        assert items[1][1].get_value() == "application/json"

        parsed_cookies: list[tuple[str, str]] = parse_cookie_header("sid=abc; theme=light")
        assert parsed_cookies[0][0] == "sid"
        assert parsed_cookies[1][0] == "theme"
        token_cookie: list[tuple[str, str]] = parse_cookie_header("token=abc=def")
        assert token_cookie[0][0] == "token"
        assert token_cookie[0][1] == "abc=def"
        cookies: list[tuple[str, str]] = [("sid", "abc"), ("theme", "light")]
        rebuilt: str = build_cookie_header(cookies)
        assert rebuilt == "sid=abc; theme=light"
    except HeaderError as e:
        raise Error(e.message)

    bad_name: bool = False
    try:
        _bad_name: HeaderName = header_name("bad header")
        assert False
    except HeaderError as e:
        bad_name = "invalid header name" in e.message
    assert bad_name

    bad_value: bool = False
    try:
        _bad_value: HeaderValue = header_value("ok\r\n folded")
        assert False
    except HeaderError as e:
        bad_value = "line breaks" in e.message
    assert bad_value

    bad_cookie: bool = False
    try:
        _bad_cookie_result: list[tuple[str, str]] = parse_cookie_header("missing_equals")
        assert False
    except HeaderError as e:
        bad_cookie = "invalid cookie header" in e.message
    assert bad_cookie

    bad_cookie_build_semicolon: bool = False
    try:
        _bad_cookie_header: str = build_cookie_header([("foo", "bar; HttpOnly")])
        assert False
    except HeaderError as e:
        bad_cookie_build_semicolon = "invalid cookie value" in e.message
    assert bad_cookie_build_semicolon

    bad_cookie_build_crlf: bool = False
    try:
        _bad_cookie_crlf: str = build_cookie_header([("foo", "bar\r\nInjected: header")])
        assert False
    except HeaderError as e:
        bad_cookie_build_crlf = "invalid cookie value" in e.message
    assert bad_cookie_build_crlf

    bad_cookie_parse_crlf: bool = False
    try:
        _bad_cookie_parse_crlf: list[tuple[str, str]] = parse_cookie_header("foo=bar\r\nInjected: header")
        assert False
    except HeaderError as e:
        bad_cookie_parse_crlf = "line breaks or NUL" in e.message
    assert bad_cookie_parse_crlf

    bad_cookie_name: bool = False
    try:
        _bad_cookie_name: str = build_cookie_header([("bad name", "value")])
        assert False
    except HeaderError as e:
        bad_cookie_name = "invalid cookie name" in e.message
    assert bad_cookie_name

    return None
