# Test Logger class helper
from sifr.logging import getLogger, DEBUG, INFO, WARNING, ERROR, CRITICAL, Logger
from sifr.io import write_text, read_text

def main():
    path: str = "/tmp/sifr_logging_enhanced_test.log"
    try:
        _: None = write_text(path, "")

        logger: Logger = getLogger("myapp")
        logger.set_file(path)
        logger.set_level(INFO)
        logger.info("hello world")
        logger.warning("watch out")
        logger.error("something failed")
        logger.debug("this should not print")

        assert logger._emit("DEBUG", 10, "noop") is None
        output: str = read_text(path)
        assert output == "[INFO] myapp: hello world\n[WARNING] myapp: watch out\n[ERROR] myapp: something failed\n"
        assert DEBUG == 10 and INFO == 20 and WARNING == 30 and ERROR == 40 and CRITICAL == 50
    except IOError as e:
        assert False
