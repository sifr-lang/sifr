# expect-stdout: lstrip len = 4
# expect-stdout: rstrip len = 4
# expect-stdout: count an = 2
# expect-stdout: join = a-b-c

def main():
    s: str = "  hi  "
    print("lstrip len = " + str(len(s.lstrip())))
    print("rstrip len = " + str(len(s.rstrip())))

    w: str = "banana"
    print("count an = " + str(w.count("an")))

    sep: str = "-"
    parts: list[str] = ["a", "b", "c"]
    print("join = " + sep.join(parts))
