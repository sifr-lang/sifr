
def main():
    s: str = "  hi  "
    assert str("lstrip len = " + str(len(s.lstrip()))) == 'lstrip len = 4'
    assert str("rstrip len = " + str(len(s.rstrip()))) == 'rstrip len = 4'

    w: str = "banana"
    assert str("count an = " + str(w.count("an"))) == 'count an = 2'

    sep: str = "-"
    parts: list[str] = ["a", "b", "c"]
    assert str("join = " + sep.join(parts)) == 'join = a-b-c'
