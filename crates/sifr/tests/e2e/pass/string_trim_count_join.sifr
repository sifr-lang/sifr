
def main():
    s: str = "  hi  "
    assert "lstrip len = " + str(len(s.lstrip())) == "lstrip len = 4"
    assert "rstrip len = " + str(len(s.rstrip())) == "rstrip len = 4"

    w: str = "banana"
    assert "count an = " + str(w.count("an")) == "count an = 2"

    sep: str = "-"
    parts: list[str] = ["a", "b", "c"]
    assert "join = " + sep.join(parts) == "join = a-b-c"
