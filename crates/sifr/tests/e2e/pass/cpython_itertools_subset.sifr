# Adapted CPython itertools subset for sifr.itertools (canonical vector format)
from sifr.itertools import chain, repeat, take, flatten, pairwise, batched, islice, accumulate, compress, dropwhile, takewhile, filterfalse, zip_longest, count, count_from, cycle, product, permutations, combinations, combinations_with_replacement, starmap
from sifr.test import assert_bool_vector_eq

def lt3(x: int) -> bool:
    return x < 3

def add2(a: int, b: int) -> int:
    return a + b

def collect_islice(own data: Iterator[int], start_or_stop: int, stop: int | None = None, step: int = 1) -> list[int]:
    try:
        sliced: Iterator[int] = islice(iter(data), start_or_stop, stop, step)
        return list(sliced)
    except ValueError:
        return []

def collect_core_actual() -> list[bool]:
    actual: list[bool] = []
    actual.append(str(list(chain([1, 2], [3, 4]))) == "[1, 2, 3, 4]")
    actual.append(str(list(repeat(7, 3))) == "[7, 7, 7]")
    actual.append(str(take(2, [10, 20, 30])) == "[10, 20]")
    actual.append(str(flatten([[1], [2, 3], []])) == "[1, 2, 3]")
    actual.append(str(pairwise([1, 2, 3])) == "[[1, 2], [2, 3]]")

    batched_ok: bool = False
    try:
        bat: list[list[int]] = batched([1, 2, 3, 4, 5], 2)
        batched_ok = str(bat) == "[[1, 2], [3, 4], [5]]"
    except ValueError as e:
        _ = str(e.message)
    actual.append(batched_ok)

    actual.append(str(collect_islice(iter([10, 20, 30, 40]), 3)) == "[10, 20, 30]")
    actual.append(str(list(accumulate(iter([1, 2, 3, 4])))) == "[1, 3, 6, 10]")
    actual.append(str(list(accumulate(iter([1, 2, 3]), initial=0))) == "[0, 1, 3, 6]")
    actual.append(str(list(compress(iter([1, 2, 3]), iter([True, False, True])))) == "[1, 3]")
    actual.append(str(list(dropwhile(lt3, iter([1, 2, 3, 1])))) == "[3, 1]")
    actual.append(str(list(takewhile(lt3, iter([1, 2, 3, 1])))) == "[1, 2]")
    actual.append(str(list(filterfalse(lt3, iter([1, 2, 3, 1])))) == "[3]")
    actual.append(str(list(zip_longest(iter([1, 2]), iter([9]), 0))) == "[[1, 9], [2, 0]]")
    actual.append(str(list(count_from(5, 2, 4))) == "[5, 7, 9, 11]")
    ctr: Iterator[int] = count(5, 2)
    c0: int | None = next(ctr)
    c1: int | None = next(ctr)
    c2: int | None = next(ctr)
    c3: int | None = next(ctr)
    actual.append(c0 == 5 and c1 == 7 and c2 == 9 and c3 == 11)
    actual.append(str(list(cycle(iter([1, 2, 3]), 5))) == "[1, 2, 3, 1, 2]")
    actual.append(str(list(product([1, 2], [3, 4]))) == "[[1, 3], [1, 4], [2, 3], [2, 4]]")
    actual.append(str(list(product([1, 2], repeat=-1))) == "[]")
    actual.append(str(list(permutations(iter([1, 2, 3]), 2))) == "[[1, 2], [1, 3], [2, 1], [2, 3], [3, 1], [3, 2]]")
    actual.append(str(list(permutations(iter([1, 2, 3]), 4))) == "[]")
    actual.append(str(list(combinations(iter([1, 2, 3]), 2))) == "[[1, 2], [1, 3], [2, 3]]")
    actual.append(str(list(combinations(iter([1, 2, 3]), 4))) == "[]")
    actual.append(str(list(combinations_with_replacement(iter([1, 2]), 2))) == "[[1, 1], [1, 2], [2, 2]]")
    empty_ints: list[int] = []
    actual.append(str(list(combinations_with_replacement(iter(empty_ints), 2))) == "[]")
    actual.append(str(list(starmap(add2, iter([(2, 3), (4, 5)])))) == "[5, 9]")
    empty_pairs: list[tuple[int, int]] = []
    actual.append(str(list(starmap(add2, iter(empty_pairs)))) == "[]")
    return actual

def collect_negative_actual() -> list[bool]:
    actual: list[bool] = []
    invalid_batch_rejected: bool = False
    try:
        _bad: list[list[int]] = batched([1, 2], 0)
        _ = _bad
    except ValueError as e:
        invalid_batch_rejected = len(e.message) > 0
    actual.append(invalid_batch_rejected)
    invalid_zero_step: bool = False
    try:
        _zero_step: Iterator[int] = islice(iter([10, 20, 30]), 0, 3, 0)
        _ = _zero_step
    except ValueError:
        invalid_zero_step = True
    actual.append(invalid_zero_step)
    invalid_negative_step: bool = False
    try:
        _negative_step: Iterator[int] = islice(iter([10, 20, 30]), 0, 3, -1)
        _ = _negative_step
    except ValueError:
        invalid_negative_step = True
    actual.append(invalid_negative_step)
    return actual

def append_all(mut target: list[bool], values: list[bool]):
    for value in values:
        target.append(value)

def main():
    expected: list[bool] = [
        True, True, True, True, True, True, True, True,
        True, True, True, True, True, True, True, True,
        True, True, True, True, True, True, True, True,
        True, True, True, True, True, True
    ]
    actual: list[bool] = []
    append_all(actual, collect_core_actual())
    append_all(actual, collect_negative_actual())

    assert_bool_vector_eq(actual, expected)
    assert str("cpython_itertools_subset: pass") == "cpython_itertools_subset: pass"
