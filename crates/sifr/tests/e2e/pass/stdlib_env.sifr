# Test the read-only sifr.env stdlib module.
from sifr.env import getenv, getenv_opt, keys, values, items

def main():
    missing: str | None = getenv_opt("SIFR_NONEXISTENT_VAR_XYZ")
    assert str(missing is None) == "true"
    assert getenv("SIFR_NONEXISTENT_VAR_XYZ", "fallback") == "fallback"

    assert str(getenv_opt("") is None) == "true"
    assert str(getenv_opt("A=B") is None) == "true"

    names: list[str] = keys()
    vals: list[str] = values()
    pairs: list[str] = items()
    assert str(len(names) == len(vals)) == "true"
    assert str(len(names) == len(pairs)) == "true"
