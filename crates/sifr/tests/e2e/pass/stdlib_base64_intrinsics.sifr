
from sifr.base64 import b32encode, b32decode

def main():
    encoded: str = b32encode("hello")
    assert str("b32encode len > 0 = " + str(len(encoded) > 0)) == 'b32encode len > 0 = true'

    try:
        decoded: str = b32decode(encoded)
        assert str("b32decode = " + decoded) == 'b32decode = hello'
    except ParseError as e:
        _ = str("b32decode error: " + e.message)
