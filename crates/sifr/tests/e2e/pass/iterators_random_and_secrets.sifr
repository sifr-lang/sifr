# Reference: stdlib_parity_b2_iterators_functional_randomness
from sifr.itertools import chain, combinations, combinations_with_replacement, islice, permutations, product, starmap
from sifr.operator import contains, getitem, truth
from sifr.random import choice, choices, getrandbits, randrange, shuffle
from sifr.secrets import compare_digest, randbelow, randbits, token_hex


def add(a: int, b: int) -> int:
    return a + b


class Doubler:
    def __init__(self):
        pass

    def __call__(self, x: int) -> int:
        return x * 2


def main():
    assert str(list(chain([1], [2], [3]))) == '[1, 2, 3]'
    first: list[int] = [1]
    second: list[int] = [2]
    third: list[int] = [3]
    assert str(list(chain(first, second, third))) == '[1, 2, 3]'
    assert str(len(first)) == '1'
    assert str(len(second)) == '1'
    assert str(len(third)) == '1'
    assert str(list(islice([10, 20, 30, 40, 50], 1, 5, 2))) == '[20, 40]'
    assert str(list(product([1, 2], repeat=2))) == '[[1, 1], [1, 2], [2, 1], [2, 2]]'
    assert str(list(permutations([1, 2, 3], 2))) == '[[1, 2], [1, 3], [2, 1], [2, 3], [3, 1], [3, 2]]'
    assert str(list(combinations([1, 2, 3], 2))) == '[[1, 2], [1, 3], [2, 3]]'
    assert str(list(combinations_with_replacement([1, 2], 2))) == '[[1, 1], [1, 2], [2, 2]]'
    assert str(list(starmap(add, [(2, 3), (4, 5)]))) == '[5, 9]'

    doubler: Doubler = Doubler()
    assert str(doubler(3)) == '6'

    assert str(getitem([10, 20, 30], 1)) == '20'
    assert str(contains([10, 20, 30], 20)) == 'true'
    assert str(truth([10])) == 'true'

    shuffled: list[int] = [1, 2, 3, 4]
    shuffle(shuffled)
    assert str(len(shuffled)) == '4'

    try:
        picked: int = choice([1, 2, 3])
        assert str(picked >= 1 and picked <= 3) == 'true'
        sampled: list[int] = choices([1, 2, 3], k=4)
        assert str(len(sampled)) == '4'
        single_arg: int = randrange(10)
        assert str(single_arg >= 0 and single_arg < 10) == 'true'
        stepped: int = randrange(2, 10, 2)
        assert str(stepped >= 2 and stepped < 10 and stepped % 2 == 0) == 'true'
        bits: int = getrandbits(10)
        assert str(bits >= 0) == 'true'
    except ValueError as e:
        assert str("unexpected random error: " + e.message) == 'iterators_random_and_secrets: random block passed'

    try:
        _bad_choice: int = choice([])
        assert str("choice unexpectedly succeeded") == 'iterators_random_and_secrets: choice empty handled'
    except ValueError as e:
        assert str(e.message) == 'choice: items must not be empty'

    try:
        _bad_choices: list[int] = choices([], k=2)
        assert str("choices unexpectedly succeeded") == 'iterators_random_and_secrets: choices empty handled'
    except ValueError as e:
        assert str(e.message) == 'choices: items must not be empty'

    try:
        _bad_range: int = randrange(5, 3)
        assert str("randrange unexpectedly succeeded") == 'iterators_random_and_secrets: randrange bounds handled'
    except ValueError as e:
        assert str(len(e.message) > 0) == 'true'

    try:
        _bad_step: int = randrange(0, 10, 0)
        assert str("randrange step unexpectedly succeeded") == 'iterators_random_and_secrets: randrange step handled'
    except ValueError as e:
        assert str(len(e.message) > 0) == 'true'

    try:
        _bad_bits: int = getrandbits(-1)
        assert str("getrandbits unexpectedly succeeded") == 'iterators_random_and_secrets: getrandbits handled'
    except ValueError as e:
        assert str(e.message) == 'getrandbits: number of bits must be >= 0'

    assert str(compare_digest("abc", "abc")) == 'true'
    assert str(compare_digest("abc", "abd")) == 'false'
    assert str(len(token_hex(6))) == '12'

    try:
        secure_bits: int = randbits(12)
        assert str(secure_bits >= 0) == 'true'
        below: int = randbelow(7)
        assert str(below >= 0 and below < 7) == 'true'
    except ValueError as e:
        assert str("unexpected secrets error: " + e.message) == 'iterators_random_and_secrets: secrets block passed'

    try:
        _bad_below: int = randbelow(0)
        assert str("randbelow unexpectedly succeeded") == 'iterators_random_and_secrets: randbelow handled'
    except ValueError as e:
        assert str(e.message) == 'randbelow: n must be > 0'

    try:
        _bad_randbits: int = randbits(-1)
        assert str("randbits unexpectedly succeeded") == 'iterators_random_and_secrets: randbits handled'
    except ValueError as e:
        assert str(e.message) == 'randbits: number of bits must be >= 0'
