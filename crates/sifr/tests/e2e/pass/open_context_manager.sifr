
from sifr.io import read_text

def main():
    path: str = "/tmp/sifr_open_ctx_test.txt"
    try:
        with open(path, "w", encoding="utf-8") as f:
            _: None = f.write("hello from context")
        content: str = read_text(path)
        assert str("content = " + content) == 'content = hello from context'
        assert str("context manager ok") == 'context manager ok'
    except IOError as e:
        _ = str("error: " + e.message)
