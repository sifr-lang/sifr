def add_exact(value: decimal, increment: int) -> Result[decimal, DecimalConversionError]:
    return value + increment


def main():
    d: decimal = Decimal("10.25")
    b: bigdecimal = BigDecimal("2.75")

    b2: bigdecimal = b + 5

    try:
        d2: decimal = add_exact(d, 2)
        assert d2 == Decimal("12.25")
    except DecimalConversionError:
        assert False
    assert b2 == BigDecimal("7.75")
