# Test sifr.itertools module
from sifr.itertools import chain, repeat, take, flatten

def main():
    # chain two lists
    a: list[int] = [1, 2]
    b: list[int] = [3, 4]
    result: list[int] = chain(a, b)
    assert result == [1, 2, 3, 4]

    # repeat
    repeated: list[int] = repeat(7, 3)
    assert repeated == [7, 7, 7]

    # take first N elements
    data: list[int] = [10, 20, 30, 40, 50]
    first3: list[int] = take(3, data)
    assert first3 == [10, 20, 30]

    # flatten nested lists
    nested: list[list[int]] = [[1, 2], [3], [4, 5]]
    flat: list[int] = flatten(nested)
    assert flat == [1, 2, 3, 4, 5]

