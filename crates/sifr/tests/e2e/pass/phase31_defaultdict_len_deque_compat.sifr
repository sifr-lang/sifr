def main():
    groups = collections.defaultdict(list)
    groups["hit"].append("hot")
    groups["hit"].append("hut")
    assert len(groups["hit"]) == 2
    assert len(groups["miss"]) == 0

    seen = defaultdict(set)
    seen[1].add("a")
    seen[1].add("b")
    assert "a" in seen[1]
    assert len(seen[2]) == 0

    counts = defaultdict(int)
    counts["steps"] += 1
    counts["steps"] += 2
    assert counts["steps"] == 3
    assert counts["other"] == 0

    q = deque([1, 2, 3])
    assert len(q) == 3
    assert q.popleft() == 1
