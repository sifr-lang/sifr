# Test first-class bytes operations

def main():
    try:
        # Encode string to bytes
        data: bytes = b"hello"
        assert str(len(data)) == '5'

        # Decode bytes back to string
        text: str = b"hello".decode()
        assert str(text) == 'hello'

        # Hex encoding
        hex_str: str = b"hello".hex()
        assert str(hex_str) == '68656c6c6f'

        # Hex decoding
        hex_bytes: bytes = bytes.from_hex("68656c6c6f")
        result: str = hex_bytes.decode()
        assert str(result) == 'hello'
    except ParseError as e:
        _ = str("unexpected error: " + e.message)
