# Test: recursive branch attributes still require narrowing away None.

class TreeNode:
    val: int
    left: TreeNode | None
    right: TreeNode | None

    def __init__(self, val: int, left: TreeNode | None, right: TreeNode | None):
        self.val = val
        self.left = left
        self.right = right

def unsafe_value(node: TreeNode | None) -> int:
    return node.val

def main():
    print(unsafe_value(None))
