class Helper:
    items: list[int]

    def bump(self) -> None:
        self.items.append(1)


GLOBAL_HELPER: Helper = Helper([])
COUNTS: list[int] = []


def mutate_globals() -> None:
    GLOBAL_HELPER.bump()
    COUNTS.append(1)
