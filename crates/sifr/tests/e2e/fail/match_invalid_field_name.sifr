# expect-error: SIFR-MATCH-0003: class 'Point' has no field 'z' — available fields: x, y
class Point:
    x: int
    y: int

def classify(p: Point) -> str:
    match p:
        case Point(x=px, z=pz):
            return "has z"
        case _:
            return "other"

def main():
    print(classify(Point(1, 2)))
