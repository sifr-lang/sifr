# expect-error: SIFR-PROTO-0001: type 'Blob' does not implement protocol 'Comparable' required by type parameter 'T'
# Test: using heapq with a non-Comparable type should fail
from sifr.heapq import heapify

class Blob:
    data: int

def main():
    items: list[Blob] = [Blob(3), Blob(1), Blob(2)]
    heapify(items)
