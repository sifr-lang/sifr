# expect-error: SIFR-TYPE-0001: type 'float' does not satisfy constraints (int, str) required by type parameter 'T'
# Test: TypeVar constraints reject unsupported concrete type
from typing import TypeVar

T = TypeVar("T", int, str)

def echo(x: T) -> T:
    return x

def main():
    bad: float = echo(1.5)
    print(bad)
