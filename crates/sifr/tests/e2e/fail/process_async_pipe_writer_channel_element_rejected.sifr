# expect-error: SIFR-OWN-0011
from sifr.process import AsyncPipeWriter
from sifr.sync import Channel, ChannelSender, ClosedError


async def main() -> Result[None, ClosedError]:
    sender: ChannelSender[AsyncPipeWriter] = ChannelSender(Channel([], -1))
    writer: AsyncPipeWriter = AsyncPipeWriter(0)
    sent = await sender.send(writer)
    return None
