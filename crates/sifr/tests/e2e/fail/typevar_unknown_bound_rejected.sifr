# expect-error: SIFR-TYPE-0001: type 'int' does not implement protocol 'MissingBound' required by type parameter 'T'
# Test: unknown TypeVar bound is rejected (no default-allow fallback)
from typing import TypeVar

T = TypeVar("T", bound=MissingBound)

def identity(x: T) -> T:
    return x

def main():
    value: int = identity(1)
    print(value)
