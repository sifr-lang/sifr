# expect-error: SIFR-TYPE-0002: argument 1 ('values') of function 'accepts_mixed': expected 'list[int | str]', got 'list[int]'
# Test: mutable list variance is invariant (list[int] is not list[int | str])

def accepts_mixed(values: list[int | str]) -> int:
    return len(values)

def main():
    ints: list[int] = [1, 2, 3]
    size: int = accepts_mixed(ints)
    print(size)
