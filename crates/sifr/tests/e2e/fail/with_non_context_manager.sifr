# expect-error: SIFR-PROTO-0003: type 'PlainClass' does not implement the ContextManager protocol (missing __enter__ and __exit__ methods)
# Test that using a non-context-manager type in with produces a compile error
class PlainClass:
    value: int

    def __init__(self, value: int):
        self.value = value

def main():
    with PlainClass(42) as p:
        print("should not reach here")
