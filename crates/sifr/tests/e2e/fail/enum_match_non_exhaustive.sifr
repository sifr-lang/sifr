# expect-error: SIFR-MATCH-0001: non-exhaustive match: enum 'Color' has uncovered variants: BLUE — add matching case(s) or `case _:`
from enum import Enum

class Color(Enum):
    RED = 1
    GREEN = 2
    BLUE = 3

def describe(c: Color) -> str:
    match c:
        case Color.RED:
            return "red"
        case Color.GREEN:
            return "green"

def main():
    print(describe(Color.BLUE))
